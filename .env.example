# BAKR - DNSC Scholarship Matching and Monitoring System: environment template.
# Copy to .env, then run: php artisan key:generate
# Never commit .env. Never change APP_KEY on an existing DB: encrypted answers become unreadable.
#
# Production values (differ from local):
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://<your-domain>
#   LOG_LEVEL=warning
#   SESSION_SECURE_COOKIE=true
#   SESSION_ENCRYPT=true
#   MAIL_MAILER=smtp            (see CONTACT-SETUP.md)
#   Back up APP_KEY somewhere safe outside the server.

APP_NAME=BAKR
# Going live (or sharing this PC through a tunnel): APP_ENV=production, APP_DEBUG=false, LOG_LEVEL=warning,
# SESSION_SECURE_COOKIE=true, SESSION_ENCRYPT=true. With APP_DEBUG=true any error shows its code, SQL and
# request details to whoever triggered it.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local: MySQL via XAMPP. Create the `bakr` database first.
# Tests always use SQLite :memory: (phpunit.xml), whatever is set here.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bakr
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true   (production, HTTPS only: the sign-in cookie is never sent over plain http)

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail: `log` writes emails to storage/logs/laravel.log. For Gmail SMTP see CONTACT-SETUP.md.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- BAKR settings ---
# Where Contact-page messages are emailed (config/bakr.php).
BAKR_CONTACT_TO=bakr.dnsc@gmail.com

# Optional AI explainer (config/bakr_ai.php). Leave the key empty to use the
# built-in template explanations; AI buttons are hidden. Never commit a real key.
BAKR_AI_PROVIDER=gemini
# Google AI Studio key (https://aistudio.google.com). Free tier: Google may use requests to improve
# its products and human reviewers may read them; BAKR sends no name or e-mail.
BAKR_GEMINI_KEY=
BAKR_GEMINI_MODEL=gemini-3.5-flash-lite
# Claude instead: set BAKR_AI_PROVIDER=claude and BAKR_AI_KEY.
BAKR_AI_KEY=
BAKR_AI_MODEL=claude-haiku-5-5
BAKR_AI_ENDPOINT=https://api.anthropic.com/v1/messages
BAKR_AI_TIMEOUT=20

# Provider Portal accounts (config/providers.php). Used only by
# `php artisan db:seed --class=ProviderAccountSeeder`, which hashes the password
# (min. 12 characters). Leave empty here; never commit real values.
PROVIDER_CHED_EMAIL=
PROVIDER_CHED_PASSWORD=
PROVIDER_DOST_EMAIL=
PROVIDER_DOST_PASSWORD=
PROVIDER_CEBUANA_EMAIL=
PROVIDER_CEBUANA_PASSWORD=
PROVIDER_DNSC_EMAIL=
PROVIDER_DNSC_PASSWORD=
PROVIDER_GRAB_EMAIL=
PROVIDER_GRAB_PASSWORD=
PROVIDER_LANDBANK_EMAIL=
PROVIDER_LANDBANK_PASSWORD=
PROVIDER_BFAR_EMAIL=
PROVIDER_BFAR_PASSWORD=

# Administrator account (config/bakr.php 'admin'). Used only by
# `php artisan db:seed --class=AdminAccountSeeder` (password min. 12 characters). Never commit real values.
ADMIN_NAME="BAKR Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
