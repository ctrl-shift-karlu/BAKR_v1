/* BAKR — Officer Login (officerLogin). Moved out of the Blade view's inline <script> blocks (same order). */

const eyeOn = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z"/><circle cx="12" cy="12" r="3"/></svg>';
const eyeOff = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.94 10.94 0 0 1 12 19c-7 0-11-7-11-7a20.6 20.6 0 0 1 5.06-5.94M9.9 4.24A10.6 10.6 0 0 1 12 4c7 0 11 7 11 7a20.6 20.6 0 0 1-2.16 3.19M14.12 14.12a3 3 0 1 1-4.24-4.24"/><path d="M1 1l22 22"/></svg>';
document.querySelector('.eye-btn').innerHTML = eyeOn;
/* Sign-in loading screen: same preloader as the home page, shown while signing in. */
(() => {
  const preloader = document.getElementById('nxPreloader');
  const form = document.querySelector('form');
  const link = document.querySelector('.btn-signin a');
  if (!preloader || !form || !link) return;
  const target = link.href;
  let busy = false;
  new Image().src = document.body.dataset.logo; // preload so the logo is ready
  const signIn = () => {
    if (busy) return;
    busy = true;
    preloader.setAttribute('aria-hidden', 'false');
    preloader.classList.remove('nx-preloader-hide');
    setTimeout(() => {
      // fade the modal away, then show the dashboard
      preloader.classList.add('nx-preloader-hide');
      preloader.setAttribute('aria-hidden', 'true');
      setTimeout(() => { window.location.href = target; }, 450);
    }, 2000);
  };
  form.addEventListener('submit', e => { e.preventDefault(); signIn(); });
  link.addEventListener('click', e => { e.preventDefault(); signIn(); });
  // Coming back with the browser Back button: don't leave the loader stuck on screen.
  window.addEventListener('pageshow', e => {
    if (e.persisted) {
      busy = false;
      preloader.setAttribute('aria-hidden', 'true');
      preloader.classList.add('nx-preloader-hide');
    }
  });
})();
