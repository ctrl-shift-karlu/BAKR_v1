{{-- Staff prototype "forgot password" (scholar / admin). PROTOTYPE: sends nothing
     (public/js/bakr-forgot-password.js). Students use the real flow at route('student.password.request').
     ?from=scholar|admin picks the login page the back links return to. --}}
@php
    $from = in_array(request('from'), ['scholar', 'admin'], true) ? request('from') : 'admin';
    $loginUrl = url($from.'Login');
@endphp
