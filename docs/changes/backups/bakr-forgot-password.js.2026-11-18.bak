/* BAKR — staff prototype Forgot password (forgotPassword). PROTOTYPE: nothing is sent. */
(() => {
  const requestStep = document.getElementById('requestStep');
  const sentStep = document.getElementById('sentStep');
  const form = document.getElementById('resetForm');
  const emailInput = document.getElementById('email');
  const emailError = document.getElementById('emailError');
  const sendBtn = document.getElementById('sendBtn');
  const sendLabel = sendBtn.querySelector('span');
  const resendBtn = document.getElementById('resendBtn');
  const changeBtn = document.getElementById('changeBtn');
  const sentEmail = document.getElementById('sentEmail');
  let cooldownTimer = null;

  const validEmail = (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);

  const setInvalid = (on) => {
    emailInput.classList.toggle('is-invalid', on);
    emailInput.setAttribute('aria-invalid', on ? 'true' : 'false');
    emailError.hidden = !on;
  };
  emailInput.addEventListener('input', () => setInvalid(false));

  function startCooldown(seconds) {
    let left = seconds;
    resendBtn.disabled = true;
    clearInterval(cooldownTimer);
    const tick = () => {
      if (left <= 0) {
        clearInterval(cooldownTimer);
        resendBtn.disabled = false;
        resendBtn.textContent = 'Resend link';
        return;
      }
      resendBtn.textContent = 'Resend link in ' + left + 's';
      left--;
    };
    tick();
    cooldownTimer = setInterval(tick, 1000);
  }

  function showSent(email) {
    // TODO: replace with a real request once staff accounts exist.
    sentEmail.textContent = email;
    requestStep.hidden = true;
    sentStep.hidden = false;
    startCooldown(30);
    resendBtn.focus();
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = emailInput.value.trim();
    if (!validEmail(email)) {
      setInvalid(true);
      emailInput.focus();
      return;
    }
    sendBtn.disabled = true;
    sendLabel.textContent = 'Sending…';
    setTimeout(() => {
      sendBtn.disabled = false;
      sendLabel.textContent = 'Send reset link';
      showSent(email);
    }, 600);
  });

  resendBtn.addEventListener('click', () => startCooldown(30));

  changeBtn.addEventListener('click', () => {
    clearInterval(cooldownTimer);
    sentStep.hidden = true;
    requestStep.hidden = false;
    emailInput.focus();
    emailInput.select();
  });
})();
