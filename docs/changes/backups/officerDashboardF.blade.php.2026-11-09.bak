      <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
  </div>
</div>

<style>
/* Toast notifications: lower-right on desktop, top-center on mobile. */
.toast-container {
  top: auto !important;
  bottom: 0 !important;
  left: auto !important;
  right: 0 !important;
  transform: none !important;
  width: min(420px, calc(100vw - 2rem));
  padding: 1rem !important;
  pointer-events: none;
}
.toast-container .toast {
  width: 100%;
  max-width: 420px;
  margin: 0 auto;
  pointer-events: auto;
}
@media (max-width: 575.98px) {
  .toast-container {
    top: 0 !important;
    bottom: auto !important;
    left: 50% !important;
    right: auto !important;
    transform: translateX(-50%) !important;
    width: calc(100vw - 1rem);
    padding: .5rem !important;
  }
  .toast-container .toast {
    max-width: none;
  }
}
</style>

<!-- Bootstrap 5.3 JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
/* ============================================================
   DEMO DATA
   ============================================================ */
/* SAMPLE DATA: placeholder per-disbursement amount used only when a scholarship has no stated amount.
   Real amounts come from SCHOLARSHIP_BENEFITS / SCHOLARSHIP_CLASSIFICATIONS (with their release frequency). */
const SAMPLE_STIPEND_AMOUNT = 8000;
const CURRENT_AY = '2026–2027';
const CURRENT_BATCH_NUMBER = 3;
const CURRENT_SEM = '1st Semester';
const OFFICER_NAME = 'Juan Dela Cruz';

/* ------------------------------------------------------------
   SCHOLARSHIP CATALOG — mirrors the Admin dashboard's PROGRAM_CONFIGS verbatim
   (name/label, code, category, min/max amount, frequency, rules, benefits,
   required documents, maintenance). This is the single source for every
   scholarship attribute in the officer dashboard (SCHOLARSHIPS,
   SCHOLARSHIP_BENEFITS / _ELIGIBILITY / _REQUIREMENTS /
   _MAINTENANCE_REQUIREMENTS and the stipend rules below).
   ------------------------------------------------------------ */
const SCHOLARSHIP_CATALOG = {
  'DNSC Academic Scholarship': {
    label: "DNSC Academic Scholarship", code: "DNS-001", category: "Institutional support", minAmount: null, maxAmount: null, hasStipend: false, scholarCount: 0,
    amountLabel: "Not applicable", frequency: "N/A", note: "DNSC internal scholarship: stipend amount not applicable",
    rules: ["DNSC student","Academic performance / GPA","Year level","Enrollment status"],
    stipendBenefits: [],
    otherBenefits: ["Financial assistance for educational expenses","Possible stipend or scholarship allowance","Recognition for academic excellence","Support for continuing higher education"],
    documents: ["Certificate of Registration","Certificate of Rating (grades)"],
    maintenance: ["Retention requirements and grade thresholds are not published; confirm with the DNSC Scholarship and Grants Unit"]
  },
  'DNSC GIA Category A': {
    label: "DNSC Grant-in-Aid (GIA) – Category A", code: "DNS-002", category: "Institutional support", minAmount: null, maxAmount: null, hasStipend: false, scholarCount: 0,
    amountLabel: "Not applicable", frequency: "N/A", note: "DNSC internal scholarship: stipend amount not applicable",
    rules: ["DNSC student","Talent / skill category (music, dance, arts, sports)","Awards / achievements","Year level","Enrollment status"],
    stipendBenefits: [],
    otherBenefits: ["Financial assistance for educational expenses","Possible stipend or grant allowance","Opportunities to develop and showcase talents","Recognition for achievements in sports, music, dance, or arts"],
    documents: ["Certificate of Registration","Certificate of Rating (grades)"],
    maintenance: ["Retention requirements and grade thresholds are not published; confirm with the DNSC Scholarship and Grants Unit"]
  },
  'DNSC GIA Category B': {
    label: "DNSC Grant-in-Aid (GIA) – Category B", code: "DNS-003", category: "Institutional support", minAmount: null, maxAmount: null, hasStipend: false, scholarCount: 0,
    amountLabel: "Not applicable", frequency: "N/A", note: "DNSC internal scholarship: stipend amount not applicable",
    rules: ["DNSC student","Student Supreme Council officer or Student Publication Editorial Board member","Year level"],
    stipendBenefits: [],
    otherBenefits: ["Financial assistance for educational expenses","Possible stipend or grant allowance","Recognition for leadership or student publication service","Support for continued participation in campus organizations"],
    documents: ["Certificate of Registration","Certificate of Rating (grades)"],
    maintenance: ["Retention requirements and grade thresholds are not published; confirm with the DNSC Scholarship and Grants Unit"]
  },
  'DNSC SA Category C': {
    label: "DNSC Student Assistant (SA) – Category C", code: "DNS-004", category: "Institutional support", minAmount: null, maxAmount: null, hasStipend: false, scholarCount: 0,
    amountLabel: "Not applicable", frequency: "N/A", note: "DNSC internal scholarship: stipend amount not applicable",
    rules: ["DNSC student","Financial need / family income","Willingness to work as student assistant","Year level"],
    stipendBenefits: [],
    otherBenefits: ["Financial assistance for educational expenses","Possible stipend or student assistant allowance","Opportunity to gain work experience while studying","Development of workplace, communication, and organizational skills"],
    documents: ["Certificate of Registration","Certificate of Rating (grades)"],
    maintenance: ["Retention requirements and grade thresholds are not published; confirm with the DNSC Scholarship and Grants Unit"]
  },
  'CHED TDP': {
    label: "CHED TDP", code: "TDP-002", category: "Government assistance", minAmount: 7500, maxAmount: 7500, scholarCount: 0,
    amountLabel: "₱7,500.00 / semester", frequency: "Per semester", note: "",
    rules: ["GWA ≤ 1.75","Enrolled full-time"],
    stipendBenefits: ["₱7,500.00 / semester"],
    otherBenefits: ["Educational assistance"],
    documents: ["Certified true copy or electronically generated Certificate of Enrolment/Registration (COE/COR) showing the number of units","Certified true copy of the Leave of Absence (LOA) filed with the school (if applicable: returning students who skipped one semester in an academic year)","Certificate of Ratings (grades)"],
    maintenance: ["Continuing grantees must have a TDP Award Number and be enrolled in the current semester","The school, not the student, submits the consolidated Continuing TDP Forms 1–4 (billing statement, grantee details, registrar's certification) to the CHED regional office","No grade-average requirement as long as courses are passed (per a 2025 news report; secondary information, confirm with CHED)"]
  },
  'DOST-SEI': {
    label: "DOST-SEI Scholarship", code: "DOST-003", category: "Government support", minAmount: 8000, maxAmount: 8000, scholarCount: 0,
    amountLabel: "₱8,000.00 / month", frequency: "Per month", note: "",
    rules: ["Household income cap","GWA ≤ 2.00"],
    stipendBenefits: ["₱8,000.00 / month"],
    otherBenefits: ["Living allowance","Other configured DOST-SEI benefits"],
    documents: ["Registration form (each semester)","Certified copy of grades for all subjects enrolled (each semester)"],
    maintenance: ["Comply with the Scholarship Agreement and maintain the grade requirements until the course is finished","Grades are evaluated before the next semester's benefits are released","DOST-SEI issues a Letter of Enrolment each term","Exact grade cutoff and current list of forms not found; confirm with the DOST regional office"]
  },
  'CHED TES': {
    label: "CHED TES", code: "TES-001", category: "Merit-based", minAmount: 20000, maxAmount: 20000, scholarCount: 0,
    amountLabel: "₱20,000.00 / year", frequency: "Per academic year", note: "DNSC is an SUC/LUC: ₱20,000 per academic year · ₱10,000 per semester disbursement",
    rules: ["GWA ≤ 1.50"],
    stipendBenefits: ["₱20,000.00 / year"],
    otherBenefits: ["₱20,000 academic year for SUC/LUC or ₱27,000 for Private HEI"],
    documents: ["Certificate of Registration/Enrollment (COR/COE)","Certificate of Residency (private HEIs in cities or municipalities with no SUC/LUC only)","PWD ID (if applicable)","Certificate of Ratings (grades)"],
    maintenance: ["Meet the admission and retention policies of the SUC/LUC","No previous undergraduate degree","Do not overstay in the program (4–5 years plus a 1-year grace period)","Schools submit Continuing TES Forms 1–3 for validation each semester"]
  },
  'Bagong Pilipinas Scholarship Program': {
    label: "Bagong Pilipinas (BPMSP)", code: "BPM-005", category: "Performance-based", minAmount: null, maxAmount: null, scholarCount: 0,
    amountLabel: "Amount not stated", frequency: "N/A", note: "Stipend amount not stated",
    rules: ["Filipino citizen","Incoming first-year college student with no tertiary units or degree earned","Top 5 of the graduating class OR Grade 12 / SHS GWA of at least 95%","Combined annual gross income of parents/guardians not exceeding ₱2,000,000","Enrolled in a CHED-identified priority program"],
    stipendBenefits: [],
    otherBenefits: ["Merit scholarship benefits per approved program configuration"],
    documents: ["Certified true copy of COR/COE, or system-generated registration document certified by the Registrar (each succeeding payment)","Certified true copy of grades (GWA) from the previous semester/term (each succeeding payment)","Certification of no other nationally funded scholarship (start of every academic year)","Leave of Absence (Annex H) (if applicable)","Permit to Travel (if going abroad)","Graduate exit form (Annex I) (at graduation)","Return Service Agreement papers (at graduation)"],
    maintenance: ["Pass all subjects every semester","Enroll the required regular load","Promptly inform the CHED regional office of any change in status or program","Leave of Absence (Annex H): prior written approval required; allowed once for up to one academic year","Transfer or shift outside the priority domain requires prior CHED regional office approval; otherwise it is grounds for termination","Permit to Travel required when going abroad","At graduation: submit the graduate exit form (Annex I) and Return Service Agreement papers"]
  },
  'CHED Merit Scholarship Program': {
    label: "CHED Merit (CMSP)", code: "CMS-006", category: "Community support", minAmount: 20000, maxAmount: 40000, scholarCount: 0,
    amountLabel: "₱20,000.00–40,000.00 / semester", frequency: "Per semester", note: "Full: ₱40,000/semester (₱35,000 stipend + ₱5,000 allowance) · Half: ₱20,000/semester (₱17,500 stipend + ₱2,500 allowance)",
    rules: ["Community program eligibility"],
    stipendBenefits: ["₱20,000.00–40,000.00 / semester"],
    otherBenefits: ["Book and connectivity allowance (₱5,000 for full scholars, ₱2,500 for half scholars, per semester)","Tuition and other school fees are covered by Free Higher Education for SUC/LUC scholars"],
    documents: ["Certificate of Registration","Certificate of Ratings (latest grade)","Landbank Card","Student ID"],
    maintenance: ["Maintain a GWA of at least 85% (full scholar) or 80% (half scholar)","Carry a full course load each semester","Numeric grades are required; a pass/fail transcript cannot be evaluated"]
  },
  'GrabScholar': {
    label: "GrabScholar", code: "GRB-007", category: "Partner assistance", minAmount: 8000, maxAmount: 8000, scholarCount: 0,
    amountLabel: "₱8,000.00 / month", frequency: "Per month", note: "Monthly student allowance. Full-ride: also covers 100% tuition and miscellaneous fees plus a ₱11,000/year school-supplies allowance (Grab PH)",
    rules: ["Partner program eligibility"],
    stipendBenefits: ["₱8,000.00 / month"],
    otherBenefits: ["100% tuition and miscellaneous fees","₱11,000/year school-supplies allowance"],
    documents: ["Certificate of Registration","Certificate of Rating (grades)"],
    maintenance: ["Retention requirements are not listed publicly (Grab covers school fees for the whole degree as long as retention requirements are met); confirm with grabscholarcollegescholarship@gmail.com or the Scholarship Agreement"]
  },
  'cebuana': {
    label: "Cebuana Lhuillier (CLFI)", code: "CEB-008", category: "Partner assistance", minAmount: null, maxAmount: 50000, scholarCount: 0,
    amountLabel: "Up to ₱50,000.00", frequency: "Fixed stipend", note: "CLFI publishes a fixed stipend of up to ₱50,000 but does not state the payout period on its official page; confirm with CLFI before disbursing",
    rules: ["Partner program eligibility"],
    stipendBenefits: ["Up to ₱50,000.00"],
    otherBenefits: ["Support for school-related and living expenses","Education-to-Employment (E2E) pathway with the PJ Lhuillier Group of Companies"],
    documents: ["24K Loyalty Card","Proof of income","Grades (GWA of 85% with no failing mark)","Good Moral certificate","Enrollment form","Grading system"],
    maintenance: ["Renewal/retention rules are not published by CLFI; contact clfi@pjlhuillier.com"]
  }
};
// Stipend vs. other benefits are stored separately; `benefits` stays as the combined list for existing consumers.
Object.values(SCHOLARSHIP_CATALOG).forEach(c => { c.benefits = [...c.stipendBenefits, ...c.otherBenefits]; });

// Release period follows the scholarship's release frequency (admin: Per month → "September 2026").
function releasePeriodLabel(scholarshipKey) {
  const f = SCHOLARSHIP_CATALOG[scholarshipKey] && SCHOLARSHIP_CATALOG[scholarshipKey].frequency;
  if (f === 'Per month') return ['January','February','March','April','May','June','July','August','September','October','November','December'][QUEUE_NOW.getMonth()] + ' ' + QUEUE_NOW.getFullYear();
  return CURRENT_SEM + ' ' + CURRENT_AY;
}
const scholarshipHasStipend = name => !(SCHOLARSHIP_CATALOG[name] && SCHOLARSHIP_CATALOG[name].hasStipend === false);

// Scholarship stipend rules, derived from SCHOLARSHIP_CATALOG so the officer and admin views agree.
// DNSC internal scholarships carry NO stipend (₱0.00); CHED Merit is paid by Half/Full classification.
const _CLASSIFIED_STIPENDS = {
  'CHED Merit Scholarship Program': {
    full: { amount: SCHOLARSHIP_CATALOG['CHED Merit Scholarship Program'].maxAmount, cadence: 'Per semester', note: '₱35,000 stipend + ₱5,000 book/connectivity allowance (SUC/LUC rate)' },
    half: { amount: SCHOLARSHIP_CATALOG['CHED Merit Scholarship Program'].minAmount, cadence: 'Per semester', note: '₱17,500 stipend + ₱2,500 book/connectivity allowance (SUC/LUC rate)' }
  }
};
// Declared before first use: getScholarStipendAmount() reads it while the scholar data is being built.
const _FREQ_SUFFIX = { 'Per month': ' / month', 'Per semester': ' / semester', 'Per academic year': ' / year' };
const GRANT_PROGRAM_STIPENDS = Object.freeze(Object.fromEntries(Object.entries(SCHOLARSHIP_CATALOG).map(([name, c]) => {
  if (_CLASSIFIED_STIPENDS[name]) return [name, { classification: _CLASSIFIED_STIPENDS[name] }];
  if (c.hasStipend === false) return [name, { amount: 0, cadence: 'N/A', noStipend: true, note: c.note }];
  const rule = { amount: c.maxAmount, cadence: c.frequency };
  if (c.minAmount == null && c.maxAmount != null) rule.prefix = 'Up to ';
  if (c.note) rule.note = c.note;
  return [name, rule];
})));

/* Amount released per disbursement, driven by the scholar's own scholarship.
   - Uses the rule in GRANT_PROGRAM_STIPENDS (CHED Merit also follows Half/Full).
   - CHED TES is published per academic year, so it is split across two semesters (override below).
   - Grants with no published amount (DNSC Internal, GIA, Student Assistant,
     Bagong Pilipinas) use DEFAULT_STIPEND_AMOUNT until an amount is configured. */
const DEFAULT_STIPEND_AMOUNT = SAMPLE_STIPEND_AMOUNT;
// CHED TES publishes ₱20,000 per academic year for SUC/LUC (DNSC is an SUC) → ₱10,000 per semester.
const PER_DISBURSEMENT_OVERRIDES = Object.freeze({}); // CHED TES: ₱20,000 per academic year is split per semester (₱10,000) by getScholarStipendAmount()
function getScholarStipendAmount(scholar) {
  if (!scholar) return DEFAULT_STIPEND_AMOUNT;
  if (!scholarshipHasStipend(scholar.scholarship)) return 0; // DNSC internal scholarships: ₱0.00, no stipend
  if (PER_DISBURSEMENT_OVERRIDES[scholar.scholarship]) return PER_DISBURSEMENT_OVERRIDES[scholar.scholarship];
  const rule = GRANT_PROGRAM_STIPENDS[scholar.scholarship];
  const classification = scholar.classification || (rule && rule.classification ? 'full' : 'na');
  const d = getGrantStipendDetails(scholar.scholarship, classification);
  if (!d.amount) return DEFAULT_STIPEND_AMOUNT;
  return d.cadence === 'Per academic year' ? Math.round(d.amount / 2) : d.amount;
}
function stipendForStudent(student_id) {
  return getScholarStipendAmount(scholars.find(x => x.student_id === student_id));
}

const _docId = n => String(n).toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, '');
const DOC_TYPES = (function () {
  const seen = new Map();
  Object.values(SCHOLARSHIP_CATALOG).forEach(c => c.documents.forEach(n => { if (!seen.has(n)) seen.set(n, { id: _docId(n), name: n }); }));
  return [...seen.values()];
})();

// Each scholarship owns its required document list, taken from the admin catalog (SCHOLARSHIP_REQUIREMENTS.document_name).
// All counts, verification states and document information use only the requirements for that scholar's scholarship.
const SCHOLARSHIP_DOCUMENT_REQUIREMENTS = Object.freeze(Object.fromEntries(
  Object.entries(SCHOLARSHIP_CATALOG).map(([k, c]) => [k, c.documents.map(_docId)])));
function getRequiredDocTypes(scholar) {
  const ids = SCHOLARSHIP_DOCUMENT_REQUIREMENTS[scholar?.scholarship] || DOC_TYPES.map(d => d.id);
  return ids.map(id => DOC_TYPES.find(d => d.id === id)).filter(Boolean);
}
function getRequiredDocumentCount(scholar) { return getRequiredDocTypes(scholar).length; }
function hasCompletedRequiredSubmission(scholar) {
  return getRequiredDocTypes(scholar).every(dt => Boolean(scholar.docs[dt.id]?.file));
}

/* Time-in-Stage / Stale Alert config.
   QUEUE_NOW anchors "how long has this been sitting" calculations to the
   same fictional "today" the rest of the seeded demo data uses, so the
   durations below line up with the seeded submittedAt timestamp logs
   (i.e. the scholar_documents rows) rather than the visitor's real clock. */
const QUEUE_NOW = new Date('2026-09-11T16:00:00');
const STALE_THRESHOLD_HOURS = 48;

// Each scholar carries their own document set + stipend release flag.
// Disbursement channels a scholar's stipend can be routed through.
const DISBURSEMENT_CHANNELS = [
  { id: 'landbank', label: 'LandBank', icon: 'bi-bank2' },
  { id: 'ewallet',  label: 'E-Wallet', icon: 'bi-phone' },
  { id: 'other',  label: 'Others', icon: 'bi-building' },
];

// Sub-statuses unique to the payout-provider process, tracked per channel.
// A scholar sits in one of the first two while awaiting the provider; a
// failed match is logged separately in BANK_FAILURES (subType: 'account_mismatch').


/* Canonical list of DNSC institutes and their degree programs — the single
   source of truth for program dropdowns, analytics grouping and validation. */
const DNSC_INSTITUTES = [
  { name: 'Institute of Computing (IC)', programs: [
    'Bachelor of Science in Information Systems (BSIS)',
    'Bachelor of Science in Information Technology (BSIT)' ] },
  { name: 'Institute of Aquatic and Applied Sciences (IAAS)', programs: [
    'Bachelor of Science in Agro-Forestry (BSAF)',
    'Bachelor of Science in Fisheries and Aquatic Sciences (BSFAS)',
    'Bachelor of Science in Food Technology (BSFT)',
    'Bachelor of Science in Marine Biology (BSMB)' ] },
  { name: 'Institute of Leadership, Entrepreneurship, and Good Governance (ILEGG)', programs: [
    'Bachelor of Public Administration (BPA)',
    'Bachelor of Science in Criminology (BSCrim)',
    'Bachelor of Science in Disaster and Resilience Management (BSDRM)',
    'Bachelor of Science in Entrepreneurship (BS ENTREP)',
    'Bachelor of Science in Social Work (BSSW)',
    'Bachelor of Science in Tourism Management (BSTM)' ] },
  { name: 'Institute of Teacher Education (ITED)', programs: [
    'Bachelor of Arts in Communication (BACOMM)',
    'Bachelor of Secondary Education (BSeD) - English',
    'Bachelor of Secondary Education (BSeD) - Mathematics',
    'Bachelor of Secondary Education (BSeD) - Science',
    'Bachelor of Technology and Livelihood Education (BTLEd)',
    'Bachelor of Physical Education (BPE)' ] }
];
const DNSC_PROGRAMS = DNSC_INSTITUTES.flatMap(i => i.programs);
function instituteOfProgram(program) {
  const hit = DNSC_INSTITUTES.find(i => i.programs.includes(program));
  return hit ? hit.name : 'Unassigned';
}
function populateProgramSelects() {
  const sel = document.getElementById('nasProgram');
  if (!sel) return;
  sel.innerHTML = '<option value="">Select degree program…</option>' + DNSC_INSTITUTES.map(i => `<optgroup label="${i.name}">${i.programs.map(pn => `<option>${pn}</option>`).join('')}</optgroup>`).join('');
}
populateProgramSelects();

/* ============================================================
   SAMPLE DATA — NORMALIZED TABLES (mirror the ERD)
   Every record below uses the schema's table and column names.
   The dashboard's view objects (`scholars`, `disbursementHistory`)
   are DERIVED from these tables further down, so the UI reads the
   same shapes as before while the underlying data follows the schema.
   ============================================================ */
const _pad2 = n => String(n).padStart(2, '0');
const _slug = t => String(t).toUpperCase().replace(/[^A-Z0-9]+/g, '_').replace(/^_|_$/g, '');
const _isoLabel = d => d.getFullYear() + '-' + _pad2(d.getMonth() + 1) + '-' + _pad2(d.getDate());
function _fmtDate(iso) {            // 'YYYY-MM-DD…' -> 'Sep 5, 2026' (display only)
  if (!iso) return null;
  return new Date(String(iso).slice(0, 10) + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

/* ---------- USERS & REFERENCE ---------- */
const USERS = [
  { user_id: 1, full_name: OFFICER_NAME, email: 'juan.delacruz@dnsc.edu.ph', password_hash: '(hashed)', role: 'officer', is_active: true, must_change_password: false },
  { user_id: 2, full_name: 'Scholarship Administrator', email: 'admin.scholarships@dnsc.edu.ph', password_hash: '(hashed)', role: 'admin', is_active: true, must_change_password: false }
];
const OFFICERS = [{ user_id: 1 }];
const ADMINS = [{ user_id: 2 }];

const CAMPUSES = ['Main (Panabo Campus)', 'Carmen Campus', 'Samal Campus', 'Talaingod Campus', 'Asuncion Campus']
  .map((campus_name, i) => ({ campus_id: i + 1, campus_name }));

const ACADEMIC_PROGRAMS = (function () {
  let id = 1;
  return DNSC_INSTITUTES.flatMap(inst => inst.programs.map(program_name => {
    const m = program_name.match(/\(([^)]+)\)\s*(?:-\s*(.+))?$/);
    const program_code = m ? (m[2] ? m[1] + '-' + m[2].slice(0, 3).toUpperCase() : m[1]) : _slug(program_name);
    return { program_id: id++, program_code, program_name, institute: inst.name };
  }));
})();

const ACADEMIC_TERMS = [
  { term_id: 1, academic_year: '2024–2025', semester: '2nd Semester', document_deadline: '2025-03-31', is_current: false },
  { term_id: 2, academic_year: '2025–2026', semester: '1st Semester', document_deadline: '2025-09-30', is_current: false },
  { term_id: 3, academic_year: '2025–2026', semester: '2nd Semester', document_deadline: '2026-03-31', is_current: false },
  { term_id: 4, academic_year: CURRENT_AY,  semester: CURRENT_SEM,   document_deadline: '2026-09-30', is_current: true }
];
const termId = (ay, sem) => ACADEMIC_TERMS.find(t => t.academic_year === ay && t.semester === sem).term_id;
const CURRENT_TERM_ID = ACADEMIC_TERMS.find(t => t.is_current).term_id;

/* ---------- SCHOLARSHIP CONFIGURATION ---------- */
const _fundingForCategory = category => category === 'Institutional support' ? 'DNSC Scholarship Trust Fund'
  : (category === 'Partner assistance' ? 'Private sponsor grant' : 'Government scholarship grant');
// scholarship_key = catalog lookup key; scholarship_name = display name (admin label).
const SCHOLARSHIPS = Object.entries(SCHOLARSHIP_CATALOG).map(([scholarship_key, c], i) => ({
  scholarship_id: i + 1, scholarship_code: c.code, scholarship_key, scholarship_name: c.label,
  category: c.category, release_frequency: c.frequency,
  min_amount: c.minAmount, max_amount: c.maxAmount, is_active: true
}));
const scholarshipByName = n => SCHOLARSHIPS.find(s => s.scholarship_key === n);

const SCHOLARSHIP_CLASSIFICATIONS = (function () {
  const rows = []; let id = 1;
  const merit = GRANT_PROGRAM_STIPENDS['CHED Merit Scholarship Program'].classification;
  Object.entries(merit).forEach(([k, v]) => rows.push({ classification_id: id++, scholarship_id: scholarshipByName('CHED Merit Scholarship Program').scholarship_id, classification_name: k === 'full' ? 'Full' : 'Half', amount: v.amount }));
  rows.push({ classification_id: id++, scholarship_id: scholarshipByName('GrabScholar').scholarship_id, classification_name: 'Full', amount: GRANT_PROGRAM_STIPENDS['GrabScholar'].amount });
  return rows;
})();
const classificationFor = (scholarship_name, key) => key && key !== 'na'
  ? SCHOLARSHIP_CLASSIFICATIONS.find(c => c.scholarship_id === scholarshipByName(scholarship_name).scholarship_id && c.classification_name.toLowerCase() === key) || null : null;

// Child tables of SCHOLARSHIPS — rows come straight from the admin catalog.
const SCHOLARSHIP_BENEFITS = (function () {
  const rows = []; let id = 1;
  // benefit_category separates the stipend (has an amount) from other benefits (no stipend amount).
  SCHOLARSHIPS.forEach(s => {
    const c = SCHOLARSHIP_CATALOG[s.scholarship_key];
    [['Stipend', c.stipendBenefits], ['Other Benefit', c.otherBenefits]].forEach(([cat, list]) => list.forEach(b => {
      const m = b.match(/₱\s?([\d,]+)/);
      rows.push({ benefit_id: id++, scholarship_id: s.scholarship_id, benefit_category: cat, benefit_name: b, benefit_type: m ? 'Cash' : 'Non-cash', description: null, amount: m ? Number(m[1].replace(/,/g, '')) : null });
    }));
  });
  return rows;
})();

const SCHOLARSHIP_ELIGIBILITY = (function () {
  const rows = []; let id = 1;
  SCHOLARSHIPS.forEach(s => SCHOLARSHIP_CATALOG[s.scholarship_key].rules.forEach(r => rows.push({ eligibility_id: id++, scholarship_id: s.scholarship_id, criterion_name: 'Criterion', required_value: r })));
  return rows;
})();

const SCHOLARSHIP_REQUIREMENTS = (function () {
  const rows = []; let id = 1;
  SCHOLARSHIPS.forEach(s => SCHOLARSHIP_CATALOG[s.scholarship_key].documents.forEach(name => rows.push({ requirement_id: id++, scholarship_id: s.scholarship_id, doc_key: _docId(name), document_name: name, description: null, where_to_get: null, processing_time: null })));
  return rows;
})();

const SCHOLARSHIP_MAINTENANCE_REQUIREMENTS = (function () {
  const rows = []; let id = 1;
  SCHOLARSHIPS.forEach(s => SCHOLARSHIP_CATALOG[s.scholarship_key].maintenance.forEach(m => rows.push({ maintenance_id: id++, scholarship_id: s.scholarship_id, category: 'Maintenance', title: m, description: 'Per the scholarship guidelines' })));
  return rows;
})();
const requirementFor = (scholarship_id, docKey) => SCHOLARSHIP_REQUIREMENTS.find(r => r.scholarship_id === scholarship_id && r.doc_key === docKey);

/* ---------- SCHOLARS, APPLICATIONS, AWARDS ---------- */
const SCHOLARS = [], ENROLLMENTS = [], SCHOLAR_APPLICATIONS = [], SCHOLARSHIP_AWARDS = [],
      REQUIREMENT_SUBMISSIONS = [], PAYOUT_ACCOUNTS = [], DISBURSEMENTS = [];

const _campusHash = key => { let h = 0; String(key || '').split('').forEach(c => { h = (h * 31 + c.charCodeAt(0)) >>> 0; }); return (h % CAMPUSES.length) + 1; };
function _splitName(full) {
  const t = full.trim().split(/\s+/);
  if (t.length >= 3 && /^[A-Z]\.$/.test(t[1])) return { first_name: t[0], middle_name: t[1], last_name: t.slice(2).join(' ') };
  return { first_name: t[0], middle_name: null, last_name: t.slice(1).join(' ') };
}
const _PROVIDER = { landbank: 'LandBank of the Philippines', ewallet: 'E-Wallet', other: 'Others' };
function payoutAccountFor(scholar_id, payment_channel) {
  let a = PAYOUT_ACCOUNTS.find(p => p.scholar_id === scholar_id && p.payment_channel === payment_channel);
  if (!a) {
    const n = PAYOUT_ACCOUNTS.length + 1;
    a = { payout_account_id: n, scholar_id, payment_channel, account_number: (payment_channel === 'ewallet' ? '0917' : '1234') + String(1000000 + n * 7919).slice(-7), provider: _PROVIDER[payment_channel] || null };
    PAYOUT_ACCOUNTS.push(a);
  }
  return a;
}
/* Seed-data helper: the roster seeds describe documents with four legacy keys (cor / enrollment / goodmoral / income).
   Map them onto each scholarship's REAL required documents from the catalog. */
function _remapSeedDocs(sch, name, legacy) {
  legacy = legacy || {};
  if (!Object.keys(legacy).length) return [];
  const tag = String(name || '').split(' ')[0];
  const reqs = SCHOLARSHIP_REQUIREMENTS.filter(r => r.scholarship_id === sch.scholarship_id);
  const pick = (...ks) => ks.map(k => legacy[k]).find(Boolean);
  const extraSrc = [legacy.income, legacy.goodmoral, legacy.enrollment];
  let ex = 0;
  return reqs.map(r => {
    const n = r.document_name.toLowerCase();
    let src, isExtra = false;
    if (n.includes('registration') || n.includes('(cor)')) src = legacy.cor;
    else if (n.includes('rating') || n.includes('grades')) { src = legacy.enrollment; isExtra = true; }
    else if (n.includes('landbank') || n.includes('card')) { src = legacy.goodmoral; isExtra = true; }
    else if (n.includes('student id')) { src = legacy.income; isExtra = true; }
    else { isExtra = true; src = extraSrc[ex++] || pick('cor', 'enrollment', 'goodmoral'); }
    src = src || pick('income', 'cor', 'enrollment', 'goodmoral');
    const d = Object.assign({}, src);
    if (d.file && isExtra) d.file = r.doc_key + '_' + tag + '.pdf';
    return [r.doc_key, d];
  });
}
/* Sample data: deterministic GWA (1.25 – 2.75) per scholar so every record has a latest GWA to display. */
function sampleGwaFor(scholar_id) { return Math.round((1.25 + ((scholar_id * 7) % 16) * 0.1) * 100) / 100; }
function addScholarRecord(o) {
  const nm = _splitName(o.name);
  const scholar_id = o.scholar_id;
  const user_id = 100 + scholar_id;
  USERS.push({ user_id, full_name: o.name, email: (nm.first_name + '.' + nm.last_name).toLowerCase().replace(/[^a-z.]/g, '') + '@dnsc.edu.ph', password_hash: '(hashed)', role: 'scholar', is_active: true, must_change_password: false });
  const prog = ACADEMIC_PROGRAMS.find(p => p.program_name === o.program_name);
  SCHOLARS.push({
    scholar_id, user_id, scholar_number: 'SCH-' + String(scholar_id).padStart(4, '0'), student_id: o.student_id, ...nm,
    email: USERS[USERS.length - 1].email, alternative_email: null, phone_number: null, birth_date: null, age: null, sex: null, nationality: 'Filipino',
    home_address: null, city: null, province: null, zip_code: null, campus_id: o.campus_id || _campusHash(o.student_id), scholar_status: 'active'
  });
  const sch = scholarshipByName(o.scholarship);
  const cls = classificationFor(o.scholarship, o.classification);
  const award_id = scholar_id;
  SCHOLARSHIP_AWARDS.push({ award_id, scholar_id, scholarship_id: sch.scholarship_id, classification_id: cls ? cls.classification_id : null, award_status: 'active', start_date: o.start_date || '2025-08-15' });
  // Enrollment for the term the scholar is on file for (current term for the roster).
  ENROLLMENTS.push({ enrollment_id: ENROLLMENTS.length + 1, scholar_id, program_id: prog.program_id, term_id: o.term_id, year_level: o.year_level, gwa: (o.gwa != null ? o.gwa : sampleGwaFor(scholar_id)), renewal_status: o.term_id === CURRENT_TERM_ID ? 'enrolled' : 'for_renewal' });
  if (o.application_submitted_at) {
    SCHOLAR_APPLICATIONS.push({
      application_id: SCHOLAR_APPLICATIONS.length + 1, scholar_id, scholarship_id: sch.scholarship_id, classification_id: cls ? cls.classification_id : null,
      program_id: prog.program_id, term_id: o.term_id, campus_id: SCHOLARS[SCHOLARS.length - 1].campus_id, scholar_number: SCHOLARS[SCHOLARS.length - 1].scholar_number,
      student_id: o.student_id, ...nm, email: SCHOLARS[SCHOLARS.length - 1].email, year_level: o.year_level, previous_gwa: null,
      payment_channel: o.payment_channel, account_number: payoutAccountFor(scholar_id, o.payment_channel).account_number, provider: _PROVIDER[o.payment_channel] || null,
      application_status: 'approved', officer_notes: null, admin_remarks: null, submitted_by_officer_id: 1, submitted_at: o.application_submitted_at, reviewed_by_admin_id: 2
    });
  }
  payoutAccountFor(scholar_id, o.payment_channel);
  // Documents → REQUIREMENT_SUBMISSIONS. A document that was never uploaded has NO submission row
  // ("not uploaded" is the absence of a record, not a stored status).
  _remapSeedDocs(sch, o.name, o.docs).forEach(([docKey, d]) => {
    const req = requirementFor(sch.scholarship_id, docKey);
    if (!req || d.status === 'not_uploaded') return;
    const verified = d.status === 'verified';
    REQUIREMENT_SUBMISSIONS.push({
      submission_id: REQUIREMENT_SUBMISSIONS.length + 1, award_id, requirement_id: req.requirement_id, term_id: o.term_id,
      version_no: d.resubmitted ? 2 : 1, file_path: d.file, verification_status: d.status, reviewer_note: d.remarks || null,
      submitted_at: d.submittedAt || null, verified_by_officer_id: verified ? 1 : null, verified_at: verified ? '2026-09-08T10:00:00' : null
    });
  });
}

/* Roster: the 8 named scholars + generated scholars across every program. */
(function seedRoster() {
