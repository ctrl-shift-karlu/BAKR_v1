        <div id="alEmptyState" class="small text-muted-custom d-none">No notification matches these filters.</div>
        <div class="demo-note mt-2">Most recent 30 notifications · sample / demo data</div>
      </div>
    </section>

    <!-- ============================================================
         PAGE: PROFILE
