/* ============================================================
   RENDER: DISBURSEMENT PIPELINE STATES (Analytics — Overview tab)
   Operational-readiness view of where payouts sit in the release
   pipeline — headcounts per stage, not currency totals.
   ============================================================ */
function countByStatus(status) {
  return AD && AD.statusCounts ? (AD.statusCounts[status] || 0) : 0;
}

function renderDisbursementPipelineStates() {
  const labels = {
    Pending: ['pkPendingValue', 'pkPendingSub', 'Waiting for submission'],
    Submitted: ['pkSubmittedValue', 'pkSubmittedSub', 'Waiting for verification'],
    Verified: ['pkVerifiedValue', 'pkVerifiedSub', 'Waiting for stipend disbursement'],
    Credited: ['pkCreditedValue', 'pkCreditedSub', 'Stipend credited'],
    Renewal: ['pkRenewalValue', 'pkRenewalSub', 'Cycle complete']
  };
  const totalStatuses = Object.keys(labels).reduce((sum, status) => sum + countByStatus(status), 0);
  const strip = document.getElementById('disbursementPipelineStates');
  if (strip) {
    strip.classList.toggle('analytics-is-empty', totalStatuses === 0);
    let empty = strip.parentElement.querySelector('.pipeline-empty-wrap');
    if (totalStatuses === 0) {
      if (!empty) { empty = document.createElement('div'); empty.className = 'pipeline-empty-wrap'; strip.insertAdjacentElement('afterend', empty); }
      empty.innerHTML = analyticsEmptyState('No payout activity yet', 'Scholars will be counted here as they move from pending to renewal.', 'bi-inbox', AD.totalScholars ? null : ANALYTICS_ADD_SCHOLAR_CTA);
    } else if (empty) empty.remove();
  }
  Object.entries(labels).forEach(([status, ids]) => {
    const valueEl = document.getElementById(ids[0]);
    const subEl = document.getElementById(ids[1]);
    if (valueEl) valueEl.textContent = countByStatus(status);
    if (subEl) subEl.textContent = `${countByStatus(status)} scholar${countByStatus(status) === 1 ? '' : 's'} · ${ids[2]}`;
  });
}

