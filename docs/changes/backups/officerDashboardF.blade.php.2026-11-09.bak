        <div class="col-6"><div class="info-item"><div class="info-label">Program</div><div class="info-value">${epmVal('epmProgram') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Year Level</div><div class="info-value">${(document.getElementById('epmYearLevel').selectedOptions[0] || {}).text || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Student ID</div><div class="info-value">${epmVal('epmStudentId') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Academic Year</div><div class="info-value">${epmVal('epmAcademicYear') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Semester</div><div class="info-value">${epmVal('epmSemester') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Previous GWA</div><div class="info-value">${epmVal('epmGwa') !== '' && !isNaN(epmVal('epmGwa')) ? Number(epmVal('epmGwa')).toFixed(2) : '–'}</div></div></div>
