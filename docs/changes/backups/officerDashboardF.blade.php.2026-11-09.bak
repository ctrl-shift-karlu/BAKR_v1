        <div class="col-6"><div class="info-item"><div class="info-label">Last Name</div><div class="info-value">${addScholarFieldValue('nasLastName') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Middle Name</div><div class="info-value">${addScholarFieldValue('nasMiddleName') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Sex</div><div class="info-value">${sexVal}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Birth Date</div><div class="info-value">${dobVal}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Nationality</div><div class="info-value">${addScholarFieldValue('nasNationality') || '–'}</div></div></div>
      </div>
    </div>
    <div class="as-review-section">
      <div class="as-review-heading">Contact &amp; Address</div>
      <div class="row info-grid">
        <div class="col-6"><div class="info-item"><div class="info-label">Email</div><div class="info-value">${addScholarFieldValue('nasEmail') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Alternative Email</div><div class="info-value">${addScholarFieldValue('nasAltEmail') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Phone Number</div><div class="info-value">${addScholarFieldValue('nasContact') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Home Address</div><div class="info-value">${addScholarFieldValue('nasSpecificAddress') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">City</div><div class="info-value">${addScholarFieldValue('nasCity') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Province</div><div class="info-value">${addScholarFieldValue('nasProvince') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">ZIP Code</div><div class="info-value">${addScholarFieldValue('nasZip') || '–'}</div></div></div>
      </div>
    </div>
    <div class="as-review-section">
      <div class="as-review-heading">Academic Details</div>
      <div class="row info-grid">
        <div class="col-6"><div class="info-item"><div class="info-label">Campus</div><div class="info-value">${addScholarFieldValue('nasInstitute') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Program</div><div class="info-value">${addScholarFieldValue('nasProgram') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Year Level</div><div class="info-value">${(document.getElementById('nasYearLevel').selectedOptions[0] || {}).text || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Student ID</div><div class="info-value">${addScholarFieldValue('nasStudentId') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Academic Year</div><div class="info-value">${addScholarFieldValue('nasAcademicYear') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Semester</div><div class="info-value">${addScholarFieldValue('nasSemester') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Previous GWA</div><div class="info-value">${addScholarFieldValue('nasGwa') !== '' && !isNaN(addScholarFieldValue('nasGwa')) ? Number(addScholarFieldValue('nasGwa')).toFixed(2) : '–'}</div></div></div>
      </div>
    </div>
    <div class="as-review-section">
      <div class="as-review-heading">Scholarship Details</div>
      <div class="row info-grid">
        <div class="col-6"><div class="info-item"><div class="info-label">Scholar Number</div><div class="info-value">${addScholarFieldValue('nasScholarId') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Scholarship</div><div class="info-value">${(document.getElementById('nasScholarship').selectedOptions[0] || {}).text || ''}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Classification</div><div class="info-value">${addScholarFieldValue('nasClassification') === 'na' ? 'N/A' : addScholarFieldValue('nasClassification')}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Stipend</div><div class="info-value">${document.getElementById('nasStipend').value || '–'}</div></div></div>
