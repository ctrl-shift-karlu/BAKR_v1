      <div class="card-panel">
        <div class="section-title">
          <div class="st-left"><i class="bi bi-file-earmark-check"></i><span>Submitted Scholars</span></div>
          <span id="dvStaleBadge" class="status-pill pill-red d-none"><i class="bi bi-alarm-fill"></i></span>
        </div>
        <div class="filter-bar filter-bar-search filter-bar-inline">
          <div class="row g-2 align-items-end">
            <div class="col-md-6 col-lg-3">
