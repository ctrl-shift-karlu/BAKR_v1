   ============================================================ */
function renderRecentActivity() {
  const colorClass = { 'icon-green': 'text-success', 'icon-red': 'text-danger', 'icon-neutral': 'text-primary' };
  const items = activityFeed.slice(0, 3);
  document.getElementById('recentActivityList').innerHTML = items.map((a, i) => `
    <div class="d-flex gap-3 align-items-start${i < items.length - 1 ? ' border-bottom pb-2' : ''}">
      <i class="bi ${a.icon} ${colorClass[a.cls] || 'text-primary'} fs-5"></i>
      <div>
        <div class="fs-6 fw-semibold text-dark">${a.text}</div>
        <span class="small text-muted-custom">${a.time}</span>
      </div>
    </div>
  `).join('');
}

/* ============================================================
   RENDER: NOTIFICATIONS PAGE (filterable notification sidebar)
   Categorizes each activityFeed entry by its icon so the page can be
   filtered by notification type in addition to free-text search.
   ============================================================ */
function activityCategory(icon) {
  if (icon === 'bi-patch-check-fill') return { key: 'verification', label: 'Verifications' };
  if (icon === 'bi-exclamation-triangle-fill') return { key: 'correction', label: 'Corrections' };
  if (icon === 'bi-cash-coin') return { key: 'disbursement', label: 'Disbursement' };
  return { key: 'submission', label: 'Submissions' };
}

function renderActivityLogPage() {
  const listEl = document.getElementById('activityLogList');
  if (!listEl) return;
  const colorClass = { 'icon-green': 'text-success', 'icon-red': 'text-danger', 'icon-neutral': 'text-primary' };
  populateSchoolSelect('alSchool');
  const search = (document.getElementById('alSearch').value || '').toLowerCase();
  const typeFilter = document.getElementById('alType').value;
  const schoolFilter = document.getElementById('alSchool').value;
  const items = activityFeed.filter(a => {
    const category = activityCategory(a.icon);
    const matchesType = !typeFilter || category.key === typeFilter;
    const matchesSearch = !search || a.text.toLowerCase().includes(search);
    const matchedScholar = scholars.find(s => a.text.replace(/<[^>]+>/g, '').includes(s.name));
    const matchesSchool = !schoolFilter || (matchedScholar && schoolOfScholar(matchedScholar) === schoolFilter);
    return matchesType && matchesSearch && matchesSchool;
  });

  document.getElementById('alResultCount').textContent = `${items.length} event${items.length === 1 ? '' : 's'}`;
  document.getElementById('alEmptyState').classList.toggle('d-none', items.length > 0);

  listEl.innerHTML = items.map((a, i) => {
    const category = activityCategory(a.icon);
    return `
      <div class="d-flex gap-3 align-items-start${i < items.length - 1 ? ' border-bottom pb-2' : ''}">
        <i class="bi ${a.icon} ${colorClass[a.cls] || 'text-primary'} fs-5"></i>
        <div class="flex-grow-1">
          <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div class="fs-6 fw-semibold text-dark">${a.text}</div>
            <span class="status-pill pill-gray">${category.label}</span>
          </div>
          <span class="small text-muted-custom">${a.time}</span>
        </div>
      </div>`;
  }).join('');
}

document.getElementById('alSchool')?.addEventListener('change', renderActivityLogPage);

/* ============================================================
   SHARED LIST-TABLE STATE — rows per page, page number and sorting for the
   Submitted Scholars (dv) and Eligible Scholars (sr) lists. Mirrors the
   Disbursement Records table.
   ============================================================ */
const listTable = {
  dv: { page: 1, size: 10, key: 'submitted', dir: 'desc', headRow: 'dvTableHeadRow', noun: 'scholar', render: () => renderDvTable() },
  sr: { page: 1, size: 10, key: 'default', dir: 'asc', headRow: 'srTableHeadRow', noun: 'scholar', render: () => renderStipendPage() }
};
function sortListRows(rows, valueFn, state, defaultCmp) {
  const fallback = defaultCmp || ((a, b) => String(a.name).localeCompare(String(b.name)));
  if (state.key === 'default') return rows.slice().sort(fallback);
  return rows.slice().sort((a, b) => {
    const av = valueFn(a, state.key), bv = valueFn(b, state.key);
    if (av === null && bv === null) return fallback(a, b);
    if (av === null) return 1;            // empty values always sink to the bottom
    if (bv === null) return -1;
    let cmp = av < bv ? -1 : av > bv ? 1 : 0;
    if (state.dir === 'desc') cmp = -cmp;
    return cmp || fallback(a, b);
  });
}
function paginateRows(id, rows) {
  const st = listTable[id];
  const total = rows.length;
  const pages = Math.max(1, Math.ceil(total / st.size));
  st.page = Math.min(Math.max(1, st.page), pages);
  const start = (st.page - 1) * st.size;
  return { rows: rows.slice(start, start + st.size), start, total, pages };
}
function renderListFooter(id, info) {
  const st = listTable[id];
  const counter = document.getElementById(id + 'PageCounter');
  if (info.total === 0) counter.textContent = `Showing 0 of 0 ${st.noun}s`;
  else counter.textContent = `Showing ${info.start + 1}\u2013${Math.min(info.start + st.size, info.total)} of ${info.total} ${st.noun}${info.total === 1 ? '' : 's'}`;
  document.getElementById(id + 'PrevPage').disabled = st.page <= 1;
  document.getElementById(id + 'NextPage').disabled = st.page >= info.pages;
  document.getElementById(id + 'PageNumbers').innerHTML = historyPageSequence(info.pages, st.page).map(p =>
    p === '…'
      ? `<span class="text-muted-custom px-1">\u2026</span>`
      : `<button type="button" class="btn btn-sm ${p === st.page ? 'btn-scholarship-green' : 'btn-outline-scholarship'}" onclick="goToListPage('${id}', ${p})" ${p === st.page ? 'aria-current="page"' : ''}>${p}</button>`
  ).join('');
}
function updateListSortIndicators(id) {
  const st = listTable[id];
  document.querySelectorAll(`#${st.headRow} .th-sortable`).forEach(th => {
    const key = th.getAttribute('data-sort-key');
    const active = key === st.key;
    th.classList.toggle('sorted-asc', active && st.dir === 'asc');
    th.classList.toggle('sorted-desc', active && st.dir === 'desc');
    th.setAttribute('aria-sort', active ? (st.dir === 'asc' ? 'ascending' : 'descending') : 'none');
    const icon = th.querySelector('.sort-icon');
    if (icon) icon.className = 'bi sort-icon ' + (active ? (st.dir === 'asc' ? 'bi-sort-up' : 'bi-sort-down') : 'bi-arrow-down-up');
  });
}
function sortListBy(id, key) {
  const st = listTable[id];
  if (st.key === key) st.dir = st.dir === 'asc' ? 'desc' : 'asc';
  else { st.key = key; st.dir = key === 'submitted' ? 'desc' : 'asc'; }
  st.page = 1;
  st.render();
}
function goToListPage(id, page) { listTable[id].page = page; listTable[id].render(); }
function changeListPage(id, delta) { listTable[id].page += delta; listTable[id].render(); }
function initListTableControls(id) {
  const st = listTable[id];
  document.getElementById(id + 'PageSize').addEventListener('change', function () {
    st.size = parseInt(this.value, 10) || 10;
    st.page = 1;
    st.render();
  });
  document.querySelectorAll(`#${st.headRow} .th-sortable`).forEach(th => {
    th.addEventListener('click', () => sortListBy(id, th.getAttribute('data-sort-key')));
  });
}
function dvSortValue(s, key) {
  switch (key) {
    case 'name': return s.name.toLowerCase();
    case 'student_id': return s.student_id;
    case 'scholarship': return scholarshipTypeLabel(s.scholarship).toLowerCase();
    case 'documents': return docsSubmittedCount(s);
    case 'submitted': { const t = new Date(s.application_submitted_date).getTime(); return isNaN(t) ? null : t; }
    case 'queue': { const h = scholarMaxQueueHours(s); return h === undefined || h === null ? null : h; }
    case 'status': return computeVerification(s);
    default: return null;
  }
}
function srSortValue(s, key) {
  switch (key) {
    case 'name': return s.name.toLowerCase();
    case 'student_id': return s.student_id;
    case 'scholarship': return scholarshipTypeLabel(s.scholarship).toLowerCase();
    case 'channel': return isDnscScholar(s) ? '' : channelLabel(s.payment_channel);
    case 'amount': return isDnscScholar(s) ? 0 : getScholarStipendAmount(s);
    default: return null;
  }
}

/* ============================================================
   RENDER: DOCUMENT VERIFICATION PAGE
   ============================================================ */
function renderDvTable() {
  populateSchoolSelect('dvSchool');
  // KPIs follow the selected AY / semester so they always match the list below.
  const dvTerm = document.getElementById('dvSemester').value;
  const termScholars = scholars.filter(s => !dvTerm || (s.academic_year + '|' + s.semester) === dvTerm);
  const totalScholars = termScholars.length;
  const verifiedScholars = termScholars.filter(s => computeVerification(s) === 'Verified').length;
  const pendingReviewScholars = totalScholars - verifiedScholars;
  const eligibleScholars = termScholars.filter(s => scholarshipHasStipend(s.scholarship) && !isCredited(s) && computeVerification(s) === 'Verified').length;
  document.getElementById('dvKpiTotal').textContent = totalScholars;
  document.getElementById('dvKpiVerified').textContent = verifiedScholars;
  document.getElementById('dvKpiPending').textContent = pendingReviewScholars;
  document.getElementById('dvKpiEligible').textContent = eligibleScholars;

  const pill = document.getElementById('dvPeriodPill');
  if (pill) pill.textContent = dvTerm ? dvTerm.split('|').reverse().join(' ') : 'All semesters';
  const search = (document.getElementById('dvSearch').value || '').toLowerCase();
  const scholarshipFilter = document.getElementById('dvScholarship').value;
  const schoolFilter = document.getElementById('dvSchool').value;
  const semesterFilter = document.getElementById('dvSemester').value;
  const statusFilter = document.getElementById('dvStatus').value;
  const staleOnly = document.getElementById('dvStaleOnly').checked;

  // Stale Alert quick metric badge: how many documents are currently
  // lingering in the queue past the 48-hour threshold, across all scholars.
  const staleDocCount = scholars.reduce((sum, s) => sum + scholarQueuedDocs(s).filter(isDocStale).length, 0);
  const staleBadge = document.getElementById('dvStaleBadge');
  if (staleDocCount > 0) {
    staleBadge.classList.remove('d-none');
    staleBadge.innerHTML = `<i class="bi bi-alarm-fill"></i>${staleDocCount} document${staleDocCount === 1 ? '' : 's'} stale (48h+)`;
  } else {
    staleBadge.classList.add('d-none');
  }

  const filteredRows = scholars.filter(s => {
    const v = computeVerification(s);
    const matchesSearch = !search || s.name.toLowerCase().includes(search) || s.student_id.toLowerCase().includes(search);
    const matchesScholarship = scholarshipTypeMatches(s.scholarship, scholarshipFilter);
    const matchesSchool = !schoolFilter || schoolOfScholar(s) === schoolFilter;
    const matchesTerm = !semesterFilter || (s.academic_year + '|' + s.semester) === semesterFilter;
    const matchesStatus = !statusFilter || v === statusFilter;
    const matchesStale = !staleOnly || scholarIsStale(s);
    return matchesSearch && matchesScholarship && matchesSchool && matchesTerm && matchesStatus && matchesStale;
  });
  const dvSorted = sortListRows(filteredRows, dvSortValue, listTable.dv, (a, b) => (dvSortValue(b, 'submitted') || 0) - (dvSortValue(a, 'submitted') || 0));
  const dvPage = paginateRows('dv', dvSorted);
  const rows = dvPage.rows;
  updateListSortIndicators('dv');
  renderListFooter('dv', dvPage);

  const emptyState = `<tr><td colspan="8" class="text-center text-muted-custom py-4">${semesterFilter && !termScholars.length ? 'No scholars have submitted documents for this semester yet.' : 'No scholars match these filters.'}</td></tr>`;

  document.getElementById('dvTableBody').innerHTML = rows.length ? rows.map(s => {
    const v = computeVerification(s);
    const queueHours = scholarMaxQueueHours(s);
    return `
      <tr class="row-hoverable">
        <td>
          <div class="scholar-cell">
            <div class="row-avatar" style="background:${avatarColor(s.id)};">${initials(s.name)}</div>
            <div class="sc-name">${s.name}</div>
          </div>
        </td>
        <td>${s.student_id}</td>
        <td>${scholarshipTypeLabel(s.scholarship)}</td>
        <td>${docsSubmittedCount(s)} / ${getRequiredDocumentCount(s)}</td>
        <td>${s.application_submitted_date}</td>
        <td>${timeInStagePill(queueHours)}</td>
        <td>${verificationPill(v)}</td>
        <td><button type="button" class="btn-approve-sm" onclick="openReviewModal(${s.id})">Review</button></td>
      </tr>`;
  }).join('') : emptyState;

  document.getElementById('dvMobileCards').innerHTML = rows.map(s => {
    const v = computeVerification(s);
    const queueHours = scholarMaxQueueHours(s);
    return `
      <div class="row-card-mobile">
        <div class="rc-top">
          <div class="scholar-cell">
            <div class="row-avatar" style="background:${avatarColor(s.id)};">${initials(s.name)}</div>
            <div><div class="sc-name">${s.name}</div><div class="sc-sub">${s.student_id}</div></div>
          </div>
          ${verificationPill(v)}
        </div>
        <div class="rc-line"><span class="rc-label">Scholarship</span><span class="rc-value">${scholarshipTypeLabel(s.scholarship)}</span></div>
        <div class="rc-line"><span class="rc-label">Documents</span><span class="rc-value">${docsSubmittedCount(s)} / ${getRequiredDocumentCount(s)}</span></div>
        <div class="rc-line"><span class="rc-label">Application Submitted</span><span class="rc-value">${s.application_submitted_date}</span></div>
        <div class="rc-line"><span class="rc-label">Time in Queue</span><span class="rc-value">${timeInStagePill(queueHours)}</span></div>
        <button type="button" class="btn-approve-sm w-100" onclick="openReviewModal(${s.id})">Review</button>
      </div>`;
  }).join('');
}
['dvSearch', 'dvScholarship', 'dvSchool', 'dvStatus', 'dvSemester', 'dvStaleOnly'].forEach(id => {
  const h = () => { listTable.dv.page = 1; renderDvTable(); };
  document.getElementById(id).addEventListener('input', h);
  document.getElementById(id).addEventListener('change', h);
});
initListTableControls('dv');

/* ============================================================
   RENDER: SCHOLARS PAGE
   ============================================================ */
// Returns the full scholars list after search/dropdown/chart filters are applied
// (unsorted, unpaginated) — shared by the table renderer and roster exports.
function getFilteredScholars() {
  const search = (document.getElementById('scSearch').value || '').toLowerCase();
  const scholarshipFilter = document.getElementById('scScholarship').value;
  const schoolFilter = document.getElementById('scSchool').value;
  const termFilter = document.getElementById('scTerm').value;
  const statusFilter = document.getElementById('scStatus').value;
  const stipendFilter = document.getElementById('scStipend').value;

  return scholars.filter(s => {
    const v = computeVerification(s);
    const st = computeStipendStatus(s);
    const matchesSearch = !search || s.name.toLowerCase().includes(search) || s.student_id.toLowerCase().includes(search) || scholarIdOf(s).toLowerCase().includes(search) || s.program_name.toLowerCase().includes(search);
    const matchesScholarship = scholarshipTypeMatches(s.scholarship, scholarshipFilter);
    const matchesSchool = !schoolFilter || schoolOfScholar(s) === schoolFilter;
    const matchesTerm = !termFilter || (s.academic_year + '|' + s.semester) === termFilter;
    const matchesStatus = !statusFilter || v === statusFilter;
    const matchesStipend = !stipendFilter || st === stipendFilter;
    let matchesChart = true;
    if (scChartFilter) {
      if (scChartFilter.type === 'scholarship') matchesChart = s.scholarship === scChartFilter.value;
      else if (scChartFilter.type === 'course') matchesChart = s.program_name === scChartFilter.value;
      else if (scChartFilter.type === 'institute') matchesChart = instituteOfProgram(s.program_name) === scChartFilter.value;
      else if (scChartFilter.type === 'yearLevel') matchesChart = String(s.yearLevel) === String(scChartFilter.value);
    }
    return matchesSearch && matchesScholarship && matchesSchool && matchesTerm && matchesStatus && matchesStipend && matchesChart;
  });
}

// Compares two scholars on the given sortable column key.
function compareScholarsBy(a, b, key) {
  let av, bv;
  switch (key) {
    case 'scholarId': av = scholarIdOf(a); bv = scholarIdOf(b); break;
    case 'name': av = a.name; bv = b.name; break;
    case 'student_id': av = a.student_id; bv = b.student_id; break;
    case 'course': av = a.program_name; bv = b.program_name; break;
    case 'scholarship': av = a.scholarship; bv = b.scholarship; break;
    case 'ay': av = a.academic_year + ' ' + a.semester; bv = b.academic_year + ' ' + b.semester; break;
    case 'verification': av = computeVerification(a); bv = computeVerification(b); break;
    case 'stipend': av = computeStipendStatus(a); bv = computeStipendStatus(b); break;
    default: av = ''; bv = '';
  }
  if (typeof av === 'string') av = av.toLowerCase();
  if (typeof bv === 'string') bv = bv.toLowerCase();
  if (av < bv) return -1;
  if (av > bv) return 1;
  return 0;
}

function sortScholarsBy(key) {
  if (scSortKey === key) {
    scSortDir = scSortDir === 'asc' ? 'desc' : 'asc';
  } else {
    scSortKey = key;
    scSortDir = 'asc';
  }
  scCurrentPage = 1;
  renderScholarsTable();
}

function updateScSortIndicators() {
  
function initSortableHeaderAccessibility() {
  document.querySelectorAll('.th-sortable').forEach(th => {
    if (!th.hasAttribute('tabindex')) th.setAttribute('tabindex', '0');
    if (!th.hasAttribute('role')) th.setAttribute('role', 'button');
    if (!th.hasAttribute('aria-sort')) th.setAttribute('aria-sort', 'none');
  });
}
initSortableHeaderAccessibility();

document.querySelectorAll('#scTableHeadRow .th-sortable').forEach(th => {
    th.classList.remove('sorted-asc', 'sorted-desc');
    const icon = th.querySelector('.sort-icon');
    const key = th.getAttribute('data-sort-key');
    th.setAttribute('aria-sort', key === scSortKey ? (scSortDir === 'asc' ? 'ascending' : 'descending') : 'none');
    if (key === scSortKey) {
      th.classList.add(scSortDir === 'asc' ? 'sorted-asc' : 'sorted-desc');
      icon.className = 'bi sort-icon ' + (scSortDir === 'asc' ? 'bi-sort-alpha-down' : 'bi-sort-alpha-up');
    } else {
      icon.className = 'bi bi-arrow-down-up sort-icon';
    }
  });
}

function renderScholarsTable() {
  populateSchoolSelect('scSchool');
  const filtered = getFilteredScholars();
  const sorted = filtered.slice().sort((a, b) => {
    const cmp = compareScholarsBy(a, b, scSortKey);
    return scSortDir === 'asc' ? cmp : -cmp;
  });

  const totalRows = sorted.length;
  const totalPages = Math.max(1, Math.ceil(totalRows / scPageSize));
  if (scCurrentPage > totalPages) scCurrentPage = totalPages;
  if (scCurrentPage < 1) scCurrentPage = 1;
  const start = (scCurrentPage - 1) * scPageSize;
  const rows = sorted.slice(start, start + scPageSize);

  updateScSortIndicators();

  const emptyState = `<tr><td colspan="8" class="text-center text-muted-custom py-4">No scholars match these filters.</td></tr>`;

  document.getElementById('scTableBody').innerHTML = rows.length ? rows.map(s => {
    const v = computeVerification(s);
    const st = computeStipendStatus(s);
    return `
      <tr class="row-hoverable">
        <td>${scholarIdOf(s)}</td>
        <td>
          <div class="scholar-cell">
            <div class="row-avatar" style="background:${avatarColor(s.id)};">${initials(s.name)}</div>
            <div class="sc-name">${s.name}</div>
          </div>
        </td>
        <td>${s.student_id}</td>
        <td>${s.program_name}</td>
        <td>${s.scholarship.replace(' Scholarship', '')}</td>
        <td>${verificationPill(v)}</td>
        <td>${stipendPill(st)}</td>
        <td><button type="button" class="btn btn-sm btn-outline-scholarship btn-review" onclick="openProfileModal(${s.id})">View</button></td>
      </tr>`;
  }).join('') : emptyState;

  document.getElementById('scMobileCards').innerHTML = rows.map(s => {
    const v = computeVerification(s);
    const st = computeStipendStatus(s);
    return `
      <div class="row-card-mobile">
        <div class="rc-top">
          <div class="scholar-cell">
            <div class="row-avatar" style="background:${avatarColor(s.id)};">${initials(s.name)}</div>
            <div><div class="sc-name">${s.name}</div><div class="sc-sub">${s.student_id}</div></div>
          </div>
          ${verificationPill(v)}
        </div>
        <div class="rc-line"><span class="rc-label">Program</span><span class="rc-value">${s.program_name}</span></div>
        <div class="rc-line"><span class="rc-label">Scholar ID</span><span class="rc-value">${scholarIdOf(s)}</span></div>
        <div class="rc-line"><span class="rc-label">Stipend</span><span class="rc-value">${stipendPill(st)}</span></div>
        <button type="button" class="btn btn-sm btn-outline-scholarship btn-review mt-2 w-100" onclick="openProfileModal(${s.id})">View Profile</button>
      </div>`;
  }).join('');

  // Footer: page counter + prev/next state
  const counterEl = document.getElementById('scPageCounter');
  if (totalRows === 0) {
    counterEl.textContent = 'Showing 0 of 0 scholars';
  } else {
    const rangeEnd = Math.min(start + scPageSize, totalRows);
    counterEl.textContent = `Showing ${start + 1}\u2013${rangeEnd} of ${totalRows} scholar${totalRows === 1 ? '' : 's'}`;
  }
  document.getElementById('scPrevPage').disabled = scCurrentPage <= 1;
  document.getElementById('scNextPage').disabled = scCurrentPage >= totalPages;
}

function changeScholarsPage(delta) {
  scCurrentPage += delta;
  renderScholarsTable();
}

document.getElementById('scPageSize').addEventListener('change', function () {
  scPageSize = parseInt(this.value, 10) || 10;
  scCurrentPage = 1;
  renderScholarsTable();
});

document.querySelectorAll('#scTableHeadRow .th-sortable').forEach(th => {
  th.addEventListener('click', () => sortScholarsBy(th.getAttribute('data-sort-key')));
});

['scSearch', 'scScholarship', 'scSchool', 'scTerm', 'scStatus', 'scStipend'].forEach(id => {
  document.getElementById(id).addEventListener('input', () => { scCurrentPage = 1; renderScholarsTable(); });
  document.getElementById(id).addEventListener('change', () => { scCurrentPage = 1; renderScholarsTable(); });
});
function resetScholarFilters() {
  document.getElementById('scSearch').value = '';
  document.getElementById('scScholarship').value = '';
  document.getElementById('scSchool').value = '';
  document.getElementById('scTerm').value = '';
  document.getElementById('scStatus').value = '';
  document.getElementById('scStipend').value = '';
  scCurrentPage = 1;
  clearScChartFilter(); // also clears any chart drill-down and re-renders the table
}

/* ============================================================
   SCHOLARS ROSTER EXPORT (CSV / PDF)
   ============================================================ */
function csvEscape(val) {
  const str = String(val === undefined || val === null ? '' : val);
  if (/[",\n]/.test(str)) return '"' + str.replace(/"/g, '""') + '"';
  return str;
}

function downloadTextFile(content, filename, mime) {
  const blob = new Blob([content], { type: mime });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

function exportScholarsRoster(format) {
  const rows = getFilteredScholars().slice().sort((a, b) => {
    const cmp = compareScholarsBy(a, b, scSortKey);
    return scSortDir === 'asc' ? cmp : -cmp;
  });

  if (!rows.length) {
    showToast('Nothing to export', 'No scholars match the current filters.', 'red');
    return;
  }

  if (format === 'csv') {
    const headers = ['Scholar', 'Student ID', 'Program', 'Scholarship', 'Academic Term', 'Verification', 'Stipend Status'];
    const lines = [headers.map(csvEscape).join(',')];
    rows.forEach(s => {
      lines.push([
        s.name, s.student_id, s.program_name, s.scholarship,
        `${s.academic_year} \u00b7 ${s.semester}`, computeVerification(s), computeStipendStatus(s)
      ].map(csvEscape).join(','));
    });
    downloadTextFile(lines.join('\r\n'), `scholars-roster-${todayFileStamp()}.csv`, 'text/csv;charset=utf-8;');
    showToast('Roster exported', `${rows.length} scholar record${rows.length === 1 ? '' : 's'} exported as CSV.`);
    pushActivity('bi-download', 'icon-neutral', `Scholars roster exported as <strong>CSV</strong> (${rows.length} record${rows.length === 1 ? '' : 's'})`);
    return;
  }

  // PDF export: opens a print-formatted window so the officer can save it as
  // a PDF via the browser's print dialog — no external library required.
  const tableRows = rows.map(s => `
    <tr>
      <td>${s.name}</td>
      <td>${s.student_id}</td>
      <td>${s.program_name}</td>
      <td>${scholarshipTypeLabel(s.scholarship)}</td>
      <td>${s.academic_year} \u00b7 ${s.semester}</td>
      <td>${computeVerification(s)}</td>
      <td>${computeStipendStatus(s)}</td>
    </tr>`).join('');

  const win = window.open('', '_blank');
  if (!win) {
    showToast('Pop-up blocked', 'Please allow pop-ups to export the roster as PDF.', 'red');
    return;
  }
  win.document.write(`<!DOCTYPE html><html><head><title>Scholars Roster</title><meta charset="UTF-8">
    <style>
      * { box-sizing: border-box; }
      body { font-family: Arial, Helvetica, sans-serif; color: #2b2925; padding: 28px; }
      h1 { font-size: 18px; margin: 0 0 2px 0; }
      p.meta { font-size: 12px; color: #7a756e; margin: 0 0 18px 0; }
      table { width: 100%; border-collapse: collapse; }
      th, td { border: 1px solid #ddd; padding: 6px 8px; font-size: 11px; text-align: left; }
      th { background: #f4f2ee; }
      @media print { body { padding: 0; } }
    
/* Final accessibility and responsive component contract. */
.btn,
.quick-action-btn,
.aq-btn,
.btn-approve-sm,
.btn-revision-sm,
.btn-preview-sm {
  min-height: var(--ui-control-h);
  padding: 0 0.875rem;
  border-radius: var(--ui-radius-control);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--ui-space-2);
}
.role-badge,
.doc-req-badge,
.time-in-stage .tis-tag,
.nav-section-label,
.offcanvas .nav-section-label { font-size: 0.75rem; }
.card-panel { background: var(--sd-surface); border-radius: 18px; }
.sd-date-pill { background: var(--sd-surface); border: 1px solid var(--sd-border); }
.analytics-period-toggle { cursor: pointer; }

@media (max-width: 1199.98px) {
  .sidebar { width: 220px; flex-basis: 220px; padding: 1rem 0.75rem; }
}
@media (max-width: 991.98px) {
  .sidebar { display: none; }
  .mobile-topbar { display: flex; }
}
#page-dashboard .chart-bar,
#page-analytics .chart-bar {
  width: 100%;
  max-width: 44px;
  min-width: 18px;
}


/* Dashboard hero flows directly into the content stack without a divider. */
#page-dashboard .sd-hero {
  border-bottom: 0;
  box-shadow: none;
}
#page-dashboard .action-needed-container,
#page-dashboard .payout-progress-container {
  margin-bottom: var(--ui-space-5);
}
#page-dashboard .action-needed-container .triage-summary-grid {
  margin-bottom: var(--ui-space-4);
}


/* Dashboard operational layout: metrics sit above Action Needed in the left column. */
#page-dashboard .dashboard-action-column,
#page-dashboard .dashboard-payout-column { display: flex; flex-direction: column; min-width: 0; }
#page-dashboard .dashboard-action-column .triage-summary-grid { margin-bottom: var(--ui-space-4); }
#page-dashboard .dashboard-action-column .action-needed-container,
#page-dashboard .dashboard-payout-column .payout-progress-container { margin-bottom: 0; }
#page-dashboard .dashboard-payout-column .payout-progress-container { height: 100%; }


/* Keep semester/scholarship filters and roster metrics in one shared panel. */
#page-dashboard .action-overview-container {
  margin-bottom: var(--ui-space-5);
}
#page-dashboard .action-overview-container .triage-filter-bar {
  margin-bottom: var(--ui-space-4);
}
#page-dashboard .action-overview-container .triage-summary-grid {
  margin-bottom: 0;
}



/* Document Verification filters: AY / Semester gets the same width as on the
   Stipend Disbursement page, and the Stale Alert toggle sits on its own row so
   it can never collide with the dropdown's text. */
#page-document-verification #dvSemester { text-overflow: ellipsis; white-space: nowrap; overflow: hidden; }
#page-document-verification .dv-stale-row { padding-top: .35rem; }
#page-document-verification .dv-stale-row .form-check { display: flex; align-items: center; gap: .5rem; margin: 0; padding-left: 0; }
#page-document-verification .dv-stale-row .form-check-input { float: none; margin: 0; flex-shrink: 0; }
#page-document-verification .dv-stale-row .form-check-label { white-space: normal; }


</style></head><body>
      <h1>DNSC Scholarship System \u2014 Scholars Roster</h1>
      <p class="meta">Generated ${new Date().toLocaleString()} \u00b7 ${rows.length} scholar${rows.length === 1 ? '' : 's'}</p>
      <table>
        <thead><tr><th>Scholar</th><th>Student ID</th><th>Program</th><th>Scholarship</th><th>Academic Term</th><th>Verification</th><th>Stipend</th></tr></thead>
        <tbody>${tableRows}</tbody>
      </table>
    </body></html>`);
  win.document.close();
  win.focus();
  setTimeout(() => { win.print(); }, 300);
  showToast('Roster ready', `${rows.length} scholar record${rows.length === 1 ? '' : 's'} opened for PDF export.`);
  pushActivity('bi-download', 'icon-neutral', `Scholars roster exported as <strong>PDF</strong> (${rows.length} record${rows.length === 1 ? '' : 's'})`);
}

function todayFileStamp() {
  const d = new Date();
  const pad = n => String(n).padStart(2, '0');
  return `${d.getFullYear()}${pad(d.getMonth() + 1)}${pad(d.getDate())}`;
}

/* ============================================================
   RENDER: STIPEND DISBURSEMENT PAGE
   ============================================================ */
let srTermFilter = '2026–2027|1st Semester';
let srScholarshipFilter = '';
let srStatusFilter = '';
let srSearch = '';
let srSchoolFilter = '';
function populateScholarshipSelect(id, includeBlank = false) {
  const el = document.getElementById(id); if (!el) return;
  const current = el.value;
  el.innerHTML = stipendScholarshipOptionsMarkup('All scholarship types');
  el.value = isScholarshipFilterValue(current) && current !== '__internal' && current !== '__external' ? current : '';
}
// Scholars in the chosen semester / scholarship / search, before the verification check.
function getStipendTermCohort() {
  // Includes DNSC internal scholars alongside stipend-paying scholars (they get "Mark as complete" instead of "Disburse").
  return scholars.filter(s =>
    (!srTermFilter || (s.academic_year + '|' + s.semester) === srTermFilter) &&
    scholarshipTypeMatches(s.scholarship, srScholarshipFilter) &&
    (!srSchoolFilter || schoolOfScholar(s) === srSchoolFilter) &&
    (!srSearch || s.name.toLowerCase().includes(srSearch) || s.student_id.toLowerCase().includes(srSearch)));
}
function getStipendReleaseCohort() {
  return getStipendTermCohort().filter(s => !isDnscScholar(s) && computeVerification(s) === 'Verified');
}
function renderStipendPage() {
  populateScholarshipSelect('srScholarship');
  populateSchoolSelect('srSchool');
  const termEl = document.getElementById('srTerm');
  srTermFilter = termEl ? termEl.value : srTermFilter;
  srScholarshipFilter = document.getElementById('srScholarship')?.value || '';
  srSchoolFilter = document.getElementById('srSchool')?.value || '';
  srStatusFilter = document.getElementById('srStatus')?.value || '';
  srSearch = (document.getElementById('srSearch')?.value || '').trim().toLowerCase();

  const fullCohort = getStipendTermCohort();
  const dnscAll = fullCohort.filter(isDnscScholar);
  const dnscComplete = dnscAll.filter(isMarkedComplete);
  const termCohort = fullCohort.filter(s => !isDnscScholar(s));
  const eligibleAll = termCohort.filter(s => computeVerification(s) === 'Verified');
  const ready = eligibleAll.filter(s => !isCredited(s));
  const released = eligibleAll.filter(s => isCredited(s));
  const notYet = termCohort.length - eligibleAll.length;
  // Table rows: ready scholars first, then already-released ones.
  const stipendRows = eligibleAll
    .filter(s => !srStatusFilter || (srStatusFilter === 'ready' ? !isCredited(s) : (srStatusFilter === 'released' ? isCredited(s) : false)));
  const dnscRows = dnscAll
    .filter(s => !srStatusFilter || (srStatusFilter === 'dnsc_pending' ? !isMarkedComplete(s) : (srStatusFilter === 'dnsc_complete' ? isMarkedComplete(s) : false)));
  const eligible = stipendRows.concat(dnscRows);
  const isSettled = s => isDnscScholar(s) ? isMarkedComplete(s) : isCredited(s);
  const srDefaultCmp = (a, b) => (isSettled(a) - isSettled(b)) || a.name.localeCompare(b.name);
  const eligibleSorted = sortListRows(eligible, srSortValue, listTable.sr, srDefaultCmp);
  const srPage = paginateRows('sr', eligibleSorted);
  const pageRows = srPage.rows;
  updateListSortIndicators('sr');
  renderListFooter('sr', srPage);

  const readyIds = new Set(ready.map(s => s.id));
  stipendSelection.forEach(id => { if (!readyIds.has(id)) stipendSelection.delete(id); });
  const termLabel = srTermFilter ? srTermFilter.split('|').reverse().join(' ') : 'All Semesters';
  document.getElementById('stipendTableTitle').textContent = `Eligible Scholars · ${termLabel}`;
  const cards = [
    { label: 'Eligible Scholars', value: eligibleAll.length },
    { label: 'Ready for Disbursement', value: ready.length },
    { label: 'Already Disbursed', value: released.length },
    { label: 'DNSC Scholars', value: dnscAll.length },
    { label: 'Marked Complete', value: dnscComplete.length }
  ];
  document.getElementById('stipendSummaryRow').innerHTML = cards.map(c => `<div class="dv-kpi-card"><div class="dv-kpi-label">${c.label}</div><div class="dv-kpi-value">${c.value}</div></div>`).join('');
  const emptyMsg = !fullCohort.length ? 'No scholars are enrolled for this selection.' : (!eligibleAll.length && !dnscAll.length ? 'No scholar has completed document verification for this selection yet.' : 'No eligible scholars match these filters.');
  const emptyState = `<tr><td colspan="7" class="text-center text-muted-custom py-4">${emptyMsg}</td></tr>`;
  const chLabel = s => channelLabel(s.payment_channel);
  document.getElementById('stipendTableBody').innerHTML = pageRows.length ? pageRows.map(s => {
    const dnsc = isDnscScholar(s);
    const checkboxCell = (dnsc || isCredited(s)) ? `<td></td>` : `<td><input type="checkbox" class="form-check-input stipend-row-check" data-id="${s.id}" ${stipendSelection.has(s.id) ? 'checked' : ''} onchange="toggleStipendSelection(${s.id}, this.checked)" aria-label="Select ${s.name} for release"></td>`;
    const actionBtn = dnsc
      ? (isMarkedComplete(s) ? `<button type="button" class="btn btn-sm btn-outline-scholarship btn-review" onclick="openProfileModal(${s.id})">View</button>` : `<button type="button" class="btn btn-sm btn-academic-red btn-review" onclick="openCompleteModal(${s.id})">Mark as complete</button>`)
      : (isCredited(s) ? `<button type="button" class="btn btn-sm btn-outline-scholarship btn-review" onclick="openProfileModal(${s.id})">View</button>` : `<button type="button" class="btn btn-sm btn-academic-red btn-review" onclick="openReleaseModal(${s.id})">Disburse</button>`);
    return `<tr class="row-hoverable">${checkboxCell}<td><div class="scholar-cell"><div class="row-avatar" style="background:${avatarColor(s.id)};">${initials(s.name)}</div><div class="sc-name">${s.name}</div></div></td><td>${s.student_id}</td><td>${scholarshipTypeLabel(s.scholarship)}</td><td>${dnsc ? '—' : chLabel(s)}</td><td class="cell-amount">${dnsc ? 'N/A' : peso(getScholarStipendAmount(s))}</td><td>${actionBtn}</td></tr>`;
  }).join('') : emptyState;
  const mobileCards = pageRows.map(s => `<div class="row-card-mobile"><div class="rc-top"><div class="scholar-cell"><div class="row-avatar" style="background:${avatarColor(s.id)};">${initials(s.name)}</div><div><div class="sc-name">${s.name}</div><div class="sc-sub">${s.student_id}</div></div></div>${(isDnscScholar(s) || isCredited(s)) ? '' : `<label class="sr-mobile-check"><input type="checkbox" class="form-check-input stipend-row-check" data-id="${s.id}" ${stipendSelection.has(s.id) ? 'checked' : ''} onchange="toggleStipendSelection(${s.id}, this.checked)" aria-label="Select ${s.name} for release"><span>Select</span></label>`}</div><div class="rc-line"><span class="rc-label">Scholarship</span><span class="rc-value">${scholarshipTypeLabel(s.scholarship)}</span></div><div class="rc-line"><span class="rc-label">Channel</span><span class="rc-value">${isDnscScholar(s) ? '—' : chLabel(s)}</span></div><div class="rc-line"><span class="rc-label">Amount</span><span class="rc-value cell-amount">${isDnscScholar(s) ? 'N/A' : peso(getScholarStipendAmount(s))}</span></div>${isDnscScholar(s) ? (isMarkedComplete(s) ? `<button type="button" class="btn btn-sm btn-outline-scholarship btn-review mt-2 w-100" onclick="openProfileModal(${s.id})">View</button>` : `<button type="button" class="btn btn-sm btn-academic-red btn-review mt-2 w-100" onclick="openCompleteModal(${s.id})">Mark as complete</button>`) : (isCredited(s) ? `<button type="button" class="btn btn-sm btn-outline-scholarship btn-review mt-2 w-100" onclick="openProfileModal(${s.id})">View</button>` : `<button type="button" class="btn btn-sm btn-academic-red btn-review mt-2 w-100" onclick="openReleaseModal(${s.id})">Disburse Stipend</button>`)}</div>`).join('');
  document.getElementById('stipendMobileCards').innerHTML = `<div class="sr-mobile-select-all"><label for="stipendSelectAllMobile"><input type="checkbox" class="form-check-input" id="stipendSelectAllMobile" onchange="toggleSelectAllStipend(this.checked)" aria-label="Select all ready-for-disbursement scholars"><span>Select all</span></label></div>${mobileCards}`;
  const selectAllBox = document.getElementById('stipendSelectAll');
  const readyShown = eligible.filter(s => !isDnscScholar(s) && !isCredited(s));
  const syncSelectAll = box => { if (!box) return; const selShown = readyShown.filter(s => stipendSelection.has(s.id)).length; box.checked = readyShown.length > 0 && selShown === readyShown.length; box.indeterminate = selShown > 0 && selShown < readyShown.length; };
  syncSelectAll(selectAllBox);
  syncSelectAll(document.getElementById('stipendSelectAllMobile'));
  document.getElementById('batchReleaseCount').textContent = stipendSelection.size;
  document.getElementById('batchReleaseBtn').disabled = stipendSelection.size === 0;
}
['srSearch','srTerm','srScholarship','srSchool','srStatus'].forEach(id => { const el = document.getElementById(id); if (!el) return; const h = () => { stipendSelection.clear(); listTable.sr.page = 1; renderStipendPage(); }; el.addEventListener('change', h); el.addEventListener('input', h); });
initListTableControls('sr');

/* ============================================================
   RENDER: DISBURSEMENT HISTORY PAGE
   Filterable (semester / channel / scholarship type), sortable (scholar, amount,
   release date, ...), and paginated (page-size selector + numbered
   pages with prev/next), mirroring the Scholars table's patterns.
   ============================================================ */
let dhSortKey = 'date';
let dhSortDir = 'desc';
let dhCurrentPage = 1;
let dhPageSize = 10;

function todayHistoryDate() {
  return new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

function channelLabel(id) {
  const ch = DISBURSEMENT_CHANNELS.find(c => c.id === id);
  return ch ? ch.label : '—';
}

function historyStatusPill(status) {
  if (status === 'Pending') return `<span class="status-pill pill-pending"><i class="bi bi-hourglass-split"></i>Pending</span>`;
  return `<span class="status-pill pill-credited"><i class="bi bi-check-circle-fill"></i>Disbursed</span>`;
}

// History rows after the filter-bar selects are applied (unsorted, unpaginated).
function getFilteredHistory() {
  const termFilter = document.getElementById('dhTerm').value;
  const channelFilter = document.getElementById('dhChannel').value;
  const scholarshipFilter = document.getElementById('dhScholarship').value;
  const schoolFilter = document.getElementById('dhSchool').value;

  return disbursementHistory.filter(h => {
    const matchesTerm = !termFilter || (h.academic_year + '|' + h.semester) === termFilter;
    const matchesChannel = !channelFilter || h.payment_channel === channelFilter;
    const historyScholarship = h.scholarship || (scholars.find(s => s.student_id === h.student_id)?.scholarship || '');
    const matchesScholarship = scholarshipTypeMatches(historyScholarship, scholarshipFilter);
    const matchesSchool = !schoolFilter || schoolOfHistory(h) === schoolFilter;
    return h.status === 'Released' && matchesTerm && matchesChannel && matchesScholarship && matchesSchool;
  });
}

// Verified date: the day the officer verified all of the scholar's uploaded documents.
// Sample data — derived deterministically from the disbursement date (always earlier).
function historyVerifiedDate(h) {
  if (h.verifiedDate) return h.verifiedDate;
  const seed = String(h.student_id || h.scholar || '').split('').reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 7);
  const offset = 2 + (seed % 8); // verified 2–9 days before release
  const base = h.date ? new Date(h.date) : new Date(2026, 8, 20); // pending payouts: verified around Sep 20, 2026
  base.setDate(base.getDate() - (h.date ? offset : (seed % 6)));
  const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  h.verifiedDate = MONTHS[base.getMonth()] + ' ' + base.getDate() + ', ' + base.getFullYear();
  return h.verifiedDate;
}
function historyVerifiedValue(h) { return new Date(historyVerifiedDate(h)).getTime(); }

// Numeric timestamp for date sorting; null while the payout is still pending.
function historyDateValue(h) {
  return h.date ? new Date(h.date).getTime() : null;
}

function compareHistoryBy(a, b, key) {
  let av, bv;
  switch (key) {
    case 'name': av = a.scholar.toLowerCase(); bv = b.scholar.toLowerCase(); break;
    case 'student_id': av = a.student_id; bv = b.student_id; break;
    case 'term': av = a.academic_year + ' ' + a.semester; bv = b.academic_year + ' ' + b.semester; break;
    case 'channel': av = channelLabel(a.payment_channel); bv = channelLabel(b.payment_channel); break;
    case 'amount': av = a.amount; bv = b.amount; break;
    case 'date': av = historyDateValue(a); bv = historyDateValue(b); break;
    case 'verified': av = historyVerifiedValue(a); bv = historyVerifiedValue(b); break;
    default: av = ''; bv = '';
  }
  if (av === null && bv === null) return 0;
  if (av === null) return 1;
  if (bv === null) return -1;
  if (av < bv) return -1;
  if (av > bv) return 1;
  return 0;
}

function sortHistoryBy(key) {
  if (dhSortKey === key) {
    dhSortDir = dhSortDir === 'asc' ? 'desc' : 'asc';
  } else {
    dhSortKey = key;
    dhSortDir = key === 'date' ? 'desc' : 'asc';
  }
  dhCurrentPage = 1;
  renderHistoryTable();
}

function updateDhSortIndicators() {
  document.querySelectorAll('#dhTableHeadRow .th-sortable').forEach(th => {
    th.classList.remove('sorted-asc', 'sorted-desc');
    const icon = th.querySelector('.sort-icon');
    const key = th.getAttribute('data-sort-key');
    th.setAttribute('aria-sort', key === dhSortKey ? (dhSortDir === 'asc' ? 'ascending' : 'descending') : 'none');
    if (key === dhSortKey) {
      th.classList.add(dhSortDir === 'asc' ? 'sorted-asc' : 'sorted-desc');
      icon.className = 'bi sort-icon ' + (dhSortDir === 'asc' ? 'bi-sort-up' : 'bi-sort-down');
    } else {
      icon.className = 'bi bi-arrow-down-up sort-icon';
    }
  });
}

// Numbered page sequence with ellipses when the page count gets large.
function historyPageSequence(totalPages, current) {
  if (totalPages <= 7) return Array.from({ length: totalPages }, (_, i) => i + 1);
  const pages = [1];
  const lo = Math.max(2, current - 1);
  const hi = Math.min(totalPages - 1, current + 1);
  if (lo > 2) pages.push('…');
  for (let p = lo; p <= hi; p++) pages.push(p);
  if (hi < totalPages - 1) pages.push('…');
  pages.push(totalPages);
  return pages;
}

function renderHistoryTable() {
  populateSchoolSelect('dhSchool');
  const filtered = getFilteredHistory();
  const sorted = filtered.slice().sort((a, b) => {
    let cmp = compareHistoryBy(a, b, dhSortKey);
    if (dhSortDir === 'desc') cmp = -cmp;
    // Pending rows (no release date yet) always sink to the bottom when
    // sorting by date, regardless of direction.
    if (dhSortKey === 'date') {
      const an = historyDateValue(a) === null ? 1 : 0;
      const bn = historyDateValue(b) === null ? 1 : 0;
      if (an !== bn) return an - bn;
    }
    return cmp;
  });

  const totalRows = sorted.length;
  const totalPages = Math.max(1, Math.ceil(totalRows / dhPageSize));
  if (dhCurrentPage > totalPages) dhCurrentPage = totalPages;
  if (dhCurrentPage < 1) dhCurrentPage = 1;
  const start = (dhCurrentPage - 1) * dhPageSize;
  const rows = sorted.slice(start, start + dhPageSize);

  updateDhSortIndicators();

  const emptyState = `<tr><td colspan="9" class="text-center text-muted-custom py-4">No disbursements match these filters.</td></tr>`;

  document.getElementById('historyTableBody').innerHTML = rows.length ? rows.map(h => `
    <tr class="row-hoverable">
      <td>${h.scholar}</td>
      <td>${h.student_id}</td>
      <td>${h.semester}</td>
      <td>${h.academic_year}</td>
      <td>${channelLabel(h.payment_channel)}</td>
      <td class="cell-amount">${peso(h.amount)}</td>
      <td>${historyVerifiedDate(h)}</td>
      <td>${h.date || '—'}</td>
      <td>${h.releasedBy}</td>
    </tr>
  `).join('') : emptyState;

  document.getElementById('historyMobileCards').innerHTML = rows.map(h => `
    <div class="row-card-mobile">
      <div class="rc-top"><div class="sc-name">${h.scholar}</div></div>
      <div class="rc-line"><span class="rc-label">Student ID</span><span class="rc-value">${h.student_id}</span></div>
      <div class="rc-line"><span class="rc-label">Term</span><span class="rc-value">${h.semester} ${h.academic_year}</span></div>
      <div class="rc-line"><span class="rc-label">Channel</span><span class="rc-value">${channelLabel(h.payment_channel)}</span></div>
      <div class="rc-line"><span class="rc-label">Amount</span><span class="rc-value cell-amount">${peso(h.amount)}</span></div>
      <div class="rc-line"><span class="rc-label">Verified Date</span><span class="rc-value">${historyVerifiedDate(h)}</span></div>
      <div class="rc-line"><span class="rc-label">Disbursement Date</span><span class="rc-value">${h.date || '—'}</span></div>
      <div class="rc-line"><span class="rc-label">Disbursed By</span><span class="rc-value">${h.releasedBy}</span></div>
    </div>
  `).join('');

  // Footer: page counter + page-size selector + numbered pages + prev/next.
  const counterEl = document.getElementById('dhPageCounter');
  if (totalRows === 0) {
    counterEl.textContent = 'Showing 0 of 0 disbursements';
  } else {
    const rangeEnd = Math.min(start + dhPageSize, totalRows);
    counterEl.textContent = `Showing ${start + 1}\u2013${rangeEnd} of ${totalRows} disbursement${totalRows === 1 ? '' : 's'}`;
  }
  document.getElementById('dhPrevPage').disabled = dhCurrentPage <= 1;
  document.getElementById('dhNextPage').disabled = dhCurrentPage >= totalPages;

  document.getElementById('dhPageNumbers').innerHTML = historyPageSequence(totalPages, dhCurrentPage).map(p =>
    p === '…'
      ? `<span class="text-muted-custom px-1">\u2026</span>`
      : `<button type="button" class="btn btn-sm ${p === dhCurrentPage ? 'btn-scholarship-green' : 'btn-outline-scholarship'}" onclick="goToHistoryPage(${p})" ${p === dhCurrentPage ? 'aria-current="page"' : ''}>${p}</button>`
  ).join('');
}

function goToHistoryPage(page) {
  dhCurrentPage = page;
  renderHistoryTable();
}

function changeHistoryPage(delta) {
  dhCurrentPage += delta;
  renderHistoryTable();
}

populateScholarshipSelect('dhScholarship', true);
['dhTerm', 'dhChannel', 'dhScholarship', 'dhSchool'].forEach(id => {
  document.getElementById(id).addEventListener('change', () => { dhCurrentPage = 1; renderHistoryTable(); });
});
document.getElementById('dhPageSize').addEventListener('change', function () {
  dhPageSize = parseInt(this.value, 10) || 10;
  dhCurrentPage = 1;
  renderHistoryTable();
});
document.querySelectorAll('#dhTableHeadRow .th-sortable').forEach(th => {
  th.addEventListener('click', () => sortHistoryBy(th.getAttribute('data-sort-key')));
});

/* ============================================================
   DOCUMENT REVIEW MODAL LOGIC
   ============================================================ */
let currentReviewScholarId = null;

function openReviewModal(scholarId) {
  currentReviewScholarId = scholarId;
  renderReviewModal();
  bootstrap.Modal.getOrCreateInstance(document.getElementById('reviewModal')).show();
}

function renderReviewModal() {
  const s = getScholar(currentReviewScholarId);
  if (!s) return;

  document.getElementById('reviewScholarName').textContent = s.name;
  document.getElementById('reviewScholarId').textContent = s.student_id;
  document.getElementById('reviewScholarship').textContent = scholarshipTypeLabel(s.scholarship);

  document.getElementById('reviewDocListContainer').innerHTML = getRequiredDocTypes(s).map(dt => {
    const doc = s.docs[dt.id];
    const meta = docStatusMeta[doc.status];
    const isVerified = doc.status === 'verified';
    const canAct = doc.status === 'pending' || doc.status === 'submitted' || doc.status === 'requires_update';

    let fileRow = doc.file
      ? `<div class="doc-thumb-grid" aria-label="Document preview"><div class="doc-thumb"><i class="bi bi-file-earmark-text"></i><span title="${doc.file}">${doc.file}</span></div></div>`
      : `<div class="small text-muted-custom">No file uploaded yet.</div>`;

    let actions = '';
    if (canAct) {
      actions = `
        <div class="doc-actions">
          ${doc.file ? `<button type="button" class="btn-preview-sm" onclick="viewDocumentDemo('${dt.name}')"><i class="bi bi-eye"></i>View Document</button>` : `<button type="button" class="btn-preview-sm" disabled aria-disabled="true" title="No file uploaded yet"><i class="bi bi-eye"></i>View Document</button>`}
          <button type="button" class="btn-approve-sm" onclick="verifyDoc(${s.id}, '${dt.id}')"><i class="bi bi-check2"></i>Approve</button>
          <button type="button" class="btn-revision-sm" onclick="toggleCorrectionBox('${dt.id}')"><i class="bi bi-exclamation-triangle"></i>Revision</button>
        </div>
        <div class="correction-box d-none" id="correctionBox-${dt.id}">
          <label for="remarkInput-${dt.id}">Officer Remarks</label>
          <textarea class="form-control form-control-sm" id="remarkInput-${dt.id}" rows="2" placeholder="e.g. Please upload a clearer copy showing the complete document and signature.">${doc.status === 'requires_update' ? doc.remarks : ''}</textarea>
          <button type="button" class="btn-revision-sm mt-2" onclick="submitCorrection(${s.id}, '${dt.id}')"><i class="bi bi-send"></i>Submit Revision</button>
        </div>`;
    }

    let remarkNote = '';
    if (doc.status === 'requires_update' && doc.remarks) {
      remarkNote = `<div class="remark-note"><i class="bi bi-chat-left-text-fill mt-1"></i><div><strong>Officer remarks:</strong> ${doc.remarks}</div></div>`;
    }

    return `
      <div class="doc-row">
        <div class="review-doc-head mb-2">
          <span class="doc-name">${dt.name}</span>
          <span class="doc-status-badge ${meta.cls}"><i class="bi ${meta.icon}"></i>${meta.label}</span>
        </div>
        ${fileRow}
        ${timeInStageBadge(doc)}
        ${remarkNote}
        ${isVerified ? '' : actions}
      </div>`;
  }).join('');
}

function toggleCorrectionBox(docId) {
  const box = document.getElementById('correctionBox-' + docId);
  if (box) box.classList.toggle('d-none');
}

function viewDocumentDemo(docName) {
  showToast('Demo preview', `"${docName}" would open here in the live system. No file preview in this concept.`);
}

function verifyDoc(scholarId, docId) {
  const s = getScholar(scholarId);
  s.docs[docId].status = 'verified';
  s.docs[docId].remarks = '';
  pushActivity('bi-patch-check-fill', 'icon-green', `<strong>${s.name}'s</strong> ${DOC_TYPES.find(d => d.id === docId).name} was verified`);
  showToast('Document verified', `${DOC_TYPES.find(d => d.id === docId).name} marked as verified for ${s.name}.`);
  renderReviewModal();
  renderAllTables();
}

function submitCorrection(scholarId, docId) {
  const s = getScholar(scholarId);
  const textarea = document.getElementById('remarkInput-' + docId);
  const remark = (textarea.value || '').trim() || 'Please re-upload this document with the missing information.';
  s.docs[docId].status = 'requires_update';
  s.docs[docId].resubmitted = false;
  s.docs[docId].remarks = remark;
  pushActivity('bi-exclamation-triangle-fill', 'icon-red', `<strong>${s.name}'s</strong> ${DOC_TYPES.find(d => d.id === docId).name} was marked for correction`);
  showToast('Correction requested', `${s.name} will be notified to re-upload this document.`, 'red');
  renderReviewModal();
  renderAllTables();
}

/* ============================================================
   LATEST GWA — read from ENROLLMENTS.gwa (most recent term that has a GWA).
   Entering / correcting it is only allowed once every required document is verified.
   ============================================================ */
function latestGwaOf(scholarId) {
  const rows = ENROLLMENTS.filter(e => e.scholar_id === scholarId && e.gwa != null)
    .sort((a, b) => b.term_id - a.term_id);
  return rows.length ? rows[0].gwa : null;
}
function formatGwa(g) { return (g == null || isNaN(g)) ? '–' : Number(g).toFixed(2); }

function toggleProfileDocPreview(docId) {
  const panel = document.getElementById('profileDocPreview-' + docId);
  const btn = document.getElementById('profileDocBtn-' + docId);
  if (!panel) return;
  const open = panel.classList.toggle('d-none') === false;
  if (btn) {
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    btn.innerHTML = open ? '<i class="bi bi-eye-slash"></i>Hide' : '<i class="bi bi-eye"></i>Preview';
  }
}

function saveScholarGwa(scholarId) {
  const s = getScholar(scholarId);
  if (!s) return;
  const input = document.getElementById('profileGwaInput');
  const errEl = document.getElementById('profileGwaError');
  errEl.textContent = '';
  if (computeVerification(s) !== 'Verified') {
    errEl.textContent = 'GWA can only be entered once all required documents are approved.';
    return;
  }
  const raw = (input.value || '').trim();
  const val = Number(raw);
  if (raw === '' || isNaN(val) || val < 1 || val > 5) {
    errEl.textContent = 'Enter a valid GWA between 1.00 and 5.00.';
    return;
  }
  const newGwa = Math.round(val * 100) / 100;
  const enr = ENROLLMENTS.find(e => e.scholar_id === scholarId && e.term_id === CURRENT_TERM_ID);
  if (!enr) { errEl.textContent = 'No enrollment found for the current term.'; return; }
  const oldGwa = enr.gwa;
  enr.gwa = newGwa;
  pushActivity('bi-mortarboard-fill', 'icon-green', `<strong>${s.name}'s</strong> GWA was ${oldGwa == null ? 'recorded as' : 'updated from ' + formatGwa(oldGwa) + ' to'} <strong>${formatGwa(newGwa)}</strong>`);
  showToast('GWA saved', `${s.name}'s latest GWA is now ${formatGwa(newGwa)}.`);
  openProfileModal(scholarId); // re-render the open modal with the new value
  renderAllTables();
}

/* ============================================================
   SCHOLAR PROFILE MODAL LOGIC
   ============================================================ */
function openProfileModal(scholarId) {
  const s = getScholar(scholarId);
  if (!s) return;
  const v = computeVerification(s);
  const st = computeStipendStatus(s);

  document.getElementById('profileModalTitle').innerHTML = `<i class="bi bi-person-badge me-2" style="color:var(--sd-green-700);"></i>${s.name}`;

  const info = [
    { label: 'Full Name', value: s.name },
    { label: 'Student ID', value: s.student_id },
    { label: 'Scholar ID', value: scholarIdOf(s) },
    { label: 'Program', value: s.program_name },
    { label: 'Academic Year', value: s.academic_year },
    { label: 'Current Semester', value: s.semester },
    { label: 'Verification Status', value: verificationPill(v) },
    { label: 'Stipend Status', value: stipendPill(st) },
    { label: 'Scholarship', value: s.scholarship },
    { label: 'Stipend', value: (SCHOLARSHIP_CATALOG[s.scholarship]?.stipendBenefits || []).join(' • ') || 'No stipend amount' },
    { label: 'Other Benefits', value: (SCHOLARSHIP_CATALOG[s.scholarship]?.otherBenefits || []).join(' • ') || 'None' },
    { label: 'Latest GWA', value: formatGwa(latestGwaOf(s.id)) }
  ];
  document.getElementById('profileInfoGrid').innerHTML = info.map(i => `
    <div class="col-6 info-item">
      <div class="info-label">${i.label}</div>
      <div class="info-value">${i.value}</div>
    </div>
  `).join('');

  // GWA entry / correction — unlocked only when every required document is approved.
  const gwaReady = v === 'Verified';
  const curGwa = latestGwaOf(s.id);
  const gwaInput = document.getElementById('profileGwaInput');
  const gwaBtn = document.getElementById('profileGwaSaveBtn');
  gwaInput.value = curGwa != null ? Number(curGwa).toFixed(2) : '';
  gwaInput.disabled = !gwaReady;
  gwaBtn.disabled = !gwaReady;
  gwaBtn.onclick = () => saveScholarGwa(s.id);
  gwaInput.onkeydown = e => { if (e.key === 'Enter') { e.preventDefault(); if (!gwaBtn.disabled) gwaBtn.click(); } };
  document.getElementById('profileGwaError').textContent = '';
  document.getElementById('profileGwaHint').innerHTML = gwaReady
    ? `<i class="bi bi-patch-check-fill me-1" style="color:var(--sd-green-700);"></i>All required documents are approved. You can enter or correct the GWA.`
    : `<i class="bi bi-lock-fill me-1"></i>Locked until all required documents are approved (currently <strong>${v}</strong>).`;

  document.getElementById('profileDocStatus').innerHTML = getRequiredDocTypes(s).map(dt => {
    const doc = s.docs[dt.id];
    const meta = docStatusMeta[doc.status];
    const sheetLines = [92, 100, 78, 96, 64].map(w => `<div class="dps-line" style="width:${w}%;"></div>`).join('');
    const preview = doc.file ? `
      <div class="doc-preview-panel d-none" id="profileDocPreview-${dt.id}">
        <div class="doc-preview-sheet">
          <div class="dps-head">Davao del Norte State College<br><span>${dt.name}</span></div>
          <div class="dps-meta"><strong>${s.name}</strong> · ${s.student_id}<br>${s.semester}, A.Y. ${s.academic_year}</div>
          ${sheetLines}
          <div class="dps-foot"><span title="${doc.file}"><i class="bi bi-file-earmark-pdf me-1"></i>${doc.file}</span><span class="dps-stamp ${meta.cls}">${meta.label}</span></div>
        </div>
        <div class="small text-muted-custom text-center mt-1">Preview of the uploaded file. Original files are not stored in this prototype, so a document-style placeholder is shown.</div>
      </div>` : '';
    return `
      <div class="py-2" style="border-bottom:1px solid var(--sd-border);">
        <div class="profile-doc-line">
          <span class="small">${dt.name}</span>
          <span class="profile-doc-ctrls">
            ${doc.file ? `<button type="button" class="btn-preview-sm" id="profileDocBtn-${dt.id}" aria-expanded="false" onclick="toggleProfileDocPreview('${dt.id}')"><i class="bi bi-eye"></i>Preview</button>` : `<span class="btn-preview-sm" aria-hidden="true" style="visibility:hidden;"><i class="bi bi-eye"></i>Preview</span>`}
            <span class="doc-status-badge ${meta.cls}"><i class="bi ${meta.icon}"></i>${meta.label}</span>
          </span>
        </div>
        ${preview}
      </div>`;
  }).join('');

  // Released payouts only, newest first. Monthly scholarships list one entry per month; semestral ones one per semester.
  const history = disbursementHistory
    .filter(h => h.student_id === s.student_id && h.status === 'Released')
    .sort((x, y) => new Date(y.release_date || 0) - new Date(x.release_date || 0));
  const cadence = scholarshipHasStipend(s.scholarship)
    ? (SCHOLARSHIP_CATALOG[s.scholarship].frequency === 'Per month' ? 'Released monthly' : 'Released per semester')
    : '';
  document.getElementById('profileStipendHistory').innerHTML = !scholarshipHasStipend(s.scholarship)
    ? `<div class="small text-muted-custom">DNSC internal scholarship — no stipend is disbursed.</div>` + (isMarkedComplete(s) ? `<div class="alert alert-success d-flex align-items-start gap-2 mt-2 mb-0 small" role="alert"><i class="bi bi-check-circle-fill mt-1"></i><div>Marked as complete on ${_fmtDate(s.benefitsCompletedAt)}. Appropriate benefits can be awarded in person at the school's office.</div></div>` : '')
    : (history.length
      ? `<div class="small text-muted-custom mb-1">${cadence}</div>` + history.map(h => `
        <div class="d-flex justify-content-between align-items-center py-2" style="border-bottom:1px solid var(--sd-border);">
          <div>
            <div class="small fw-semibold">${h.release_period || (h.semester + ' ' + h.academic_year)}</div>
            <div class="small text-muted-custom">${SCHOLARSHIP_CATALOG[s.scholarship].frequency === 'Per month' ? h.semester + ' ' + h.academic_year + ' · ' : ''}${h.date}</div>
          </div>
          <div class="text-end">
            <div class="amount-value">${peso(h.amount)}</div>
            <span class="status-pill pill-credited"><i class="bi bi-check-circle-fill"></i>Disbursed</span>
          </div>
        </div>`).join('')
      : `<div class="small text-muted-custom">No stipends disbursed yet for this scholar.</div>`);

  bootstrap.Modal.getOrCreateInstance(document.getElementById('profileModal')).show();
}

/* ============================================================
   RELEASE CONFIRMATION MODAL LOGIC
   ============================================================ */
let currentReleaseScholarId = null;

// Batch selection state for "Release Selected" (Set of scholar IDs currently checked).
const stipendSelection = new Set();

function toggleStipendSelection(scholarId, checked) {
  if (checked) stipendSelection.add(scholarId);
  else stipendSelection.delete(scholarId);
  renderStipendPage();
}

function toggleSelectAllStipend(checked) {
  const readyIds = srStatusFilter === 'released' ? [] : getStipendReleaseCohort().filter(s => !isCredited(s)).map(s => s.id);
  stipendSelection.clear();
  if (checked) readyIds.forEach(id => stipendSelection.add(id));
  renderStipendPage();
}

function openReleaseModal(scholarId) {
  const s = getScholar(scholarId);
  if (!s) return;
  currentReleaseScholarId = scholarId;
  const dnsc = isDnscProgram(s.scholarship);
  document.getElementById('relScholarName').textContent = s.name;
  document.getElementById('relScholarId').textContent = scholarIdOf(s);
  document.getElementById('relAmount').textContent = dnsc ? 'N/A' : peso(getScholarStipendAmount(s));
  document.getElementById('relAccountNumber').textContent = dnsc ? 'N/A' : (s.accountNumber || '—');
  document.getElementById('relPeriod').textContent = releasePeriodLabel(s.scholarship);

  // Reset the acknowledgment checkbox and primary button each time the modal
  // is (re)opened — prevents a stale checked/loading state, or a previous
  // mid-submit interruption (e.g. modal dismissed via Esc), from carrying over.
  const ackCheck = document.getElementById('relAckCheck');
  ackCheck.checked = false;
  setBtnIdle(document.getElementById('confirmReleaseBtn'), 'Confirm Disbursement', true);

  bootstrap.Modal.getOrCreateInstance(document.getElementById('releaseModal')).show();
}

/* DNSC scholars: "Mark as complete" records completion and shows an informational confirmation modal. */
function openCompleteModal(scholarId) {
  const s = getScholar(scholarId);
  if (!s || !isDnscScholar(s)) return;
  if (!isMarkedComplete(s)) {
    s.benefitsComplete = true;
    s.benefitsCompletedAt = new Date().toISOString();
    pushActivity('bi-patch-check-fill', 'icon-green', `<strong>${s.name}</strong> was marked as complete (${scholarshipTypeLabel(s.scholarship)})`);
  }
  document.getElementById('cmpScholarName').textContent = s.name;
  document.getElementById('cmpScholarId').textContent = scholarIdOf(s);
  document.getElementById('cmpCampus').textContent = schoolOfScholar(s);
  bootstrap.Modal.getOrCreateInstance(document.getElementById('completeModal')).show();
  renderAllTables();
}

/* Shared loading-state helpers: swap a primary action button into a
   disabled, spinner state immediately on click (prevents double-submit
   while the "request" is in flight), and restore it afterward. */
function setBtnLoading(btn, loadingLabel) {
  if (!btn.dataset.restoreHtml) btn.dataset.restoreHtml = btn.innerHTML;
  btn.disabled = true;
  btn.setAttribute('aria-busy', 'true');
  btn.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>${loadingLabel}`;
}
function setBtnIdle(btn, label, disabled) {
  btn.removeAttribute('aria-busy');
  btn.innerHTML = label !== undefined ? label : (btn.dataset.restoreHtml || btn.innerHTML);
  btn.disabled = !!disabled;
  delete btn.dataset.restoreHtml;
}

document.getElementById('confirmReleaseBtn').addEventListener('click', function () {
  const btn = this;
  if (btn.disabled) return; // already submitting, or acknowledgment not yet checked
  if (!document.getElementById('relAckCheck').checked) return; // safeguard: acknowledgment required
  const s = getScholar(currentReleaseScholarId);
  if (!s) return;

  setBtnLoading(btn, 'Processing…');

  // Simulate the async round-trip to the disbursement backend so the
  // loading state is visible before the modal closes.
  setTimeout(function () {
    recordCreditedDisbursement(s);

    pushActivity('bi-cash-coin', 'icon-green', `Stipend disbursed to <strong>${s.name}</strong> for 1st Semester 2026–2027`);
    showToast('Stipend disbursed', `${peso(getScholarStipendAmount(s))} recorded as disbursed to ${s.name}.`);

    bootstrap.Modal.getInstance(document.getElementById('releaseModal')).hide();
    setBtnIdle(btn, 'Confirm Disbursement', true);
    renderAllTables();
  }, 650);
});

/* ============================================================
   BATCH RELEASE CONFIRMATION MODAL LOGIC (two-step)
   ============================================================ */
function openBatchReleaseModal() {
  if (stipendSelection.size === 0) return;
  const selected = scholars.filter(s => stipendSelection.has(s.id));
  const total = selected.reduce((sum, s) => sum + getScholarStipendAmount(s), 0);

  document.getElementById('batchRelCount').textContent = selected.length;
  document.getElementById('batchRelTotal').textContent = peso(total);
  document.getElementById('batchRelPeriod').textContent = [...new Set(selected.map(s => releasePeriodLabel(s.scholarship)))].join(' · ') || `${CURRENT_SEM} ${CURRENT_AY}`;
  document.getElementById('batchRelCountConfirm').textContent = selected.length;
  document.getElementById('batchRelTotalConfirm').textContent = peso(total);
  document.getElementById('batchRelList').innerHTML = selected.map(s => {
    const dnsc = isDnscProgram(s.scholarship);
    const acct = dnsc ? 'N/A' : (s.accountNumber || '—');
    const amt = dnsc ? 'N/A' : peso(getScholarStipendAmount(s));
    return `<div class="small py-1">${s.name} <span class="text-muted-custom">(${scholarIdOf(s)})</span> <span class="text-muted-custom">— Acct: ${acct} · ${amt}</span></div>`;
  }).join('');

  // Reset the acknowledgment checkbox and primary button each time the modal
  // is (re)opened so the confirm button always starts disabled — prevents a
  // stale checked/loading state from an earlier batch carrying over.
  const ackCheck = document.getElementById('batchRelAckCheck');
  ackCheck.checked = false;
  setBtnIdle(document.getElementById('batchRelConfirmBtn'), 'Confirm &amp; Disburse All', true);
  document.getElementById('batchRelAckLabel').textContent =
    `I verify that all ${selected.length} recipient record${selected.length === 1 ? '' : 's'} have been reviewed.`;

  showBatchReleaseStep(1);
  bootstrap.Modal.getOrCreateInstance(document.getElementById('batchReleaseModal')).show();
}

function showBatchReleaseStep(step) {
  const isStep1 = step === 1;
  document.getElementById('batchReleaseStep1').classList.toggle('d-none', !isStep1);
  document.getElementById('batchReleaseStep2').classList.toggle('d-none', isStep1);
  document.getElementById('batchRelCancelBtn').classList.toggle('d-none', !isStep1);
  document.getElementById('batchRelContinueBtn').classList.toggle('d-none', !isStep1);
  document.getElementById('batchRelBackBtn').classList.toggle('d-none', isStep1);
  document.getElementById('batchRelConfirmBtn').classList.toggle('d-none', isStep1);
}

document.getElementById('batchRelConfirmBtn').addEventListener('click', function () {
  const btn = this;
  if (btn.disabled) return; // already submitting, or acknowledgment not yet checked
  if (!document.getElementById('batchRelAckCheck').checked) return; // safeguard: acknowledgment required
  const selected = scholars.filter(s => stipendSelection.has(s.id));
  if (!selected.length) return;

  setBtnLoading(btn, 'Disbursing…');

  // Simulate the async round-trip to the disbursement backend so the
  // loading state is visible before the modal closes.
  setTimeout(function () {
    selected.forEach(s => {
      recordCreditedDisbursement(s);
    });

    const total = selected.reduce((sum, s) => sum + getScholarStipendAmount(s), 0);
    pushActivity('bi-cash-coin', 'icon-green', `Stipend disbursed to <strong>${selected.length} scholars</strong> (${peso(total)} total) for 1st Semester 2026–2027`);
    showToast('Batch disbursement complete', `${peso(total)} recorded as disbursed across ${selected.length} scholar${selected.length === 1 ? '' : 's'}.`);

    stipendSelection.clear();
    bootstrap.Modal.getInstance(document.getElementById('batchReleaseModal')).hide();
    setBtnIdle(btn, 'Confirm &amp; Disburse All', true);
    renderAllTables();
  }, 800);
});

/* ============================================================
   ADD NEW SCHOLAR PAGE — 4-STEP WIZARD
   ============================================================ */
const ADD_SCHOLAR_TOTAL_STEPS = 4;
let addScholarStep = 1;
const pendingScholarSubmissions = [];

// Add New Scholar uses the requested onboarding channel choices.
const ADD_SCHOLAR_CHANNELS = [
  { id: 'landbank', label: 'LandBank' },
  { id: 'ewallet', label: 'E-Wallet' },
  { id: 'other', label: 'Others' }
];
(function populateAddScholarChannelSelect() {
  const sel = document.getElementById('nasChannel');
  if (!sel) return;
  sel.innerHTML = '<option value="">Select channel…</option>' + ADD_SCHOLAR_CHANNELS.map(ch => `<option value="${ch.id}">${ch.label}</option>`).join('');
})();

function getGrantStipendDetails(program, classification) {
  const rule = GRANT_PROGRAM_STIPENDS[program];
  if (!rule) return { amount: null, cadence: 'N/A', display: 'Select a grant program' };
  const cat = SCHOLARSHIP_CATALOG[program];
  // Amount text is the Admin "Amount" label (e.g. ₱7,500.00 / semester, Up to ₱50,000.00, Amount not stated).
  if (rule.noStipend) return { amount: 0, cadence: 'N/A', note: rule.note, noStipend: true, display: cat.amountLabel };
  const selected = rule.classification ? rule.classification[classification] : rule;
  if (!selected) return { amount: null, cadence: 'N/A', display: 'Select Half or Full classification' };
  const display = rule.classification
    ? '₱' + Number(selected.amount).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + (_FREQ_SUFFIX[selected.cadence] || '')
    : cat.amountLabel;
  return { ...selected, display };
}
function getGrantStipend(program, classification) { return getGrantStipendDetails(program, classification).amount || 0; }
function renderGrantStipend() {
  const program = document.getElementById('nasScholarship');
  const classification = document.getElementById('nasClassification');
  const stipend = document.getElementById('nasStipend');
  const help = document.getElementById('nasStipendHelp');
  if (!program || !classification || !stipend) return;
  const details = getGrantStipendDetails(program.value, classification.value);
  stipend.value = details.display;
  if (help) help.textContent = details.note || '';
}
document.getElementById('nasScholarship').addEventListener('change', renderGrantStipend);
document.getElementById('nasClassification').addEventListener('change', renderGrantStipend);

const SCHOLARSHIP_CONFIGS = Object.freeze(Object.fromEntries(Object.entries(SCHOLARSHIP_CATALOG).map(([k, c]) => {
  const cls = SCHOLARSHIP_CLASSIFICATIONS.filter(x => x.scholarship_id === scholarshipByName(k).scholarship_id).map(x => x.classification_name.toLowerCase()).sort((a, b) => a === 'half' ? -1 : 1);
  return [k, { classificationOptions: cls.length ? cls : ['na'], label: c.label, code: c.code, category: c.category, frequency: c.frequency, amountLabel: c.amountLabel, eligibility: c.rules, benefits: c.benefits, stipendBenefits: c.stipendBenefits, otherBenefits: c.otherBenefits, requiredDocuments: c.documents, maintenance: c.maintenance }];
})));
function getScholarshipConfig(program) { return SCHOLARSHIP_CONFIGS[program] || { classificationOptions: ['na'], label: '', code: '', category: '', frequency: '', amountLabel: '', eligibility: [], benefits: [], stipendBenefits: [], otherBenefits: [], requiredDocuments: [], maintenance: [] }; }
function renderScholarshipConfiguration() {
  const programEl = document.getElementById('nasScholarship');
  const classEl = document.getElementById('nasClassification');
  const panel = document.getElementById('nasScholarshipConfig');
  if (!programEl || !classEl || !panel) return;
  const program = programEl.value;
  if (!program) { panel.innerHTML = '<div class="as-config-empty">Select a scholarship to load its eligibility, stipend, benefits, required documents, and maintenance requirements.</div>'; return; }
  const cfg = getScholarshipConfig(program);
  const allowed = new Set(cfg.classificationOptions);
  Array.from(classEl.options).forEach(opt => { if (opt.value) opt.hidden = !allowed.has(opt.value); });
  if (!allowed.has(classEl.value)) classEl.value = cfg.classificationOptions[0] || 'na';
  renderGrantStipend();
  panel.innerHTML = `<div class="as-config-grid">
    <div><div class="as-config-label">Scholarship Name</div><div class="as-config-value">${cfg.label}</div></div>
    <div><div class="as-config-label">Scholarship Code</div><div class="as-config-value">${cfg.code}</div></div>
    <div><div class="as-config-label">Category</div><div class="as-config-value">${cfg.category}</div></div>
    <div><div class="as-config-label">Calculated stipend</div><div class="as-config-value"><strong>${document.getElementById('nasStipend').value}</strong></div></div>
    <div><div class="as-config-label">Release Frequency</div><div class="as-config-value">${cfg.frequency}</div></div>
    <div><div class="as-config-label">Classification</div><div class="as-config-value">${classEl.value === 'na' ? 'N/A' : classEl.value === 'full' ? 'Full' : 'Half'}</div></div>
  </div>
  <details class="as-nonmonetary-details">
    <summary><i class="bi bi-chevron-right me-2"></i>View eligibility, benefits &amp; requirements</summary>
    <div class="as-nonmonetary-body">
      <div><div class="as-config-label">Eligibility</div><div class="as-config-value">${cfg.eligibility.join('; ') || 'No eligibility rules configured.'}</div></div>
      <div><div class="as-config-label">Stipend</div><ul class="as-config-list">${cfg.stipendBenefits.length ? cfg.stipendBenefits.map(x => `<li>${x}</li>`).join('') : '<li>No stipend amount</li>'}</ul></div>
      <div><div class="as-config-label">Other Benefits</div><ul class="as-config-list">${cfg.otherBenefits.length ? cfg.otherBenefits.map(x => `<li>${x}</li>`).join('') : '<li>None</li>'}</ul></div>
      <div><div class="as-config-label">Required Documents</div><ul class="as-config-list">${cfg.requiredDocuments.map(x => `<li>${x}</li>`).join('')}</ul></div>
      <div><div class="as-config-label">Maintenance Requirements</div><ul class="as-config-list">${cfg.maintenance.map(x => `<li>${x}</li>`).join('')}</ul></div>
    </div>
  </details>`;
}
document.getElementById('nasScholarship').addEventListener('change', renderScholarshipConfiguration);
document.getElementById('nasClassification').addEventListener('change', renderScholarshipConfiguration);



/* ------------------------------------------------------------
   Required-field markers (*) — driven by the live `required` state so a
   field that becomes optional/disabled (e.g. card number for DNSC grants)
   automatically loses its asterisk.
   ------------------------------------------------------------ */
function syncRequiredMarker(field) {
  if (!field || !field.id) return;
  const form = document.getElementById('addScholarForm');
  const label = form && form.querySelector(`label[for="${field.id}"], label[data-for="${field.id}"]`);
  if (!label) return;
  let star = label.querySelector('.req-star');
  if (!star) {
    star = document.createElement('span');
    star.className = 'req-star';
    star.setAttribute('aria-hidden', 'true');
    star.textContent = '*';
    label.appendChild(star);
  }
  star.hidden = !field.required;
}
function initRequiredMarkers() {
  document.querySelectorAll('#addScholarForm input, #addScholarForm select').forEach(syncRequiredMarker);
}

/* ------------------------------------------------------------
   Searchable select — wraps a native <select> (kept in the DOM as the
   source of truth, so .value / validation / reset keep working) with a
   type-to-filter combobox. Supports <optgroup> and keyboard navigation.
   ------------------------------------------------------------ */
const searchableSelects = [];
function makeSearchableSelect(select, placeholder) {
  if (!select || select._comboInput) return;
  const wrap = document.createElement('div');
  wrap.className = 'as-combo';
  select.parentNode.insertBefore(wrap, select);

  const input = document.createElement('input');
  input.type = 'text';
  input.className = 'form-control';
  input.id = select.id + 'Search';
  input.placeholder = placeholder || 'Search…';
  input.autocomplete = 'off';
  input.spellcheck = false;
  input.setAttribute('role', 'combobox');
  input.setAttribute('aria-autocomplete', 'list');
  input.setAttribute('aria-haspopup', 'listbox');
  input.setAttribute('aria-expanded', 'false');
  input.setAttribute('aria-controls', select.id + 'List');

  const caret = document.createElement('i');
  caret.className = 'bi bi-chevron-down as-combo-caret';
  caret.setAttribute('aria-hidden', 'true');

  const list = document.createElement('ul');
  list.className = 'as-combo-list';
  list.id = select.id + 'List';
  list.setAttribute('role', 'listbox');
  list.hidden = true;

  wrap.append(input, caret, list, select);
  select.classList.add('as-combo-native');
  select.tabIndex = -1;
  select.setAttribute('aria-hidden', 'true');
  select._comboInput = input;

  // Re-point the label so clicking it focuses the visible search box.
  const label = document.querySelector(`label[for="${select.id}"]`);
  if (label) { label.setAttribute('for', input.id); label.setAttribute('data-for', select.id); }

  let visible = [];   // currently rendered option rows
  let activeIdx = -1;

  const optionData = () => {
    const rows = [];
    Array.from(select.children).forEach(node => {
      if (node.tagName === 'OPTGROUP') Array.from(node.children).forEach(o => rows.push({ value: o.value, label: o.textContent, group: node.label }));
      else if (node.value) rows.push({ value: node.value, label: node.textContent, group: '' });
    });
    return rows;
  };
  const render = (query) => {
    const tokens = query.toLowerCase().split(/\s+/).filter(Boolean);
    const matches = optionData().filter(o => { const hay = (o.label + ' ' + o.group).toLowerCase(); return tokens.every(t => hay.includes(t)); });
    list.innerHTML = '';
    visible = [];
    if (!matches.length) {
      const empty = document.createElement('li');
      empty.className = 'as-combo-empty';
      empty.setAttribute('role', 'presentation');
      empty.textContent = 'No matching program';
      list.appendChild(empty);
      activeIdx = -1;
      return;
    }
    let lastGroup = null;
    matches.forEach(o => {
      if (o.group && o.group !== lastGroup) {
        const g = document.createElement('li');
        g.className = 'as-combo-group';
        g.setAttribute('role', 'presentation');
        g.textContent = o.group;
        list.appendChild(g);
        lastGroup = o.group;
      }
      const li = document.createElement('li');
      li.className = 'as-combo-opt';
      li.id = `${select.id}Opt${visible.length}`;
      li.setAttribute('role', 'option');
      li.setAttribute('aria-selected', String(o.value === select.value));
      li.textContent = o.label;
      li.addEventListener('mousedown', e => { e.preventDefault(); choose(o); });
      list.appendChild(li);
      visible.push({ el: li, data: o });
    });
    const selIdx = visible.findIndex(v => v.data.value === select.value);
    setActive(selIdx >= 0 ? selIdx : (tokens.length ? 0 : -1), selIdx >= 0 || !tokens.length);
  };
  const setActive = (i, scroll = true) => {
    visible.forEach((v, n) => v.el.classList.toggle('active', n === i));
    activeIdx = i;
    if (i >= 0) {
      input.setAttribute('aria-activedescendant', visible[i].el.id);
      if (scroll) visible[i].el.scrollIntoView({ block: 'nearest' });
    } else input.removeAttribute('aria-activedescendant');
  };
  const open = (query) => { render(query || ''); list.hidden = false; input.setAttribute('aria-expanded', 'true'); };
  const close = () => { list.hidden = true; input.setAttribute('aria-expanded', 'false'); input.removeAttribute('aria-activedescendant'); };
  const sync = () => { const o = select.selectedOptions[0]; input.value = o && o.value ? o.textContent : ''; };
  const choose = (o) => {
    select.value = o.value;
    sync();
    close();
    input.classList.remove('is-invalid');
    select.dispatchEvent(new Event('change', { bubbles: true }));
  };

  input.addEventListener('focus', () => { input.select(); open(''); });
  input.addEventListener('click', () => { if (list.hidden) open(''); });
  input.addEventListener('input', () => open(input.value));
  input.addEventListener('keydown', e => {
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      if (list.hidden) { open(''); return; }
      if (!visible.length) return;
      const step = e.key === 'ArrowDown' ? 1 : -1;
      setActive((activeIdx + step + visible.length) % visible.length);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (!list.hidden && activeIdx >= 0) choose(visible[activeIdx].data);
    } else if (e.key === 'Escape') {
      if (!list.hidden) { e.preventDefault(); e.stopPropagation(); close(); sync(); }
    } else if (e.key === 'Tab') { close(); }
  });
  input.addEventListener('blur', () => {
    close();
    if (!input.value.trim() && select.value) { select.value = ''; select.dispatchEvent(new Event('change', { bubbles: true })); }
    sync();
  });

  searchableSelects.push(sync);
  sync();
}
function syncSearchableSelects() { searchableSelects.forEach(fn => fn()); }

/* ------------------------------------------------------------
   DNSC-administered grants are paid out through "Others": the channel is
   locked to Others and the card/account number is disabled and optional.
   ------------------------------------------------------------ */
function isDnscProgram(value) {
  return !!value && !scholarshipHasStipend(value); // DNSC internal scholarships (no stipend)
}
let dnscRuleActive = false;
function applyDnscDisbursementRule(forceReset) {
  const program = document.getElementById('nasScholarship');
  const channel = document.getElementById('nasChannel');
  const account = document.getElementById('nasAccountNumber');
  const chHelp = document.getElementById('nasChannelHelp');
  const acHelp = document.getElementById('nasAccountHelp');
  if (!program || !channel || !account) return;
  const lock = isDnscProgram(program.value);

  if (lock) {
    channel.value = 'other';
    channel.disabled = true;
    account.value = '';
    account.disabled = true;
    account.required = false;
    account.placeholder = 'Not applicable';
    account.classList.remove('is-invalid');
    channel.classList.remove('is-invalid');
    if (chHelp) chHelp.textContent = 'Locked to Others for DNSC-administered grants.';
    if (acHelp) acHelp.textContent = 'Not needed — DNSC grants are not paid to a card or account.';
  } else {
    if (dnscRuleActive || forceReset) channel.value = '';
    channel.disabled = false;
    account.disabled = false;
    account.required = true;
    account.placeholder = 'Type card or account number';
    if (chHelp) chHelp.textContent = '';
    if (acHelp) acHelp.textContent = '';
  }
  dnscRuleActive = lock;
  syncRequiredMarker(channel);
  syncRequiredMarker(account);
  const feedback = (el) => { const f = el.parentElement && el.parentElement.querySelector(':scope > .invalid-feedback'); if (f) { f.textContent = ''; f.classList.remove('d-block'); } };
  if (lock) { feedback(channel); feedback(account); }
}
document.getElementById('nasScholarship').addEventListener('change', () => applyDnscDisbursementRule(false));

initRequiredMarkers();
makeSearchableSelect(document.getElementById('nasProgram'), 'Search degree program…');
applyDnscDisbursementRule(true);


// Name parts -> combined full name (kept in hidden #nasName so existing review/submit logic is unchanged)
function syncAddScholarFullName() {
  const v = id => (document.getElementById(id)?.value || '').trim().replace(/\s+/g, ' ');
  const full = [v('nasFirstName'), v('nasMiddleName'), v('nasLastName')].filter(Boolean).join(' ');
  const hidden = document.getElementById('nasName');
  if (hidden) hidden.value = full;
}
['nasFirstName', 'nasMiddleName', 'nasLastName'].forEach(id => {
  const el = document.getElementById(id);
  if (el) el.addEventListener('input', syncAddScholarFullName);
});

// Birth Date: strict yyyy-mm-dd, the same format as the SCHOLARS.birth_date DATE column
// (auto-inserts dashes, digits only, validates real calendar date)
(function initAddScholarDob() {
  const el = document.getElementById('nasDob');
  if (!el) return;
  const check = () => {
    const val = el.value;
    let msg = '';
    if (val) {
      const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(val);
      if (!m) msg = 'Use the format yyyy-mm-dd.';
      else {
        const y = +m[1], mo = +m[2], d = +m[3];
        const dt = new Date(y, mo - 1, d);
        if (dt.getFullYear() !== y || dt.getMonth() !== mo - 1 || dt.getDate() !== d) msg = 'Enter a valid date (yyyy-mm-dd).';
        else if (dt > new Date()) msg = 'Birth date cannot be in the future.';
      }
    }
    el.setCustomValidity(msg);
  };
  el.addEventListener('input', () => {
    const digits = el.value.replace(/\D/g, '').slice(0, 8);
    let out = digits;
    if (digits.length > 6) out = digits.slice(0, 4) + '-' + digits.slice(4, 6) + '-' + digits.slice(6);
    else if (digits.length > 4) out = digits.slice(0, 4) + '-' + digits.slice(4);
    el.value = out;
    check();
  });
  el.addEventListener('blur', check);
  check();
})();

// SCHOLARS.age is not typed in: it is derived from birth_date (yyyy-mm-dd).
function ageFromBirthDate(iso) {
  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(iso || '');
  if (!m) return null;
  const today = new Date();
  let age = today.getFullYear() - (+m[1]);
  const monthDiff = today.getMonth() - (+m[2] - 1);
  if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < +m[3])) age--;
  return age >= 0 ? age : null;
}

// Auto-incremented Scholar ID (read-only field). Numeric id = highest existing + 1.
function nextScholarNumericId() {
  const pool = [].concat(typeof scholars !== 'undefined' ? scholars : [], typeof pendingScholarSubmissions !== 'undefined' ? pendingScholarSubmissions : []);
  return pool.reduce((max, s) => Math.max(max, Number(s.id) || 0), 0) + 1;
}
function formatScholarId(n) { return 'SCH-' + String(n).padStart(4, '0'); }
function refreshAddScholarId() {
  const el = document.getElementById('nasScholarId');
  if (el) el.value = formatScholarId(nextScholarNumericId());
}
refreshAddScholarId();

function addScholarFieldValue(id) {
  const el = document.getElementById(id);
  return el ? el.value.trim() : '';
}

function renderAddScholarStepper() {
  document.querySelectorAll('#scholarWizardStepper .as-step').forEach(el => {
    const n = Number(el.getAttribute('data-step'));
    el.classList.toggle('active', n === addScholarStep);
    el.classList.toggle('completed', n < addScholarStep);
    const numEl = el.querySelector('.as-step-num');
    numEl.innerHTML = n < addScholarStep ? '<i class="bi bi-check-lg"></i>' : n;
  });

  document.querySelectorAll('#addScholarForm .wizard-pane').forEach(pane => {
    pane.classList.toggle('active', Number(pane.getAttribute('data-pane')) === addScholarStep);
  });

  const progressLabel = document.getElementById('scholarWizardProgressLabel');
  if (progressLabel) progressLabel.textContent = `Step ${addScholarStep} of ${ADD_SCHOLAR_TOTAL_STEPS}`;

  document.getElementById('scholarWizardPrevBtn').style.visibility = addScholarStep === 1 ? 'hidden' : 'visible';
  document.getElementById('scholarWizardNextBtn').style.display = addScholarStep === ADD_SCHOLAR_TOTAL_STEPS ? 'none' : 'inline-flex';
  document.getElementById('scholarWizardSaveBtn').style.display = addScholarStep === ADD_SCHOLAR_TOTAL_STEPS ? 'inline-flex' : 'none';

  refreshAddScholarId();
  if (addScholarStep === ADD_SCHOLAR_TOTAL_STEPS) renderAddScholarReview();
}

// Step navigation controller: hides the active .wizard-pane and shows the
// target one (via renderAddScholarStepper's class toggling), gated by
// step-level validation when moving forward. direction: 1 = next, -1 = back.
function navigateWizard(direction) {
  if (direction === 1) {
    if (!validateWizardPane(addScholarStep)) return;
    if (addScholarStep < ADD_SCHOLAR_TOTAL_STEPS) {
      addScholarStep++;
      renderAddScholarStepper();
      document.querySelector('#page-add-scholar .card-panel').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  } else if (direction === -1) {
    if (addScholarStep > 1) {
      addScholarStep--;
      renderAddScholarStepper();
    }
  }
}

// Step-level validation: runs the browser's own HTML5 constraint validation
// (checkValidity()) on every required input/select inside the active pane
// before allowing forward progression. The first invalid field gets a
// visible highlight, a native validation bubble, and focus.
function validateWizardPane(step) {
  const pane = document.querySelector(`#addScholarForm .wizard-pane[data-pane="${step}"]`);
  const fields = pane ? pane.querySelectorAll('input[required], select[required]') : [];
  let firstInvalid = null;

  fields.forEach(field => {
    const valid = field.checkValidity();
    const ui = field._comboInput || field;
    ui.classList.toggle('is-invalid', !valid);
    field.setAttribute('aria-invalid', valid ? 'false' : 'true');
    const feedbackId = `${field.id || 'wizard-field'}-error`;
    field.setAttribute('aria-describedby', feedbackId);
    let feedback = field.parentElement ? field.parentElement.querySelector(':scope > .invalid-feedback') : null;
    if (!feedback && field.parentElement) {
      feedback = document.createElement('div');
      feedback.className = 'invalid-feedback';
      feedback.id = feedbackId;
      feedback.setAttribute('role', 'alert');
      field.insertAdjacentElement('afterend', feedback);
    }
    if (feedback) {
      feedback.textContent = valid ? '' : (field.validationMessage || 'Please complete this field before continuing.');
      feedback.classList.toggle('d-block', !valid);
    }
    if (!valid && !firstInvalid) firstInvalid = field;
  });

  if (firstInvalid) {
    if (firstInvalid._comboInput) { firstInvalid._comboInput.focus(); }
    else { firstInvalid.reportValidity(); firstInvalid.focus(); }
    return false;
  }

  return true;
}

