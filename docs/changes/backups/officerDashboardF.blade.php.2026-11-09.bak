        <div class="col-12"><div class="info-item"><div class="info-label">Required Documents</div><div class="info-value">${getScholarshipConfig(epmVal('epmScholarship')).requiredDocuments.join(' • ') || 'N/A'}</div></div></div>
        <div class="col-12"><div class="info-item"><div class="info-label">Maintenance Requirements</div><div class="info-value">${getScholarshipConfig(epmVal('epmScholarship')).maintenance.join(' • ') || 'N/A'}</div></div></div>
