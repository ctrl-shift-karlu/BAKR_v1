const AVATAR_COLORS = ['var(--sd-green-700)', 'var(--sd-green-700)', 'var(--muted-red)', 'var(--sd-green-900)'];

/* ============================================================
   HELPERS
   ============================================================ */
function initials(name) {
  return name.split(' ').map(p => p[0]).slice(0, 2).join('').toUpperCase();
}
function avatarColor(id) {
  return AVATAR_COLORS[id % AVATAR_COLORS.length];
}
function peso(n) {
  return '₱' + n.toLocaleString('en-PH');
}
function getScholar(id) {
  return scholars.find(s => s.id === id);
}
function docsSubmittedCount(scholar) {
  return getRequiredDocTypes(scholar).filter(d => scholar.docs[d.id]?.file).length;
}
function computeVerification(scholar) {
  const required = getRequiredDocTypes(scholar);
  const statuses = required.map(d => scholar.docs[d.id]?.status || 'not_uploaded');
  // Pending is reserved for an incomplete required-document set.
  if (!hasCompletedRequiredSubmission(scholar)) return 'Pending';
  if (statuses.every(status => status === 'verified')) return 'Verified';
  return 'Needs Review';
}
function computeStipendStatus(scholar) {
  if (!scholarshipHasStipend(scholar.scholarship)) return isMarkedComplete(scholar) ? 'Completed' : 'Not Applicable'; // DNSC internal: no stipend
  if (isCredited(scholar)) return 'Released';
  if (computeVerification(scholar) === 'Verified') return 'Ready';
  return 'Not Eligible';
}

function verificationPill(status) {
  if (status === 'Verified') return `<span class="status-pill pill-verif pill-green"><i class="bi bi-patch-check-fill"></i>Verified</span>`;
  if (status === 'Needs Review') return `<span class="status-pill pill-verif pill-muted-red"><i class="bi bi-exclamation-triangle-fill"></i>Needs Review</span>`;
  return `<span class="status-pill pill-verif pill-red"><i class="bi bi-hourglass-split"></i>Pending</span>`;
}
function stipendPill(status) {
  if (status === 'Released') return `<span class="status-pill pill-credited"><i class="bi bi-check-circle-fill"></i>Disbursed</span>`;
  if (status === 'Ready') return `<span class="status-pill pill-pending"><i class="bi bi-hourglass-split"></i>Pending Disbursement</span>`;
  if (status === 'Completed') return `<span class="status-pill pill-credited"><i class="bi bi-check-circle-fill"></i>Marked Complete</span>`;
  if (status === 'Not Applicable') return `<span class="status-pill pill-not-eligible"><i class="bi bi-dash-circle"></i>Not Applicable</span>`;
  return `<span class="status-pill pill-not-eligible"><i class="bi bi-dash-circle"></i>Not Eligible</span>`;
}
const docStatusMeta = {
  not_uploaded:    { label: 'Not Uploaded',         cls: 'st-not-uploaded',    icon: 'bi-dash-circle' },
  submitted:       { label: 'Submitted',            cls: 'st-submitted',       icon: 'bi-check2' },
  pending:         { label: 'Pending Review',       cls: 'st-pending',         icon: 'bi-hourglass-split' },
  verified:        { label: 'Verified',             cls: 'st-verified',        icon: 'bi-patch-check-fill' },
  requires_update: { label: 'Requires Update',      cls: 'st-requires-update', icon: 'bi-exclamation-triangle-fill' }
};

/* ============================================================
   TIME-IN-STAGE TRACKER + STALE ALERT
   Reads the submittedAt timestamp log (scholar_documents) on each
   document to work out how long it has been sitting in the review
   queue waiting for an officer to open and act on it.
   ============================================================ */

// Hours a document has been waiting in the queue, or null if it isn't
// currently awaiting officer review (no timestamp / already resolved).
function hoursInQueue(doc) {
  if (!doc || !doc.submittedAt) return null;
  if (doc.status !== 'pending' && doc.status !== 'submitted') return null;
  const ms = QUEUE_NOW - new Date(doc.submittedAt);
  return Math.max(0, ms / (1000 * 60 * 60));
}

function formatQueueDuration(hours) {
  if (hours < 1) return '<1h';
  const totalHours = Math.floor(hours);
  if (totalHours < 24) return `${totalHours}h`;
  const days = Math.floor(totalHours / 24);
  const rem = totalHours % 24;
  return rem ? `${days}d ${rem}h` : `${days}d`;
}

function isDocStale(doc) {
  const h = hoursInQueue(doc);
  return h !== null && h > STALE_THRESHOLD_HOURS;
}

// Every document for a scholar that is currently sitting in the review queue.
function scholarQueuedDocs(scholar) {
  return getRequiredDocTypes(scholar).map(dt => scholar.docs[dt.id]).filter(d => hoursInQueue(d) !== null);
}

// Longest a scholar's documents have been waiting, or null if nothing is queued.
function scholarMaxQueueHours(scholar) {
  const hrs = scholarQueuedDocs(scholar).map(hoursInQueue);
  return hrs.length ? Math.max(...hrs) : null;
}

function scholarIsStale(scholar) {
  return scholarQueuedDocs(scholar).some(isDocStale);
}

function queueTier(hours) {
  if (hours > STALE_THRESHOLD_HOURS) return { tier: 'ts-stale', pill: 'pill-danger', label: 'Stale' };
  if (hours >= 24) return { tier: 'ts-aging', pill: 'pill-amber', label: 'Aging' };
  return { tier: 'ts-ok', pill: 'pill-green', label: 'On Track' };
}

// Compact "quick metric badge" used in tables / mobile cards.
function timeInStagePill(hours) {
  if (hours === null) return `<span class="text-muted-custom small">—</span>`;
  const t = queueTier(hours);
  return `<span class="status-pill ${t.pill}"><i class="bi bi-hourglass-split"></i>${formatQueueDuration(hours)} · ${t.label}</span>`;
}

// Fuller visual progress bar used inside the Document Review modal, scaled
// to the 48-hour stale threshold (bar fills solid once it tips over 48h).
function timeInStageBadge(doc) {
  const hours = hoursInQueue(doc);
  if (hours === null) return '';
  const t = queueTier(hours);
  const pct = Math.min(100, Math.round((hours / STALE_THRESHOLD_HOURS) * 100));
  return `
    <div class="time-in-stage ${t.tier}">
      <div class="tis-top">
        <span class="tis-label"><i class="bi bi-clock-history"></i>${formatQueueDuration(hours)} in review queue</span>
        <span class="tis-tag">${t.label}</span>
      </div>
      <div class="tis-track"><div class="tis-fill" style="width:${pct}%;"></div></div>
    </div>`;
}

function pushActivity(icon, cls, text) {
  activityFeed.unshift({ icon, cls, text, time: 'Just now' });
  activityFeed = activityFeed.slice(0, 30);
  renderRecentActivity();
  renderActivityLogPage();
}

function showToast(title, message, type) {
  const icon = document.getElementById('toastIcon');
  const titleEl = document.getElementById('toastTitle');
  const msgEl = document.getElementById('toastMessage');
  titleEl.textContent = title;
  msgEl.textContent = message;
  icon.className = 'bi fs-5 ' + (type === 'red' ? 'bi-exclamation-triangle-fill' : 'bi-check-circle-fill');
  icon.style.color = type === 'red' ? 'var(--sd-danger)' : 'var(--sd-green-700)';
  const toastEl = document.getElementById('mainToast');
  bootstrap.Toast.getOrCreateInstance(toastEl, { delay: 3200 }).show();
}

/* ============================================================
   NAVIGATION
   ============================================================ */
function showPage(page) {
  document.querySelectorAll('.page-section').forEach(sec => sec.classList.remove('active-page'));
  const target = document.getElementById('page-' + page);
  if (target) target.classList.add('active-page');

  if (page === 'add-scholar' && typeof resetAddScholarWizard === 'function') resetAddScholarWizard();
  if (page === 'pending-approvals' && typeof renderPendingApprovalTable === 'function') renderPendingApprovalTable();

  // Keep Analytics populated on first entry and after updates made elsewhere.
  if (page === 'analytics' && typeof renderAnalyticsWidgets === 'function') {
    try {
      renderAnalyticsWidgets();
      setAnalyticsTab('overview');
    } catch (error) {
      console.error('Analytics render failed:', error);
      document.getElementById('analyticsUnavailableNotice')?.classList.remove('d-none');
      console.warn('Analytics unavailable for the selected period or dataset.');
    }
  }

  document.querySelectorAll('.sidebar-nav .nav-link[data-page]').forEach(link => {
    link.classList.toggle('active', link.getAttribute('data-page') === page);
  });

  // close mobile offcanvas if open
  const offcanvasEl = document.getElementById('mobileSidebar');
  const oc = bootstrap.Offcanvas.getInstance(offcanvasEl);
  if (oc) oc.hide();

  window.scrollTo({ top: 0, behavior: 'instant' in window ? 'instant' : 'auto' });
}

document.querySelectorAll('.sidebar-nav .nav-link[data-page]').forEach(link => {
  link.addEventListener('click', function (e) {
    e.preventDefault();
    showPage(link.getAttribute('data-page'));
  });
});
document.querySelectorAll('.sidebar-nav .nav-link[data-toast]').forEach(link => {
  link.addEventListener('click', function (e) {
    e.preventDefault();
    const key = link.getAttribute('data-toast');
    if (key === 'notifications') showToast('No new notifications', 'You are all caught up for today.');
    const offcanvasEl = document.getElementById('mobileSidebar');
    const oc = bootstrap.Offcanvas.getInstance(offcanvasEl);
    if (oc) oc.hide();
  });
});

const SCHOLARSHIP_TYPE_OPTIONS = Object.entries(SCHOLARSHIP_CATALOG).map(([value, c]) => ({ value, label: c.label }));
function scholarshipTypeOption(value) {
  return SCHOLARSHIP_TYPE_OPTIONS.find(o => o.value === value) || { value, label: value };
}
function scholarshipTypeLabel(value) { return scholarshipTypeOption(value).label; }
function scholarshipTypeMatches(actual, selected) {
  if (!selected || selected === 'all') return true;
  if (selected === '__internal') return !scholarshipHasStipend(actual);   // all DNSC internal (no stipend)
  if (selected === '__external') return scholarshipHasStipend(actual);    // all external (with stipend)
  return actual === selected;
}
const isScholarshipFilterValue = v => v === '__internal' || v === '__external' || SCHOLARSHIP_TYPE_OPTIONS.some(o => o.value === v);
function scholarshipFilterLabel(v) {
  if (!v || v === 'all') return 'all scholarship types';
  if (v === '__internal') return 'All DNSC Internal';
  if (v === '__external') return 'All external';
  return scholarshipTypeLabel(v);
}
const CAMPUS_OPTIONS = Object.freeze(['Main (Panabo Campus)', 'Carmen Campus', 'Samal Campus', 'Talaingod Campus', 'Asuncion Campus']);
function scholarIdOf(scholar) { return scholar?.scholarId || formatScholarId(scholar?.id || 0); }
// Deterministic fallback so any record without an explicit campus still lands in one of the five campuses.
function campusFromKey(key) {
  let h = 0; String(key || '').split('').forEach(c => { h = (h * 31 + c.charCodeAt(0)) >>> 0; });
  return CAMPUS_OPTIONS[h % CAMPUS_OPTIONS.length];
}
function schoolOfScholar(scholar) {
  if (CAMPUS_OPTIONS.includes(scholar?.school)) return scholar.school;
  if (CAMPUS_OPTIONS.includes(scholar?.institute)) return scholar.institute;
  return campusFromKey(scholar?.student_id || scholar?.name);
}
function schoolOfHistory(record) {
  const scholar = scholars.find(s => s.student_id === record?.student_id);
  if (CAMPUS_OPTIONS.includes(record?.school)) return record.school;
  return scholar ? schoolOfScholar(scholar) : campusFromKey(record?.student_id || record?.scholar);
}
function allSchoolOptions() {
  return [...CAMPUS_OPTIONS];
}
function schoolOptionsMarkup(allLabel = 'All schools') {
  return `<option value="">${allLabel}</option>` + allSchoolOptions().map(v => `<option value="${v}">${v}</option>`).join('');
}
function populateSchoolSelect(id, allLabel = 'All schools') {
  const el = document.getElementById(id); if (!el) return;
  const current = el.value;
  el.innerHTML = schoolOptionsMarkup(allLabel);
  el.value = allSchoolOptions().includes(current) ? current : '';
}
function stipendScholarshipOptionsMarkup(allLabel = 'All scholarship types') {
  // Stipend / disbursement filters only list scholarships that actually pay a stipend (DNSC internal ones never do).
  const external = SCHOLARSHIP_TYPE_OPTIONS.filter(o => scholarshipHasStipend(o.value));
  return `<option value="">${allLabel}</option>` + external.map(o => `<option value="${o.value}">${o.label}</option>`).join('');
}
function scholarshipOptionsMarkup(allLabel = 'All scholarship types') {
  // Same grouping as the Admin dashboard: DNSC Internal (no stipend) / External scholarships (with stipend).
  const mk = o => `<option value="${o.value}">${o.label}</option>`;
  const internal = SCHOLARSHIP_TYPE_OPTIONS.filter(o => !scholarshipHasStipend(o.value));
  const external = SCHOLARSHIP_TYPE_OPTIONS.filter(o => scholarshipHasStipend(o.value));
  return `<option value="">${allLabel}</option>`
    + `<optgroup label="DNSC Internal (no stipend)"><option value="__internal">All DNSC Internal</option>${internal.map(mk).join('')}</optgroup>`
    + `<optgroup label="External scholarships (with stipend)"><option value="__external">All external</option>${external.map(mk).join('')}</optgroup>`;
}
function populateCanonicalScholarshipSelect(id, allValue = '') {
  const el = document.getElementById(id); if (!el) return;
  const current = el.value;
  el.innerHTML = scholarshipOptionsMarkup(allValue === 'all' ? 'All scholarship types' : 'All scholarships');
  el.value = isScholarshipFilterValue(current) ? current : allValue;
}

/* ============================================================
   RENDER: DASHBOARD SUMMARY CARDS
   ============================================================ */
function computeDashboardStats() {
  const documentsPending = scholars.reduce((sum, s) =>
    sum + getRequiredDocTypes(s).filter(dt => s.docs[dt.id].status === 'pending' || s.docs[dt.id].status === 'submitted').length, 0);
  const stipendsPending = scholars.filter(s => scholarshipHasStipend(s.scholarship) && !isCredited(s)).length;
  const resubmitScholars = scholars.filter(s => getRequiredDocTypes(s).some(dt => s.docs[dt.id].status === 'requires_update')).length;
  const incompleteScholars = scholars.filter(s => getRequiredDocTypes(s).some(dt => s.docs[dt.id].status === 'not_uploaded')).length;
  const readyForDisbursement = scholars.filter(s => scholarshipHasStipend(s.scholarship) && !isCredited(s) && computeVerification(s) === 'Verified').length;
  const pendingAdminApproval = typeof pendingScholarSubmissions !== 'undefined' ? pendingScholarSubmissions.length : 0;
  const resubmittedDocs = scholars.reduce((sum, s) => sum + getRequiredDocTypes(s).filter(dt => s.docs[dt.id].resubmitted && s.docs[dt.id].status !== 'verified' && s.docs[dt.id].status !== 'requires_update').length, 0);
  return { documentsPending, stipendsPending, resubmitScholars, resubmittedDocs, incompleteScholars, readyForDisbursement, pendingAdminApproval };
}

function renderSummaryCards() {
  if (!document.getElementById('statStrip')) return; // strip is currently commented out in the markup
  const stats = computeDashboardStats();
  const programCount = new Set(scholars.map(s => s.scholarship)).size;

  document.getElementById('statStrip').innerHTML = `
    <div class="stat-item doc-color">
      <div class="stat-item__label">Pending Verification</div>
      <div class="stat-item__value">${stats.documentsPending}</div>
      <div class="stat-item__sub">Documents waiting for review</div>
    </div>
    <div class="stat-item stipend-color">
      <div class="stat-item__label">Ready for Disbursement</div>
      <div class="stat-item__value">${stats.readyForDisbursement}</div>
      <div class="stat-item__sub">Fully verified scholars</div>
    </div>
    <div class="stat-item resub-color">
      <div class="stat-item__label">Correction Requested</div>
      <div class="stat-item__value">${stats.resubmitScholars}</div>
      <div class="stat-item__sub">Awaiting scholar re-upload</div>
    </div>
  `;
}

/* ============================================================
   RENDER: DISBURSEMENT QUEUE WIDGET
   ============================================================ */
const DISBURSEMENT_QUEUE_STATUS_LABELS = {
  released: 'Disbursed / Credited',
  ready: 'Ready for Disbursement'
};
let dqScholarshipFilter = 'all';
let dqTermFilter = 'all';
let dqSchoolFilter = 'all';

function getDisbursementBatchStatus(scholar) {
  // Payout progress intentionally excludes scholars still in document review (and scholarships with no stipend).
  if (!scholarshipHasStipend(scholar.scholarship)) return null;
  if (isCredited(scholar)) return 'released';
  if (computeVerification(scholar) === 'Verified') return 'ready';
  return null;
}

function populateDisbursementQueueFilters() {
  const select = document.getElementById('dqScholarshipFilter');
  if (!select) return;
  const current = select.value || dqScholarshipFilter;
  select.innerHTML = stipendScholarshipOptionsMarkup('All scholarship types').replace('value=""', 'value="all"');
  select.value = isScholarshipFilterValue(current) && current !== '__internal' && current !== '__external' ? current : 'all';
  dqScholarshipFilter = select.value;
  const schoolSelect = document.getElementById('dqSchoolFilter');
  if (schoolSelect) {
    const currentSchool = schoolSelect.value || dqSchoolFilter;
    schoolSelect.innerHTML = schoolOptionsMarkup('All schools').replace('value=""', 'value="all"');
    schoolSelect.value = allSchoolOptions().includes(currentSchool) ? currentSchool : 'all';
    dqSchoolFilter = schoolSelect.value;
  }
}
function updateDisbursementQueueFilters() {
  const scholarshipEl = document.getElementById('dqScholarshipFilter');
  const termEl = document.getElementById('dqTermFilter');
  dqScholarshipFilter = scholarshipEl ? scholarshipEl.value : 'all';
  dqTermFilter = termEl ? termEl.value : 'all';
  dqSchoolFilter = document.getElementById('dqSchoolFilter')?.value || 'all';
  renderDisbursementQueue();
}

function renderDisbursementQueue() {
  populateDisbursementQueueFilters();
  // Progress always describes the full payout-eligible scholarship cohort.
  // The payout-status filter is a breakdown/count filter and must not turn
  // “Ready for Release” into a misleading “Released 0 of 0” metric.
  const eligibleCohort = scholars.filter(s =>
    getDisbursementBatchStatus(s) !== null &&
    scholarshipTypeMatches(s.scholarship, dqScholarshipFilter) &&
    (dqSchoolFilter === 'all' || schoolOfScholar(s) === dqSchoolFilter) &&
    (dqTermFilter === 'all' || (s.academic_year + '|' + s.semester) === dqTermFilter)
  );
  const selected = eligibleCohort;
  const total = eligibleCohort.length;
  const paid = eligibleCohort.filter(s => isCredited(s)).length;
  const pct = total > 0 ? Math.round((paid / total) * 100) : 0;
  const readyToProcess = eligibleCohort.filter(s => getDisbursementBatchStatus(s) === 'ready').length;
  const termLabel = dqTermFilter === 'all' ? 'all semesters' : dqTermFilter.replace('|', ' · ');
  const scholarshipLabel = scholarshipFilterLabel(dqScholarshipFilter);
  const context = document.getElementById('dqFilterContext');
  if (context) context.textContent = `Current selection: ${termLabel} · ${selected.length} verified scholar${selected.length === 1 ? '' : 's'} · ${scholarshipLabel}.`;

  document.getElementById('dqDisbursedLine').innerHTML = `Disbursed: <strong style="color:var(--sd-ink);">${paid}</strong> of ${total} payout-eligible Scholar${total === 1 ? '' : 's'}`;
  document.getElementById('dqPercentLine').textContent = `${pct}% Complete`;
  document.getElementById('dqProgressBar').style.width = pct + '%';
}
/* ============================================================
   RENDER: ATTENTION REQUIRED
   ============================================================ */
let triageTermFilter = '';
let triageScholarshipFilter = '';
let triageSchoolFilter = '';
function renderTriageSummaryCards() {
  const el = document.getElementById('triageSummaryCards');
  if (!el) return;
  populateCanonicalScholarshipSelect('triageScholarshipFilter');
  populateSchoolSelect('triageSchoolFilter');
  const termEl = document.getElementById('triageTermFilter');
  const scholarshipEl = document.getElementById('triageScholarshipFilter');
  triageTermFilter = termEl ? termEl.value : triageTermFilter;
  triageScholarshipFilter = scholarshipEl ? scholarshipEl.value : triageScholarshipFilter;
  triageSchoolFilter = document.getElementById('triageSchoolFilter')?.value || triageSchoolFilter;
  const selectedScholars = scholars.filter(s =>
    (!triageTermFilter || (s.academic_year + '|' + s.semester) === triageTermFilter) &&
    scholarshipTypeMatches(s.scholarship, triageScholarshipFilter)
    && (!triageSchoolFilter || schoolOfScholar(s) === triageSchoolFilter)
  );
  const selectedIds = new Set(selectedScholars.map(s => s.id));
  const pending = (typeof pendingScholarSubmissions !== 'undefined' ? pendingScholarSubmissions : []).filter(s =>
    (!triageTermFilter || (s.academic_year + '|' + s.semester) === triageTermFilter) &&
    scholarshipTypeMatches(s.scholarship, triageScholarshipFilter)
    && (!triageSchoolFilter || schoolOfScholar(s) === triageSchoolFilter)
  );
  const label = triageTermFilter ? triageTermFilter.replace('|', ' · ') : 'All semesters';
  el.innerHTML = `
    <div class="triage-metric-card triage-metric-total" data-page="scholars" role="button" tabindex="0" aria-label="View all scholars" onclick="showPage('scholars')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();showPage('scholars');}">
      <div class="triage-metric-icon"><i class="bi bi-people-fill"></i></div>
      <div><div class="triage-metric-label">Total Scholars</div><div class="triage-metric-value">${selectedScholars.length}</div></div>
    </div>
    <div class="triage-metric-card triage-metric-pending" data-page="pending-approvals" role="button" tabindex="0" aria-label="View pending admin approval scholars" onclick="showPage('pending-approvals')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();showPage('pending-approvals');}">
      <div class="triage-metric-icon"><i class="bi bi-person-check-fill"></i></div>
      <div><div class="triage-metric-label">Pending Admin Approval</div><div class="triage-metric-value">${pending.length}</div></div>
    </div>`;
}
function updateTriageFilters() { renderTriageSummaryCards(); }


['triageScholarshipFilter', 'triageSchoolFilter'].forEach(id => document.getElementById(id)?.addEventListener('change', updateTriageFilters));

function renderAttentionRequired() {
  renderTriageSummaryCards();
  const stats = computeDashboardStats();
  const resubmitList = scholars.filter(s => getRequiredDocTypes(s).some(dt => s.docs[dt.id].status === 'requires_update'));

  const N = n => `<span class="aq-num">${n}</span>`;
  const items = [
    { dot: 'amber', text: `${N(stats.documentsPending)} document${stats.documentsPending === 1 ? '' : 's'} waiting for verification`, btn: 'Process Queue', page: 'document-verification' },
    { dot: 'red', text: `${N(stats.resubmittedDocs)} document${stats.resubmittedDocs === 1 ? ' has' : 's have'} been resubmitted`, btn: 'Review', page: 'document-verification' },
    { dot: 'amber', text: `${N(stats.readyForDisbursement)} scholar${stats.readyForDisbursement === 1 ? '' : 's'} ready for stipend disbursement`, btn: 'Disburse Funds', page: 'stipend-release' }
  ];

  document.getElementById('attentionList').innerHTML = items.map(it => `
    <div class="aq-row">
      <div class="aq-left">
        <span class="aq-dot aq-dot-${it.dot}"></span>
        <span class="aq-text">${it.text}</span>
      </div>
      <button type="button" class="aq-btn" onclick="${it.action || `showPage('${it.page}')`}">${it.btn}</button>
    </div>
  `).join('');
}

/* ============================================================
   RENDER: ANALYTICS — SCHOLARS PER SCHOLARSHIP TYPE
   ============================================================ */
function niceAxisScale(maxValue, targetTicks) {
  if (maxValue <= 0) return { max: targetTicks, step: 1 };
  const rawStep = maxValue / (targetTicks - 1);
  const exponent = Math.floor(Math.log10(rawStep));
  const fraction = rawStep / Math.pow(10, exponent);
  let niceFraction;
  if (fraction <= 1) niceFraction = 1;
  else if (fraction <= 2) niceFraction = 2;
  else if (fraction <= 5) niceFraction = 5;
  else niceFraction = 10;
  const step = Math.max(1, niceFraction * Math.pow(10, exponent));
  const max = Math.ceil(maxValue / step) * step;
  return { max, step };
}

function analyticsEmptyState(title, message, icon = 'bi-bar-chart-line', action) {
  const btn = action
    ? `<button type="button" class="btn btn-sm btn-scholarship-green mt-2" onclick="showPage('${action.page}')"><i class="bi ${action.icon || 'bi-arrow-right'} me-1" aria-hidden="true"></i>${action.label}</button>`
    : '';
  return `<div class="analytics-empty-state" role="status">
    <i class="bi ${icon}" aria-hidden="true"></i>
    <strong>${title}</strong>
    <span>${message}</span>${btn}
  </div>`;
}
const ANALYTICS_ADD_SCHOLAR_CTA = { page: 'add-scholar', label: 'Add a scholar', icon: 'bi-person-plus' };

function setAnalyticsEmpty(id, title, message, icon, action) {
  const el = document.getElementById(id);
  if (el) el.innerHTML = analyticsEmptyState(title, message, icon, action);
}

function renderAnalytics() {
  const rawCounts = AD.yearCounts || {};
  const types = ['1st Year', '2nd Year', '3rd Year', '4th Year'];
  Object.keys(rawCounts).forEach(k => { if (!types.includes(k) && Number(rawCounts[k]) > 0) types.push(k); });
  const counts = Object.fromEntries(types.map(t => [t, Number(rawCounts[t] || 0)]));
  const maxCount = Math.max(...types.map(t => counts[t]), 1);

  if (!AD.totalScholars) {
    setAnalyticsEmpty('analyticsBars', 'No scholars enrolled yet', 'Once scholars are added, you\u2019ll see how they are spread across each year level here.', 'bi-bar-chart-line', ANALYTICS_ADD_SCHOLAR_CTA);
    const y = document.getElementById('analyticsYAxis'); if (y) y.innerHTML = '';
    const g = document.getElementById('analyticsGridlines'); if (g) g.innerHTML = '';
    const x = document.getElementById('analyticsXLabels'); if (x) x.innerHTML = '';
    const tb = document.getElementById('analyticsScholarshipTableBody'); if (tb) tb.innerHTML = '';
    return;
  }

  const { max: axisMax, step } = niceAxisScale(maxCount, 5);
  const ticks = [];
  for (let v = axisMax; v >= 0; v -= step) ticks.push(v);

  document.getElementById('analyticsYAxis').innerHTML = ticks.map(t => `<span class="chart-tick">${t}</span>`).join('');
  document.getElementById('analyticsGridlines').innerHTML = ticks.map(() => `<div class="gridline"></div>`).join('');

  document.getElementById('analyticsBars').innerHTML = types.map(t => {
    const heightPct = Math.round((counts[t] / axisMax) * 100);
    const sharePct = Math.round((counts[t] / (AD.totalScholars || 1)) * 100);
    const label = `${t}: ${counts[t]} scholar${counts[t] === 1 ? '' : 's'} (${sharePct}%)`;
    const canDrill = AD.isLive && YEAR_LEVEL_LABELS_LOOKUP(t) !== undefined;
    const safe = t.replace(/'/g, "\\'");
    const barDrill = canDrill
      ? `role="button" tabindex="0" aria-label="${label}. Activate to view these scholars."
          onclick="filterByCourseYearSegment('year', '${safe}')"
          onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();filterByCourseYearSegment('year', '${safe}');}"`
      : `role="img" tabindex="0" aria-label="${label}"`;
    const barCls = counts[t] > 0 ? '' : 'chart-bar-empty';
    return `
      <div class="chart-bar-col">
        <div class="chart-bar ${barCls}" style="height:${heightPct}%;" data-tooltip="${label}" aria-describedby="chartFloatTooltip" onmouseenter="showChartFloatTooltip(event, this.getAttribute('data-tooltip'))" onmousemove="showChartFloatTooltip(event, this.getAttribute('data-tooltip'))" onmouseleave="hideChartFloatTooltip()" onfocus="showChartFloatTooltip(event, this.getAttribute('data-tooltip'))" onblur="hideChartFloatTooltip()" ${barDrill}></div>
      </div>`;
  }).join('');

  const tableBody = document.getElementById('analyticsScholarshipTableBody');
  if (tableBody) {
    tableBody.innerHTML = types.map(t => `<tr><td>${t}</td><td>${counts[t]}</td><td>${Math.round((counts[t] / (AD.totalScholars || 1)) * 100)}%</td></tr>`).join('');
  }

  document.getElementById('analyticsXLabels').innerHTML = types.map(t => `<span class="chart-tick">${t}</span>`).join('');
}
function YEAR_LEVEL_LABELS_LOOKUP(label) {
  return Object.keys(YEAR_LEVEL_LABELS).find(k => YEAR_LEVEL_LABELS[k] === label);
}

/* ============================================================
   RENDER: SCHOLARS BY PROGRAM / YEAR LEVEL (toggle doughnut chart)
   ============================================================ */
const YEAR_LEVEL_LABELS = { 1: '1st Year', 2: '2nd Year', 3: '3rd Year', 4: '4th Year' };
let courseYearView = 'institute'; // 'institute' | 'program'

// Categorical sequence drawn from the shared green/gold data-viz palette
// (see :root — --chart-cat-1..8), so every chart on this page pulls from
// the same semantic source instead of one-off colors.
const DOUGHNUT_COLORS = [
  'var(--chart-cat-1)', 'var(--chart-cat-2)', 'var(--chart-cat-3)', 'var(--chart-cat-4)',
  'var(--chart-cat-5)', 'var(--chart-cat-6)', 'var(--chart-cat-7)', 'var(--chart-cat-8)'
];

const PROGRAM_PALETTE = [
  '#1f6b3a','#d4a017','#4c9f70','#8a5a00','#0f3d24','#e8c766','#7fbf9a','#b5651d','#2e8b8b',
  '#6b8e23','#c0392b','#5b7db1','#8e6bb0','#e07a9a','#3d5a80','#a3b18a','#f2a541','#7a4e2d'
];
function doughnutColor(i) { return PROGRAM_PALETTE[i % PROGRAM_PALETTE.length]; }
function setCourseYearView(mode) {
  courseYearView = mode;
  renderCourseYearChart();
}

function setAnalyticsTab(tab) {
  const overviewPane = document.getElementById('analyticsPaneOverview');
  const operationsPane = document.getElementById('analyticsPaneOperations');
  const overviewBtn = document.getElementById('anTabOverview');
  const operationsBtn = document.getElementById('anTabOperations');
  const isOverview = tab === 'overview';
  overviewPane.style.display = isOverview ? '' : 'none';
  operationsPane.style.display = isOverview ? 'none' : '';
  overviewBtn.classList.toggle('active', isOverview);
  operationsBtn.classList.toggle('active', !isOverview);
  overviewBtn.setAttribute('aria-selected', String(isOverview));
  operationsBtn.setAttribute('aria-selected', String(!isOverview));
  overviewBtn.tabIndex = isOverview ? 0 : -1;
  operationsBtn.tabIndex = isOverview ? -1 : 0;
  if (typeof hideChartFloatTooltip === 'function') hideChartFloatTooltip();
}
document.addEventListener('keydown', function (e) {
  const tabBtn = e.target.closest && e.target.closest('.analytics-subtabs [role="tab"]');
  if (!tabBtn || !['ArrowLeft','ArrowRight','Home','End'].includes(e.key)) return;
  e.preventDefault();
  const next = (e.key === 'ArrowLeft' || e.key === 'Home') ? 'overview' : 'operations';
  setAnalyticsTab(next);
  document.getElementById(next === 'overview' ? 'anTabOverview' : 'anTabOperations').focus();
});

function renderCourseYearChart() {
  let labels, counts;

  if (courseYearView === 'institute') {
    counts = {};
    Object.entries(AD.courseCounts || {}).forEach(([prog, n]) => {
      const inst = instituteOfProgram(prog);
      counts[inst] = (counts[inst] || 0) + Number(n || 0);
    });
    labels = DNSC_INSTITUTES.map(i => i.name).filter(n => counts[n] != null);
    if (counts['Unassigned']) labels.push('Unassigned');
  } else {
    counts = AD.courseCounts || {};
    // Fixed official program order; unknown programs go last.
    labels = DNSC_PROGRAMS.filter(p => counts[p] != null);
    Object.keys(counts).forEach(p => { if (!labels.includes(p)) labels.push(p); });
  }

  const total = AD.totalScholars || 0;
  labels = labels.filter(l => Number(counts[l]) > 0);
  // Color is tied to the program's fixed position in the official list so it never shifts.
  const colorKeys = courseYearView === 'institute' ? DNSC_INSTITUTES.map(i => i.name) : DNSC_PROGRAMS;
  const colorIndex = l => { const k = colorKeys.indexOf(l); return k >= 0 ? k : colorKeys.length + labels.indexOf(l); };
  const chartTotal = labels.reduce((sum, l) => sum + Number(counts[l] || 0), 0);
  const size = 190, r = 74, cx = size / 2, cy = size / 2, strokeWidth = 26;
  document.getElementById('cySubtext').textContent = courseYearView === 'institute'
    ? 'Enrolled scholars grouped by institute.'
    : 'Enrolled scholars grouped by degree program.';
  document.getElementById('cyTogglePrograms').classList.toggle('active', courseYearView === 'program');
  document.getElementById('cyToggleInstitute').classList.toggle('active', courseYearView === 'institute');
  document.getElementById('cyTogglePrograms').setAttribute('aria-pressed', String(courseYearView === 'program'));
  document.getElementById('cyToggleInstitute').setAttribute('aria-pressed', String(courseYearView === 'institute'));
  const capEl = document.getElementById('cyDoughnutTableCaption');
  if (capEl) capEl.textContent = courseYearView === 'institute' ? 'Scholars by institute' : 'Scholars by program';
  if (!labels.length || total === 0) {
    const svg = document.getElementById('cyDoughnutSvg');
    if (svg) svg.innerHTML = analyticsEmptyState('No breakdown to show yet', `Add scholars to see them grouped by ${courseYearView === 'institute' ? 'institute' : 'program'}.`, 'bi-pie-chart', ANALYTICS_ADD_SCHOLAR_CTA);
    document.querySelector('#page-analytics .doughnut-wrap')?.classList.add('is-empty');
    const legend = document.getElementById('cyLegend'); if (legend) legend.innerHTML = '';
    const center = document.getElementById('cyCenterValue'); if (center) center.textContent = '0';
    const body = document.getElementById('cyDoughnutTableBody'); if (body) body.innerHTML = '';
    return;
  }
  document.querySelector('#page-analytics .doughnut-wrap')?.classList.remove('is-empty');
  const circumference = 2 * Math.PI * r;

  let cumulative = 0;
  const segments = labels.map((l, i) => {
    const value = counts[l];
    const pct = chartTotal > 0 ? value / chartTotal : 0;
    const dash = pct * circumference;
    const seg = { label: l, value, pct, dash, offset: cumulative, color: doughnutColor(colorIndex(l)), idx: i };
    cumulative += dash;
    return seg;
  });

  const arcs = segments.filter(s => s.value > 0).map((s, idx) => {
    const label = `${s.label}: ${s.value} scholar${s.value === 1 ? '' : 's'} (${Math.round(s.pct * 100)}%)`;
    const segDrill = AD.isLive
      ? `role="button" tabindex="0" aria-label="${label}. Activate to view these scholars."
         onclick="filterByCourseYearSegment('${courseYearView}', '${s.label.replace(/'/g, "\\'")}')"
         onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();filterByCourseYearSegment('${courseYearView}', '${s.label.replace(/'/g, "\\'")}');}"`
      : `role="img" tabindex="0" aria-label="${label} — historical period, drill-down unavailable." aria-valuemin="0" aria-valuemax="${AD.totalScholars || 1}" aria-valuenow="${s.value}"`;
    return `
    <circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="${s.color}" stroke-width="${strokeWidth}"
      stroke-dasharray="${s.dash.toFixed(3)} ${(circumference - s.dash).toFixed(3)}"
      stroke-dashoffset="${(-s.offset).toFixed(3)}"
      transform="rotate(-90 ${cx} ${cy})"
      data-seg-idx="${s.idx}"
      ${segDrill}
      data-tooltip="${label}" aria-describedby="chartFloatTooltip"
      onmouseenter="showChartFloatTooltip(event, this.getAttribute('data-tooltip')); highlightDoughnutSegment(${s.idx});" onmousemove="showChartFloatTooltip(event, this.getAttribute('data-tooltip'))" onmouseleave="hideChartFloatTooltip(); clearDoughnutHighlight();"
      onfocus="showChartFloatTooltip(event, this.getAttribute('data-tooltip')); highlightDoughnutSegment(${s.idx});" onblur="hideChartFloatTooltip(); clearDoughnutHighlight();">
      <title>${label}</title>
    </circle>`;
  }).join('');

  document.getElementById('cyDoughnutSvg').innerHTML = `
    <svg viewBox="0 0 ${size} ${size}" role="img" aria-label="Scholars by ${courseYearView === 'institute' ? 'institute' : 'program'}" aria-describedby="cyDoughnutDescription">
      <circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="var(--sd-border)" stroke-width="${strokeWidth}" />
      ${arcs}
    </svg>`;

  document.getElementById('cyCenterValue').textContent = chartTotal;

  document.getElementById('cyLegend').innerHTML = segments.map(s => {
    const label = `${s.label}: ${s.value} scholar${s.value === 1 ? '' : 's'} (${Math.round(s.pct * 100)}%)`;
    const rowDrill = AD.isLive
      ? `role="button" tabindex="0" title="${label}" aria-label="${label}. Activate to view these scholars."
         onclick="filterByCourseYearSegment('${courseYearView}', '${s.label.replace(/'/g, "\\'")}')"
         onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();filterByCourseYearSegment('${courseYearView}', '${s.label.replace(/'/g, "\\'")}');}"`
      : `role="img" tabindex="0" title="${label}" aria-label="${label} — historical period, drill-down unavailable."`;
    return `
    <div class="doughnut-legend-row" ${rowDrill}
      onmouseenter="highlightDoughnutSegment(${s.idx})" onmouseleave="clearDoughnutHighlight()"
      onfocus="highlightDoughnutSegment(${s.idx})" onblur="clearDoughnutHighlight()">
      <span class="dl-swatch" style="background:${s.color};"></span>
      <span class="dl-label">${s.label}</span>
      <span class="dl-value">${s.value} <span class="dl-pct">(${Math.round(s.pct * 100)}%)</span></span>
    </div>`;
  }).join('');

  document.getElementById('cySubtext').textContent = courseYearView === 'institute'
    ? 'Enrolled scholars grouped by institute.'
    : 'Enrolled scholars grouped by degree program.';

  // Accessible data fallback for the SVG doughnut above — same segments,
  // as a real table for screen readers.
  const tableCaption = document.getElementById('cyDoughnutTableCaption');
  if (tableCaption) {
    tableCaption.textContent = courseYearView === 'institute'
      ? 'Scholars by institute'
      : 'Scholars by program';
  }
  const tableBody = document.getElementById('cyDoughnutTableBody');
  if (tableBody) {
    tableBody.innerHTML = segments.map(s => `
      <tr><td>${s.label}</td><td>${s.value}</td><td>${Math.round(s.pct * 100)}%</td></tr>`).join('');
  }

  document.getElementById('cyTogglePrograms').classList.toggle('active', courseYearView === 'program');
  document.getElementById('cyToggleInstitute').classList.toggle('active', courseYearView === 'institute');
}

/* ============================================================
   RENDER: DISBURSEMENT DISTRIBUTION (Overview tab — toggle)
   Line chart of scholars credited, derived from disbursementHistory:
   - Monthly: scholars credited each month.
   - Semester: scholars credited each academic term.
   ============================================================ */
const MONTH_NAMES = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
function releasedRecords() {
  return disbursementHistory.filter(h => h.status === 'Released' && h.date).map(h => ({ ...h, d: new Date(h.date) })).filter(h => !isNaN(h.d));
}
// Scholars credited per month for the n months ending at (endYear, endMonth0), derived from disbursement history.
function buildMonthlySeries(endYear, endMonth0, n) {
  const recs = releasedRecords(), out = [];
  for (let i = n - 1; i >= 0; i--) {
    const dt = new Date(endYear, endMonth0 - i, 1);
    const count = recs.filter(r => r.d.getFullYear() === dt.getFullYear() && r.d.getMonth() === dt.getMonth()).length;
    const m = dt.getMonth();
    const note = count === 0 ? 'No stipend run this month' : (m === 7 ? 'New term onboarding run' : 'Regular monthly stipend run');
    out.push({ label: MONTH_NAMES[m] + ' ' + dt.getFullYear(), count, note });
  }
  return out;
}
// Scholars credited per semester, derived from disbursement history.
function buildTermSeries() {
  const recs = releasedRecords();
  const terms = [['2nd Semester','2024–2025'],['1st Semester','2025–2026'],['2nd Semester','2025–2026'],['1st Semester', CURRENT_AY]];
  return terms.map(([sem, ay]) => {
    const count = recs.filter(r => r.semester === sem && r.academic_year === ay).length;
    return { label: sem.replace('Semester','Sem') + ' ' + ay, count, note: count ? 'Stipends credited this semester' : 'No stipends credited yet' };
  });
}
const MONTHLY_CADENCE = buildMonthlySeries(2026, 8, 6);
const TERM_MILESTONES = buildTermSeries();
let timeSeriesView = 'monthly'; // 'monthly' | 'term'

function setTimeSeriesView(mode) {
  timeSeriesView = mode;
  renderTimeSeriesChart();
}

function renderTimeSeriesChart() {
  const isMonthly = timeSeriesView === 'monthly';
  const data = (isMonthly ? AD.monthly : AD.termMilestones) || [];
  const maxCount = Math.max(...data.map(d => d.count), 0);
  const host = document.getElementById('tsLineChart');
  if (!host) return;

  document.getElementById('tsSubtext').textContent = isMonthly
    ? `Scholars credited per month — most recent ${data.length || 0} months.`
    : `Scholars credited per semester — most recent ${data.length || 0} semesters.`;
  document.getElementById('tsDemoNote').textContent = 'Sample / demo data — based on disbursement history records';
  document.getElementById('tsToggleMonthly').classList.toggle('active', isMonthly);
  document.getElementById('tsToggleTerm').classList.toggle('active', !isMonthly);
  document.getElementById('tsToggleMonthly').setAttribute('aria-pressed', String(isMonthly));
  document.getElementById('tsToggleTerm').setAttribute('aria-pressed', String(!isMonthly));

  if (!data.length || maxCount === 0) {
    host.innerHTML = analyticsEmptyState('No disbursement activity yet', AD.totalScholars ? 'No stipends have been credited in this view yet. Credited scholars will appear here after the first disbursement.' : 'Disbursement activity appears here once scholars are added and their stipends are disbursed.', 'bi-graph-up', AD.totalScholars ? { page: 'stipend-release', label: 'Go to Stipend Disbursement', icon: 'bi-cash-coin' } : ANALYTICS_ADD_SCHOLAR_CTA);
    return;
  }

  const W = Math.max(320, Math.round(host.clientWidth || 640)), H = 220, padL = 40, padR = 24, padT = 26, padB = 38;
  const plotW = W - padL - padR, plotH = H - padT - padB;
  const { max: axisMax, step } = niceAxisScale(maxCount, 5);
  const color = isMonthly ? 'var(--sd-green-700)' : 'var(--sd-gold)';
  const xAt = i => data.length === 1 ? padL + plotW / 2 : padL + (plotW * i) / (data.length - 1);
  const yAt = v => padT + plotH - (v / axisMax) * plotH;

  let grid = '';
  for (let v = 0; v <= axisMax; v += step) {
    grid += `<line class="ts-grid" x1="${padL}" x2="${W - padR}" y1="${yAt(v)}" y2="${yAt(v)}"/>` +
            `<text class="ts-axis-text" x="${padL - 10}" y="${yAt(v) + 4}" text-anchor="end">${v}</text>`;
  }
  const pts = data.map((d, i) => ({ x: xAt(i), y: yAt(d.count), d }));
  const linePath = pts.map((p, i) => `${i ? 'L' : 'M'}${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ');
  const areaPath = `${linePath} L${pts[pts.length - 1].x.toFixed(1)} ${yAt(0)} L${pts[0].x.toFixed(1)} ${yAt(0)} Z`;
  const gid = 'tsFill' + (isMonthly ? 'M' : 'S');

  const dots = pts.map((p, i) => {
    const d = p.d;
    const isSelected = !isMonthly && i === AD.selectedTermIndex;
    const note = isSelected ? d.note + ' — selected period' : d.note;
    const label = `${d.label}: ${d.count} scholar${d.count === 1 ? '' : 's'} credited — ${note}`;
    return `<circle class="ts-dot${d.count === 0 ? ' is-zero' : ''}" cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="${isSelected ? 7 : 5.5}" fill="${color}"
        role="img" tabindex="0" aria-label="${label}" data-tooltip="${label}" aria-describedby="chartFloatTooltip"
        onmouseenter="showChartFloatTooltip(event, this.getAttribute('data-tooltip'))" onmousemove="showChartFloatTooltip(event, this.getAttribute('data-tooltip'))" onmouseleave="hideChartFloatTooltip()"
        onfocus="showChartFloatTooltip(event, this.getAttribute('data-tooltip'))" onblur="hideChartFloatTooltip()"/>` +
      `<text class="ts-val-text" x="${p.x.toFixed(1)}" y="${(p.y - 13).toFixed(1)}" text-anchor="middle">${d.count}</text>` +
      `<text class="ts-axis-text" x="${p.x.toFixed(1)}" y="${H - padB + 24}" text-anchor="middle">${d.label}</text>`;
  }).join('');

  host.innerHTML = `
    <svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" role="img" aria-label="Line chart of scholars credited per ${isMonthly ? 'month' : 'semester'}">
      <defs><linearGradient id="${gid}" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="${color}" stop-opacity=".22"/><stop offset="100%" stop-color="${color}" stop-opacity="0"/></linearGradient></defs>
      ${grid}
      <path d="${areaPath}" fill="url(#${gid})"/>
      <path class="ts-line" d="${linePath}" stroke="${color}"/>
      ${dots}
    </svg>`;
}

let _tsResizeT;
window.addEventListener('resize', () => { clearTimeout(_tsResizeT); _tsResizeT = setTimeout(() => { if (AD && document.getElementById('tsLineChart')?.clientWidth) renderTimeSeriesChart(); }, 150); });

/* ============================================================
   CHART INTERACTIVITY: floating tooltip + click-to-drilldown
   ============================================================ */
function showChartFloatTooltip(evt, text) {
  const el = evt.currentTarget;
  text = String(text || el.getAttribute('data-tooltip') || '');
  el.setAttribute('aria-describedby', 'chartFloatTooltip');
  if (!text) return;
  const tip = document.getElementById('chartFloatTooltip');
  tip.textContent = text;
  tip.setAttribute('aria-hidden', 'false');
  let x, y;
  if (evt.type === 'focus') {
    const rect = el.getBoundingClientRect();
    x = rect.left + rect.width / 2;
    y = rect.top;
  } else {
    x = evt.clientX;
    y = evt.clientY - 8;
  }
  tip.classList.add('is-visible');
  const half = (tip.offsetWidth || 0) / 2 + 8;
  x = Math.min(Math.max(x, half), window.innerWidth - half);
  y = Math.max(y, (tip.offsetHeight || 0) + 16);
  tip.style.left = x + 'px';
  tip.style.top = y + 'px';
}
function hideChartFloatTooltip() {
  const tip = document.getElementById('chartFloatTooltip');
  tip.classList.remove('is-visible');
  tip.setAttribute('aria-hidden', 'true');
}

// Single-touch taps don't reliably fire :hover / mouseenter, so chart bars
// and doughnut segments get an explicit tap-to-select state instead: the
// first tap selects the element and shows its tooltip; a second tap on that
// same element lets its normal click action (filter / drilldown) proceed.
// Tapping elsewhere, or a different chart element, clears the selection.
function initChartTouchSupport() {
  const TAP_SELECTOR = '.chart-bar[data-tooltip], .doughnut-svg-holder circle[data-seg-idx]';

  function deselect(el) {
    el.classList.remove('is-tap-selected');
    if (el.tagName === 'circle') clearDoughnutHighlight();
  }

  let tapDismissTimer = null;
  function select(el) {
    document.querySelectorAll('.is-tap-selected').forEach(prev => { if (prev !== el) deselect(prev); });
    el.classList.add('is-tap-selected');
    clearTimeout(tapDismissTimer);
    tapDismissTimer = setTimeout(() => {
      document.querySelectorAll('.is-tap-selected').forEach(deselect);
      hideChartFloatTooltip();
    }, 5000);
    if (el.tagName === 'circle') {
      highlightDoughnutSegment(el.getAttribute('data-seg-idx'));
      showChartFloatTooltip({ currentTarget: el, type: 'focus' });
    }
  }

  document.addEventListener('touchstart', evt => {
    const el = evt.target.closest(TAP_SELECTOR);
    if (!el) {
      document.querySelectorAll('.is-tap-selected').forEach(deselect);
      hideChartFloatTooltip();
      return;
    }
    if (!el.classList.contains('is-tap-selected')) {
      select(el);
      if (el.hasAttribute('onclick')) el.dataset.suppressNextTap = 'true';
    }
  }, { passive: true });

  // A tap's subsequent click is suppressed the first time (so the officer
  // can read the tooltip before it triggers filter/drilldown); the same
  // element's next click is allowed through and clears the selection.
  document.addEventListener('click', evt => {
    const el = evt.target.closest(TAP_SELECTOR);
    if (!el) return;
    if (el.dataset.suppressNextTap === 'true') {
      delete el.dataset.suppressNextTap;
      evt.preventDefault();
      evt.stopPropagation();
      return;
    }
    deselect(el);
    if (el.tagName === 'circle') hideChartFloatTooltip();
  }, true);
}

// Legend <-> doughnut slice linking: hovering/focusing a legend row isolates
// its matching arc on the chart (dims the rest) and vice versa isn't needed
// since the arcs already carry their own hover/focus tooltip + highlight.
function highlightDoughnutSegment(idx) {
  const svg = document.querySelector('#cyDoughnutSvg svg');
  if (!svg) return;
  svg.classList.add('is-highlighting');
  svg.querySelectorAll('circle[data-seg-idx]').forEach(c => {
    c.classList.toggle('is-active-segment', c.getAttribute('data-seg-idx') === String(idx));
  });
}
function clearDoughnutHighlight() {
  const svg = document.querySelector('#cyDoughnutSvg svg');
  if (!svg) return;
  svg.classList.remove('is-highlighting');
  svg.querySelectorAll('circle[data-seg-idx]').forEach(c => c.classList.remove('is-active-segment'));
}

// Scholars page can be pre-filtered by a chart drilldown (see filterByScholarshipType
// / filterByCourseYearSegment below and the "View in Scholars Table" modal button).
let scChartFilter = null; // { type: 'scholarship'|'course'|'yearLevel', value: string, label: string }
let scSortKey = 'name';
let scSortDir = 'asc'; // 'asc' | 'desc'
let scCurrentPage = 1;
let scPageSize = 10;

function groupModalRows(list) {
  const emptyState = `<tr><td colspan="5" class="text-center text-muted-custom py-4">No scholars in this group.</td></tr>`;
  return list.length ? list.map(s => `
    <tr class="row-hoverable">
      <td>
        <div class="scholar-cell">
          <div class="row-avatar" style="background:${avatarColor(s.id)};">${initials(s.name)}</div>
          <div class="sc-name">${s.name}</div>
        </div>
      </td>
      <td>${s.student_id}</td>
      <td>${s.program_name}</td>
      <td>${s.scholarship.replace(' Scholarship', '')}</td>
      <td>${YEAR_LEVEL_LABELS[s.yearLevel] || '—'}</td>
    </tr>`).join('') : emptyState;
}

function openGroupModal(title, subtext, list, chartFilter) {
  document.getElementById('groupModalTitle').innerHTML = `<i class="bi bi-people-fill me-2" style="color:var(--sd-green-700);"></i>${title}`;
  document.getElementById('groupModalSubtext').textContent = subtext;
  document.getElementById('groupModalTableBody').innerHTML = groupModalRows(list);
  document.getElementById('groupModalViewAllBtn').onclick = function () {
    scChartFilter = chartFilter;
    scCurrentPage = 1;
    bootstrap.Modal.getInstance(document.getElementById('groupModal')).hide();
    showPage('scholars');
    renderScChartFilterChip();
    renderScholarsTable();
  };
  bootstrap.Modal.getOrCreateInstance(document.getElementById('groupModal')).show();
}

function filterByScholarshipType(type) {
  const list = scholars.filter(s => s.scholarship === type);
  const pct = Math.round((list.length / (scholars.length || 1)) * 100);
  openGroupModal(
    type,
    `${list.length} scholar${list.length === 1 ? '' : 's'} (${pct}% of all scholars) currently hold this scholarship.`,
    list,
    { type: 'scholarship', value: type, label: type }
  );
}

function filterByCourseYearSegment(mode, value) {
  let list, label;
  if (mode === 'institute') {
    list = scholars.filter(s => instituteOfProgram(s.program_name) === value);
    label = value;
    var filterDef = { type: 'institute', value: value, label: label };
  } else if (mode === 'year') {
    const yearNum = Object.keys(YEAR_LEVEL_LABELS).find(k => YEAR_LEVEL_LABELS[k] === value);
    list = scholars.filter(s => String(s.yearLevel) === String(yearNum));
    label = value;
    var filterDef = { type: 'yearLevel', value: yearNum, label: label };
  } else {
    list = scholars.filter(s => s.program_name === value);
    label = value;
    var filterDef = { type: 'course', value: value, label: label };
  }
  const pct = Math.round((list.length / (scholars.length || 1)) * 100);
  openGroupModal(
    label,
    `${list.length} scholar${list.length === 1 ? '' : 's'} (${pct}% of all scholars) are in this group.`,
    list,
    filterDef
  );
}

function renderScChartFilterChip() {
  const bar = document.getElementById('scChartFilterChip');
  if (!bar) return;
  if (!scChartFilter) { bar.innerHTML = ''; bar.classList.add('d-none'); return; }
  bar.classList.remove('d-none');
  bar.innerHTML = `
    <span class="status-pill pill-green" style="cursor:default;">
      <i class="bi bi-funnel-fill"></i> Filtered: ${scChartFilter.label}
      <button type="button" class="btn-close btn-close-sm ms-2" aria-label="Clear chart filter" onclick="clearScChartFilter()" style="font-size:0.6rem; vertical-align:middle;"></button>
    </span>`;
}
function clearScChartFilter() {
  scChartFilter = null;
  scCurrentPage = 1;
  renderScChartFilterChip();
  renderScholarsTable();
}

