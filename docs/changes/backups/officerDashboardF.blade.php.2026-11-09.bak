              <input type="text" class="form-control" id="dvSearch" placeholder="Name or Student ID">
            </div>
            <div class="col-6 col-lg-2">
              <label class="form-label mb-0" for="dvSemester">AY / Semester</label>
              <select class="form-select" id="dvSemester"><option value="2026–2027|1st Semester" selected>1st Semester 2026–2027 (current)</option><option value="2025–2026|2nd Semester">2nd Semester 2025–2026</option><option value="2025–2026|1st Semester">1st Semester 2025–2026</option><option value="">All semesters</option></select>
            </div>
            <div class="col-6 col-lg-2">
              <label class="form-label mb-0" for="dvScholarship">Scholarship</label>
              <select class="form-select" id="dvScholarship"><option value="">All scholarships</option><optgroup label="DNSC Internal (no stipend)"><option value="__internal">All DNSC Internal</option><option value="DNSC Academic Scholarship">DNSC Academic Scholarship</option><option value="DNSC GIA Category A">DNSC Grant-in-Aid (GIA) – Category A</option><option value="DNSC GIA Category B">DNSC Grant-in-Aid (GIA) – Category B</option><option value="DNSC SA Category C">DNSC Student Assistant (SA) – Category C</option></optgroup><optgroup label="External scholarships (with stipend)"><option value="__external">All external</option><option value="CHED TDP">CHED TDP</option><option value="DOST-SEI">DOST-SEI Scholarship</option><option value="CHED TES">CHED TES</option><option value="Bagong Pilipinas Scholarship Program">Bagong Pilipinas (BPMSP)</option><option value="CHED Merit Scholarship Program">CHED Merit (CMSP)</option><option value="GrabScholar">GrabScholar</option><option value="cebuana">Cebuana Lhuillier (CLFI)</option></optgroup></select>
            </div>
            <div class="col-6 col-lg-2">
              <label class="form-label mb-0" for="dvSchool">School</label>
              <select class="form-select" id="dvSchool"><option value="">All schools</option></select>
            </div>
            <div class="col-6 col-lg-2">
              <label class="form-label mb-0" for="dvStatus">Status</label>
              <select class="form-select" id="dvStatus">
                <option value="">All statuses</option>
                <option value="Verified">Verified</option>
                <option value="Needs Review">Needs Review</option>
                <option value="Pending">Pending</option>
              </select>
            </div>
            <div class="col-6 col-lg-auto dv-stale-row">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="dvStaleOnly">
                <label class="form-check-label small" for="dvStaleOnly" title="Show only scholars queued for 48 hours or more">
                  <i class="bi bi-alarm-fill" style="color:var(--sd-green-700);"></i>
                  Stale 48h+ only
                </label>
              </div>
            </div>
          </div>
        </div>
        <div class="table-app-wrap table-responsive-wrap">
          <table class="table-app">
            <thead>
              <tr id="dvTableHeadRow">
                <th tabindex="0" role="button" class="th-sortable" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}" data-sort-key="name">Scholar <i class="bi bi-arrow-down-up sort-icon"></i></th>
                <th tabindex="0" role="button" class="th-sortable" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}" data-sort-key="student_id">Student ID <i class="bi bi-arrow-down-up sort-icon"></i></th>
                <th tabindex="0" role="button" class="th-sortable" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}" data-sort-key="scholarship">Scholarship <i class="bi bi-arrow-down-up sort-icon"></i></th>
                <th tabindex="0" role="button" class="th-sortable" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}" data-sort-key="documents">Documents <i class="bi bi-arrow-down-up sort-icon"></i></th>
                <th tabindex="0" role="button" class="th-sortable" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}" data-sort-key="submitted">Submitted <i class="bi bi-arrow-down-up sort-icon"></i></th>
                <th tabindex="0" role="button" class="th-sortable" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}" data-sort-key="queue">Time in Queue <i class="bi bi-arrow-down-up sort-icon"></i></th>
                <th tabindex="0" role="button" class="th-sortable" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}" data-sort-key="status">Status <i class="bi bi-arrow-down-up sort-icon"></i></th>
                <th></th>
              </tr>
            </thead>
            <tbody id="dvTableBody"></tbody>
          </table>
        </div>
        <div id="dvMobileCards"></div>
        <div class="table-footer-bar">
          <div class="tf-pagesize">
            <label class="form-label mb-0 small text-muted-custom" for="dvPageSize">Rows per page</label>
            <select class="form-select form-select-sm" id="dvPageSize">
              <option value="5">5</option>
              <option value="10" selected>10</option>
              <option value="25">25</option>
              <option value="50">50</option>
