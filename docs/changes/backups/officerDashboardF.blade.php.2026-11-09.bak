      </div>
    </section>

    <!-- ============================================================
         PAGE: NOTIFICATIONS
         Dedicated, filterable notification sidebar reached from the Dashboard.
         ============================================================ -->
    <section class="page-section" id="page-activity-log">
      <div class="page-header notifications-page-header">
        <div class="eyebrow">Officer / Notifications</div>
        <h1>Notifications</h1>
        <p class="text-muted-custom mb-0">Stay up to date with submissions, verifications, corrections, and disbursements.</p>
      </div>

      <div class="filter-bar filter-bar-search">
        <div class="row g-2 align-items-end">
          <div class="col-md-7">
            <label class="form-label mb-0">Search notifications</label>
