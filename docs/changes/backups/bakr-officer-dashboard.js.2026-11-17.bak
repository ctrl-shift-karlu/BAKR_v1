function resetAddScholarWizard() {
  addScholarStep = 1;
  refreshAddScholarId();
  const form = document.getElementById('addScholarForm');
  if (form) {
    form.reset();
    form.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
  }
  syncSearchableSelects();
  applyDnscDisbursementRule(true);
  renderGrantStipend();
  renderScholarshipConfiguration();
  document.getElementById('nasVerifyCheck').checked = false;
  document.getElementById('scholarWizardSaveBtn').disabled = true;
  renderAddScholarStepper();
}

document.getElementById('nasVerifyCheck').addEventListener('change', function () {
  document.getElementById('scholarWizardSaveBtn').disabled = !this.checked;
});

function submitNewScholar() {
  if (!document.getElementById('nasVerifyCheck').checked) {
    showToast('Verification required', 'Please confirm the details are accurate before adding this scholar.', 'red');
    return;
  }

  const name = addScholarFieldValue('nasName');
  const student_id = addScholarFieldValue('nasStudentId');
  const course = addScholarFieldValue('nasProgram');
  const scholarship = document.getElementById('nasScholarship').value;
  const classification = document.getElementById('nasClassification').value;
  const stipendDetails = getGrantStipendDetails(scholarship, classification);
  const stipendAmount = stipendDetails.amount;
  const channel = document.getElementById('nasChannel').value;

  if (!name || !student_id || !course) {
    showToast('Missing information', 'Please fill in name, student ID, and degree program.', 'red');
    return;
  }

  const newId = nextScholarNumericId();
  pendingScholarSubmissions.push({
    id: newId,
    submittedAt: new Date().toISOString(),
    approvalStatus: 'Pending Approval',
    name, student_id, program_name: course,
    scholarId: formatScholarId(newId),
    firstName: addScholarFieldValue('nasFirstName'),
    middleName: addScholarFieldValue('nasMiddleName'),
    lastName: addScholarFieldValue('nasLastName'),
    email: addScholarFieldValue('nasEmail'),
    alternateEmail: addScholarFieldValue('nasAltEmail'),
    contact: addScholarFieldValue('nasContact'),
    age: ageFromBirthDate(document.getElementById('nasDob').value),
    nationality: addScholarFieldValue('nasNationality'),
    specificAddress: addScholarFieldValue('nasSpecificAddress'),
    city: addScholarFieldValue('nasCity'),
    province: addScholarFieldValue('nasProvince'),
    zipCode: addScholarFieldValue('nasZip'),
    sex: document.getElementById('nasSex').value,
    dob: document.getElementById('nasDob').value,
    institute: addScholarFieldValue('nasInstitute'),
    yearLevel: Number(document.getElementById('nasYearLevel').value) || 1,
    classification,
    currentGwa: Number(addScholarFieldValue('nasGwa')) || null,
    accountNumber: addScholarFieldValue('nasAccountNumber'),
    stipendAmount,
    stipendCadence: stipendDetails.cadence,
    stipendDisplay: stipendDetails.display,
    scholarship,
    benefits: getScholarshipConfig(scholarship).benefits,
    stipendBenefits: getScholarshipConfig(scholarship).stipendBenefits,
    otherBenefits: getScholarshipConfig(scholarship).otherBenefits,
    maintenanceRequirements: getScholarshipConfig(scholarship).maintenance,
    requiredDocuments: getRequiredDocTypes({ scholarship }).map(d => d.name),
    requiredDocumentIds: (SCHOLARSHIP_DOCUMENT_REQUIREMENTS[scholarship] || DOC_TYPES.map(d => d.id)).slice(),
    academic_year: addScholarFieldValue('nasAcademicYear'),
    semester: addScholarFieldValue('nasSemester'),
    application_submitted_date: '–',
    payment_channel: channel,
    docs: Object.fromEntries(getRequiredDocTypes({ scholarship }).map(d => [d.id, { status: 'not_uploaded', file: null, remarks: '' }]))
  });

  showToast('Scholar submitted for approval', `${name}'s profile is pending admin approval. It has not been added to the scholar roster yet.`);
  resetAddScholarWizard();
  renderAllTables();
  showPage('dashboard');
}





/* ============================================================
   EDIT PENDING SCHOLAR — modal version of the Add New Scholar wizard.
   Everything is editable except the Scholar ID.
   ============================================================ */
const EDIT_PENDING_TOTAL_STEPS = 4;
let editPendingStep = 1;
let editPendingId = null;
let editDnscRuleActive = false;
const epmEl = id => document.getElementById(id);
function epmVal(id) { const el = epmEl(id); return el ? el.value.trim() : ''; }

(function populateEditPendingSelects() {
  const ch = epmEl('epmChannel');
  if (ch) ch.innerHTML = '<option value="">Select channel…</option>' + ADD_SCHOLAR_CHANNELS.map(c => `<option value="${c.id}">${c.label}</option>`).join('');
  const pr = epmEl('epmProgram');
  if (pr) pr.innerHTML = '<option value="">Select degree program…</option>' + DNSC_INSTITUTES.map(i => `<optgroup label="${i.name}">${i.programs.map(pn => `<option>${pn}</option>`).join('')}</optgroup>`).join('');
})();

function renderEditGrantStipend() {
  const program = document.getElementById('epmScholarship');
  const classification = document.getElementById('epmClassification');
  const stipend = document.getElementById('epmStipend');
  const help = document.getElementById('epmStipendHelp');
  if (!program || !classification || !stipend) return;
  const details = getGrantStipendDetails(program.value, classification.value);
  stipend.value = details.display;
  if (help) help.textContent = details.note || '';
}
function renderEditScholarshipConfiguration() {
  const programEl = document.getElementById('epmScholarship');
  const classEl = document.getElementById('epmClassification');
  const panel = document.getElementById('epmScholarshipConfig');
  if (!programEl || !classEl || !panel) return;
  const program = programEl.value;
  if (!program) { panel.innerHTML = '<div class="as-config-empty">Select a scholarship to load its eligibility, stipend, benefits, required documents, and maintenance requirements.</div>'; return; }
  const cfg = getScholarshipConfig(program);
  const allowed = new Set(cfg.classificationOptions);
  Array.from(classEl.options).forEach(opt => { if (opt.value) opt.hidden = !allowed.has(opt.value); });
  if (!allowed.has(classEl.value)) classEl.value = cfg.classificationOptions[0] || 'na';
  renderEditGrantStipend();
  panel.innerHTML = `<div class="as-config-grid">
    <div><div class="as-config-label">Scholarship Name</div><div class="as-config-value">${cfg.label}</div></div>
    <div><div class="as-config-label">Scholarship Code</div><div class="as-config-value">${cfg.code}</div></div>
    <div><div class="as-config-label">Category</div><div class="as-config-value">${cfg.category}</div></div>
    <div><div class="as-config-label">Calculated stipend</div><div class="as-config-value"><strong>${document.getElementById('epmStipend').value}</strong></div></div>
    <div><div class="as-config-label">Release Frequency</div><div class="as-config-value">${cfg.frequency}</div></div>
    <div><div class="as-config-label">Classification</div><div class="as-config-value">${classEl.value === 'na' ? 'N/A' : classEl.value === 'full' ? 'Full' : 'Half'}</div></div>
  </div>
  <details class="as-nonmonetary-details">
    <summary><i class="bi bi-chevron-right me-2"></i>View eligibility, benefits &amp; requirements</summary>
    <div class="as-nonmonetary-body">
      <div><div class="as-config-label">Eligibility</div><div class="as-config-value">${cfg.eligibility.join('; ') || 'No eligibility rules configured.'}</div></div>
      <div><div class="as-config-label">Stipend</div><ul class="as-config-list">${cfg.stipendBenefits.length ? cfg.stipendBenefits.map(x => `<li>${x}</li>`).join('') : '<li>No stipend amount</li>'}</ul></div>
      <div><div class="as-config-label">Other Benefits</div><ul class="as-config-list">${cfg.otherBenefits.length ? cfg.otherBenefits.map(x => `<li>${x}</li>`).join('') : '<li>None</li>'}</ul></div>
      <div><div class="as-config-label">Required Documents</div><ul class="as-config-list">${cfg.requiredDocuments.map(x => `<li>${x}</li>`).join('')}</ul></div>
      <div><div class="as-config-label">Maintenance Requirements</div><ul class="as-config-list">${cfg.maintenance.map(x => `<li>${x}</li>`).join('')}</ul></div>
    </div>
  </details>`;
}
function syncEditRequiredMarker(field) {
  if (!field || !field.id) return;
  const form = document.getElementById('editPendingForm');
  const label = form && form.querySelector(`label[for="${field.id}"], label[data-for="${field.id}"]`);
  if (!label) return;
  let star = label.querySelector('.req-star');
  if (!star) {
    star = document.createElement('span');
    star.className = 'req-star';
    star.setAttribute('aria-hidden', 'true');
    star.textContent = '*';
    label.appendChild(star);
  }
  star.hidden = !field.required;
}
function applyEditDnscDisbursementRule(forceReset) {
  const program = document.getElementById('epmScholarship');
  const channel = document.getElementById('epmChannel');
  const account = document.getElementById('epmAccountNumber');
  const chHelp = document.getElementById('epmChannelHelp');
  const acHelp = document.getElementById('epmAccountHelp');
  if (!program || !channel || !account) return;
  const lock = isDnscProgram(program.value);

  if (lock) {
    channel.value = 'other';
    channel.disabled = true;
    account.value = '';
    account.disabled = true;
    account.required = false;
    account.placeholder = 'Not applicable';
    account.classList.remove('is-invalid');
    channel.classList.remove('is-invalid');
    if (chHelp) chHelp.textContent = 'Locked to Others for DNSC-administered grants.';
    if (acHelp) acHelp.textContent = 'Not needed — DNSC grants are not paid to a card or account.';
  } else {
    if (editDnscRuleActive || forceReset) channel.value = '';
    channel.disabled = false;
    account.disabled = false;
    account.required = true;
    account.placeholder = 'Type card or account number';
    if (chHelp) chHelp.textContent = '';
    if (acHelp) acHelp.textContent = '';
  }
  editDnscRuleActive = lock;
  syncEditRequiredMarker(channel);
  syncEditRequiredMarker(account);
  const feedback = (el) => { const f = el.parentElement && el.parentElement.querySelector(':scope > .invalid-feedback'); if (f) { f.textContent = ''; f.classList.remove('d-block'); } };
  if (lock) { feedback(channel); feedback(account); }
}

function initEditRequiredMarkers() {
  document.querySelectorAll('#editPendingForm input, #editPendingForm select').forEach(syncEditRequiredMarker);
}
epmEl('epmScholarship').addEventListener('change', renderEditGrantStipend);
epmEl('epmClassification').addEventListener('change', renderEditGrantStipend);
epmEl('epmScholarship').addEventListener('change', renderEditScholarshipConfiguration);
epmEl('epmClassification').addEventListener('change', renderEditScholarshipConfiguration);
epmEl('epmScholarship').addEventListener('change', () => applyEditDnscDisbursementRule(false));
initEditRequiredMarkers();
makeSearchableSelect(epmEl('epmProgram'), 'Search degree program…');

function syncEditPendingFullName() {
  const v = id => (epmEl(id)?.value || '').trim().replace(/\s+/g, ' ');
  const hidden = epmEl('epmName');
  if (hidden) hidden.value = [v('epmFirstName'), v('epmMiddleName'), v('epmLastName')].filter(Boolean).join(' ');
}
['epmFirstName', 'epmMiddleName', 'epmLastName'].forEach(id => epmEl(id)?.addEventListener('input', syncEditPendingFullName));

(function initEditPendingDob() {
  const el = document.getElementById('epmDob');
  if (!el) return;
  const check = () => {
    const val = el.value;
    let msg = '';
    if (val) {
      const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(val);
      if (!m) msg = 'Use the format yyyy-mm-dd.';
      else {
        const y = +m[1], mo = +m[2], d = +m[3];
        const dt = new Date(y, mo - 1, d);
        if (dt.getFullYear() !== y || dt.getMonth() !== mo - 1 || dt.getDate() !== d) msg = 'Enter a valid date (yyyy-mm-dd).';
        else if (dt > new Date()) msg = 'Birth date cannot be in the future.';
      }
    }
    el.setCustomValidity(msg);
  };
  el.addEventListener('input', () => {
    const digits = el.value.replace(/\D/g, '').slice(0, 8);
    let out = digits;
    if (digits.length > 6) out = digits.slice(0, 4) + '-' + digits.slice(4, 6) + '-' + digits.slice(6);
    else if (digits.length > 4) out = digits.slice(0, 4) + '-' + digits.slice(4);
    el.value = out;
    check();
  });
  el.addEventListener('blur', check);
  check();
})();

function validateEditPendingPane(step) {
  const pane = document.querySelector(`#editPendingForm .wizard-pane[data-pane="${step}"]`);
  const fields = pane ? pane.querySelectorAll('input[required], select[required]') : [];
  let firstInvalid = null;

  fields.forEach(field => {
    const valid = field.checkValidity();
    const ui = field._comboInput || field;
    ui.classList.toggle('is-invalid', !valid);
    field.setAttribute('aria-invalid', valid ? 'false' : 'true');
    const feedbackId = `${field.id || 'wizard-field'}-error`;
    field.setAttribute('aria-describedby', feedbackId);
    let feedback = field.parentElement ? field.parentElement.querySelector(':scope > .invalid-feedback') : null;
    if (!feedback && field.parentElement) {
      feedback = document.createElement('div');
      feedback.className = 'invalid-feedback';
      feedback.id = feedbackId;
      feedback.setAttribute('role', 'alert');
      field.insertAdjacentElement('afterend', feedback);
    }
    if (feedback) {
      feedback.textContent = valid ? '' : (field.validationMessage || 'Please complete this field before continuing.');
      feedback.classList.toggle('d-block', !valid);
    }
    if (!valid && !firstInvalid) firstInvalid = field;
  });

  if (firstInvalid) {
    if (firstInvalid._comboInput) { firstInvalid._comboInput.focus(); }
    else { firstInvalid.reportValidity(); firstInvalid.focus(); }
    return false;
  }

  return true;
}

