        <div class="col-6"><div class="info-item"><div class="info-label">Account Number</div><div class="info-value">${document.getElementById('epmAccountNumber').disabled ? 'Not applicable' : (epmVal('epmAccountNumber') || '–')}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Release Frequency</div><div class="info-value">${getScholarshipConfig(epmVal('epmScholarship')).frequency || '–'}</div></div></div>
        <div class="col-12"><div class="info-item"><div class="info-label">Eligibility</div><div class="info-value">${getScholarshipConfig(epmVal('epmScholarship')).eligibility.join('; ') || 'N/A'}</div></div></div>
        <div class="col-12"><div class="info-item"><div class="info-label">Stipend</div><div class="info-value">${getScholarshipConfig(epmVal('epmScholarship')).stipendBenefits.join(' • ') || 'No stipend amount'}</div></div></div>
        <div class="col-12"><div class="info-item"><div class="info-label">Other Benefits</div><div class="info-value">${getScholarshipConfig(epmVal('epmScholarship')).otherBenefits.join(' • ') || 'None'}</div></div></div>
        <div class="col-12"><div class="info-item"><div class="info-label">Required Documents</div><div class="info-value">${getScholarshipConfig(epmVal('epmScholarship')).requiredDocuments.join(' • ') || 'N/A'}</div></div></div>
        <div class="col-12"><div class="info-item"><div class="info-label">Maintenance Requirements</div><div class="info-value">${getScholarshipConfig(epmVal('epmScholarship')).maintenance.join(' • ') || 'N/A'}</div></div></div>
      </div>
    </div>`;
}

function renderEditPendingStepper() {
  document.querySelectorAll('#epmStepper .as-step').forEach(el => {
    const n = Number(el.getAttribute('data-step'));
    el.classList.toggle('active', n === editPendingStep);
    el.classList.toggle('completed', n < editPendingStep);
    el.querySelector('.as-step-num').innerHTML = n < editPendingStep ? '<i class="bi bi-check-lg"></i>' : n;
  });
  document.querySelectorAll('#editPendingForm .wizard-pane').forEach(p => p.classList.toggle('active', Number(p.getAttribute('data-pane')) === editPendingStep));
  epmEl('epmProgressLabel').textContent = `Step ${editPendingStep} of ${EDIT_PENDING_TOTAL_STEPS}`;
  epmEl('epmPrevBtn').style.visibility = editPendingStep === 1 ? 'hidden' : 'visible';
  epmEl('epmNextBtn').style.display = editPendingStep === EDIT_PENDING_TOTAL_STEPS ? 'none' : 'inline-flex';
  epmEl('epmSaveBtn').style.display = editPendingStep === EDIT_PENDING_TOTAL_STEPS ? 'inline-flex' : 'none';
  if (editPendingStep === EDIT_PENDING_TOTAL_STEPS) renderEditPendingReview();
  const body = document.querySelector('#editPendingModal .modal-body');
  if (body) body.scrollTop = 0;
}

function navigateEditPending(direction) {
  if (direction === 1) {
    if (!validateEditPendingPane(editPendingStep)) return;
    if (editPendingStep < EDIT_PENDING_TOTAL_STEPS) { editPendingStep++; renderEditPendingStepper(); }
  } else if (editPendingStep > 1) {
    editPendingStep--; renderEditPendingStepper();
  }
}

epmEl('epmVerifyCheck').addEventListener('change', function () { epmEl('epmSaveBtn').disabled = !this.checked; });

function openEditPendingScholar(id) {
  const s = pendingScholarSubmissions.find(x => String(x.id) === String(id));
  if (!s) { showToast('Not found', 'This pending submission could not be found.', 'red'); return; }
  editPendingId = s.id;
  editPendingStep = 1;

  const form = epmEl('editPendingForm');
  form.reset();
  form.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
  form.querySelectorAll('.invalid-feedback').forEach(f => { f.textContent = ''; f.classList.remove('d-block'); });

  // Fall back to splitting the full name for records that have no name parts.
  let first = s.firstName, middle = s.middleName, last = s.lastName;
  if (!first && !last && s.name) {
    const parts = String(s.name).trim().split(/\s+/);
    last = parts.length > 1 ? parts.pop() : '';
    first = parts.shift() || '';
    middle = parts.join(' ');
  }
  const set = (fid, v) => { const el = epmEl(fid); if (el) el.value = (v === null || v === undefined) ? '' : v; };
  set('epmFirstName', first); set('epmMiddleName', middle); set('epmLastName', last);
  set('epmSex', s.sex); set('epmDob', s.dob); set('epmNationality', s.nationality || 'Filipino');
  set('epmEmail', s.email); set('epmAltEmail', s.alternateEmail); set('epmContact', s.contact);
  set('epmSpecificAddress', s.specificAddress); set('epmCity', s.city); set('epmProvince', s.province); set('epmZip', s.zipCode);
  set('epmInstitute', s.institute); set('epmProgram', s.program_name);
  set('epmYearLevel', s.yearLevel); set('epmStudentId', s.student_id);
  set('epmAcademicYear', s.academic_year); set('epmSemester', s.semester); set('epmGwa', s.currentGwa);
  set('epmScholarId', s.scholarId);
  set('epmScholarship', s.scholarship);
  epmEl('epmDob').dispatchEvent(new Event('input', { bubbles: true }));
  syncEditPendingFullName();

  editDnscRuleActive = false;
  applyEditDnscDisbursementRule(true);
  renderEditScholarshipConfiguration();
  set('epmClassification', s.classification);
  renderEditScholarshipConfiguration();
  if (!epmEl('epmChannel').disabled) {
    set('epmChannel', s.payment_channel);
    set('epmAccountNumber', s.accountNumber);
  }
  renderEditGrantStipend();

  epmEl('epmVerifyCheck').checked = false;
  epmEl('epmSaveBtn').disabled = true;
  syncSearchableSelects();
  initEditRequiredMarkers();
  renderEditPendingStepper();
  bootstrap.Modal.getOrCreateInstance(epmEl('editPendingModal')).show();
}

function saveEditedPendingScholar() {
  if (!epmEl('epmVerifyCheck').checked) {
    showToast('Verification required', 'Please confirm the details are accurate before saving.', 'red');
    return;
  }
  const rec = pendingScholarSubmissions.find(x => String(x.id) === String(editPendingId));
  if (!rec) { showToast('Not found', 'This pending submission could not be found.', 'red'); return; }

  for (let step = 1; step <= 3; step++) {
    if (!validateEditPendingPane(step)) { editPendingStep = step; renderEditPendingStepper(); return; }
  }

  syncEditPendingFullName();
  const name = epmVal('epmName');
  const course = epmVal('epmProgram');
  const student_id = epmVal('epmStudentId');
  if (!name || !student_id || !course) {
    showToast('Missing information', 'Please fill in name, student ID, and degree program.', 'red');
    return;
  }
  const scholarship = epmEl('epmScholarship').value;
  const classification = epmEl('epmClassification').value;
  const stipendDetails = getGrantStipendDetails(scholarship, classification);
  const cfg = getScholarshipConfig(scholarship);
  const reqDocs = getRequiredDocTypes({ scholarship });
  const oldDocs = rec.docs || {};

  Object.assign(rec, {
    // id, scholarId, submittedAt and approvalStatus are intentionally left untouched.
    name, student_id, program_name: course,
    firstName: epmVal('epmFirstName'),
    middleName: epmVal('epmMiddleName'),
    lastName: epmVal('epmLastName'),
    email: epmVal('epmEmail'),
    alternateEmail: epmVal('epmAltEmail'),
    contact: epmVal('epmContact'),
    age: ageFromBirthDate(epmEl('epmDob').value),
    nationality: epmVal('epmNationality'),
    specificAddress: epmVal('epmSpecificAddress'),
    city: epmVal('epmCity'),
    province: epmVal('epmProvince'),
    zipCode: epmVal('epmZip'),
    sex: epmEl('epmSex').value,
    dob: epmEl('epmDob').value,
    institute: epmVal('epmInstitute'),
    yearLevel: Number(epmEl('epmYearLevel').value) || 1,
    classification,
    currentGwa: Number(epmVal('epmGwa')) || null,
    accountNumber: epmVal('epmAccountNumber'),
    stipendAmount: stipendDetails.amount,
    stipendCadence: stipendDetails.cadence,
    stipendDisplay: stipendDetails.display,
    scholarship,
    benefits: cfg.benefits,
    stipendBenefits: cfg.stipendBenefits,
    otherBenefits: cfg.otherBenefits,
    maintenanceRequirements: cfg.maintenance,
    requiredDocuments: reqDocs.map(d => d.name),
    requiredDocumentIds: (SCHOLARSHIP_DOCUMENT_REQUIREMENTS[scholarship] || DOC_TYPES.map(d => d.id)).slice(),
    academic_year: epmVal('epmAcademicYear'),
    semester: epmVal('epmSemester'),
    payment_channel: epmEl('epmChannel').value,
    // Keep any existing document progress for documents that are still required.
    docs: Object.fromEntries(reqDocs.map(d => [d.id, oldDocs[d.id] || { status: 'not_uploaded', file: null, remarks: '' }]))
  });

  bootstrap.Modal.getOrCreateInstance(epmEl('editPendingModal')).hide();
  showToast('Pending scholar updated', `${name}'s details were saved. The submission is still pending admin approval.`);
  editPendingId = null;
  renderAllTables();
}


/* Filter affordances: show active criteria count and provide one-click reset. */
function initFilterAffordances() {
  document.querySelectorAll('.filter-bar').forEach((bar, index) => {
    if (bar.querySelector('.filter-affordance')) return;
    const meta = document.createElement('div');
    meta.className = 'filter-affordance';
    meta.innerHTML = '<span class="filter-count" aria-live="polite">No active filters</span><button type="button" class="btn btn-sm btn-outline-scholarship directory-reset btn-ui btn-ui--secondary btn-ui--sm">Reset</button>';
    bar.appendChild(meta);
    const controls = [...bar.querySelectorAll('input:not([type="checkbox"]), select, textarea')];
    const toggles = [...bar.querySelectorAll('input[type="checkbox"]')].filter(el => el.id !== 'dvStaleOnly');
    const countEl = meta.querySelector('.filter-count');
    const resetBtn = meta.querySelector('button');
    const update = () => {
      const count = controls.filter(el => el.value && el.value !== '').length + toggles.filter(el => !el.checked).length;
      countEl.textContent = count ? `${count} active filter${count === 1 ? '' : 's'}` : 'No active filters';
      resetBtn.disabled = count === 0;
    };
    controls.concat(toggles).forEach(el => el.addEventListener('input', update));
    controls.concat(toggles).forEach(el => el.addEventListener('change', update));
    resetBtn.addEventListener('click', () => {
      controls.forEach(el => { el.value = ''; el.dispatchEvent(new Event('change', { bubbles: true })); });
      toggles.forEach(el => { el.checked = true; el.dispatchEvent(new Event('change', { bubbles: true })); });
      if (bar.querySelector('#scSearch') && typeof clearScChartFilter === 'function') clearScChartFilter();
      update();
    });
    update();
  });
}

/* ============================================================
   RENDER: PENDING ADMIN APPROVAL
   ============================================================ */
let paSortKey = 'name';
let paSortDir = 'asc';
let paCurrentPage = 1;
let paPageSize = 10;
function comparePendingApprovals(a, b, key) {
  const av = String(key === 'school' ? schoolOfScholar(a) : key === 'scholarship' ? scholarshipTypeLabel(a.scholarship) : (a[key] || '')).toLowerCase();
  const bv = String(key === 'school' ? schoolOfScholar(b) : key === 'scholarship' ? scholarshipTypeLabel(b.scholarship) : (b[key] || '')).toLowerCase();
  return av.localeCompare(bv, undefined, { numeric: true });
}
function renderPendingApprovalTable() {
  populateSchoolSelect('paSchool');
  populateCanonicalScholarshipSelect('paScholarship');
  const paProgramEl = document.getElementById('paProgram');
  if (paProgramEl) {
    const currentProgram = paProgramEl.value;
    paProgramEl.innerHTML = '<option value="">All programs</option>' + DNSC_INSTITUTES.map(i => `<optgroup label="${i.name}">${i.programs.map(pn => `<option value="${pn}">${pn}</option>`).join('')}</optgroup>`).join('');
    paProgramEl.value = DNSC_PROGRAMS.includes(currentProgram) ? currentProgram : '';
  }
  const program = paProgramEl?.value || '';
  const search = (document.getElementById('paSearch')?.value || '').trim().toLowerCase();
  const scholarship = document.getElementById('paScholarship')?.value || '';
  const school = document.getElementById('paSchool')?.value || '';
  const filtered = pendingScholarSubmissions.filter(s => {
    const haystack = [s.name, s.student_id, s.scholarId, s.program_name, schoolOfScholar(s)].join(' ').toLowerCase();
    return (!search || haystack.includes(search)) && scholarshipTypeMatches(s.scholarship, scholarship) && (!program || s.program_name === program) && (!school || schoolOfScholar(s) === school);
  });
  const sorted = filtered.slice().sort((a,b) => (paSortDir === 'asc' ? 1 : -1) * comparePendingApprovals(a,b,paSortKey));
  const total = sorted.length;
  const pages = Math.max(1, Math.ceil(total / paPageSize));
  paCurrentPage = Math.min(Math.max(1, paCurrentPage), pages);
  const start = (paCurrentPage - 1) * paPageSize;
  const rows = sorted.slice(start, start + paPageSize);
  document.querySelectorAll('#paTableHeadRow .th-sortable').forEach(th => {
    const active = th.dataset.sortKey === paSortKey;
    th.classList.toggle('sorted-asc', active && paSortDir === 'asc');
    th.classList.toggle('sorted-desc', active && paSortDir === 'desc');
    th.setAttribute('aria-sort', active ? (paSortDir === 'asc' ? 'ascending' : 'descending') : 'none');
    const icon = th.querySelector('.sort-icon');
    if (icon) icon.className = 'bi sort-icon ' + (active ? (paSortDir === 'asc' ? 'bi-sort-up' : 'bi-sort-down') : 'bi-arrow-down-up');
  });
  const empty = '<tr><td colspan="7" class="text-center text-muted-custom py-4">No pending approval students match these filters.</td></tr>';
  document.getElementById('paTableBody').innerHTML = rows.length ? rows.map(s => `<tr class="row-hoverable"><td>${s.name}</td><td>${s.student_id}</td><td>${s.scholarId || '—'}</td><td>${s.program_name || '—'}</td><td>${scholarshipTypeLabel(s.scholarship)}</td><td>${schoolOfScholar(s)}</td><td class="text-end"><button type="button" class="btn btn-sm btn-outline-scholarship btn-edit-pending" onclick="openEditPendingScholar(${s.id})" aria-label="Edit ${String(s.name).replace(/"/g, '&quot;')}"><i class="bi bi-pencil-square"></i> Edit</button></td></tr>`).join('') : empty;
  document.getElementById('paMobileCards').innerHTML = rows.map(s => `<div class="row-card-mobile"><div class="rc-top"><div class="scholar-cell"><div class="row-avatar" style="background:${avatarColor(s.id)};">${initials(s.name)}</div><div><div class="sc-name">${s.name}</div><div class="sc-sub">${s.student_id}</div></div></div></div><div class="rc-line"><span class="rc-label">Scholar ID</span><span class="rc-value">${s.scholarId || '—'}</span></div><div class="rc-line"><span class="rc-label">Program</span><span class="rc-value">${s.program_name || '—'}</span></div><div class="rc-line"><span class="rc-label">Scholarship Type</span><span class="rc-value">${scholarshipTypeLabel(s.scholarship)}</span></div><div class="rc-line"><span class="rc-label">School</span><span class="rc-value">${schoolOfScholar(s)}</span></div><div class="rc-line"><button type="button" class="btn btn-sm btn-outline-scholarship btn-edit-pending w-100 justify-content-center" onclick="openEditPendingScholar(${s.id})"><i class="bi bi-pencil-square"></i> Edit</button></div></div>`).join('');
  document.getElementById('paResultCount').textContent = `${total} student${total === 1 ? '' : 's'}`;
  document.getElementById('paPageCounter').textContent = total ? `Showing ${start + 1}–${Math.min(start + paPageSize, total)} of ${total} students` : 'Showing 0 of 0 students';
  document.getElementById('paPrevPage').disabled = paCurrentPage <= 1;
  document.getElementById('paNextPage').disabled = paCurrentPage >= pages;
  document.getElementById('paPageNumbers').innerHTML = historyPageSequence(pages, paCurrentPage).map(n => n === '…' ? '<span class="text-muted-custom px-1">…</span>' : `<button type="button" class="btn btn-sm ${n === paCurrentPage ? 'btn-scholarship-green' : 'btn-outline-scholarship'}" onclick="goPendingApprovalPage(${n})" ${n === paCurrentPage ? 'aria-current="page"' : ''}>${n}</button>`).join('');
}
function goPendingApprovalPage(page) { paCurrentPage = page; renderPendingApprovalTable(); }
function changePendingApprovalPage(delta) { paCurrentPage += delta; renderPendingApprovalTable(); }
function sortPendingApprovals(key) { if (paSortKey === key) paSortDir = paSortDir === 'asc' ? 'desc' : 'asc'; else { paSortKey = key; paSortDir = 'asc'; } paCurrentPage = 1; renderPendingApprovalTable(); }
['paSearch','paScholarship','paProgram','paSchool'].forEach(id => document.getElementById(id)?.addEventListener('input', () => { paCurrentPage = 1; renderPendingApprovalTable(); }));
['paSearch','paScholarship','paProgram','paSchool'].forEach(id => document.getElementById(id)?.addEventListener('change', () => { paCurrentPage = 1; renderPendingApprovalTable(); }));
document.querySelectorAll('#paTableHeadRow .th-sortable').forEach(th => th.addEventListener('click', () => sortPendingApprovals(th.dataset.sortKey)));
document.getElementById('paPrevPage')?.addEventListener('click', () => changePendingApprovalPage(-1));
document.getElementById('paNextPage')?.addEventListener('click', () => changePendingApprovalPage(1));
document.getElementById('paPageSize')?.addEventListener('change', function() { paPageSize = parseInt(this.value, 10) || 10; paCurrentPage = 1; renderPendingApprovalTable(); });

/* ============================================================
   MASTER RENDER
   ============================================================ */
function renderAllTables() {
  try {
    AD = getAnalyticsDataset();
  } catch (error) {
    console.error('Dataset initialization failed:', error);
    return;
  }

  // Render independently so one optional widget cannot blank the entire app.
  const widgets = [
    ['summary cards', renderSummaryCards],
    ['disbursement queue', renderDisbursementQueue],
    ['attention queue', renderAttentionRequired],
    ['scholarship analytics', renderAnalytics],
    ['course/year analytics', renderCourseYearChart],
    ['time-series analytics', renderTimeSeriesChart],
    ['disbursement pipeline', renderDisbursementPipeline],
    ['pipeline states', renderDisbursementPipelineStates],
    ['document verification table', renderDvTable],
    ['scholars table', renderScholarsTable],
    ['stipend page', renderStipendPage],
    ['history table', renderHistoryTable],
    ['pending approval table', renderPendingApprovalTable],
    ['recent activity', renderRecentActivity],
    ['activity log', renderActivityLogPage]
  ];
  widgets.forEach(([label, render]) => {
    try { render(); }
    catch (error) { console.error(`Render failed: ${label}`, error); }
  });
}


// Activate a visible page before rendering data. This prevents a single
// widget exception from leaving the entire app on a white screen.
showPage('dashboard');
initFilterAffordances();
renderAllTables();
updatePeriodUI();
setAnalyticsTab('overview');
initChartTouchSupport();

/* ============================================================
   PROFILE / SETTINGS (demo-only, no backend)
   ============================================================ */
function handleChangePassword(e) {
  e.preventDefault();
  const newPass = document.getElementById('newPassword').value;
  const confirmPass = document.getElementById('confirmPassword').value;
  if (newPass !== confirmPass) {
    showToast('Passwords do not match', 'Please re-enter your new password.', 'red');
    return false;
  }
  showToast('Password updated', 'Your password has been changed for this demo session.');
  document.getElementById('changePasswordForm').reset();
  return false;
}

function handleLogout() {
  openLogoutModal();
}


/* Live date + time pill on the Dashboard and Analytics headers, same
   treatment as the Scholar Dashboard. Updates every element sharing the
   class (not a single id), so both pages' pills stay in sync. */
(function () {
  var dateEls = document.querySelectorAll('.js-officer-date');
  var timeEls = document.querySelectorAll('.js-officer-time');
  if (!dateEls.length || !timeEls.length) return;
  function tick() {
    var now = new Date();
    var dateText = now.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).toUpperCase();
    var timeText = now.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }).replace(/\s/g, '');
    dateEls.forEach(function (el) { el.textContent = dateText; });
    timeEls.forEach(function (el) { el.textContent = timeText; });
  }
  tick();
  setInterval(tick, 60000);
})();
