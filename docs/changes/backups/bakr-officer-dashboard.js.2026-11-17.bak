// Stipend vs. other benefits are stored separately; `benefits` stays as the combined list for existing consumers.
Object.values(SCHOLARSHIP_CATALOG).forEach(c => { c.benefits = [...c.stipendBenefits, ...c.otherBenefits]; });

// Release period follows the scholarship's release frequency (admin: Per month → "September 2026").
function releasePeriodLabel(scholarshipKey) {
  const f = SCHOLARSHIP_CATALOG[scholarshipKey] && SCHOLARSHIP_CATALOG[scholarshipKey].frequency;
  if (f === 'Per month') return ['January','February','March','April','May','June','July','August','September','October','November','December'][QUEUE_NOW.getMonth()] + ' ' + QUEUE_NOW.getFullYear();
  return CURRENT_SEM + ' ' + CURRENT_AY;
}
const scholarshipHasStipend = name => !(SCHOLARSHIP_CATALOG[name] && SCHOLARSHIP_CATALOG[name].hasStipend === false);

// Scholarship stipend rules, derived from SCHOLARSHIP_CATALOG so the officer and admin views agree.
// DNSC internal scholarships carry NO stipend (₱0.00); CHED Merit is paid by Half/Full classification.
const _CLASSIFIED_STIPENDS = {
  'CHED Merit Scholarship Program': {
    full: { amount: SCHOLARSHIP_CATALOG['CHED Merit Scholarship Program'].maxAmount, cadence: 'Per semester', note: '₱35,000 stipend + ₱5,000 book/connectivity allowance (SUC/LUC rate)' },
    half: { amount: SCHOLARSHIP_CATALOG['CHED Merit Scholarship Program'].minAmount, cadence: 'Per semester', note: '₱17,500 stipend + ₱2,500 book/connectivity allowance (SUC/LUC rate)' }
  }
};
// Declared before first use: getScholarStipendAmount() reads it while the scholar data is being built.
const _FREQ_SUFFIX = { 'Per month': ' / month', 'Per semester': ' / semester', 'Per academic year': ' / year' };
const GRANT_PROGRAM_STIPENDS = Object.freeze(Object.fromEntries(Object.entries(SCHOLARSHIP_CATALOG).map(([name, c]) => {
  if (_CLASSIFIED_STIPENDS[name]) return [name, { classification: _CLASSIFIED_STIPENDS[name] }];
  if (c.hasStipend === false) return [name, { amount: 0, cadence: 'N/A', noStipend: true, note: c.note }];
  const rule = { amount: c.maxAmount, cadence: c.frequency };
  if (c.minAmount == null && c.maxAmount != null) rule.prefix = 'Up to ';
  if (c.note) rule.note = c.note;
  return [name, rule];
})));

/* Amount released per disbursement, driven by the scholar's own scholarship.
   - Uses the rule in GRANT_PROGRAM_STIPENDS (CHED Merit also follows Half/Full).
   - CHED TES is published per academic year, so it is split across two semesters (override below).
   - Grants with no published amount (DNSC Internal, GIA, Student Assistant,
     Bagong Pilipinas) use DEFAULT_STIPEND_AMOUNT until an amount is configured. */
const DEFAULT_STIPEND_AMOUNT = SAMPLE_STIPEND_AMOUNT;
// CHED TES publishes ₱20,000 per academic year for SUC/LUC (DNSC is an SUC) → ₱10,000 per semester.
const PER_DISBURSEMENT_OVERRIDES = Object.freeze({}); // CHED TES: ₱20,000 per academic year is split per semester (₱10,000) by getScholarStipendAmount()
function getScholarStipendAmount(scholar) {
  if (!scholar) return DEFAULT_STIPEND_AMOUNT;
  if (!scholarshipHasStipend(scholar.scholarship)) return 0; // DNSC internal scholarships: ₱0.00, no stipend
  if (PER_DISBURSEMENT_OVERRIDES[scholar.scholarship]) return PER_DISBURSEMENT_OVERRIDES[scholar.scholarship];
  const rule = GRANT_PROGRAM_STIPENDS[scholar.scholarship];
  const classification = scholar.classification || (rule && rule.classification ? 'full' : 'na');
  const d = getGrantStipendDetails(scholar.scholarship, classification);
  if (!d.amount) return DEFAULT_STIPEND_AMOUNT;
  return d.cadence === 'Per academic year' ? Math.round(d.amount / 2) : d.amount;
}
function stipendForStudent(student_id) {
  return getScholarStipendAmount(scholars.find(x => x.student_id === student_id));
}

const _docId = n => String(n).toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, '');
const DOC_TYPES = (function () {
  const seen = new Map();
  Object.values(SCHOLARSHIP_CATALOG).forEach(c => c.documents.forEach(n => { if (!seen.has(n)) seen.set(n, { id: _docId(n), name: n }); }));
  return [...seen.values()];
})();

// Each scholarship owns its required document list, taken from the admin catalog (SCHOLARSHIP_REQUIREMENTS.document_name).
// All counts, verification states and document information use only the requirements for that scholar's scholarship.
const SCHOLARSHIP_DOCUMENT_REQUIREMENTS = Object.freeze(Object.fromEntries(
  Object.entries(SCHOLARSHIP_CATALOG).map(([k, c]) => [k, c.documents.map(_docId)])));
function getRequiredDocTypes(scholar) {
  const ids = SCHOLARSHIP_DOCUMENT_REQUIREMENTS[scholar?.scholarship] || DOC_TYPES.map(d => d.id);
  return ids.map(id => DOC_TYPES.find(d => d.id === id)).filter(Boolean);
}
function getRequiredDocumentCount(scholar) { return getRequiredDocTypes(scholar).length; }
function hasCompletedRequiredSubmission(scholar) {
  return getRequiredDocTypes(scholar).every(dt => Boolean(scholar.docs[dt.id]?.file));
}

/* Time-in-Stage / Stale Alert config.
   QUEUE_NOW anchors "how long has this been sitting" calculations to the
   same fictional "today" the rest of the seeded demo data uses, so the
   durations below line up with the seeded submittedAt timestamp logs
   (i.e. the scholar_documents rows) rather than the visitor's real clock. */
const QUEUE_NOW = new Date('2026-09-11T16:00:00');
const STALE_THRESHOLD_HOURS = 48;

// Each scholar carries their own document set + stipend release flag.
// Disbursement channels a scholar's stipend can be routed through.
const DISBURSEMENT_CHANNELS = [
  { id: 'landbank', label: 'LandBank', icon: 'bi-bank2' },
  { id: 'ewallet',  label: 'E-Wallet', icon: 'bi-phone' },
  { id: 'other',  label: 'Others', icon: 'bi-building' },
];

// Sub-statuses unique to the payout-provider process, tracked per channel.
// A scholar sits in one of the first two while awaiting the provider; a
// failed match is logged separately in BANK_FAILURES (subType: 'account_mismatch').


/* Canonical list of DNSC institutes and their degree programs — the single
   source of truth for program dropdowns, analytics grouping and validation. */
const DNSC_INSTITUTES = [
  { name: 'Institute of Computing (IC)', programs: [
    'Bachelor of Science in Information Systems (BSIS)',
    'Bachelor of Science in Information Technology (BSIT)' ] },
  { name: 'Institute of Aquatic and Applied Sciences (IAAS)', programs: [
    'Bachelor of Science in Agro-Forestry (BSAF)',
    'Bachelor of Science in Fisheries and Aquatic Sciences (BSFAS)',
    'Bachelor of Science in Food Technology (BSFT)',
    'Bachelor of Science in Marine Biology (BSMB)' ] },
  { name: 'Institute of Leadership, Entrepreneurship, and Good Governance (ILEGG)', programs: [
    'Bachelor of Public Administration (BPA)',
    'Bachelor of Science in Criminology (BSCrim)',
    'Bachelor of Science in Disaster and Resilience Management (BSDRM)',
    'Bachelor of Science in Entrepreneurship (BS ENTREP)',
    'Bachelor of Science in Social Work (BSSW)',
    'Bachelor of Science in Tourism Management (BSTM)' ] },
  { name: 'Institute of Teacher Education (ITED)', programs: [
    'Bachelor of Arts in Communication (BACOMM)',
    'Bachelor of Secondary Education (BSeD) - English',
    'Bachelor of Secondary Education (BSeD) - Mathematics',
    'Bachelor of Secondary Education (BSeD) - Science',
    'Bachelor of Technology and Livelihood Education (BTLEd)',
    'Bachelor of Physical Education (BPE)' ] }
];
const DNSC_PROGRAMS = DNSC_INSTITUTES.flatMap(i => i.programs);
function instituteOfProgram(program) {
  const hit = DNSC_INSTITUTES.find(i => i.programs.includes(program));
  return hit ? hit.name : 'Unassigned';
}
function populateProgramSelects() {
  const sel = document.getElementById('nasProgram');
  if (!sel) return;
  sel.innerHTML = '<option value="">Select degree program…</option>' + DNSC_INSTITUTES.map(i => `<optgroup label="${i.name}">${i.programs.map(pn => `<option>${pn}</option>`).join('')}</optgroup>`).join('');
}
populateProgramSelects();

/* ============================================================
   SAMPLE DATA — NORMALIZED TABLES (mirror the ERD)
   Every record below uses the schema's table and column names.
   The dashboard's view objects (`scholars`, `disbursementHistory`)
   are DERIVED from these tables further down, so the UI reads the
   same shapes as before while the underlying data follows the schema.
   ============================================================ */
const _pad2 = n => String(n).padStart(2, '0');
const _slug = t => String(t).toUpperCase().replace(/[^A-Z0-9]+/g, '_').replace(/^_|_$/g, '');
const _isoLabel = d => d.getFullYear() + '-' + _pad2(d.getMonth() + 1) + '-' + _pad2(d.getDate());
function _fmtDate(iso) {            // 'YYYY-MM-DD…' -> 'Sep 5, 2026' (display only)
  if (!iso) return null;
  return new Date(String(iso).slice(0, 10) + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

/* ---------- USERS & REFERENCE ---------- */
const USERS = [
  { user_id: 1, full_name: OFFICER_NAME, email: 'juan.delacruz@dnsc.edu.ph', password_hash: '(hashed)', role: 'officer', is_active: true, must_change_password: false },
  { user_id: 2, full_name: 'Scholarship Administrator', email: 'admin.scholarships@dnsc.edu.ph', password_hash: '(hashed)', role: 'admin', is_active: true, must_change_password: false }
];
const OFFICERS = [{ user_id: 1 }];
const ADMINS = [{ user_id: 2 }];

const CAMPUSES = ['Main (Panabo Campus)', 'Carmen Campus', 'Samal Campus', 'Talaingod Campus', 'Asuncion Campus']
  .map((campus_name, i) => ({ campus_id: i + 1, campus_name }));

const ACADEMIC_PROGRAMS = (function () {
  let id = 1;
  return DNSC_INSTITUTES.flatMap(inst => inst.programs.map(program_name => {
    const m = program_name.match(/\(([^)]+)\)\s*(?:-\s*(.+))?$/);
    const program_code = m ? (m[2] ? m[1] + '-' + m[2].slice(0, 3).toUpperCase() : m[1]) : _slug(program_name);
    return { program_id: id++, program_code, program_name, institute: inst.name };
  }));
})();

const ACADEMIC_TERMS = [
  { term_id: 1, academic_year: '2024–2025', semester: '2nd Semester', document_deadline: '2025-03-31', is_current: false },
  { term_id: 2, academic_year: '2025–2026', semester: '1st Semester', document_deadline: '2025-09-30', is_current: false },
  { term_id: 3, academic_year: '2025–2026', semester: '2nd Semester', document_deadline: '2026-03-31', is_current: false },
  { term_id: 4, academic_year: CURRENT_AY,  semester: CURRENT_SEM,   document_deadline: '2026-09-30', is_current: true }
];
const termId = (ay, sem) => ACADEMIC_TERMS.find(t => t.academic_year === ay && t.semester === sem).term_id;
const CURRENT_TERM_ID = ACADEMIC_TERMS.find(t => t.is_current).term_id;

/* ---------- SCHOLARSHIP CONFIGURATION ---------- */
const _fundingForCategory = category => category === 'Institutional support' ? 'DNSC Scholarship Trust Fund'
  : (category === 'Partner assistance' ? 'Private sponsor grant' : 'Government scholarship grant');
// scholarship_key = catalog lookup key; scholarship_name = display name (admin label).
const SCHOLARSHIPS = Object.entries(SCHOLARSHIP_CATALOG).map(([scholarship_key, c], i) => ({
  scholarship_id: i + 1, scholarship_code: c.code, scholarship_key, scholarship_name: c.label,
  category: c.category, release_frequency: c.frequency,
  min_amount: c.minAmount, max_amount: c.maxAmount, is_active: true
}));
const scholarshipByName = n => SCHOLARSHIPS.find(s => s.scholarship_key === n);

const SCHOLARSHIP_CLASSIFICATIONS = (function () {
  const rows = []; let id = 1;
  const merit = GRANT_PROGRAM_STIPENDS['CHED Merit Scholarship Program'].classification;
  Object.entries(merit).forEach(([k, v]) => rows.push({ classification_id: id++, scholarship_id: scholarshipByName('CHED Merit Scholarship Program').scholarship_id, classification_name: k === 'full' ? 'Full' : 'Half', amount: v.amount }));
  rows.push({ classification_id: id++, scholarship_id: scholarshipByName('GrabScholar').scholarship_id, classification_name: 'Full', amount: GRANT_PROGRAM_STIPENDS['GrabScholar'].amount });
  return rows;
})();
const classificationFor = (scholarship_name, key) => key && key !== 'na'
  ? SCHOLARSHIP_CLASSIFICATIONS.find(c => c.scholarship_id === scholarshipByName(scholarship_name).scholarship_id && c.classification_name.toLowerCase() === key) || null : null;

// Child tables of SCHOLARSHIPS — rows come straight from the admin catalog.
const SCHOLARSHIP_BENEFITS = (function () {
  const rows = []; let id = 1;
  // benefit_category separates the stipend (has an amount) from other benefits (no stipend amount).
  SCHOLARSHIPS.forEach(s => {
    const c = SCHOLARSHIP_CATALOG[s.scholarship_key];
    [['Stipend', c.stipendBenefits], ['Other Benefit', c.otherBenefits]].forEach(([cat, list]) => list.forEach(b => {
      const m = b.match(/₱\s?([\d,]+)/);
      rows.push({ benefit_id: id++, scholarship_id: s.scholarship_id, benefit_category: cat, benefit_name: b, benefit_type: m ? 'Cash' : 'Non-cash', description: null, amount: m ? Number(m[1].replace(/,/g, '')) : null });
    }));
  });
  return rows;
})();

const SCHOLARSHIP_ELIGIBILITY = (function () {
  const rows = []; let id = 1;
  SCHOLARSHIPS.forEach(s => SCHOLARSHIP_CATALOG[s.scholarship_key].rules.forEach(r => rows.push({ eligibility_id: id++, scholarship_id: s.scholarship_id, criterion_name: 'Criterion', required_value: r })));
  return rows;
})();

const SCHOLARSHIP_REQUIREMENTS = (function () {
  const rows = []; let id = 1;
  SCHOLARSHIPS.forEach(s => SCHOLARSHIP_CATALOG[s.scholarship_key].documents.forEach(name => rows.push({ requirement_id: id++, scholarship_id: s.scholarship_id, doc_key: _docId(name), document_name: name, description: null, where_to_get: null, processing_time: null })));
  return rows;
})();

const SCHOLARSHIP_MAINTENANCE_REQUIREMENTS = (function () {
  const rows = []; let id = 1;
  SCHOLARSHIPS.forEach(s => SCHOLARSHIP_CATALOG[s.scholarship_key].maintenance.forEach(m => rows.push({ maintenance_id: id++, scholarship_id: s.scholarship_id, category: 'Maintenance', title: m, description: 'Per the scholarship guidelines' })));
  return rows;
})();
const requirementFor = (scholarship_id, docKey) => SCHOLARSHIP_REQUIREMENTS.find(r => r.scholarship_id === scholarship_id && r.doc_key === docKey);

/* ---------- SCHOLARS, APPLICATIONS, AWARDS ---------- */
const SCHOLARS = [], ENROLLMENTS = [], SCHOLAR_APPLICATIONS = [], SCHOLARSHIP_AWARDS = [],
      REQUIREMENT_SUBMISSIONS = [], PAYOUT_ACCOUNTS = [], DISBURSEMENTS = [];

const _campusHash = key => { let h = 0; String(key || '').split('').forEach(c => { h = (h * 31 + c.charCodeAt(0)) >>> 0; }); return (h % CAMPUSES.length) + 1; };
function _splitName(full) {
  const t = full.trim().split(/\s+/);
  if (t.length >= 3 && /^[A-Z]\.$/.test(t[1])) return { first_name: t[0], middle_name: t[1], last_name: t.slice(2).join(' ') };
  return { first_name: t[0], middle_name: null, last_name: t.slice(1).join(' ') };
}
const _PROVIDER = { landbank: 'LandBank of the Philippines', ewallet: 'E-Wallet', other: 'Others' };
function payoutAccountFor(scholar_id, payment_channel) {
  let a = PAYOUT_ACCOUNTS.find(p => p.scholar_id === scholar_id && p.payment_channel === payment_channel);
  if (!a) {
    const n = PAYOUT_ACCOUNTS.length + 1;
    a = { payout_account_id: n, scholar_id, payment_channel, account_number: (payment_channel === 'ewallet' ? '0917' : '1234') + String(1000000 + n * 7919).slice(-7), provider: _PROVIDER[payment_channel] || null };
    PAYOUT_ACCOUNTS.push(a);
  }
  return a;
}
/* Seed-data helper: the roster seeds describe documents with four legacy keys (cor / enrollment / goodmoral / income).
   Map them onto each scholarship's REAL required documents from the catalog. */
function _remapSeedDocs(sch, name, legacy) {
  legacy = legacy || {};
  if (!Object.keys(legacy).length) return [];
  const tag = String(name || '').split(' ')[0];
  const reqs = SCHOLARSHIP_REQUIREMENTS.filter(r => r.scholarship_id === sch.scholarship_id);
  const pick = (...ks) => ks.map(k => legacy[k]).find(Boolean);
  const extraSrc = [legacy.income, legacy.goodmoral, legacy.enrollment];
  let ex = 0;
  return reqs.map(r => {
    const n = r.document_name.toLowerCase();
    let src, isExtra = false;
    if (n.includes('registration') || n.includes('(cor)')) src = legacy.cor;
    else if (n.includes('rating') || n.includes('grades')) { src = legacy.enrollment; isExtra = true; }
    else if (n.includes('landbank') || n.includes('card')) { src = legacy.goodmoral; isExtra = true; }
    else if (n.includes('student id')) { src = legacy.income; isExtra = true; }
    else { isExtra = true; src = extraSrc[ex++] || pick('cor', 'enrollment', 'goodmoral'); }
    src = src || pick('income', 'cor', 'enrollment', 'goodmoral');
    const d = Object.assign({}, src);
    if (d.file && isExtra) d.file = r.doc_key + '_' + tag + '.pdf';
    return [r.doc_key, d];
  });
}
/* Sample data: deterministic GWA (1.25 – 2.75) per scholar so every record has a latest GWA to display. */
function sampleGwaFor(scholar_id) { return Math.round((1.25 + ((scholar_id * 7) % 16) * 0.1) * 100) / 100; }
function addScholarRecord(o) {
  const nm = _splitName(o.name);
  const scholar_id = o.scholar_id;
  const user_id = 100 + scholar_id;
  USERS.push({ user_id, full_name: o.name, email: (nm.first_name + '.' + nm.last_name).toLowerCase().replace(/[^a-z.]/g, '') + '@dnsc.edu.ph', password_hash: '(hashed)', role: 'scholar', is_active: true, must_change_password: false });
  const prog = ACADEMIC_PROGRAMS.find(p => p.program_name === o.program_name);
  SCHOLARS.push({
    scholar_id, user_id, scholar_number: 'SCH-' + String(scholar_id).padStart(4, '0'), student_id: o.student_id, ...nm,
    email: USERS[USERS.length - 1].email, alternative_email: null, phone_number: null, birth_date: null, age: null, sex: null, nationality: 'Filipino',
    home_address: null, city: null, province: null, zip_code: null, campus_id: o.campus_id || _campusHash(o.student_id), scholar_status: 'active'
  });
  const sch = scholarshipByName(o.scholarship);
  const cls = classificationFor(o.scholarship, o.classification);
  const award_id = scholar_id;
  SCHOLARSHIP_AWARDS.push({ award_id, scholar_id, scholarship_id: sch.scholarship_id, classification_id: cls ? cls.classification_id : null, award_status: 'active', start_date: o.start_date || '2025-08-15' });
  // Enrollment for the term the scholar is on file for (current term for the roster).
  ENROLLMENTS.push({ enrollment_id: ENROLLMENTS.length + 1, scholar_id, program_id: prog.program_id, term_id: o.term_id, year_level: o.year_level, gwa: (o.gwa != null ? o.gwa : sampleGwaFor(scholar_id)), renewal_status: o.term_id === CURRENT_TERM_ID ? 'enrolled' : 'for_renewal' });
  if (o.application_submitted_at) {
    SCHOLAR_APPLICATIONS.push({
      application_id: SCHOLAR_APPLICATIONS.length + 1, scholar_id, scholarship_id: sch.scholarship_id, classification_id: cls ? cls.classification_id : null,
      program_id: prog.program_id, term_id: o.term_id, campus_id: SCHOLARS[SCHOLARS.length - 1].campus_id, scholar_number: SCHOLARS[SCHOLARS.length - 1].scholar_number,
      student_id: o.student_id, ...nm, email: SCHOLARS[SCHOLARS.length - 1].email, year_level: o.year_level, previous_gwa: null,
      payment_channel: o.payment_channel, account_number: payoutAccountFor(scholar_id, o.payment_channel).account_number, provider: _PROVIDER[o.payment_channel] || null,
      application_status: 'approved', officer_notes: null, admin_remarks: null, submitted_by_officer_id: 1, submitted_at: o.application_submitted_at, reviewed_by_admin_id: 2
    });
  }
  payoutAccountFor(scholar_id, o.payment_channel);
  // Documents → REQUIREMENT_SUBMISSIONS. A document that was never uploaded has NO submission row
  // ("not uploaded" is the absence of a record, not a stored status).
  _remapSeedDocs(sch, o.name, o.docs).forEach(([docKey, d]) => {
    const req = requirementFor(sch.scholarship_id, docKey);
    if (!req || d.status === 'not_uploaded') return;
    const verified = d.status === 'verified';
    REQUIREMENT_SUBMISSIONS.push({
      submission_id: REQUIREMENT_SUBMISSIONS.length + 1, award_id, requirement_id: req.requirement_id, term_id: o.term_id,
      version_no: d.resubmitted ? 2 : 1, file_path: d.file, verification_status: d.status, reviewer_note: d.remarks || null,
      submitted_at: d.submittedAt || null, verified_by_officer_id: verified ? 1 : null, verified_at: verified ? '2026-09-08T10:00:00' : null
    });
  });
}

/* Roster: the 8 named scholars + generated scholars across every program. */
(function seedRoster() {
  const D = (s, f, extra) => Object.assign({ status: s, file: f, remarks: '' }, extra || {});
  const named = [
    { name: 'Maria Santos', student_id: '2026-00124', program_name: 'Bachelor of Science in Information Systems (BSIS)', year_level: 3, scholarship: 'CHED TDP', applied: '2026-09-10', channel: 'landbank', disb: 'batch_generated',
      docs: { cor: D('verified', 'COR_Maria_1stSem2026.pdf'), goodmoral: D('verified', 'GoodMoral_Maria.pdf'), enrollment: D('verified', 'COE_Maria_2026.pdf'), income: D('verified', 'ProofIncome_Maria.pdf') } },
    { name: 'John Reyes', student_id: '2026-00131', program_name: 'Bachelor of Science in Criminology (BSCrim)', year_level: 2, scholarship: 'DOST-SEI', applied: '2026-09-09', channel: 'landbank',
      docs: { cor: D('verified', 'COR_John_1stSem2026.pdf'), goodmoral: D('pending', 'GoodMoral_John.pdf', { submittedAt: '2026-09-10T09:20:00' }), enrollment: D('verified', 'COE_John_2026.pdf'), income: { status: 'requires_update', file: 'ProofIncome_John.pdf', remarks: 'Please upload a clearer copy showing the complete document and signature.' } } },
    { name: 'Anna Garcia', student_id: '2026-00145', program_name: 'Bachelor of Science in Fisheries and Aquatic Sciences (BSFAS)', year_level: 4, scholarship: 'CHED TDP', applied: '2026-09-08', channel: 'landbank',
      docs: { cor: D('verified', 'COR_Anna_1stSem2026.pdf'), goodmoral: D('verified', 'GoodMoral_Anna.pdf'), enrollment: D('verified', 'COE_Anna_2026.pdf'), income: D('verified', 'ProofIncome_Anna.pdf') } },
    { name: 'Pedro Cruz', student_id: '2026-00152', program_name: 'Bachelor of Science in Agro-Forestry (BSAF)', year_level: 1, scholarship: 'CHED TDP', applied: '2026-09-07', channel: 'other',
      docs: { cor: D('pending', 'COR_Pedro_1stSem2026.pdf', { submittedAt: '2026-09-07T08:00:00' }), goodmoral: D('not_uploaded', null), enrollment: D('pending', 'COE_Pedro_2026.pdf', { submittedAt: '2026-09-09T13:00:00' }), income: D('not_uploaded', null) } },
    { name: 'Carla Mendoza', student_id: '2026-00175', program_name: 'Bachelor of Science in Social Work (BSSW)', year_level: 2, scholarship: 'DNSC Academic Scholarship', applied: '2026-09-06', channel: 'other',
      docs: { cor: D('verified', 'COR_Carla_1stSem2026.pdf'), goodmoral: D('verified', 'GoodMoral_Carla.pdf'), enrollment: D('pending', 'COE_Carla_2026.pdf', { submittedAt: '2026-09-10T21:30:00' }), income: D('verified', 'ProofIncome_Carla.pdf') } },
    { name: 'Liza Fernandez', student_id: '2026-00160', program_name: 'Bachelor of Secondary Education (BSeD) - English', year_level: 3, scholarship: 'CHED TES', applied: '2026-09-05', channel: 'ewallet', disb: 'awaiting_ack',
      docs: { cor: D('verified', 'COR_Liza_1stSem2026.pdf'), goodmoral: D('verified', 'GoodMoral_Liza.pdf'), enrollment: D('verified', 'COE_Liza_2026.pdf'), income: D('verified', 'ProofIncome_Liza.pdf') } },
    { name: 'Mark Villanueva', student_id: '2026-00168', program_name: 'Bachelor of Science in Information Technology (BSIT)', year_level: 4, scholarship: 'DOST-SEI', applied: '2026-09-04', channel: 'landbank',
      docs: { cor: D('verified', 'COR_Mark_1stSem2026.pdf'), goodmoral: D('verified', 'GoodMoral_Mark.pdf'), enrollment: D('verified', 'COE_Mark_2026.pdf'), income: D('verified', 'ProofIncome_Mark.pdf') } },
    { name: 'Miguel Torres', student_id: '2026-00182', program_name: 'Bachelor of Science in Tourism Management (BSTM)', year_level: 3, scholarship: 'CHED TES', applied: '2026-09-03', channel: 'ewallet', disb: 'batch_generated',
      docs: { cor: D('verified', 'COR_Miguel_1stSem2026.pdf'), goodmoral: D('verified', 'GoodMoral_Miguel.pdf'), enrollment: D('verified', 'COE_Miguel_2026.pdf'), income: D('verified', 'ProofIncome_Miguel.pdf') } }
  ];
  named.forEach((n, i) => {
    addScholarRecord({ scholar_id: i + 1, name: n.name, student_id: n.student_id, program_name: n.program_name, year_level: n.year_level, scholarship: n.scholarship,
      term_id: CURRENT_TERM_ID, application_submitted_at: n.applied + 'T09:00:00', payment_channel: n.channel, docs: n.docs, campus_id: ((i * 3 + 1) % CAMPUSES.length) + 1 });
    n._disb = n.disb;
  });
  // Batches already generated / awaiting provider acknowledgement (not yet credited).
  named.filter(n => n._disb).forEach(n => {
    const sc = SCHOLARS.find(s => s.student_id === n.student_id);
    DISBURSEMENTS.push({ disbursement_id: DISBURSEMENTS.length + 1, award_id: sc.scholar_id, payout_account_id: payoutAccountFor(sc.scholar_id, n.channel).payout_account_id, term_id: CURRENT_TERM_ID, released_by_officer_id: 1,
      release_period: releasePeriodLabel(n.scholarship), amount: null, funding_source: null, scheduled_release_date: '2026-09-15', release_date: null, credited_at: null, disbursement_status: n._disb, failure_reason: null });
  });

  // Generated scholars so every program appears in the analytics charts.
  const first = ['Angelo','Bea','Carlo','Denise','Elijah','Faith','Gabriel','Hannah','Ian','Jasmine','Kevin','Lara','Migo','Nina','Owen','Patricia','Quinn','Rafael','Sofia','Tomas'];
  const last = ['Alcantara','Bautista','Castillo','Dela Cruz','Estrada','Flores','Gonzales','Herrera','Ignacio','Jimenez','Lopez','Morales','Navarro','Ocampo','Pascual','Ramos','Salazar','Tan','Uy','Valdez'];
  const grants = ['DNSC Academic Scholarship','CHED TDP','CHED TES','CHED Merit Scholarship Program','DOST-SEI','Bagong Pilipinas Scholarship Program','GrabScholar'];
  const perProgram = [8,7,6,5,4,3,5,7,4,5,4,3,4,4,3,3,2,3];
  const mk = (st, file) => ({ status: st, file: st === 'not_uploaded' ? null : file, remarks: st === 'requires_update' ? 'Please upload a clearer copy.' : '' });
  let n = 0, id = 1000;
  DNSC_PROGRAMS.forEach((prog, pi) => {
    for (let k = 0; k < perProgram[pi]; k++, n++) {
      const nm = first[n % first.length] + ' ' + last[(n * 7 + pi) % last.length];
      const mode = n % 6; // 0 none uploaded, 1 needs update, 2 submitted, 3 verified, 4 credited, 5 verified + re-submitted
      const dst = mode === 0 ? ['not_uploaded','not_uploaded','not_uploaded','not_uploaded']
        : mode === 1 ? ['verified','requires_update','verified','submitted']
        : mode === 2 ? ['submitted','pending','verified','submitted']
        : mode === 5 ? ['verified','verified','verified','submitted']
        : ['verified','verified','verified','verified'];
      const tag = nm.split(' ')[0];
      const grant = grants[n % grants.length];
      const cls = grant === 'CHED Merit Scholarship Program' ? (n % 2 ? 'half' : 'full') : (grant === 'GrabScholar' ? 'full' : 'na');
      const channel = ['landbank', 'ewallet', 'other'][n % 3];
      const sid = id++;
      addScholarRecord({ scholar_id: sid, name: nm, student_id: '2026-' + String(200 + n).padStart(5, '0'), program_name: prog, year_level: (n % 4) + 1, scholarship: grant, classification: cls,
        term_id: CURRENT_TERM_ID, application_submitted_at: '2026-09-' + _pad2(1 + (n % 9)) + 'T09:00:00', payment_channel: channel,
        campus_id: ((SCHOLARS.length * 3 + 1) % CAMPUSES.length) + 1,
        docs: { cor: mk(dst[0], 'COR_' + tag + '.pdf'), goodmoral: mk(dst[1], 'GoodMoral_' + tag + '.pdf'), enrollment: mk(dst[2], 'COE_' + tag + '.pdf'),
                income: Object.assign(mk(dst[3], 'ProofIncome_' + tag + '.pdf'), mode === 5 ? { resubmitted: true, remarks: 'Re-uploaded after correction request.' } : {}) } });
      if (mode === 4 && scholarshipHasStipend(grant)) SCHOLARS[SCHOLARS.length - 1]._creditedThisTerm = true; // handled in disbursement seeding below
    }
  });
})();

/* Scholars who were paid in earlier terms or are awaiting their current-term payout but
   have not yet filed a current-term application (so they are not on the active roster). */
[
  ['Rhea M. Caspillo', '2025-00842', 'CHED TDP'], ['Dominic S. Yu', '2025-00837', 'CHED TDP'],
  ['Jessa P. Ramos', '2025-00991', 'DOST-SEI'], ['Kevin L. Ortega', '2025-00987', 'CHED TES'],
  ['Nicole B. Fernandez', '2025-00778', 'DOST-SEI'], ['Paolo V. Rivera', '2025-00764', 'DOST-SEI'],
  ['Charmaine O. Dee', '2025-00690', 'CHED TDP'], ['Harold T. Uy', '2025-00655', 'GrabScholar']
].forEach(([name, student_id, scholarship], i) => {
  addScholarRecord({ scholar_id: 500 + i, name, student_id, program_name: DNSC_PROGRAMS[(i * 5 + 2) % DNSC_PROGRAMS.length], year_level: 2 + (i % 3), scholarship, classification: scholarship === 'GrabScholar' ? 'full' : 'na',
    term_id: termId('2025–2026', '2nd Semester'), payment_channel: 'landbank', docs: {} });
});

/* ---------- DISBURSEMENTS ---------- */
const _scholarByStudentId = sid => SCHOLARS.find(s => s.student_id === sid);
const _awardOf = scholar_id => SCHOLARSHIP_AWARDS.find(a => a.scholar_id === scholar_id);
const _awardHasStipend = award => scholarshipHasStipend(SCHOLARSHIPS.find(s => s.scholarship_id === award.scholarship_id).scholarship_key);
const _scholarHasStipend = sc => _awardHasStipend(_awardOf(sc.scholar_id));
function _amountForAward(award) {
  const sch = SCHOLARSHIPS.find(s => s.scholarship_id === award.scholarship_id);
  const cls = SCHOLARSHIP_CLASSIFICATIONS.find(c => c.classification_id === award.classification_id);
  return getScholarStipendAmount({ scholarship: sch.scholarship_key, classification: cls ? cls.classification_name.toLowerCase() : 'na' });
}
function _fundingOf(award) { return _fundingForCategory(SCHOLARSHIPS.find(s => s.scholarship_id === award.scholarship_id).category); }
function addDisbursement(o) {          // o: student_id, ay, semester, channel, release_date (ISO|null), status
  const sc = _scholarByStudentId(o.student_id), award = _awardOf(sc.scholar_id);
  if (!_awardHasStipend(award)) return; // DNSC internal scholarships carry no stipend → no disbursement rows
  const credited = o.disbursement_status === 'credited';
  DISBURSEMENTS.push({
    disbursement_id: DISBURSEMENTS.length + 1, award_id: award.award_id, payout_account_id: payoutAccountFor(sc.scholar_id, o.payment_channel).payout_account_id,
    term_id: termId(o.academic_year, o.semester), released_by_officer_id: 1, release_period: (SCHOLARSHIP_CATALOG[SCHOLARSHIPS.find(x => x.scholarship_id === award.scholarship_id).scholarship_key].frequency === 'Per month' && o.release_date ? ['January','February','March','April','May','June','July','August','September','October','November','December'][Number(o.release_date.slice(5, 7)) - 1] + ' ' + o.release_date.slice(0, 4) : o.semester + ' ' + o.academic_year), amount: _amountForAward(award),
    funding_source: _fundingOf(award), scheduled_release_date: o.release_date || '2026-09-20', release_date: credited ? o.release_date : null,
    credited_at: credited ? o.release_date + 'T14:00:00' : null, disbursement_status: o.disbursement_status, failure_reason: null
  });
}
// Fill amount/funding on the batch rows created for the roster above.
DISBURSEMENTS.forEach(d => { const a = SCHOLARSHIP_AWARDS.find(x => x.award_id === d.award_id); d.amount = _amountForAward(a); d.funding_source = _fundingOf(a); });

const _CUR = { academic_year: CURRENT_AY, semester: CURRENT_SEM }, _PY = '2025–2026';
[
  ['2026-00145', _CUR.academic_year, _CUR.semester, 'landbank', '2026-09-05', 'credited'],
  ['2025-00842', _CUR.academic_year, _CUR.semester, 'landbank', null, 'pending'],
  ['2025-00837', _CUR.academic_year, _CUR.semester, 'other', null, 'pending'],
  ['2025-00991', _CUR.academic_year, _CUR.semester, 'other', '2026-09-02', 'credited'],
  ['2025-00987', _CUR.academic_year, _CUR.semester, 'ewallet', '2026-08-28', 'credited'],
  ['2026-00168', _CUR.academic_year, _CUR.semester, 'landbank', '2026-08-30', 'credited']
  // Prior-term history is generated per scholar by release frequency in seedDisbursements() below.
].forEach(([student_id, academic_year, semester, payment_channel, release_date, disbursement_status]) => addDisbursement({ student_id, academic_year, semester, payment_channel, release_date, disbursement_status }));

// Prior-term and recent releases so the history page and Disbursement Distribution chart have realistic volume.
(function seedDisbursements() {
  // Every roster scholar generated as already credited this term gets a September record.
  SCHOLARS.filter(s => s._creditedThisTerm).forEach((s, i) => {
    const ch = PAYOUT_ACCOUNTS.find(p => p.scholar_id === s.scholar_id).payment_channel;
    addDisbursement({ student_id: s.student_id, academic_year: CURRENT_AY, semester: CURRENT_SEM, payment_channel: ch, disbursement_status: 'credited', release_date: '2026-09-' + _pad2(1 + (i % 26)) });
  });

  /* Frequency-aware history. Each stipend scholar gets history that matches how their scholarship is released:
     - Per month (DOST-SEI, GrabScholar)  → one payout per MONTH (period "October 2025").
     - Everyone else (semestral releases: CHED TDP, CHED TES, CHED Merit, Bagong Pilipinas) → exactly ONE payout per SEMESTER
       (period "1st Semester 2025–2026"), never several payouts inside the same semester. */
  const MN = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  const keyOf = sc => SCHOLARSHIPS.find(x => x.scholarship_id === _awardOf(sc.scholar_id).scholarship_id).scholarship_key;
  const isMonthly = sc => SCHOLARSHIP_CATALOG[keyOf(sc)].frequency === 'Per month';
  const chanOf = sc => PAYOUT_ACCOUNTS.find(x => x.scholar_id === sc.scholar_id).payment_channel;
  const yearOf = sc => (ENROLLMENTS.find(e => e.scholar_id === sc.scholar_id) || {}).year_level || 1;
  const dayOf = (sc, m) => _pad2(3 + ((sc.scholar_id * 3 + m * 5) % 24));
  const periodOf = (sc, ay, sem, iso) => isMonthly(sc) ? MN[Number(iso.slice(5, 7)) - 1] + ' ' + iso.slice(0, 4) : sem + ' ' + ay;
  const pay = (sc, ay, sem, iso) => {
    const award = _awardOf(sc.scholar_id), period = periodOf(sc, ay, sem, iso);
    if (DISBURSEMENTS.some(d => d.award_id === award.award_id && d.release_period === period)) return; // one per period
    addDisbursement({ student_id: sc.student_id, academic_year: ay, semester: sem, payment_channel: chanOf(sc), disbursement_status: 'credited', release_date: iso });
  };
  const stipendScholars = SCHOLARS.filter(sc => _scholarHasStipend(sc));

  // Prior terms (2025–2026). First-year scholars have no earlier payouts.
  stipendScholars.filter(sc => yearOf(sc) >= 2).forEach(sc => {
    if (isMonthly(sc)) {
      [[2025, 8], [2025, 9], [2025, 10], [2025, 11], [2025, 12], [2026, 1]].forEach(([y, m]) => pay(sc, _PY, '1st Semester', y + '-' + _pad2(m) + '-' + dayOf(sc, m)));
      [[2026, 2], [2026, 3], [2026, 4], [2026, 5], [2026, 6]].forEach(([y, m]) => pay(sc, _PY, '2nd Semester', y + '-' + _pad2(m) + '-' + dayOf(sc, m)));
    } else {
      pay(sc, _PY, '1st Semester', '2025-' + (10 + (sc.scholar_id % 2)) + '-' + dayOf(sc, 10));
      pay(sc, _PY, '2nd Semester', '2026-' + _pad2(3 + (sc.scholar_id % 2)) + '-' + dayOf(sc, 3));
    }
  });

  // Current term for payees who are not on the active roster (their DISBURSEMENTS rows are the source of truth).
  stipendScholars.filter(sc => sc.scholar_id >= 500 && sc.scholar_id < 1000).forEach(sc => {
    pay(sc, CURRENT_AY, CURRENT_SEM, '2026-08-' + dayOf(sc, 8));
    if (isMonthly(sc)) pay(sc, CURRENT_AY, CURRENT_SEM, '2026-09-0' + (3 + (sc.scholar_id % 6)));
  });

  // Monthly scholars paid in a later month this term also have the earlier months of the term on record.
  stipendScholars.filter(isMonthly).forEach(sc => {
    const award = _awardOf(sc.scholar_id);
    DISBURSEMENTS.filter(d => d.award_id === award.award_id && d.term_id === CURRENT_TERM_ID && d.disbursement_status === 'credited' && d.release_date).forEach(d => {
      const last = Number(d.release_date.slice(5, 7));
      for (let m = 8; m < last; m++) pay(sc, CURRENT_AY, CURRENT_SEM, '2026-' + _pad2(m) + '-' + dayOf(sc, m));
    });
  });
})();

/* ============================================================
   VIEW MODEL — derived from the tables above (UI reads these)
   - payment_channel is the scholar's payout channel (PAYOUT_ACCOUNTS)
   - disbursement status/dates come from DISBURSEMENTS, not a Boolean
   - "not uploaded" = no REQUIREMENT_SUBMISSIONS row for that requirement
   ============================================================ */
const _currentDisbursement = scholar_id => {
  const award = _awardOf(scholar_id);
  const rows = DISBURSEMENTS.filter(d => d.award_id === award.award_id && d.term_id === CURRENT_TERM_ID);
  return rows.find(d => d.disbursement_status === 'credited') || rows[rows.length - 1] || null;
};
function buildScholarView(sc) {
  const award = _awardOf(sc.scholar_id), sch = SCHOLARSHIPS.find(s => s.scholarship_id === award.scholarship_id);
  const cls = SCHOLARSHIP_CLASSIFICATIONS.find(c => c.classification_id === award.classification_id);
  const enr = ENROLLMENTS.find(e => e.scholar_id === sc.scholar_id && e.term_id === CURRENT_TERM_ID);
  const prog = ACADEMIC_PROGRAMS.find(p => p.program_id === enr.program_id), term = ACADEMIC_TERMS.find(t => t.term_id === enr.term_id);
  const app = SCHOLAR_APPLICATIONS.find(a => a.scholar_id === sc.scholar_id && a.term_id === CURRENT_TERM_ID);
  const acct = PAYOUT_ACCOUNTS.find(p => p.scholar_id === sc.scholar_id);
  const docs = {};
  DOC_TYPES.forEach(dt => {
    const req = requirementFor(sch.scholarship_id, dt.id);
    const sub = req && REQUIREMENT_SUBMISSIONS.filter(r => r.award_id === award.award_id && r.requirement_id === req.requirement_id && r.term_id === CURRENT_TERM_ID).sort((a, b) => b.version_no - a.version_no)[0];
    docs[dt.id] = sub
      ? Object.assign({ status: sub.verification_status, file: sub.file_path, remarks: sub.reviewer_note || '' }, sub.submitted_at ? { submittedAt: sub.submitted_at } : {}, sub.version_no > 1 ? { resubmitted: true } : {})
      : { status: 'not_uploaded', file: null, remarks: '' };
  });
  const disb = _currentDisbursement(sc.scholar_id);
  const view = {
    id: sc.scholar_id, name: [sc.first_name, sc.middle_name, sc.last_name].filter(Boolean).join(' '), student_id: sc.student_id, scholar_number: sc.scholar_number,
    program_code: prog.program_code, program_name: prog.program_name, institute: prog.institute, yearLevel: enr.year_level,
    scholarship: sch.scholarship_key, classification: cls ? cls.classification_name.toLowerCase() : 'na',
    term_id: term.term_id, academic_year: term.academic_year, semester: term.semester,
    application_submitted_date: app ? _fmtDate(app.submitted_at) : '–',
    payment_channel: acct.payment_channel, accountNumber: acct.account_number, accountProvider: acct.provider, disbursement: disb, school: CAMPUSES.find(c => c.campus_id === sc.campus_id).campus_name,
    docs
  };
  const sub = disb && disb.disbursement_status !== 'credited' && disb.disbursement_status !== 'pending' ? disb.disbursement_status : null;
  if (sub) view.subStatus = sub;
  return view;
}
const isCredited = s => !!(s && s.disbursement && s.disbursement.disbursement_status === 'credited');
// DNSC internal scholarships carry no stipend; instead the officer marks the scholar as complete so benefits can be awarded in person.
const isDnscScholar = s => !!s && !scholarshipHasStipend(s.scholarship);
const isMarkedComplete = s => !!(s && s.benefitsComplete);

let scholars = SCHOLARS.filter(sc => ENROLLMENTS.some(e => e.scholar_id === sc.scholar_id && e.term_id === CURRENT_TERM_ID)).map(buildScholarView);

function disbursementToHistoryRow(d) {
  const award = SCHOLARSHIP_AWARDS.find(a => a.award_id === d.award_id), sc = SCHOLARS.find(s => s.scholar_id === award.scholar_id);
  const acct = PAYOUT_ACCOUNTS.find(p => p.payout_account_id === d.payout_account_id), term = ACADEMIC_TERMS.find(t => t.term_id === d.term_id);
  return {
    disbursement_id: d.disbursement_id, scholar: [sc.first_name, sc.middle_name, sc.last_name].filter(Boolean).join(' '), student_id: sc.student_id,
    semester: term.semester, academic_year: term.academic_year, release_period: d.release_period, amount: d.amount, date: _fmtDate(d.release_date),
    release_date: d.release_date, credited_at: d.credited_at, disbursement_status: d.disbursement_status, funding_source: d.funding_source,
    releasedBy: USERS.find(u => u.user_id === d.released_by_officer_id).full_name,
    status: d.disbursement_status === 'credited' ? 'Released' : 'Pending', payment_channel: acct.payment_channel
  };
}
// History page shows credited and still-pending payouts (batch-generated / awaiting-ack rows live in the release workflow).
let disbursementHistory = DISBURSEMENTS.filter(d => d.disbursement_status === 'credited' || d.disbursement_status === 'pending').map(disbursementToHistoryRow);

// Called when an officer confirms a disbursement: writes the DISBURSEMENTS row, then refreshes the view objects.
function recordCreditedDisbursement(s) {
  const today = _isoLabel(new Date());
  const award = _awardOf(s.id);
  let d = DISBURSEMENTS.find(x => x.award_id === award.award_id && x.term_id === CURRENT_TERM_ID && x.disbursement_status !== 'credited');
  if (!d) {
    d = { disbursement_id: DISBURSEMENTS.length + 1, award_id: award.award_id, payout_account_id: payoutAccountFor(s.id, s.payment_channel).payout_account_id, term_id: CURRENT_TERM_ID, released_by_officer_id: 1,
      release_period: releasePeriodLabel(s.scholarship), amount: getScholarStipendAmount(s), funding_source: _fundingOf(award), scheduled_release_date: today, release_date: null, credited_at: null, disbursement_status: 'pending', failure_reason: null };
    DISBURSEMENTS.push(d);
  }
  d.amount = getScholarStipendAmount(s); d.release_date = today; d.credited_at = new Date().toISOString(); d.disbursement_status = 'credited';
  s.disbursement = d; delete s.subStatus;
  disbursementHistory.push(disbursementToHistoryRow(d));
}

