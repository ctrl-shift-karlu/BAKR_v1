        <div class="col-6"><div class="info-item"><div class="info-label">Email</div><div class="info-value">${epmVal('epmEmail') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Alternative Email</div><div class="info-value">${epmVal('epmAltEmail') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Phone Number</div><div class="info-value">${epmVal('epmContact') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Home Address</div><div class="info-value">${epmVal('epmSpecificAddress') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">City</div><div class="info-value">${epmVal('epmCity') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Province</div><div class="info-value">${epmVal('epmProvince') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">ZIP Code</div><div class="info-value">${epmVal('epmZip') || '–'}</div></div></div>
      </div>
    </div>
    <div class="as-review-section">
      <div class="as-review-heading">Academic Details</div>
      <div class="row info-grid">
        <div class="col-6"><div class="info-item"><div class="info-label">Campus</div><div class="info-value">${epmVal('epmInstitute') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Program</div><div class="info-value">${epmVal('epmProgram') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Year Level</div><div class="info-value">${(document.getElementById('epmYearLevel').selectedOptions[0] || {}).text || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Student ID</div><div class="info-value">${epmVal('epmStudentId') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Academic Year</div><div class="info-value">${epmVal('epmAcademicYear') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Semester</div><div class="info-value">${epmVal('epmSemester') || '–'}</div></div></div>
        <div class="col-6"><div class="info-item"><div class="info-label">Previous GWA</div><div class="info-value">${epmVal('epmGwa') !== '' && !isNaN(epmVal('epmGwa')) ? Number(epmVal('epmGwa')).toFixed(2) : '–'}</div></div></div>
