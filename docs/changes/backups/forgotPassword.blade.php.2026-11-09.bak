<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>Forgot Password — Officer Portal</title>
<link rel="icon" type="image/png" href="{{ asset('images/logo/bakr-logo.png') }}">
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
<style>
  :root {
    --vanilla: #fbf7ee;
    --surface: #fffefa;
    --vanilla-deep: #f4eede;
    --green-900: #1e3b2a;
    --green-700: #29553b;
    --green-600: #2f6641;
    --green-500: #3e7b50;
    --sage: #7e9c86;
    --sage-tint: #eaf0e8;
    --gold: #b8912f;
    --gold-tint: #fbf1dc;
    --ink: #23281f;
    --ink-soft: #5b6357;
    --border: #e6dfc9;
    --danger: #b42318;
    color-scheme: light;
  }
  * { box-sizing: border-box; }
  html { -webkit-tap-highlight-color: transparent; scroll-padding-top: env(safe-area-inset-top, 0px); }
  body {
    margin: 0;
    min-height: 100svh;
    background: var(--vanilla);
    color: var(--ink);
    font-family: "Inter", sans-serif;
    -webkit-font-smoothing: antialiased;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 28px calc(20px + env(safe-area-inset-right,0px)) calc(28px + env(safe-area-inset-bottom,0px)) calc(20px + env(safe-area-inset-left,0px));
  }
  h1, h2, .display { font-family: "Poppins", sans-serif; letter-spacing: -0.01em; }
  .serif { font-family: "Poppins", sans-serif; font-weight: 600; }
  ::selection { background: var(--gold-tint); color: var(--green-900); }

  .stage {
    width: 100%;
    max-width: 960px;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0 40px 0 40px;
    box-shadow: 0 30px 60px -30px rgba(30, 59, 42, 0.28);
    overflow: hidden;
  }

  /* ============ LEFT: FORM ============ */
  .panel-form {
    padding: 46px 44px 40px;
    display: flex;
    flex-direction: column;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 40px;
  }
  .brand-mark {
    width: 30px;
    height: 30px;
    border-radius: 0 9px 0 9px;
    background: linear-gradient(135deg, var(--sage), var(--green-700));
    flex-shrink: 0;
    box-shadow: 0 2px 6px rgba(30,59,42,0.25);
  }
  .brand-name {
    font-family: "Poppins", sans-serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--green-900);
  }
  .brand-tag {
    color: var(--ink-soft);
    font-size: 10px;
    letter-spacing: 0.09em;
    margin-left: 4px;
    font-weight: 600;
  }

  .form-head { margin-bottom: 30px; }
  .form-head h1 {
    font-size: 26px;
    font-weight: 700;
    color: var(--green-900);
    margin: 0 0 8px;
  }
  .form-head p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 14.5px;
    line-height: 1.5;
  }

  form { display: flex; flex-direction: column; gap: 18px; }
  .field label {
    display: block;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 7px;
  }
  .input-wrap { position: relative; }
  .input-wrap input {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: var(--vanilla);
    font-family: "Inter", sans-serif;
    font-size: 14.5px;
    color: var(--ink);
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .input-wrap input::placeholder { color: #a3a893; }
  .input-wrap input:focus {
    border-color: var(--sage);
    box-shadow: 0 0 0 3px var(--sage-tint);
    background: var(--surface);
  }
  .field.invalid .input-wrap input {
    border-color: var(--danger);
    box-shadow: 0 0 0 3px rgba(180, 35, 24, 0.1);
  }
  .field-error {
    display: none;
    margin: 7px 0 0;
    font-size: 12.5px;
    color: var(--danger);
  }
  .field.invalid .field-error { display: block; }
  .hint {
    margin: 7px 0 0;
    font-size: 12.5px;
    color: var(--ink-soft);
    line-height: 1.5;
  }

  .btn-signin {
    margin-top: 6px;
    width: 100%;
    padding: 13px;
    border: none;
    border-radius: 11px;
    background: linear-gradient(135deg, var(--green-600), var(--green-900));
    color: var(--vanilla);
    font-family: "Poppins", sans-serif;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.03em;
    cursor: pointer;
    box-shadow: 0 12px 24px -12px rgba(30, 59, 42, 0.55);
    transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
  }
  .btn-signin:hover { transform: translateY(-1px); box-shadow: 0 16px 28px -12px rgba(30, 59, 42, 0.6); }
  .btn-signin:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
  .btn-signin:disabled { opacity: 0.7; cursor: default; transform: none; }

  .btn-ghost {
    width: 100%;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: var(--vanilla);
    color: var(--green-700);
    font-family: "Poppins", sans-serif;
    font-weight: 600;
    font-size: 13.5px;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .btn-ghost:hover:not(:disabled) { background: var(--sage-tint); border-color: var(--sage); }
  .btn-ghost:focus-visible { outline: 2px solid var(--sage); outline-offset: 2px; }
  .btn-ghost:disabled { color: var(--ink-soft); cursor: default; }

  /* success state */
  .sent { display: none; flex-direction: column; gap: 18px; }
  .stage.is-sent form.request { display: none; }
  .stage.is-sent .sent { display: flex; }
  .stage.is-sent .form-head.request-head { display: none; }
  .sent-head { display: none; margin-bottom: 4px; }
  .stage.is-sent .sent-head { display: block; }
  .sent-icon {
    width: 52px; height: 52px;
    border-radius: 50% 50% 50% 6px;
    background: var(--sage-tint);
    color: var(--green-700);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 18px;
  }
  .sent-email { color: var(--green-900); font-weight: 600; word-break: break-all; }
  .sent-note {
    background: var(--gold-tint);
    border: 1px solid #efdfb6;
    border-radius: 11px;
    padding: 12px 14px;
    font-size: 13px;
    color: var(--ink-soft);
    line-height: 1.5;
    margin: 0;
  }

  .back-link { margin-top: 22px; width: 100%; text-align: left; }
  .back-link a {
    font-size: 12.5px;
    color: var(--green-500);
    font-weight: 600;
    text-decoration: none;
  }
  .back-link a:hover { text-decoration: underline; }
  .back-link a:focus-visible { outline: 2px solid var(--sage); border-radius: 4px; }

  .spacer { flex: 1; min-height: 22px; }
  .foot-note {
    text-align: center;
    font-size: 11.5px;
    color: #9ba193;
  }

  /* ============ RIGHT: VISUAL PANEL ============ */
  .panel-visual {
    position: relative;
    background-image:
      radial-gradient(560px 320px at 100% 0%, rgba(184, 145, 47, 0.28), transparent 60%),
      linear-gradient(190deg, rgba(41, 85, 59, 0.86), rgba(30, 59, 42, 0.9)),
      url("https://i.ytimg.com/vi/wxgmUyT4CAY/maxresdefault.jpg");
    background-size: cover, cover, cover;
    background-position: center, center, center;
    background-color: var(--green-900);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
  }
  .panel-visual::before {
    content: "";
    position: absolute;
    top: -60px;
    right: -80px;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    border: 1px solid rgba(251, 247, 238, 0.1);
  }
  .panel-visual::after {
    content: "";
    position: absolute;
    bottom: -90px;
    left: -70px;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    border: 1px solid rgba(251, 247, 238, 0.08);
  }
  .visual-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 2;
  }
  .visual-copy {
    text-align: center;
    color: var(--vanilla);
    margin-bottom: 26px;
  }
  .visual-copy .serif {
    font-size: 21px;
    font-weight: 500;
    margin: 0 0 6px;
  }
  .visual-copy p {
    margin: 0;
    font-size: 13px;
    color: var(--vanilla-deep);
    opacity: 0.85;
  }

  .orbit { position: relative; width: 240px; height: 240px; }
  .orbit-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px dashed rgba(251, 247, 238, 0.22);
  }
  .orbit-core {
    position: absolute;
    top: 50%; left: 50%;
    width: 74px; height: 74px;
    transform: translate(-50%, -50%);
    border-radius: 50% 50% 50% 6px;
    background: linear-gradient(135deg, var(--gold), #8f6f21);
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 10px 24px -8px rgba(0,0,0,0.5);
    color: var(--vanilla);
  }
  .orbit-core svg { width: 34px; height: 34px; }
  .badge {
    position: absolute;
    width: 52px; height: 52px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: var(--vanilla);
    box-shadow: 0 10px 20px -8px rgba(0,0,0,0.45);
  }
  .badge svg { width: 24px; height: 24px; }
  .b1 { top: -4px; left: 50%; transform: translateX(-50%); background: #eef4f0; color: var(--green-700); }
  .b2 { bottom: 22px; right: 2px; background: var(--gold-tint); color: #a3782a; }
  .b3 { bottom: 22px; left: 2px; background: var(--sage-tint); color: var(--green-600); }

  /* ============ RESPONSIVE ============ */
  @media (max-width: 820px) {
    .stage { grid-template-columns: 1fr; max-width: 460px; border-radius: 0 32px 0 32px; }
    .panel-visual { order: -1; padding: 34px 24px; }
    .orbit { width: 180px; height: 180px; }
    .orbit-core { width: 58px; height: 58px; }
    .orbit-core svg { width: 26px; height: 26px; }
    .badge { width: 42px; height: 42px; }
    .badge svg { width: 19px; height: 19px; }
    .visual-copy { margin-bottom: 22px; }
    .visual-copy .serif { font-size: 18px; }
    .panel-form { padding: 34px 26px 28px; }
  }
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; }
  }
</style>
</head>
<body>
  <div class="stage" id="stage">
    <!-- LEFT: FORM -->
    <div class="panel-form">
      <div class="brand">
        <div class="brand-mark"></div>
        <span class="brand-name">BAKR</span>
        <span class="brand-tag">PORTAL</span>
      </div>

      <!-- Step 1: request -->
      <div class="form-head request-head">
        <h1>Forgot your password?</h1>
        <p>Enter the email specifically linked to your BAKR account and we'll send you a link to reset it.</p>
      </div>

      <form class="request" id="resetForm" novalidate>
        <div class="field" id="emailField">
          <label for="email">Email</label>
          <div class="input-wrap">
            <input id="email" type="email" placeholder="Enter your email" autocomplete="username" aria-describedby="emailError" />
          </div>
          <p class="field-error" id="emailError" role="alert">Enter a valid email address.</p>
        </div>

        <button type="submit" class="btn-signin" id="sendBtn">Send reset link</button>
      </form>

      <!-- Step 2: sent -->
      <div class="sent-head">
        <div class="sent-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
        </div>
        <div class="form-head" style="margin-bottom:0">
          <h1>Check your email</h1>
          <p>If an account exists for <span class="sent-email" id="sentEmail"></span>, a reset link is on its way.</p>
        </div>
      </div>

      <div class="sent" id="sentPanel" aria-live="polite">
        <p class="sent-note">The link expires in 30 minutes. If you don't see it, check your spam folder.</p>
        <button type="button" class="btn-ghost" id="resendBtn">Resend link</button>
        <button type="button" class="btn-ghost" id="changeBtn">Use a different email</button>
      </div>

      <div class="back-link">
        <a href="{{ asset('officerLogin') }}">Back to sign in</a>
      </div>

      <div class="spacer"></div>
      <div class="foot-note">BAKR · Portal</div>
    </div>

    <!-- RIGHT: VISUAL -->
    <div class="panel-visual">
      <div class="visual-inner">
        <div class="visual-copy">
          <p class="serif">Locked out? It happens.</p>
          <p>Reset your password and get back to your applications</p>
        </div>

      </div>
    </div>
  </div>

  <script>
    const stage = document.getElementById('stage');
    const form = document.getElementById('resetForm');
    const emailInput = document.getElementById('email');
    const emailField = document.getElementById('emailField');
    const sendBtn = document.getElementById('sendBtn');
    const resendBtn = document.getElementById('resendBtn');
    const changeBtn = document.getElementById('changeBtn');
    const sentEmail = document.getElementById('sentEmail');
    let cooldownTimer = null;

    const validEmail = v => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);

    emailInput.addEventListener('input', () => emailField.classList.remove('invalid'));

    function startCooldown(seconds) {
      let left = seconds;
      resendBtn.disabled = true;
      clearInterval(cooldownTimer);
      const tick = () => {
        if (left <= 0) {
          clearInterval(cooldownTimer);
          resendBtn.disabled = false;
          resendBtn.textContent = 'Resend link';
          return;
        }
        resendBtn.textContent = 'Resend link in ' + left + 's';
        left--;
      };
      tick();
      cooldownTimer = setInterval(tick, 1000);
    }

    function sendLink(email) {
      // TODO: replace with a real request, e.g. fetch('forgot_password.php', { method: 'POST', body: ... })
      sentEmail.textContent = email;
      stage.classList.add('is-sent');
      startCooldown(30);
    }

    form.addEventListener('submit', e => {
      e.preventDefault();
      const email = emailInput.value.trim();
      if (!validEmail(email)) {
        emailField.classList.add('invalid');
        emailInput.focus();
        return;
      }
      sendBtn.disabled = true;
      sendBtn.textContent = 'Sending…';
      setTimeout(() => {
        sendBtn.disabled = false;
        sendBtn.textContent = 'Send reset link';
        sendLink(email);
      }, 600);
    });

    resendBtn.addEventListener('click', () => {
      // TODO: call the same endpoint again
      startCooldown(30);
    });

    changeBtn.addEventListener('click', () => {
      clearInterval(cooldownTimer);
      stage.classList.remove('is-sent');
      emailInput.focus();
      emailInput.select();
    });
  </script>
</body>
</html>
