.offcanvas-backdrop.show { background-color: rgba(0,0,0,.4); opacity: 1; }
body.offcanvas-open { overflow: hidden; }
@media (max-width: 767.98px) {
.directory-action,
.apc-action,
.btn-view-sm,
.btn-reject-sm,
.btn-ineligible-sm { min-height: 44px;
    min-width: 44px;
    padding: .65rem .85rem; }
}
.dashboard-kpi-filters { display:grid; grid-template-columns:auto 1fr; gap:.35rem .5rem; margin-top:.75rem; padding-top:.7rem; border-top:1px solid var(--border-subtle); }
.dashboard-kpi-filters label { font-size:.75rem; align-self:center; color:var(--text-muted); }
.dashboard-kpi-filters select { min-width:0; min-height:34px; padding:.3rem .45rem; border:1px solid var(--border-subtle); border-radius:8px; background:var(--surface-card); color:var(--text-primary); font:inherit; font-size:.75rem; }
.summary-scope-filter { margin-bottom:1rem; }
@media(max-width:575.98px) {
.dashboard-kpi-filters { grid-template-columns:1fr }
.dashboard-kpi-filters label { margin-top:.2rem }
}
.analytics-widget-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: stretch; gap: 1.25rem; }
.analytics-widget-grid > .analytics-widget:last-child { grid-column: auto; }
.bar-chart { gap: .55rem; height: 220px; padding-top: .25rem; }
.bar-col { gap: .12rem; justify-content: flex-end; }
.bar-label { min-height: 2.4em; display:flex; align-items:flex-start; justify-content:center; line-height:1.2; font-size:.75rem; }
.donut-chart { background: conic-gradient(var(--color-brand-primary) 0 82%, var(--color-brand-accent) 82% 94%, var(--sd-danger) 94% 100%); }
.donut-layout { min-height: 220px; gap: 1.1rem; }
.dashboard-scholar-filter-card { min-width: 0; }
@media (max-width: 900px) {
.analytics-widget-grid { grid-template-columns: 1fr; }
.analytics-widget-grid > .analytics-widget:last-child { grid-column: auto; }
}
.analytics-widget-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.analytics-widget-grid > .analytics-widget:last-child { grid-column: auto; }
.analytics-widget .donut-layout { flex-wrap: wrap; justify-content: center; }
.analytics-widget .chart-legend { min-width: 0; }
@media (max-width: 575.98px) {
.analytics-widget-grid { grid-template-columns: 1fr; }
}
.scholars-filter-merged.directory-filter-row.filter-bar { background: transparent !important; border: 0 !important; border-bottom: 1px solid var(--sd-border) !important; border-radius: 0 !important;
  box-shadow: none !important; transform: none !important; padding: 0 0 .9rem !important; margin: 0 0 .75rem !important; }
#page-dashboard .kpi-card .kpi-top { min-height: 40px; align-items: center; }
#page-dashboard .kpi-card .kpi-sub { margin-top: auto; }
.row-card-mobile .rc-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .6rem; }
.row-card-mobile .rc-actions button { flex: 1 1 auto; }
@media (min-width: 1280px) {
#page-manage-scholars .table-app-wrap { overflow-x: visible; box-shadow: none; }
#page-manage-scholars .table-app-wrap::after { display: none; }
#pendingApprovalsTable,
#scholarDirectoryTable { table-layout: fixed; width: 100%; min-width: 0; }
#pendingApprovalsTable th,
#pendingApprovalsTable td,
#scholarDirectoryTable th,
#scholarDirectoryTable td { min-width: 0 !important; overflow-wrap: anywhere; }
#pendingApprovalsTable thead th,
#scholarDirectoryTable thead th { height: auto; padding: .7rem .6rem; line-height: 1.25; white-space: normal; }
#pendingApprovalsTable tbody td,
#scholarDirectoryTable tbody td { height: auto; padding: .6rem .6rem; line-height: 1.35; vertical-align: middle; }
#pendingApprovalsTable .program-chip,
#scholarDirectoryTable .program-chip { white-space: nowrap; }
#scholarDirectoryTable .lifecycle-pill { white-space: nowrap; }
#pendingApprovalsTable th:nth-child(1),
#pendingApprovalsTable td:nth-child(1) { width: 4% !important; padding-inline: .4rem; text-align: center; }
#pendingApprovalsTable th:nth-child(2),
#pendingApprovalsTable td:nth-child(2) { width: 10.5% !important; white-space: nowrap; overflow-wrap: normal; }
#pendingApprovalsTable th:nth-child(3),
#pendingApprovalsTable td:nth-child(3) { width: 18% !important; }
#pendingApprovalsTable th:nth-child(4),
#pendingApprovalsTable td:nth-child(4) { width: 14% !important; }
#pendingApprovalsTable th:nth-child(5),
#pendingApprovalsTable td:nth-child(5) { width: 15% !important; }
#pendingApprovalsTable th:nth-child(6),
#pendingApprovalsTable td:nth-child(6) { width: 9% !important; white-space: nowrap; overflow-wrap: normal; }
#pendingApprovalsTable th:nth-child(7),
#pendingApprovalsTable td:nth-child(7) { width: 29.5% !important; white-space: nowrap; }
#pendingApprovalsTable td:nth-child(7) .btn-ui--sm { padding: .3rem .5rem; }
#scholarDirectoryTable th:nth-child(1),
#scholarDirectoryTable td:nth-child(1) { width: 10.5% !important; white-space: nowrap; overflow-wrap: normal; }
#scholarDirectoryTable th:nth-child(2),
#scholarDirectoryTable td:nth-child(2) { width: 16% !important; }
#scholarDirectoryTable th:nth-child(3),
#scholarDirectoryTable td:nth-child(3) { width: 13.5% !important; }
#scholarDirectoryTable th:nth-child(4),
#scholarDirectoryTable td:nth-child(4) { width: 13% !important; }
#scholarDirectoryTable th:nth-child(5),
#scholarDirectoryTable td:nth-child(5) { width: 9.5% !important; white-space: nowrap; overflow-wrap: normal; }
#scholarDirectoryTable th:nth-child(6),
#scholarDirectoryTable td:nth-child(6) { width: 13.5% !important; }
#scholarDirectoryTable th:nth-child(7),
#scholarDirectoryTable td:nth-child(7) { width: 12% !important; }
#scholarDirectoryTable th:nth-child(8),
#scholarDirectoryTable td:nth-child(8) { width: 12% !important; white-space: nowrap; }
}
#pendingBatchBar:not(.is-visible),
.batch-context-bar:not(.is-visible) { display: none !important; }
.batch-context-bar.is-visible { display: flex !important; margin-top: .85rem; }
@media (min-width: 992px) {
#page-analytics .analytics-chart-stage { min-height: 0; }
#page-analytics .kpi-card .kpi-top { min-height: 0; margin-bottom: .35rem; }
#page-analytics .analytics-global-filter { padding: .6rem .9rem; margin-bottom: .75rem; gap: .75rem; }
#page-analytics .analytics-global-filter select { padding-block: .35rem; min-height: 36px; }
#page-analytics .analytics-global-filter .btn-export-summary { min-height: 36px; padding-block: .3rem; }
#page-analytics .source-truth-note { margin-bottom: .75rem; padding: .5rem .9rem; }
#page-analytics .analytics-widget.card-panel { padding: 1rem 1.2rem; }
#page-analytics .analytics-widget .section-title { margin-bottom: .6rem; }
#page-analytics .bar-chart { height: 190px; }
#page-analytics .donut-layout { min-height: 190px; }
#page-analytics .donut-chart { width: 160px; height: 160px; }
}
@media (min-width: 1100px) {
#alreadyScholarsPanel .directory-filter-row { display: grid !important; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .8rem; }
#alreadyScholarsPanel .directory-filter-row > * { min-width: 0; flex: none; }
#alreadyScholarsPanel .directory-search-group { grid-column: 1 / span 3; grid-row: 1; }
#alreadyScholarsPanel .directory-reset { grid-column: 4; grid-row: 1; width: 100%; }
}

/* ============================================================
   ADMIN ANALYTICS FIXES
   ============================================================ */
/* Filter bar: same field treatment as .directory-filter-row so both admin toolbars match. */
.analytics-global-filter {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  background: var(--sd-vanilla);
  border: 1px solid var(--sd-border);
  border-radius: var(--radius-sm);
}
.analytics-filter-group {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: .35rem;
  flex: 1 1 220px;
  min-width: 0;
}
.analytics-filter-group label {
  margin: 0;
  color: var(--sd-ink-soft);
  font-size: .7rem;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: .02em;
  text-transform: uppercase;
}
.analytics-filter-group select {
  width: 100%;
  min-width: 0;
  min-height: 40px;
  padding: .5rem .7rem;
  color: var(--sd-ink);
  background: var(--sd-surface);
  border: 1px solid var(--sd-border);
  border-radius: 9px;
  font: inherit;
  font-size: .78rem;
}
.analytics-filter-group select:focus {
  outline: none;
  border-color: var(--sd-gold);
  box-shadow: 0 0 0 .2rem rgba(184,145,47,.14);
}
.btn-export-summary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: .5rem;
  flex: 0 0 auto;
  width: auto;
  min-height: 40px;
  padding: .5rem 1rem;
  color: var(--sd-green-700);
  background: var(--sd-surface);
  border: 1px solid var(--sd-green-700);
  border-radius: var(--ui-radius-control);
  font-size: .82rem;
  font-weight: 600;
  white-space: nowrap;
  cursor: pointer;
  transition: background .18s ease, color .18s ease;
}
.btn-export-summary:hover { background: var(--sd-green-700); color: var(--white); }
.btn-export-summary:focus-visible { outline: 2px solid var(--sd-green-700); outline-offset: 2px; }

/* Empty state is hidden until renderAnalyticsFiltered() adds .is-visible (no-data filter result). */
.analytics-chart-stage > .analytics-empty-state { display: none; }
.analytics-chart-stage > .analytics-empty-state.is-visible { display: flex; }
.analytics-widget-grid { display: grid; }

/* Institute bar labels: full name on desktop, code only (IC, IAAS, IBPA, ITED) below desktop. */
#instituteBarChart .bar-label .bl-code { display: none; }
@media (max-width: 991.98px) {
  #instituteBarChart .bar-label .bl-full { display: none; }
  #instituteBarChart .bar-label .bl-code { display: inline; font-weight: 600; }
  #instituteBarChart .bar-label { min-height: 0; }
}

/* Analytics filters: Export Summary sits to the right of the School dropdown instead of taking its own row. */
#page-analytics .analytics-global-filter { flex-wrap: wrap; align-items: flex-end; }
#page-analytics .analytics-global-filter > .btn-export-summary { flex: 0 0 auto; width: auto; min-width: 0; }
@media (max-width: 767.98px) {
  #page-analytics .analytics-global-filter > .analytics-filter-group:first-child { flex: 1 1 100%; }
  #page-analytics .analytics-global-filter > .analytics-filter-group:not(:first-child) { flex: 1 1 0; min-width: 0; }
  #page-analytics .analytics-global-filter > .btn-export-summary { flex: 0 0 auto; width: auto; }
}
.quick-review-dialog { max-width: 960px; }
.quick-review-dialog .modal-content { max-height: min(92vh, 900px); }
.quick-review-dialog .modal-body { overflow-y: auto; }
.quick-review-dialog .modal-footer { position: sticky; bottom: 0; z-index: 3; background: var(--sd-surface); border-top: 1px solid var(--sd-border); box-shadow: 0 -8px 18px rgba(24, 65, 44, .08); }
.account-created-banner { display:flex; gap:.8rem; align-items:flex-start; padding:1rem; border:1px solid var(--sd-border); border-radius:14px; background:var(--sd-sage-tint); color:var(--sd-green-900); margin-bottom:1rem; }
.account-created-banner i { font-size:1.35rem; }
.account-created-banner span { display:block; color:var(--sd-ink-soft); font-size:.85rem; margin-top:.15rem; }
.account-credentials-grid .info-value { word-break:break-word; }
.account-created-note { display:flex; gap:.5rem; align-items:flex-start; color:var(--sd-ink-soft); font-size:.82rem; margin-top:1rem; }
/* Keep every modal centered with visible space on both sides; only the toast notification uses the mobile top edge. */
.modal-dialog { width:calc(100% - 2rem); margin-left:auto; margin-right:auto; }
.modal-dialog.modal-dialog-centered { display:flex; align-items:center; min-height:calc(100% - 3.5rem) !important; }
@media (max-width: 575.98px) { .modal-dialog.modal-dialog-centered { margin:1rem auto; min-height:calc(100% - 2rem) !important; } .quick-review-dialog .modal-content { max-height: calc(100vh - 2rem); } .quick-review-dialog .modal-footer { flex-wrap:wrap; } .quick-review-dialog .modal-footer button { flex:1 1 auto; } }

/* ============================================================
   LOGOUT CONFIRMATION MODAL
   Copied from the Scholar Dashboard. Class names are prefixed
   (lgo-) so they never collide with Bootstrap's .modal rules.
   ============================================================ */
body.lgo-scroll-lock { overflow: hidden; }
.lgo-backdrop {
  position: fixed; inset: 0; z-index: 1080;
  display: flex; align-items: center; justify-content: center;
  padding: 20px; line-height: normal;
  background: rgba(20, 40, 29, 0.5);
}
.lgo-backdrop[hidden] { display: none; }
.lgo-modal {
  position: relative; display: flex; flex-direction: column;
  width: 100%; max-width: 540px; max-height: 30vh;
  overflow: hidden;
  background: var(--sd-surface);
  border: 1px solid var(--sd-border);
  border-radius: 18px;
  box-shadow: 0 30px 60px -24px rgba(20, 40, 29, 0.55), 0 8px 20px rgba(20, 40, 29, 0.15);
  color: var(--sd-ink);
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 16px; font-weight: 400; line-height: normal;
}
.lgo-head {
  position: relative; flex: 0 0 auto;
  padding: 16px 20px;
  background: linear-gradient(150deg, var(--sd-gold-tint), var(--sd-surface) 72%);
  border-bottom: 1px solid var(--sd-border);
}
.lgo-head h3 {
  margin: 0 0 12px;
  font-family: 'Poppins', sans-serif;
  font-size: 20px; font-weight: 700; line-height: normal;
  color: var(--sd-green-900);
}
.lgo-close {
  position: absolute; top: 18px; right: 18px;
  width: 40px; height: 40px; min-width: 40px; min-height: 40px;
  display: flex; align-items: center; justify-content: center;
  padding: 0;
  border: 1px solid var(--sd-border); border-radius: 10px;
  background: var(--sd-surface); color: #2d3229;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
}
.lgo-close:hover { background: var(--sd-vanilla-deep); color: var(--sd-green-900); }
.lgo-close:focus-visible { outline: 2px solid var(--sd-gold); outline-offset: 2px; }
.lgo-close svg { width: 15px; height: 15px; }
.lgo-body {
  flex: 1 1 auto; min-height: 0;
  padding: 20px;
  overflow-x: hidden; overflow-y: auto;
}
.lgo-current {
  margin: 0 0 14px;
  font-size: 12.5px; line-height: 1.55;
  color: #2d3229;
}
.lgo-foot {
  flex: 0 0 auto;
  display: flex; justify-content: flex-end; gap: 8px;
  padding: 16px 20px;
  border-top: 1px solid var(--sd-border);
}
.lgo-btn {
  display: inline-flex; align-items: center; justify-content: center;
  gap: 8px; flex-shrink: 0; white-space: nowrap;
  margin: 0; height: 38px; min-height: 38px; padding: 0 14px;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 14px; font-weight: 600; line-height: 14px;
  border: 1px solid transparent; border-radius: 10px;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
}
.lgo-btn:focus-visible { outline: 2px solid var(--sd-gold); outline-offset: 2px; }
.lgo-btn.quiet { background: var(--sd-surface); color: var(--sd-green-700); border-color: var(--sd-border); }
.lgo-btn.quiet:hover { background: var(--sd-vanilla-deep); }
.lgo-btn.danger { background: var(--sd-danger); color: var(--sd-surface); font-weight: 700; }
.lgo-btn.danger:hover { filter: brightness(0.92); }
.lgo-btn.danger a { color: var(--sd-vanilla); text-decoration: none; }
@media (max-width: 600px) { .lgo-backdrop { padding: 12px; } }
@media (max-width: 575.98px) { .lgo-foot .lgo-btn { flex: 1; } }

/* ============================================================
   EDIT PASSWORD CARD
   Copied from the Scholar Dashboard (Settings). Class names are
   prefixed (pwc-) so they never collide with Bootstrap / officer rules.
   ============================================================ */
.pwc-card {
  display: block;
  padding: 20px;
  background: var(--sd-surface);
  border: 1px solid var(--sd-border);
  border-radius: 18px;
  box-shadow: none;
  color: var(--sd-ink);
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 16px; font-weight: 400; line-height: 1.5;
}
.pwc-head {
  display: flex; align-items: center; justify-content: space-between;
  gap: 12px; min-height: 32px; margin-bottom: 0;
}
.pwc-head h3 {
  margin: 0;
  font-family: 'Poppins', sans-serif;
  font-size: 0.95rem; font-weight: 700; line-height: 1.25;
  color: var(--sd-ink);
}
.pwc-sub {
  margin-top: 0.15rem;
  font-size: 0.74rem; line-height: 1.4;
  color: #2d3229;
}
.pwc-msg {
  display: flex; align-items: flex-start; gap: 9px;
  margin-top: 16px; padding: 11px 13px;
  border-radius: 12px;
  font-size: 12.5px; font-weight: 600; line-height: 1.5;
}
.pwc-msg[hidden] { display: none; }
.pwc-msg.success {
  background: #eaf0e8; color: #29553b;
  border: 1px solid rgba(62, 123, 80, 0.3);
}
.pwc-msg.error {
  background: #fde8e7; color: #b42318;
  border: 1px solid rgba(180, 35, 24, 0.3);
}
.pwc-form { margin-top: 18px; }
.pwc-form[hidden] { display: none; }
.pwc-field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }
.pwc-field label {
  display: flex; flex-direction: column; gap: 5.6px;
  margin: 0 0 8px;
  font-size: 0.78rem; font-weight: 600; line-height: 1.2;
  color: var(--sd-ink);
}
.pwc-input {
  display: block; width: 100%; min-height: 38px;
  padding: 0 12.8px;
  background-color: var(--sd-surface);
  border: 1px solid var(--sd-border); border-radius: 10px;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 0.88rem; font-weight: 400; line-height: 1.5;
  color: var(--sd-ink);
  appearance: none;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
.pwc-input:focus {
  outline: none;
  color: #212529;
  border-color: var(--sd-green-700);
  box-shadow: 0 0 0 3px rgba(41, 85, 59, 0.14);
}
.pwc-actions { display: flex; flex-wrap: wrap; gap: 8px; }
.pwc-btn {
  display: inline-flex; align-items: center; justify-content: center;
  gap: 8px; flex-shrink: 0; white-space: nowrap;
  margin: 0; min-height: 38px; padding: 0 14px;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 14px; font-weight: 600; line-height: 14px;
  border: 1px solid transparent; border-radius: 10px;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease, transform 0.12s ease;
}
.pwc-btn.sm { min-height: 34px; padding: 0 12px; font-size: 0.78rem; line-height: 0.78rem; }
.pwc-btn:focus-visible { outline: 2px solid var(--sd-gold); outline-offset: 3px; }
.pwc-btn:disabled { opacity: 0.6; cursor: not-allowed; }
.pwc-btn.primary { background: var(--sd-green-700); border-color: var(--sd-green-700); color: var(--sd-vanilla); font-weight: 700; }
.pwc-btn.primary:hover { background: var(--sd-green-900); border-color: var(--sd-green-900); transform: translateY(-1px); }
.pwc-btn.quiet { background: var(--sd-surface); border-color: var(--sd-border); color: var(--sd-green-700); }
.pwc-btn.quiet:hover { background: #eaf0e8; border-color: #7e9c86; color: var(--sd-green-900); }

/* ============================================================
   SCHOLAR DETAILS — FULL RECORD MODAL (schema-driven sections)
   ============================================================ */
#masterFileModal .sfd-header { align-items: flex-start; border-bottom: 1px solid var(--sd-border); }
#masterFileModal .sfd-head-main { display: flex; align-items: center; gap: 1rem; }
#masterFileModal .sfd-avatar { width: 56px; height: 56px; border-radius: 50%; background: var(--sd-green-700); color: var(--sd-vanilla, #fff); display: grid; place-items: center; font-weight: 700; font-size: 1.15rem; flex: 0 0 56px; }
#masterFileModal .sfd-head-pills { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .45rem; }
#masterFileModal .sfd-body { background: var(--ivory, #faf9f5); padding: 1.1rem 1.25rem; display: flex; flex-direction: column; overflow: hidden; min-height: 0; }
#masterFileModal .sfd-wrap { margin: 0 auto; width: 100%; display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; }
#masterFileModal .sfd-summary { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .75rem; margin-bottom: 1rem; flex: 0 0 auto; } /* always 5 equal cards */
#masterFileModal .sfd-stat { background: var(--white); border: 1px solid var(--sd-border); border-radius: var(--radius-sm, 10px); padding: .75rem .9rem; height: 72px; display: flex; flex-direction: column; justify-content: center; min-width: 0; }
#masterFileModal .sfd-stat .k { font-size: .72rem; color: var(--sd-ink-soft); margin-bottom: .15rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#masterFileModal .sfd-stat .v { font-weight: 700; font-size: .95rem; color: var(--sd-ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#masterFileModal .sfd-tabs { flex: 0 0 auto; flex-wrap: nowrap; overflow-x: auto; background: var(--ivory, #faf9f5); margin-bottom: 0; }
#masterFileModal .sfd-tabs .nav-link { display: inline-flex; align-items: center; gap: .35rem; }
#masterFileModal .sfd-pane { padding-top: 1rem; }
#masterFileModal .sfd-wrap > .tab-content { flex: 1 1 auto; min-height: 0; overflow-y: scroll; scrollbar-gutter: stable; } /* only the tab content scrolls; the cards and tabs stay put */
@media (max-width: 767.98px) { #masterFileModal .sfd-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); } #masterFileModal .sfd-stat:last-child { grid-column: 1 / -1; } }
.sfd-card { background: var(--white); border: 1px solid var(--sd-border); border-radius: var(--radius, 14px); padding: 1rem 1.1rem; margin-bottom: 1rem; }
.sfd-card-title { display: flex; align-items: center; gap: .45rem; color: var(--sd-green-700); font-size: .86rem; font-weight: 700; margin-bottom: .6rem; }
.sfd-card-title .tbl { margin-left: auto; font-weight: 500; font-size: .68rem; color: var(--sd-ink-soft); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
.sfd-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 0 1.5rem; }
.sfd-field { padding: .55rem 0; border-bottom: 1px solid var(--sd-border); min-width: 0; }
.sfd-field .l { font-size: .72rem; color: var(--sd-ink-soft); margin-bottom: .1rem; }
.sfd-field .v { font-weight: 600; font-size: .88rem; color: var(--sd-ink); overflow-wrap: anywhere; }
.sfd-field .v.muted { color: var(--sd-ink-soft); font-weight: 500; }
.sfd-two { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1rem; }
.sfd-two > .sfd-card { margin-bottom: 0; }
.sfd-table-wrap { overflow-x: auto; }
.sfd-table { width: 100%; border-collapse: collapse; font-size: .8rem; }
.sfd-table th { text-align: left; font-size: .7rem; text-transform: uppercase; letter-spacing: .03em; color: var(--sd-ink-soft); padding: .45rem .6rem; border-bottom: 1px solid var(--sd-border); white-space: nowrap; }
.sfd-table td { padding: .55rem .6rem; border-bottom: 1px solid var(--sd-border); vertical-align: top; color: var(--sd-ink); }
.sfd-table tr:last-child td { border-bottom: none; }
.sfd-empty { color: var(--sd-ink-soft); font-size: .82rem; padding: .4rem 0; }
.sfd-list { margin: 0; padding-left: 1.1rem; font-size: .84rem; color: var(--sd-ink); }
.sfd-list li { margin-bottom: .3rem; }
.sfd-list small { color: var(--sd-ink-soft); }
.sfd-timeline { list-style: none; margin: 0; padding: 0; }
.sfd-timeline li { display: grid; grid-template-columns: 150px 1fr; gap: .75rem; padding: .55rem 0; border-bottom: 1px solid var(--sd-border); font-size: .82rem; }
.sfd-timeline li:last-child { border-bottom: none; }
.sfd-timeline .t { color: var(--sd-ink-soft); font-size: .74rem; }
#masterFileModal .modal-dialog { max-width: min(1100px, calc(100vw - 2.5rem)); margin-left: auto; margin-right: auto; }
#masterFileModal .modal-dialog-scrollable .modal-content { height: min(720px, calc(100vh - 2.5rem)); min-height: min(720px, calc(100vh - 2.5rem)); max-height: min(720px, calc(100vh - 2.5rem)); } /* fixed size: switching tabs never resizes the modal; the body scrolls instead */
@media (max-width: 575.98px) { #masterFileModal .modal-dialog { max-width: calc(100vw - 1.5rem); } #masterFileModal .modal-dialog-scrollable .modal-content { height: calc(100vh - 1.5rem); min-height: calc(100vh - 1.5rem); max-height: calc(100vh - 1.5rem); } }
/* Scholars list + Pending Scholar Approvals: same table design as the Officer dashboard Scholars table.
   Auto-width columns, plain-text scholarship, always fits its card (no horizontal scrolling: cells wrap instead). CSS only. */
#scholarDirectoryTable,
#pendingApprovalsTable { table-layout: auto; width: 100%; min-width: 0 !important; max-width: 100%; border-collapse: separate; border-spacing: 0; }
.table-app-wrap:has(#scholarDirectoryTable),
.table-app-wrap:has(#pendingApprovalsTable) { overflow-x: hidden; }
#scholarDirectoryTable th:nth-child(n),
#pendingApprovalsTable th:nth-child(n),
#scholarDirectoryTable td:nth-child(n),
#pendingApprovalsTable td:nth-child(n) { width: auto !important; min-width: 0 !important; overflow-wrap: break-word; word-break: normal; position: static; }
#scholarDirectoryTable thead th,
#pendingApprovalsTable thead th { height: auto; padding: .8rem .6rem; font-size: .76rem; font-weight: 600; color: var(--sd-ink-soft); white-space: normal; text-transform: none; vertical-align: middle; }
#scholarDirectoryTable tbody td,
#pendingApprovalsTable tbody td { height: auto; min-height: 0; padding: .85rem .6rem; font-size: .88rem; line-height: 1.35; vertical-align: middle; border-bottom: 1px solid var(--sd-border); }
#scholarDirectoryTable tbody tr:last-child td,
#pendingApprovalsTable tbody tr:last-child td { border-bottom: 0; }
#scholarDirectoryTable tbody td:first-child,
#pendingApprovalsTable tbody td:first-child { white-space: nowrap; }
#scholarDirectoryTable tbody td strong,
#pendingApprovalsTable tbody td strong { font-weight: 600; font-size: .9rem; color: var(--sd-ink); }
#scholarDirectoryTable .program-chip,
#pendingApprovalsTable .program-chip { display: inline; min-height: 0; padding: 0; border: 0; border-radius: 0; background: none; font-size: inherit; font-weight: 400; line-height: inherit; color: inherit; white-space: normal; }
#scholarDirectoryTable .lifecycle-pill,
#pendingApprovalsTable .lifecycle-pill { white-space: normal; max-width: 100%; }
#scholarDirectoryTable tbody td:last-child,
#pendingApprovalsTable tbody td:last-child { white-space: normal; }
#pendingApprovalsTable tbody td:last-child .btn-ui { margin: .15rem .1rem; }
#pendingApprovalsTable tbody td:nth-child(2),
#pendingApprovalsTable tbody td:nth-child(6) { white-space: nowrap; }
#pendingApprovalsTable tbody td:nth-child(1),
#pendingApprovalsTable thead th:nth-child(1) { padding-inline: .4rem; }
@media (max-width: 640px) { .sfd-timeline li { grid-template-columns: 1fr; gap: .1rem; } }

/* Logout preloader: same brand pulse as the home page's opening preloader. */
@keyframes nxPreloaderPulse {
  0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(184, 145, 47, .45); }
  50% { transform: scale(1.1); box-shadow: 0 0 0 10px rgba(184, 145, 47, 0); }
}
.nx-preloader {
  position: fixed; inset: 0; z-index: 12000;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px;
  background: radial-gradient(600px 300px at 50% 0%, rgba(184, 145, 47, .14), transparent 62%),
              linear-gradient(190deg, #1f4d3a 0%, #143a2b 70%);
  transition: opacity .5s ease, visibility .5s ease;
}
.nx-preloader-mark {
  width: 72px; height: 72px; box-sizing: border-box; flex-shrink: 0;
  border-radius: 0 14px 0 14px;
  background: url("{{ asset('images/logo/bakr-logo.png') }}") center / contain no-repeat, linear-gradient(135deg, #7e9c86, #29553b);
  box-shadow: 0 2px 6px rgba(0, 0, 0, .25);
  animation: nxPreloaderPulse 2.0s ease-in-out infinite;
}
.nx-preloader span {
  font-family: 'Poppins', sans-serif; color: #fdfbf8; letter-spacing: .3em;
  font-size: 13px; font-weight: 700; text-transform: uppercase; opacity: .85;
}
.nx-preloader.nx-preloader-hide { opacity: 0; visibility: hidden; pointer-events: none; }
@media (prefers-reduced-motion: reduce) { .nx-preloader { transition: none; } .nx-preloader-mark { animation: none; } }
</style>
</head>
<body>

<!-- ============================================================
     MOBILE TOP BAR
     ============================================================ -->
<div class="mobile-topbar d-lg-none">
  <button class="btn btn-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar" aria-label="Open navigation">
    <i class="bi bi-list fs-4 u-text-ink"></i>
  </button>
  <div class="d-flex align-items-center gap-2 mobile-topbar-brand">
    <div class="brand-badge mobile-brand-mark"><i class="bi bi-shield-lock-fill"></i></div>
    <span class="fw-semibold mobile-topbar-title">Admin Portal</span>
  </div>
  <button class="btn btn-sm p-0" type="button" onclick="showToast('No new notifications', 'You are all caught up for today.')" aria-label="Notifications">
    <i class="bi bi-bell fs-5 u-text-green"></i>
  </button>
</div>

<!-- ============================================================
     OFFCANVAS SIDEBAR (mobile / tablet)
     ============================================================ -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="mobileSidebar" aria-label="Mobile navigation">
  <div class="offcanvas-header border-bottom">
    <div class="brand offcanvas-brand">
      <div class="brand-badge"><i class="bi bi-shield-lock-fill"></i></div>
      <div class="brand-text">
        <div class="brand-title">Admin Portal</div>
        <div class="brand-sub">BAKR Scholarship Management System</div>
      </div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body d-flex flex-column">
    <h6 class="nav-section-label">MENU</h6>
    <nav class="sidebar-nav" id="mobileNavMenu">
      <a href="#" class="nav-link" data-page="dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a>
      <a href="#" class="nav-link" data-page="analytics"><i class="bi bi-bar-chart-line"></i> Analytics</a>
      <a href="#" class="nav-link" data-page="manage-scholars"><i class="bi bi-people"></i> Scholars <span class="badge ms-auto nav-counter-badge" data-counter="pending-scholars">5</span></a>
      <a href="#" class="nav-link" data-page="manage-scholarships"><i class="bi bi-mortarboard"></i> Scholarships</a>
      <a href="#" class="nav-link" data-page="officers"><i class="bi bi-person-badge"></i> Officers</a>
      <a href="#" class="nav-link" data-page="settings"><i class="bi bi-gear"></i> Settings</a>
    </nav>
  </div>
</div>

<!-- ============================================================
     AUDIT LOG DRAWER (Dashboard: "Audit Log" trigger)
     Slide-out activity feed, demoted from the main dashboard body
     so it no longer consumes high-fold screen space.
     ============================================================ -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="auditLogDrawer" aria-labelledby="auditLogDrawerLabel">
  <div class="offcanvas-header">
    <h5 class="offcanvas-title" id="auditLogDrawerLabel"><i class="bi bi-clock-history me-2 u-text-green"></i>Audit Log &amp; System Activity</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body">
    <p class="text-muted-custom activity-description">Officer &amp; Admin actions, most recent first.</p>
    <div id="activityFeed">
      <!-- Demo entries — replace with a live audit trail -->
      <div class="activity-item">
        <div class="activity-icon act-admin"><i class="bi bi-check-circle-fill"></i></div>
        <div>
          <div class="activity-text"><strong>Admin</strong> approved scholar <strong>Maria Jimenez</strong></div>
          <div class="activity-time">2026-09-26 09:24 · Application: Pending → Approved</div>
        </div>
      </div>
      <div class="activity-item">
        <div class="activity-icon act-system"><i class="bi bi-pencil-fill"></i></div>
        <div>
          <div class="activity-text">Scholarship criteria updated for <strong>DNSC Academic Scholarship</strong></div>
          <div class="activity-time">2026-09-26 07:24</div>
        </div>
      </div>
      <div class="activity-item">
        <div class="activity-icon act-officer"><i class="bi bi-person-plus-fill"></i></div>
        <div>
          <div class="activity-text"><strong>Officer R. Cruz</strong> added student <strong>Maria Jimenez</strong> to CHED TDP</div>
          <div class="activity-time">2026-09-25 14:10</div>
        </div>
      </div>
      <div class="activity-item">
        <div class="activity-icon act-admin"><i class="bi bi-x-circle-fill"></i></div>
        <div>
          <div class="activity-text"><strong>Admin</strong> requested correction for scholar <strong>Miguel Castillo</strong></div>
          <div class="activity-time">2026-09-25 13:45 · Sent back to Officer R. Cruz with remarks</div>
        </div>
      </div>
      <div class="activity-item">
        <div class="activity-icon act-officer"><i class="bi bi-file-earmark-check-fill"></i></div>
        <div>
          <div class="activity-text"><strong>Officer R. Cruz</strong> submitted a scholar registration for <strong>Patricia Navarro</strong></div>
          <div class="activity-time">2026-09-24 10:14</div>
        </div>
      </div>
      <div class="activity-item">
        <div class="activity-icon act-officer"><i class="bi bi-file-earmark-check-fill"></i></div>
        <div>
          <div class="activity-text"><strong>Officer R. Cruz</strong> submitted a scholar registration for <strong>Isabel Fernandez</strong></div>
          <div class="activity-time">2026-09-23 15:05</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ============================================================
     APP SHELL
     ============================================================ -->
<div class="app-shell">

  <!-- ---------- DESKTOP SIDEBAR ---------- -->
  <aside class="sidebar d-none d-lg-flex flex-column">
    <div class="brand">
      <div class="brand-badge"><i class="bi bi-shield-lock-fill"></i></div>
      <div class="brand-text">
        <div class="brand-title">Admin Portal</div>
        <div class="brand-sub">BAKR Scholarship Management System</div>
        <span class="role-badge">ADMIN ACCESS</span>
      </div>
    </div>

    <h6 class="nav-section-label">MENU</h6>
    <nav class="sidebar-nav" id="desktopNavMenu">
      <a href="#" class="nav-link" data-page="dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a>
      <a href="#" class="nav-link" data-page="analytics"><i class="bi bi-bar-chart-line"></i> Analytics</a>
      <a href="#" class="nav-link" data-page="manage-scholars"><i class="bi bi-people"></i> Scholars <span class="badge ms-auto nav-counter-badge" data-counter="pending-scholars">5</span></a>
      <a href="#" class="nav-link" data-page="manage-scholarships"><i class="bi bi-mortarboard"></i> Scholarships</a>
      <a href="#" class="nav-link" data-page="officers"><i class="bi bi-person-badge"></i> Officers</a>
      <a href="#" class="nav-link" data-page="settings"><i class="bi bi-gear"></i> Settings</a>
    </nav>

    <div class="sidebar-footer">
      <div class="admin-mini">
        <div class="admin-mini-avatar">A</div>
        <div>
          <div class="admin-mini-name">Admin User</div>
          <div class="admin-mini-role">System Administrator</div>
        </div>
      </div>
    </div>
  </aside>

  <!-- ---------- MAIN CONTENT ---------- -->
  <main class="main-content">

    <!-- ============================================================
         PAGE: DASHBOARD
         ============================================================ -->
    <section class="page-section" id="page-dashboard">
      <div class="page-header">
        <div>
          <div class="eyebrow">ADMIN WORKSPACE · CURRENT TERM</div>
          <h1>Welcome back, Admin!</h1>
          <p class="text-muted-custom mb-0">Review submitted scholars and keep the scholarship system configured and on track.</p>
        </div>
      </div>

      <!-- Hero Operational Banner -->
      <div class="sd-hero">
        <div>
          <h2>Here's what needs your attention</h2>
          <p class="sd-sub">Scholar submissions are awaiting your review. Approve or return them so the system can create the scholar account. Document submission becomes available after approval.</p>
        </div>
        <div class="d-flex gap-2">
          <button type="button" class="quick-action-btn quick-action-btn-primary" onclick="showPage('manage-scholars')">
            <i class="bi bi-person-check"></i> Review Pending Scholars
          </button>
          <button type="button" class="quick-action-btn" onclick="showPage('manage-scholarships')">
            <i class="bi bi-mortarboard"></i> Manage Scholarships
          </button>
        </div>
      </div>

      <div class="kpi-grid">
        <div class="kpi-card dashboard-scholar-filter-card">
          <div class="kpi-top"><div class="kpi-icon icon-green"><i class="bi bi-people-fill"></i></div><button type="button" class="btn-view-sm btn-ui btn-ui--ghost btn-ui--sm" onclick="showPage('manage-scholars')">View</button></div>
          <div class="kpi-label">Total Active Scholars</div><div class="kpi-value" id="dashboardActiveScholarCount">–</div>
          <div class="kpi-sub" id="dashboardScholarSplit">Currently enrolled in active programs</div>
        </div>
        <button type="button" class="kpi-card kpi-highlight" onclick="showPage('manage-scholars')">
          <div class="kpi-top"><div class="kpi-icon icon-gold"><i class="bi bi-person-check-fill"></i></div></div>
          <div class="kpi-label">Pending Approvals</div><div class="kpi-value kpi-value-gold" id="dashboardPendingCount">5</div>
          <div class="kpi-sub">Scholar submissions awaiting review</div>
        </button>
        <button type="button" class="kpi-card" onclick="showPage('manage-scholarships')">
          <div class="kpi-top"><div class="kpi-icon icon-green"><i class="bi bi-mortarboard-fill"></i></div></div>
          <div class="kpi-label">Active Scholarship Programs</div><div class="kpi-value" id="dashboardProgramCount">11</div>
          <div class="kpi-sub">Programs configured for the current term</div>
        </button>
        <button type="button" class="kpi-card" onclick="showPage('officers')">
          <div class="kpi-top"><div class="kpi-icon icon-neutral"><i class="bi bi-person-badge-fill"></i></div></div>
          <div class="kpi-label">Active Officers</div><div class="kpi-value" id="dashboardOfficerCount">4</div>
          <div class="kpi-sub">Officers with system-wide access</div>
        </button>
      </div>

      <div class="card-panel dash-section" id="recentActivityPanel">
        <div class="section-title"><div class="st-left"><i class="bi bi-clock-history"></i><span>Recent Activity</span></div><button type="button" class="btn btn-sm btn-outline-scholarship btn-ui btn-ui--secondary btn-ui--sm" data-bs-toggle="offcanvas" data-bs-target="#auditLogDrawer">View audit log</button></div>
        <div class="activity-list">
          <div class="activity-item"><div class="activity-icon act-admin"><i class="bi bi-check-circle-fill"></i></div><div><div class="activity-text"><strong>Admin</strong> approved scholar <strong>Maria Jimenez</strong></div><div class="activity-time">2026-09-26 09:24</div></div></div>
          <div class="activity-item"><div class="activity-icon act-system"><i class="bi bi-pencil-fill"></i></div><div><div class="activity-text"><strong>Admin</strong> updated scholarship <strong>DNSC Academic Scholarship</strong></div><div class="activity-time">2026-09-26 07:24</div></div></div>
          <div class="activity-item"><div class="activity-icon act-officer"><i class="bi bi-person-plus-fill"></i></div><div><div class="activity-text"><strong>Officer R. Cruz</strong> added student <strong>Maria Jimenez</strong> to CHED TDP</div><div class="activity-time">2026-09-25 14:10</div></div></div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         PAGE: ANALYTICS
         ============================================================ -->
    <section class="page-section" id="page-analytics">
      <div class="page-header">
        <div>
          <div class="eyebrow">ADMIN WORKSPACE &middot; ACADEMIC TRACKING</div>
          <h1>Analytics &amp; Insights</h1>
          <p class="text-muted-custom mb-0">Academic tracking, application queues, and compliance insights computed from sample records.</p>
        </div>
        <div class="ph-actions"><div class="sd-date-pill"><i class="bi bi-bar-chart-line"></i><strong>Sample data · as of Oct 13, 2026</strong></div></div>
      </div>

      <div class="kpi-grid">
        <button type="button" class="kpi-card" title="Count of scholarship awards with status Active in the selected scholarship and campus (sample data)." onclick="showPage('manage-scholars')">
          <div class="kpi-top"><div class="kpi-icon icon-green"><i class="bi bi-people-fill"></i></div></div>
          <div class="kpi-label">Total Active Scholars</div><div class="kpi-value" id="kpiTotalScholars">–</div>
          <div class="kpi-sub"><i class="bi bi-calendar-check"></i> <span id="kpiScholarSplit">Active awards · AY 2026-2027, 1st Semester</span></div>
        </button>
        <button type="button" class="kpi-card kpi-highlight" title="Count of scholar applications with status Pending (sample data)." onclick="showPage('manage-scholars')">
          <div class="kpi-top"><div class="kpi-icon icon-gold"><i class="bi bi-inbox-fill"></i></div><span class="status-pill pill-amber" role="status" aria-label="Status: Urgent"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>Urgent</span></div>
          <div class="kpi-label">Pending Applications Queue</div><div class="kpi-value kpi-value-gold" id="kpiPendingQueue">–</div>
          <div class="kpi-sub kpi-trend-warn"><i class="bi bi-exclamation-triangle-fill"></i> <span id="kpiUrgentCount">0</span> require urgent review (&gt; 3 days old)</div>
        </button>
        <button type="button" class="kpi-card" title="Active scholars who have uploaded all documentary requirements for the current term, divided by all active scholars (sample data)." onclick="showPage('manage-scholars')" aria-label="View document renewal compliance details">
          <div class="kpi-top"><div class="kpi-icon icon-neutral"><i class="bi bi-file-earmark-check-fill"></i></div></div>
          <div class="kpi-label">Document Renewal Compliance Rate</div><div class="kpi-value" id="kpiComplianceRate">–</div>
          <div class="kpi-sub kpi-trend-danger"><i class="bi bi-exclamation-circle-fill"></i> <span id="kpiOverdueCount">0</span> scholars with outstanding requirements (deadline 2026-11-15)</div>
        </button>
      </div>

      <div class="analytics-global-filter filter-bar ui-filter-toolbar" role="group" aria-label="Global analytics filters">
        <div class="analytics-filter-group"><label for="analyticsProgram">Scholarship</label><select id="analyticsProgram" onchange="applyAnalyticsFilters()"><option value="all">All scholarships</option></select></div>
        <div class="analytics-filter-group"><label for="analyticsSchool">Campus</label><select id="analyticsSchool" onchange="applyAnalyticsFilters()"><option value="all">All campuses</option></select></div>
        <button type="button" class="btn-export-summary" onclick="exportSummary()" aria-label="Export non-financial audit summary"><i class="bi bi-download"></i> Export Summary</button>
      </div>

      <div class="source-truth-note" id="analyticsActiveFilterNote" role="status"><i class="bi bi-funnel-fill"></i><span id="analyticsActiveFilterText">Showing data for all scholarships across all campuses.</span> <span class="text-muted-custom">· Figures are counts computed from the Scholars list, its requirement submissions and the pending applications; standing percentages are shares of active scholars.</span></div>

      <div class="analytics-chart-stage" id="analyticsChartStage">
        <div class="analytics-widget-grid">
        <div class="card-panel analytics-widget">
          <div class="section-title"><div class="st-left"><i class="bi bi-bar-chart-fill"></i><span>Scholar Distribution by Institute</span></div><span class="text-muted-custom chart-meta">Student Count</span></div>
          <div class="bar-chart" id="instituteBarChart" aria-label="Scholars by institute bar chart"></div>
        </div>
        <div class="card-panel analytics-widget">
          <div class="section-title"><div class="st-left"><i class="bi bi-donut-chart-fill"></i><span>Document Compliance Status</span></div></div>
          <div class="donut-layout">
            <div class="donut-chart" id="standingDonut" role="img" aria-label="Document compliance status: Compliant, Incomplete Documents, Overdue"><div class="donut-center"><strong id="standingGoodPct">–</strong><span>Compliant</span></div></div>
            <div class="chart-legend" aria-label="Document compliance status">
              <div class="legend-row"><span class="legend-dot legend-green"></span>Compliant <strong id="standingGoodCount">–</strong></div>
              <div class="legend-row"><span class="legend-dot legend-gold"></span>Incomplete Documents <strong id="standingIncompleteCount">–</strong></div>
              <div class="legend-row"><span class="legend-dot legend-danger"></span>Overdue Documents <strong id="standingOverdueCount">–</strong></div>
            </div>
          </div>
        </div>
      </div>
        <div class="analytics-loading-overlay" id="analyticsLoadingOverlay" aria-live="polite" aria-hidden="true">
          <div class="analytics-loading-card"><div class="analytics-loading-label"><span class="analytics-spinner"></span> Updating analytics</div><div class="analytics-skeleton-grid"><div class="analytics-skeleton"></div><div class="analytics-skeleton"></div><div class="analytics-skeleton"></div><div class="analytics-skeleton"></div></div></div>
        </div>
        <div class="analytics-empty-state" id="analyticsEmptyState" role="status"><div><i class="bi bi-bar-chart-line"></i><strong>No data available for the selected scholarship type and school.</strong><span>Try switching filters.</span></div></div>
