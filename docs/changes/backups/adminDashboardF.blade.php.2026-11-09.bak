.batch-context-bar { position: sticky; bottom: 1rem; z-index: 10; display: flex; opacity: 0; transform: translateY(.5rem); pointer-events: none; transition: opacity .2s ease, transform .2s ease; }
.batch-context-bar.is-visible { opacity: 1; transform: translateY(0); pointer-events: auto; }
