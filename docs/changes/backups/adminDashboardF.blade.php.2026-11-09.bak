.bar-col { position: relative; cursor: pointer; }
.bar-col[data-tooltip]::after { content: attr(data-tooltip); position: absolute; left: 50%; bottom: calc(100% + .5rem); transform: translate(-50%, .35rem); opacity: 0; pointer-events: none; z-index: 5; min-width: 150px; padding: .5rem .65rem; border-radius: var(--ui-radius-control); background: var(--sd-green-900); color: var(--sd-vanilla); font-size: .75rem; line-height: 1.3; text-align: center; transition: opacity .16s ease, transform .16s ease; }
