@section('content')
@php
    $uid = auth()->id();
    $me = auth()->user();
    $isScholar = \App\Models\Scholar::heldBy((int) $uid);
    // Scholars have no matching: no match summary for them.
    $current = $isScholar ? null : \App\Models\ScholarshipApplication::where('user_id', $uid)->where('is_current', true)->first();
    $tally = $current ? $current->matches()->selectRaw('status, count(*) as n')->groupBy('status')->pluck('n', 'status') : collect();
    $nElig = (int) ($tally['eligible'] ?? 0);
    $nPoss = (int) ($tally['possible'] ?? 0);
    $nInfo = (int) ($tally['needs_info'] ?? 0);
    $nNot  = (int) ($tally['not_eligible'] ?? 0);
    $nAll  = $nElig + $nPoss + $nInfo + $nNot;
    $w     = fn ($n) => $nAll ? round($n / $nAll * 100, 1) : 0;
    $answers = $current?->answers ?? [];
    $initials = collect(preg_split('/\s+/', trim($me->name)))->filter()->take(2)->map(fn ($p) => mb_strtoupper(mb_substr($p, 0, 1)))->implode('');
    $banner = match (true) {
        request()->routeIs('student.results') => 'opt/students2.jpg',
        request()->routeIs('student.profile', 'scholar.profile') => 'opt/dnsc_gate.jpg',
        request()->routeIs('student.application.*', 'scholar.requirements') => 'opt/lib.jpg',
        request()->routeIs('scholar.scholarship') => 'graduates.jpg',
        default => 'dnsc_campus.jpg',
    };
    if ($isScholar) {
        $myScholars = \App\Models\Scholar::where('user_id', $uid)->with('scholarship')->get();
        $term = \App\Support\AcademicTerm::current();
        // Sidebar badge: this term's requirements still to upload or to fix.
        $todo = \App\Models\ScholarRequirement::whereIn('scholar_id', $myScholars->filter(fn ($s) => $s->scholarship->offers('requirements'))->pluck('id'))
            ->where('term', $term)->whereIn('status', ['missing', 'needs_revision'])->count();
        $exploreOpen = request()->routeIs('student.scholarships', 'student.help');
        $home = route('scholar.overview');
    } else {
        $home = route('student.dashboard');
    }
@endphp

