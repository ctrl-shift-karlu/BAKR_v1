</div>

<!-- ============================================================
     APP SHELL
     ============================================================ -->
<div class="app-shell dash-panel">

  <!-- ---------- DESKTOP SIDEBAR ---------- -->
  <aside class="sidebar dash-side d-none d-lg-flex flex-column">
    <div class="brand">
      <div class="brand-badge" style="background: linear-gradient(135deg, var(--sd-sage), var(--sd-green-700));">
        <i class="bi bi-person-badge-fill"></i>
      </div>
      <div class="brand-text">
        <div class="brand-title">Officer Portal</div>
        <div class="brand-sub">BAKR Scholarship Management System</div>
        <span class="role-badge" style="color: var(--sd-sage); border-color: rgba(126,156,134,0.4); background: rgba(126,156,134,0.16);">OFFICER ACCESS</span>
      </div>
    </div>

    <div class="nav-section-label">MENU</div>
    <nav class="sidebar-nav dash-nav" id="desktopNavMenu">
      <a href="#" class="nav-link" data-page="dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a>
      <a href="#" class="nav-link" data-page="analytics"><i class="bi bi-bar-chart-line"></i> Analytics</a>
      <a href="#" class="nav-link" data-page="scholars"><i class="bi bi-people"></i> Scholars</a>
      <a href="#" class="nav-link" data-page="add-scholar"><i class="bi bi-person-plus"></i> Add New Scholar</a>
      <a href="#" class="nav-link" data-page="document-verification"><i class="bi bi-file-earmark-check"></i> Document Verification</a>
      <a href="#" class="nav-link" data-page="stipend-release"><i class="bi bi-cash-coin"></i> Stipend Disbursement</a>
      <a href="#" class="nav-link" data-page="disbursement-history"><i class="bi bi-clock-history"></i> Disbursement History</a>
    </nav>

    <div class="nav-section-label">SYSTEM</div>
    <nav class="sidebar-nav dash-nav flex-grow-1" id="desktopNavSystem">
      <a href="#" class="nav-link" data-page="activity-log"><i class="bi bi-bell"></i> Notifications</a>
      <a href="#" class="nav-link" data-page="profile"><i class="bi bi-person"></i> Profile</a>
      <a href="#" class="nav-link" data-page="settings"><i class="bi bi-gear"></i> Settings</a>
    </nav>
  </aside>

  <!-- ---------- MAIN CONTENT ---------- -->
  <main class="main-content dash-main">

    <!-- ============================================================
         PAGE: DASHBOARD
         ============================================================ -->
    <section class="page-section" id="page-dashboard">

      <!-- Top Bar -->
      <div class="page-header sd-header-row">
        <div>
          <h1>Hello, Officer Juan!</h1>
          <p class="text-muted-custom mb-0">Today's scholar, document, and stipend workload at a glance.</p>
        </div>
        <div class="sd-date-pill">
          <i class="bi bi-calendar3"></i>
          <strong id="officerDatePill" class="js-officer-date">SEPTEMBER 24, 2026</strong> · <span id="officerTimePill" class="js-officer-time">12:00AM</span>
        </div>
      </div>

      <!-- Hero Operational Banner -->
      <div class="sd-hero">
        <div>
          <h2>These things need your action</h2>
          <p class="sd-sub">There are currently pending document verification submissions that require approval before stipend disbursement.</p>
        </div>
        <div class="d-flex gap-2">
          <button type="button" class="quick-action-btn quick-action-btn-primary" onclick="showPage('document-verification')">
            <i class="bi bi-file-earmark-check"></i> Review Verification Queue
          </button>
          <button type="button" class="quick-action-btn" onclick="showPage('stipend-release')">
            <i class="bi bi-cash-stack"></i> Process Disbursements
          </button>
        </div>
      </div>

      <!-- Primary dashboard summaries: aligned Scholars and Stipends cards. -->
      <div class="row g-3 mb-3 dashboard-primary-row">
        <div class="col-lg-7 dashboard-primary-left">
        <div class="action-overview-container card-panel">
          <div class="section-title overview-section-title">
            <h3><i class="bi bi-people-fill me-2"></i>Scholars Summary</h3>
          </div>
          <div class="triage-filter-bar" aria-label="Action needed filters">
            <div><label class="visually-hidden" for="triageScholarshipFilter">Scholarship type</label><select aria-label="Scholarship type" id="triageScholarshipFilter" class="form-select form-select-sm"><option value="">All scholarship types</option></select></div>
            <div><label class="visually-hidden" for="triageSchoolFilter">School</label><select aria-label="School" id="triageSchoolFilter" class="form-select form-select-sm"><option value="">All schools</option></select></div>
          </div>

          <div class="triage-summary-grid" id="triageSummaryCards">
            <div class="triage-metric-card triage-metric-total">
              <div class="triage-metric-icon"><i class="bi bi-people-fill"></i></div>
              <div><div class="triage-metric-label">Total Scholars</div><div class="triage-metric-value">0</div></div>
            </div>
            <div class="triage-metric-card triage-metric-pending">
              <div class="triage-metric-icon"><i class="bi bi-person-check-fill"></i></div>
              <div><div class="triage-metric-label">Pending Admin Approval</div><div class="triage-metric-value">0</div></div>
            </div>
          </div>
        </div>
        </div>

        <div class="col-lg-5 dashboard-primary-right">
        <div class="payout-progress-container card-panel">
          <div class="section-title">
            <h3><i class="bi bi-cash-coin me-2"></i>Stipends Summary</h3>
          </div>
          <div class="dq-filter-bar" aria-label="Stipends summary filters">
            <div class="dq-filter-group">
              <label class="visually-hidden" for="dqTermFilter">Semester</label>
              <select aria-label="Semester" id="dqTermFilter" class="form-select form-select-sm" onchange="updateDisbursementQueueFilters()">
                <option value="all">All semesters</option>
                <option value="2026–2027|1st Semester">1st Semester 2026–2027</option>
                <option value="2025–2026|2nd Semester">2nd Semester 2025–2026</option>
                <option value="2025–2026|1st Semester">1st Semester 2025–2026</option>
              </select>
            </div>
            <div class="dq-filter-group">
              <label class="visually-hidden" for="dqScholarshipFilter">Scholarship type</label>
              <select aria-label="Scholarship type" id="dqScholarshipFilter" class="form-select form-select-sm" onchange="updateDisbursementQueueFilters()">
                <option value="all">All scholarship types</option>
              </select>
            </div>
            <div class="dq-filter-group">
              <label class="visually-hidden" for="dqSchoolFilter">School</label>
              <select aria-label="School" id="dqSchoolFilter" class="form-select form-select-sm" onchange="updateDisbursementQueueFilters()"><option value="all">All schools</option></select>
            </div>
          </div>
          <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <span class="small text-muted-custom" id="dqDisbursedLine">Disbursed: <strong style="color:var(--sd-ink);">0</strong> of 0 Scholars</span>
              <span class="small fw-semibold" style="color:var(--sd-green-700);" id="dqPercentLine">0% Complete</span>
            </div>
            <div class="budget-progress">
              <div class="budget-progress-bar" id="dqProgressBar" style="width: 0%;"></div>
            </div>
          </div>
        </div>
        </div>
      </div>

      <!-- Secondary dashboard summaries: Documents and recent Notifications. -->
      <div class="row g-3 mb-3 dashboard-secondary-row">
        <div class="col-lg-7 dashboard-secondary-left">
        <div class="action-needed-container card-panel">
          <div class="section-title">
            <div class="action-heading-copy">
              <h3><i class="bi bi-exclamation-triangle-fill me-2" style="color:var(--sd-gold);"></i>Documents Summary</h3>
            </div>
            <span class="badge-attention">Action Needed</span>
          </div>
          <div class="triage-content-label"><i class="bi bi-list-check me-2"></i>Items requiring attention</div>
          <div class="aq-list" id="attentionList">
            <div class="aq-row"><div class="aq-left"><span class="aq-dot aq-dot-amber"></span><span class="aq-text"><span class="aq-num">3</span> documents waiting for verification</span></div><button class="aq-btn" type="button" onclick="showPage('document-verification')">Process Queue</button></div>
            <div class="aq-row"><div class="aq-left"><span class="aq-dot aq-dot-red"></span><span class="aq-text"><span class="aq-num">2</span> documents have been resubmitted</span></div><button class="aq-btn" type="button" onclick="showPage('document-verification')">Review</button></div>
            <div class="aq-row"><div class="aq-left"><span class="aq-dot aq-dot-amber"></span><span class="aq-text"><span class="aq-num">4</span> scholars ready for stipend disbursement</span></div><button class="aq-btn" type="button" onclick="showPage('stipend-release')">Disburse Funds</button></div>
          </div>
        </div>
        </div>
        <div class="col-lg-5 dashboard-secondary-right">
          <div class="card-panel h-100">
            <div class="section-title">
              <h3><i class="bi bi-bell me-2"></i>Activities / Notifications</h3>
              <button type="button" class="btn btn-sm btn-outline-scholarship" onclick="showPage('activity-log')">
                View All Notifications <i class="bi bi-arrow-right ms-1"></i>
              </button>
            </div>
            <div class="d-flex flex-column gap-3" id="recentActivityList"></div>
            <div class="demo-note mt-2">Latest 3 notifications · sample / demo data</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         PAGE: PENDING ADMIN APPROVAL
         ============================================================ -->
    <section class="page-section" id="page-pending-approvals">
      <div class="page-header">
        <div class="eyebrow">Officer / Scholars / Pending Approval</div>
        <h1>Pending Admin Approval</h1>
        <p class="text-muted-custom mb-0">Review scholar submissions awaiting admin approval.</p>
      </div>
      <div class="card-panel">
        <div class="section-title">
          <div class="st-left"><i class="bi bi-person-check"></i><span>Students Pending Approval</span></div>
          <span class="small text-muted-custom" id="paResultCount"></span>
        </div>
        <div class="filter-bar filter-bar-search filter-bar-inline">
          <div class="row g-2 align-items-end">
            <div class="col-md-3">
              <label class="form-label mb-0" for="paSearch">Search scholar / Student ID / Scholar ID</label>
              <input type="text" class="form-control" id="paSearch" placeholder="Search pending submissions">
            </div>
            <div class="col-md-3">
              <label class="form-label mb-0" for="paScholarship">Scholarship type</label>
              <select class="form-select" id="paScholarship"><option value="">All scholarship types</option></select>
            </div>
            <div class="col-md-3">
              <label class="form-label mb-0" for="paProgram">Program</label>
              <select class="form-select" id="paProgram"><option value="">All programs</option></select>
            </div>
            <div class="col-md-3">
              <label class="form-label mb-0" for="paSchool">School</label>
              <select class="form-select" id="paSchool"><option value="">All schools</option></select>
            </div>
          </div>
        </div>
        <div class="table-app-wrap table-responsive-wrap">
          <table class="table-app">
            <thead><tr id="paTableHeadRow">
              <th tabindex="0" role="button" class="th-sortable" data-sort-key="name">Scholar Name <i class="bi bi-arrow-down-up sort-icon"></i></th>
              <th tabindex="0" role="button" class="th-sortable" data-sort-key="student_id">Student ID <i class="bi bi-arrow-down-up sort-icon"></i></th>
              <th tabindex="0" role="button" class="th-sortable" data-sort-key="scholarId">Scholar ID <i class="bi bi-arrow-down-up sort-icon"></i></th>
              <th tabindex="0" role="button" class="th-sortable" data-sort-key="course">Program <i class="bi bi-arrow-down-up sort-icon"></i></th>
              <th tabindex="0" role="button" class="th-sortable" data-sort-key="scholarship">Scholarship Type <i class="bi bi-arrow-down-up sort-icon"></i></th>
              <th tabindex="0" role="button" class="th-sortable" data-sort-key="school">School <i class="bi bi-arrow-down-up sort-icon"></i></th>
              <th class="text-end">Actions</th>
            </tr></thead>
            <tbody id="paTableBody"></tbody>
          </table>
        </div>
        <div id="paMobileCards"></div>
        <div class="table-footer-bar">
          <div class="tf-pagesize"><label class="form-label mb-0 small text-muted-custom" for="paPageSize">Rows per page</label><select class="form-select form-select-sm" id="paPageSize"><option value="10">10</option><option value="25">25</option><option value="50">50</option></select></div>
          <div class="tf-counter small text-muted-custom" id="paPageCounter">Showing 0 of 0 scholars</div>
          <div class="tf-pagebtns"><button type="button" class="btn btn-outline-scholarship btn-sm" id="paPrevPage"><i class="bi bi-chevron-left"></i> Previous</button><span id="paPageNumbers" class="d-flex gap-1 align-items-center"></span><button type="button" class="btn btn-outline-scholarship btn-sm" id="paNextPage">Next <i class="bi bi-chevron-right"></i></button></div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         PAGE: ANALYTICS
         Split out from the Dashboard: scholar distribution by type
         and the system activity stream. Same visual treatment as the
         Dashboard page (re-skinned header, date pill, card-panel).
         ============================================================ -->
    <section class="page-section" id="page-analytics">

      <div class="page-header sd-header-row">
        <div>
          <h1>Analytics</h1>
          <p class="text-muted-custom mb-0">Scholar demographics, payout pipeline status, and disbursement activity.</p>
        </div>
        <div class="analytics-export-cluster" role="group" aria-label="Export analytics report"> <span class="analytics-control-label">Export Report</span> <button type="button" class="btn btn-sm btn-outline-scholarship" onclick="exportAnalyticsReport('csv')"><i class="bi bi-filetype-csv"></i> CSV</button> <button type="button" class="btn btn-sm btn-scholarship-green" onclick="exportAnalyticsReport('pdf')"><i class="bi bi-filetype-pdf"></i> PDF</button> </div>
      </div>

      <div class="analytics-period-banner" role="status">
        <i class="bi bi-people-fill" aria-hidden="true"></i>
        <span>Showing data for <strong>all scholars</strong> across every institute, program, and year level.</span>
      </div>

      <!-- Sub-tabs: Overview (day-to-day demographics/funding, for exec stakeholders)
           vs. Operations & Finance (payout bottlenecks, for staff troubleshooting). -->
      <div class="analytics-subtabs" role="tablist" aria-label="Analytics view">
        <button type="button" class="btn btn-outline-scholarship active" id="anTabOverview" role="tab" tabindex="0" aria-selected="true" aria-controls="analyticsPaneOverview" onclick="setAnalyticsTab('overview')">
          <i class="bi bi-people-fill me-1"></i>Overview
        </button>
        <button type="button" class="btn btn-outline-scholarship" id="anTabOperations" role="tab" tabindex="-1" aria-selected="false" aria-controls="analyticsPaneOperations" onclick="setAnalyticsTab('operations')">
          <i class="bi bi-gear-fill me-1"></i>Operations &amp; Finance
        </button>
      </div>

      <!-- ============ OVERVIEW: exact demographic analytics ============ -->
      <div class="analytics-tab-pane" id="analyticsPaneOverview" role="tabpanel" aria-labelledby="anTabOverview" data-analytics-variable-panel="demographics">

        <div class="row g-3 mt-1 demographic-overview-row">
          <div class="col-lg-4">
            <div class="card-panel h-100">
              <div class="section-title">
                <div class="st-left"><i class="bi bi-bar-chart-line me-2"></i><h3 class="mb-0">Scholar Distribution by Year Level</h3></div>
              </div>
              <div class="small text-muted-custom mb-3">Enrolled scholars spread across each year level.</div>
              <div class="chart-wrap" role="group" aria-label="Scholar distribution by year level" aria-describedby="analyticsScholarshipChartDescription">
                <div class="chart-y-axis" id="analyticsYAxis"></div>
                <div class="chart-plot-col">
                  <div class="chart-plot">
                    <div class="chart-gridlines" id="analyticsGridlines"></div>
                    <div class="chart-bars" id="analyticsBars"></div>
                  </div>
                  <div class="chart-x-labels" id="analyticsXLabels"></div>
                </div>
              </div>
              <p id="analyticsScholarshipChartDescription" class="visually-hidden">A responsive bar chart showing the number and percentage of enrolled scholars in each year level. Exact values are available in the hidden data table.</p>
              <table class="visually-hidden"><caption>Scholar distribution by year level</caption><thead><tr><th>Year level</th><th>Scholars</th><th>Share</th></tr></thead><tbody id="analyticsScholarshipTableBody"></tbody></table>
            </div>
          </div>

          <div class="col-lg-8">
            <div class="card-panel h-100">
              <div class="section-title">
                <div class="st-left"><i class="bi bi-mortarboard me-2"></i><h3 class="mb-0">Scholars by Institute &amp; Program</h3></div>
                <div class="btn-group btn-group-sm" role="group" aria-label="Institute or program view">
                  <button type="button" class="btn btn-outline-scholarship active" id="cyToggleInstitute" onclick="setCourseYearView('institute')">Per Institute</button>
                  <button type="button" class="btn btn-outline-scholarship" id="cyTogglePrograms" onclick="setCourseYearView('program')">Per Program</button>
                </div>
              </div>
              <div class="small text-muted-custom mb-3" id="cySubtext">Enrolled scholars grouped by institute.</div>
              <div class="doughnut-wrap">
                <div class="doughnut-svg-holder" role="group" aria-label="Scholars by institute or program" aria-describedby="cyDoughnutDescription">
                  <div id="cyDoughnutSvg"></div>
                  <div class="doughnut-center"><div class="doughnut-center-value" id="cyCenterValue">0</div><div class="doughnut-center-label">Scholars</div></div>
                </div>
                <div class="doughnut-legend" id="cyLegend"></div>
              </div>
              <p id="cyDoughnutDescription" class="visually-hidden">A doughnut chart showing the distribution of scholars by the selected institute or program view. Exact values are available in the hidden data table.</p>
              <table class="visually-hidden"><caption id="cyDoughnutTableCaption">Scholars by institute</caption><thead><tr><th>Category</th><th>Scholars</th><th>Share</th></tr></thead><tbody id="cyDoughnutTableBody"></tbody></table>
            </div>
          </div>
        </div>

        <div class="row g-3 mt-1">
          <div class="col-12">
            <div class="card-panel">
              <div class="section-title">
                <div class="st-left"><i class="bi bi-graph-up me-2"></i><h3 class="mb-0">Disbursement Distribution</h3></div>
                <div class="btn-group btn-group-sm" role="group" aria-label="Disbursement distribution period toggle">
                  <button type="button" class="btn btn-outline-scholarship active" id="tsToggleMonthly" onclick="setTimeSeriesView('monthly')">Monthly</button>
                  <button type="button" class="btn btn-outline-scholarship" id="tsToggleTerm" onclick="setTimeSeriesView('term')">Semester</button>
                </div>
              </div>
              <div class="small text-muted-custom mb-3" id="tsSubtext">Scholars credited per month — regular stipend pacing, most recent 6 months.</div>
              <div class="ts-line-wrap" id="tsLineChart" role="group" aria-label="Scholars credited over time" aria-describedby="timeSeriesChartDescription"></div>
              <p id="timeSeriesChartDescription" class="visually-hidden">A line chart showing how many scholars were credited each month or each semester. Exact values are available in each point's tooltip.</p>
              <div class="demo-note mt-2" id="tsDemoNote">Monthly cadence is sample / demo data</div>
            </div>
          </div>
        </div>

      </div>

      <!-- ============ OPERATIONS & FINANCE: payout speed, pipeline, bank failures ============ -->
      <div class="analytics-tab-pane" id="analyticsPaneOperations" role="tabpanel" aria-labelledby="anTabOperations" data-analytics-variable-panel="applications" style="display:none;">

        <div class="row g-3 mt-1">
          <div class="col-12">
            <div class="card-panel">
              <div class="section-title"><div class="st-left"><i class="bi bi-people me-2"></i><h3 class="mb-0">Scholars by Payout Stage</h3></div></div>
              <div class="small text-muted-custom mb-3">How many scholars are currently at each stage, from document submission to stipend disbursement.</div>
              <div class="pipeline-kpi-strip" id="disbursementPipelineStates" aria-label="Scholars per payout stage">
                <div class="pipeline-status-step pending"><div class="pipeline-status-label"><i class="bi bi-hourglass-split"></i>Pending</div><div class="pipeline-status-value" id="pkPendingValue">–</div><div class="pipeline-status-sub" id="pkPendingSub">Waiting for submission</div></div>
                <div class="pipeline-status-step submitted"><div class="pipeline-status-label"><i class="bi bi-send-fill"></i>Submitted</div><div class="pipeline-status-value" id="pkSubmittedValue">–</div><div class="pipeline-status-sub" id="pkSubmittedSub">Waiting for verification</div></div>
                <div class="pipeline-status-step verified"><div class="pipeline-status-label"><i class="bi bi-patch-check-fill"></i>Verified</div><div class="pipeline-status-value" id="pkVerifiedValue">–</div><div class="pipeline-status-sub" id="pkVerifiedSub">Waiting for stipend disbursement</div></div>
                <div class="pipeline-status-step credited"><div class="pipeline-status-label"><i class="bi bi-check-circle-fill"></i>Credited</div><div class="pipeline-status-value" id="pkCreditedValue">–</div><div class="pipeline-status-sub" id="pkCreditedSub">Stipend credited</div></div>
              </div>
            </div>
          </div>
        </div>

      </div>

    </section>

