    <!-- ============================================================
         PAGE: NOTIFICATIONS
         Dedicated, filterable notification sidebar reached from the Dashboard.
         ============================================================ -->
    <section class="page-section" id="page-activity-log">
      <div class="page-header notifications-page-header">
        <div class="eyebrow">Officer / Notifications</div>
        <h1>Notifications</h1>
        <p class="text-muted-custom mb-0">Stay up to date with submissions, verifications, corrections, and disbursements.</p>
      </div>

      <div class="filter-bar filter-bar-search">
        <div class="row g-2 align-items-end">
          <div class="col-md-7">
            <label class="form-label mb-0">Search notifications</label>
            <input type="text" class="form-control" id="alSearch" placeholder="e.g. Maria Santos or Certificate of Registration" oninput="renderActivityLogPage()">
          </div>
          <div class="col-md-3">
            <label class="form-label mb-0" for="alSchool">School</label>
            <select class="form-select" id="alSchool"><option value="">All schools</option></select>
          </div>
          <div class="col-md-2">
            <label class="form-label mb-0">Notification type</label>
            <select class="form-select" id="alType" onchange="renderActivityLogPage()">
              <option value="">All notifications</option>
              <option value="submission">Submissions</option>
              <option value="verification">Verifications</option>
              <option value="correction">Corrections</option>
              <option value="disbursement">Disbursement</option>
            </select>
          </div>
        </div>
      </div>

      <div class="card-panel notification-sidebar">
        <div class="section-title">
          <div class="st-left"><i class="bi bi-bell"></i><span>All Notifications</span></div>
          <span class="small text-muted-custom" id="alResultCount"></span>
        </div>
        <div class="d-flex flex-column gap-3" id="activityLogList"></div>
        <div id="alEmptyState" class="small text-muted-custom d-none">No notification matches these filters.</div>
        <div class="demo-note mt-2">Most recent 30 notifications · sample / demo data</div>
      </div>
    </section>

