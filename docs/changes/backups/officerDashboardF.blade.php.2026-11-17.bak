    <!-- ============================================================
         PAGE: ADD NEW SCHOLAR (minimal — just exists for now)
         ============================================================ -->
    <section class="page-section" id="page-add-scholar">
      <div class="page-header">
        <div class="eyebrow">Officer / Scholars / Add New</div>
        <h1>Add New Scholar</h1>
        <p class="text-muted-custom mb-0">Walk through all four steps to onboard a new scholar to the roster.</p>
      </div>

      <div class="card-panel as-wizard-card">

        <!-- Step indicator -->
        <div class="as-wizard-progress" id="scholarWizardProgressLabel">Step 1 of 4</div>
        <div class="as-req-legend"><span class="req-star" aria-hidden="true">*</span> Required field</div>
        <div class="as-stepper" id="scholarWizardStepper">
          <div class="as-step" data-step="1">
            <div class="as-step-circle"><span class="as-step-num">1</span></div>
            <div class="as-step-label">Basic Identity</div>
          </div>
          <div class="as-step" data-step="2">
            <div class="as-step-circle"><span class="as-step-num">2</span></div>
            <div class="as-step-label">Academic Details</div>
          </div>
          <div class="as-step" data-step="3">
            <div class="as-step-circle"><span class="as-step-num">3</span></div>
            <div class="as-step-label">Scholarship Details</div>
          </div>
          <div class="as-step" data-step="4">
            <div class="as-step-circle"><span class="as-step-num">4</span></div>
            <div class="as-step-label">Review &amp; Verify</div>
          </div>
        </div>

        <form id="addScholarForm" onsubmit="return false;">

          <!-- STEP 1: Basic Identity -->
          <div class="wizard-pane active" id="wizardPane1" data-pane="1">
            <div class="wizard-pane-title">Basic Identity</div>
            <div class="wizard-pane-sub">Enter the scholar's personal, contact, and address details.</div>
            <div class="as-information-grid">
              <section class="as-information-card">
                <div class="as-information-card-head"><h3>Personal Information</h3><p>Who the scholar is</p></div>
                <div class="as-information-rows">
                  <div class="as-information-row"><label for="nasFirstName">First Name</label><input type="text" class="form-control" id="nasFirstName" placeholder="e.g. Angelo Karl" autocomplete="given-name" required></div>
                  <div class="as-information-row"><label for="nasLastName">Last Name</label><input type="text" class="form-control" id="nasLastName" placeholder="e.g. Santos" autocomplete="family-name" required></div>
                  <div class="as-information-row"><label for="nasMiddleName">Middle Name</label><input type="text" class="form-control" id="nasMiddleName" placeholder="e.g. Reyes" autocomplete="additional-name"><input type="hidden" id="nasName"></div>
                  <div class="as-information-row"><label for="nasSex">Sex</label><select class="form-select" id="nasSex" required><option value="">Select…</option><option value="Female">Female</option><option value="Male">Male</option></select></div>
                  <div class="as-information-row"><label for="nasDob">Birth Date</label><input type="text" class="form-control" id="nasDob" inputmode="numeric" placeholder="yyyy-mm-dd" maxlength="10" pattern="[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])" autocomplete="bday" required></div>
                  <div class="as-information-row"><label for="nasNationality">Nationality</label><input type="text" class="form-control" id="nasNationality" value="Filipino" required></div>
                </div>
              </section>
              <section class="as-information-card">
                <div class="as-information-card-head"><h3>Contact Information</h3><p>How the scholarship office reaches the scholar</p></div>
                <div class="as-information-subhead">Contact</div>
                <div class="as-information-rows">
                  <div class="as-information-row"><label for="nasEmail">Email</label><input type="email" class="form-control" id="nasEmail" placeholder="e.g. angelo.santos@gmail.com" required></div>
                  <div class="as-information-row"><label for="nasAltEmail">Alternative Email</label><input type="email" class="form-control" id="nasAltEmail" placeholder="Not provided"></div>
                  <div class="as-information-row"><label for="nasContact">Phone Number</label><input type="tel" class="form-control" id="nasContact" placeholder="e.g. 0917 123 4567" required></div>
                </div>
                <div class="as-information-subhead">Address</div>
                <div class="as-information-rows">
                  <div class="as-information-row"><label for="nasSpecificAddress">Home Address</label><input type="text" class="form-control" id="nasSpecificAddress" placeholder="House / street / barangay" required></div>
                  <div class="as-information-row"><label for="nasCity">City</label><input type="text" class="form-control" id="nasCity" placeholder="e.g. Malolos City" required></div>
                  <div class="as-information-row"><label for="nasProvince">Province</label><input type="text" class="form-control" id="nasProvince" placeholder="e.g. Bulacan" required></div>
                  <div class="as-information-row"><label for="nasZip">ZIP Code</label><input type="text" class="form-control" id="nasZip" placeholder="e.g. 3000" required></div>
                </div>
              </section>
            </div>
          </div>

          <!-- STEP 2: Academic Details -->
          <div class="wizard-pane" id="wizardPane2" data-pane="2">
            <div class="wizard-pane-title">Academic Details</div>
            <div class="wizard-pane-sub">Set the scholar's school, program, student ID, and current academic standing.</div>
            <div class="as-information-grid">
              <section class="as-information-card">
                <div class="as-information-card-head"><h3>School Information</h3><p>The scholar's current academic information</p></div>
                <div class="as-information-rows">
                  <div class="as-information-row"><label for="nasInstitute">Campus</label><select class="form-select" id="nasInstitute" required><option value="">Select campus…</option><option value="Main (Panabo Campus)">Main (Panabo Campus)</option><option value="Carmen Campus">Carmen Campus</option><option value="Samal Campus">Samal Campus</option><option value="Talaingod Campus">Talaingod Campus</option><option value="Asuncion Campus">Asuncion Campus</option></select></div>
                  <div class="as-information-row"><label for="nasProgram">Program</label><select class="form-select" id="nasProgram" required><option value="">Select degree program…</option></select></div>
                  <div class="as-information-row"><label for="nasYearLevel">Year Level</label><select class="form-select" id="nasYearLevel" required><option value="">Select year…</option><option value="1">1st Year</option><option value="2">2nd Year</option><option value="3">3rd Year</option><option value="4">4th Year</option><option value="5">5th Year</option></select></div>
                  <div class="as-information-row"><label for="nasStudentId">Student ID</label><input type="text" class="form-control" id="nasStudentId" placeholder="2026-0000" required></div>
                </div>
              </section>
              <section class="as-information-card">
                <div class="as-information-card-head"><h3>Academic Period</h3><p>Current term and standing</p></div>
                <div class="as-information-rows">
                  <div class="as-information-row"><label for="nasAcademicYear">Academic Year</label><select class="form-select" id="nasAcademicYear" required><option value="">Select AY…</option><option>2026–2027</option><option>2025–2026</option><option>2027–2028</option></select></div>
                  <div class="as-information-row"><label for="nasSemester">Semester</label><select class="form-select" id="nasSemester" required><option value="">Select semester…</option><option>1st Semester</option><option>2nd Semester</option><option>Summer</option></select></div>
                  <div class="as-information-row"><label for="nasGwa">Previous GWA</label><input type="number" step="0.01" min="1" max="5" class="form-control" id="nasGwa" placeholder="e.g. 1.75" required></div>
                </div>
              </section>
            </div>
          </div>

          <!-- STEP 3: Grant & Disbursement Setup -->
          <div class="wizard-pane" id="wizardPane3" data-pane="3">
            <div class="wizard-pane-title">Scholarship Details</div>
            <div class="wizard-pane-sub">Choose the grant, supported classification, and where the stipend will be sent.</div>
            <div class="row g-3">
              <div class="col-md-6"><label class="form-label mb-0" for="nasScholarId">Scholar Number</label><input type="text" class="form-control" id="nasScholarId" value="" readonly disabled aria-readonly="true"></div>
              <div class="col-md-6"><label class="form-label mb-0" for="nasScholarship">Scholarship</label><select class="form-select" id="nasScholarship" required><option value="">Select scholarship type…</option><optgroup label="DNSC Internal (no stipend)"><option value="DNSC Academic Scholarship">DNSC Academic Scholarship</option><option value="DNSC GIA Category A">DNSC Grant-in-Aid (GIA) – Category A</option><option value="DNSC GIA Category B">DNSC Grant-in-Aid (GIA) – Category B</option><option value="DNSC SA Category C">DNSC Student Assistant (SA) – Category C</option></optgroup><optgroup label="External scholarships (with stipend)"><option value="CHED TDP">CHED TDP</option><option value="DOST-SEI">DOST-SEI Scholarship</option><option value="CHED TES">CHED TES</option><option value="Bagong Pilipinas Scholarship Program">Bagong Pilipinas (BPMSP)</option><option value="CHED Merit Scholarship Program">CHED Merit (CMSP)</option><option value="GrabScholar">GrabScholar</option><option value="cebuana">Cebuana Lhuillier (CLFI)</option></optgroup></select></div>
              <div class="col-md-6"><label class="form-label mb-0" for="nasClassification">Classification</label><select class="form-select" id="nasClassification" required><option value="">Select classification…</option><option value="half">Half</option><option value="full">Full</option><option value="na">N/A</option></select></div>
              <div class="col-md-6"><label class="form-label mb-0" for="nasChannel">Payment Channel</label><select class="form-select" id="nasChannel" required></select><div class="form-text" id="nasChannelHelp"></div></div>
              <div class="col-md-6"><label class="form-label mb-0" for="nasAccountNumber">Account Number</label><input type="text" class="form-control" id="nasAccountNumber" placeholder="Type card or account number" required><div class="form-text" id="nasAccountHelp"></div></div>
              <div class="col-12"><label class="form-label mb-0" for="nasStipend">Calculated Stipend</label><input type="text" class="form-control" id="nasStipend" value="Select a grant program" readonly aria-describedby="nasStipendHelp"><div class="form-text" id="nasStipendHelp">Calculated from the selected grant and classification.</div></div>
              <div class="col-12"><div class="as-scholarship-config" id="nasScholarshipConfig" aria-live="polite"><div class="as-config-empty">Select a grant program to view non-monetary benefits and requirements.</div></div></div>
            </div>
          </div>

          <!-- STEP 4: Profile Review & Final Verification -->
          <div class="wizard-pane" id="wizardPane4" data-pane="4">
            <div class="wizard-pane-title">Review &amp; Verify</div>
            <div class="wizard-pane-sub">Confirm everything below is correct before adding this scholar to the roster.</div>
            <div id="asReviewContent"></div>
            <div class="remark-note mt-2">
              <i class="bi bi-info-circle-fill mt-1"></i>
              <div>Required documents are loaded from the selected scholarship configuration. Upload and verify them from the Document Verification page once the profile is saved.</div>
            </div>
            <div class="as-verify-box">
              <input type="checkbox" id="nasVerifyCheck">
              <label for="nasVerifyCheck">I have verified that all information provided above is accurate and complete.</label>
            </div>
          </div>

          <!-- Wizard footer navigation: sticky to the bottom of the wizard card
               so Previous/Next/Save stay reachable without scrolling back down. -->
          <div class="scholar-wizard-footer" id="scholarWizardFooter">
            <button type="button" class="btn btn-outline-scholarship" id="scholarWizardPrevBtn" onclick="navigateWizard(-1)" style="visibility:hidden;">
              <i class="bi bi-arrow-left"></i> Previous Step
            </button>
            <button type="button" class="btn btn-scholarship-green" id="scholarWizardNextBtn" onclick="navigateWizard(1)">
              Next Step <i class="bi bi-arrow-right"></i>
            </button>
            <button type="button" class="btn btn-scholarship-green" id="scholarWizardSaveBtn" onclick="submitNewScholar()" style="display:none;" disabled>
              <i class="bi bi-person-plus-fill"></i> Save Scholar Profile
            </button>
          </div>
        </form>
      </div>
    </section>

    <!-- ============================================================
         PAGE: STIPEND DISBURSEMENT
         ============================================================ -->
    <section class="page-section" id="page-stipend-release">
      <div class="page-header">
        <div class="eyebrow">Officer / Stipend Disbursement</div>
        <h1>Stipend Disbursement</h1>
        <p class="text-muted-custom mb-0" id="stipendPeriodSubtitle">Disburse stipends to scholars whose required documents are fully verified.</p>
      </div>

      <div class="dv-kpi-strip" id="stipendSummaryRow" aria-label="Stipend disbursement summary"></div>

      <div class="card-panel">
        <div class="section-title">
          <div class="st-left"><i class="bi bi-cash-coin"></i><span id="stipendTableTitle">Eligible Scholars</span></div>
          <button type="button" class="btn btn-sm btn-academic-red" id="batchReleaseBtn" disabled title="Select at least one scholar to enable" onclick="openBatchReleaseModal()">
            <i class="bi bi-cash-stack me-1"></i><span>Disburse Selected (<span id="batchReleaseCount">0</span>)</span>
          </button>
        </div>
        <div class="filter-bar filter-bar-search filter-bar-inline" aria-label="Stipend disbursement filters">
          <div class="row g-2 align-items-end">
            <div class="col-md-6 col-lg-4"><label class="form-label mb-0" for="srSearch">Search scholar / Student ID</label><input type="text" class="form-control" id="srSearch" placeholder="Name or Student ID"></div>
            <div class="col-6 col-lg-3"><label class="form-label mb-0" for="srTerm">AY / Semester</label><select class="form-select" id="srTerm"><option value="2026–2027|1st Semester" selected>1st Semester 2026–2027 (current)</option><option value="2025–2026|2nd Semester">2nd Semester 2025–2026</option><option value="2025–2026|1st Semester">1st Semester 2025–2026</option><option value="">All semesters</option></select></div>
            <div class="col-6 col-lg-3"><label class="form-label mb-0" for="srScholarship">Scholarship type</label><select class="form-select" id="srScholarship"><option value="">All scholarship types</option></select></div>
            <div class="col-6 col-lg-2"><label class="form-label mb-0" for="srSchool">School</label><select class="form-select" id="srSchool"><option value="">All schools</option></select></div>
            <div class="col-12 col-lg-2"><label class="form-label mb-0" for="srStatus">Disbursement status</label><select class="form-select" id="srStatus"><option value="">All eligible</option><option value="ready">Ready for disbursement</option><option value="released">Already disbursed</option><option value="dnsc_pending">DNSC – awaiting completion</option><option value="dnsc_complete">DNSC – marked complete</option></select></div>
          </div>
        </div>
        <div class="table-app-wrap table-responsive-wrap">
          <table class="table-app">
            <thead>
              <tr id="srTableHeadRow">
                <th style="width:2.2rem;"><input type="checkbox" class="form-check-input" id="stipendSelectAll" onchange="toggleSelectAllStipend(this.checked)" aria-label="Select all ready-for-disbursement scholars across all pages"></th>
                <th tabindex="0" role="button" class="th-sortable" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}" data-sort-key="name">Scholar <i class="bi bi-arrow-down-up sort-icon"></i></th>
                <th tabindex="0" role="button" class="th-sortable" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}" data-sort-key="student_id">Student ID <i class="bi bi-arrow-down-up sort-icon"></i></th>
                <th tabindex="0" role="button" class="th-sortable" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}" data-sort-key="scholarship">Scholarship <i class="bi bi-arrow-down-up sort-icon"></i></th>
                <th tabindex="0" role="button" class="th-sortable" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}" data-sort-key="channel">Channel <i class="bi bi-arrow-down-up sort-icon"></i></th>
                <th tabindex="0" role="button" class="th-sortable cell-amount" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}" data-sort-key="amount">Amount <i class="bi bi-arrow-down-up sort-icon"></i></th>
                <th></th>
              </tr>
            </thead>
            <tbody id="stipendTableBody"></tbody>
          </table>
        </div>
        <div id="stipendMobileCards"></div>
        <div class="table-footer-bar">
          <div class="tf-pagesize">
            <label class="form-label mb-0 small text-muted-custom" for="srPageSize">Rows per page</label>
            <select class="form-select form-select-sm" id="srPageSize">
              <option value="5">5</option>
              <option value="10" selected>10</option>
              <option value="25">25</option>
              <option value="50">50</option>
            </select>
          </div>
          <div class="tf-counter small text-muted-custom" id="srPageCounter">Showing 0 of 0 scholars</div>
          <div class="tf-pagebtns">
            <button type="button" class="btn btn-outline-scholarship btn-sm" id="srPrevPage" onclick="changeListPage('sr', -1)">
              <i class="bi bi-chevron-left"></i> Previous
            </button>
            <span id="srPageNumbers" class="d-flex gap-1 align-items-center"></span>
            <button type="button" class="btn btn-outline-scholarship btn-sm" id="srNextPage" onclick="changeListPage('sr', 1)">
              Next <i class="bi bi-chevron-right"></i>
            </button>
          </div>
        </div>
        <div class="demo-note mt-2">Only stipend-paying scholars whose required documents are verified appear as eligible. DNSC scholarship scholars are listed for completion marking instead of disbursement.</div>
      </div>
    </section>

    <!-- ============================================================
         PAGE: DISBURSEMENT HISTORY
         ============================================================ -->
    <section class="page-section" id="page-disbursement-history">
      <div class="page-header">
        <div class="eyebrow">Officer / Disbursement History</div>
        <h1>Disbursement History</h1>
        <p class="text-muted-custom mb-0">A filterable record of all stipends disbursed to scholars.</p>
      </div>

      <div class="filter-bar">
        <div class="row g-2 align-items-end">
          <div class="col-md-4">
            <label class="form-label mb-0" for="dhTerm">Semester</label>
            <select class="form-select" id="dhTerm">
              <option value="">All terms</option>
              <option value="2026–2027|1st Semester">2026–2027 · 1st Semester</option>
              <option value="2025–2026|2nd Semester">2025–2026 · 2nd Semester</option>
              <option value="2025–2026|1st Semester">2025–2026 · 1st Semester</option>
            </select>
          </div>
