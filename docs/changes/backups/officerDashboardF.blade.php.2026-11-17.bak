    <!-- ============================================================
         PAGE: SETTINGS
         ============================================================ -->
    <section class="page-section" id="page-settings">
      <div class="page-header">
        <div class="eyebrow">Officer / Settings</div>
        <h1>Settings</h1>
        <p class="text-muted-custom mb-0">Manage your account security.</p>
      </div>

      <div class="pwc-card mb-3" id="password-card" aria-labelledby="password-title">
        <div class="pwc-head">
          <div>
            <h3 id="password-title">Edit Password</h3>
            <div class="pwc-sub">Optional. Change your password only if you want to.</div>
          </div>
          <button type="button" class="pwc-btn quiet sm" id="password-toggle" aria-expanded="false" aria-controls="password-form">Change Password</button>
        </div>
        <div class="pwc-msg" id="password-msg" role="alert" hidden></div>
        <form id="password-form" class="pwc-form" novalidate hidden>
          <div class="pwc-field">
            <label for="current-password">Current Password</label>
            <input class="pwc-input" type="password" id="current-password" autocomplete="current-password" />
          </div>
          <div class="pwc-field">
            <label for="new-password">New Password</label>
            <input class="pwc-input" type="password" id="new-password" autocomplete="new-password" />
          </div>
          <div class="pwc-field">
            <label for="confirm-password">Confirm New Password</label>
            <input class="pwc-input" type="password" id="confirm-password" autocomplete="new-password" />
          </div>
          <div class="pwc-actions">
            <button type="submit" class="pwc-btn primary" id="password-submit">Update Password</button>
            <button type="button" class="pwc-btn quiet" id="password-cancel">Cancel</button>
          </div>
        </form>
      </div>

      <div class="card-panel sd-account-card sd-logout-card">
        <div>
          <div class="section-title" style="margin-bottom:0.25rem;">
            <div class="st-left"><i class="bi bi-box-arrow-right"></i><span>Log Out</span></div>
          </div>
          <p class="small text-muted-custom mb-0">End your current session on this device.</p>
        </div>
        <button type="button" class="btn btn-academic-red" onclick="handleLogout()">
          <i class="bi bi-box-arrow-right me-2"></i>Log Out
        </button>
      </div>
    </section>

  </main>
</div>

<!-- ============================================================
     LOGOUT CONFIRMATION MODAL (same design as the Scholar Dashboard)
     ============================================================ -->
<!-- Logout preloader: shown after the logout is confirmed -->
<div id="nxPreloader" class="nx-preloader nx-preloader-hide" role="status" aria-live="polite" aria-hidden="true">
  <div class="nx-preloader-mark"></div>
  <span>BAKR</span>
</div>

<div class="lgo-backdrop" id="logout-backdrop" hidden>
  <div class="lgo-modal" id="logout-modal" role="dialog" aria-modal="true" aria-labelledby="logout-modal-title">
    <div class="lgo-head">
      <h3 id="logout-modal-title">Log out?</h3>
      <button type="button" class="lgo-close" id="logout-close" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div class="lgo-body">
      <p class="lgo-current">You will be signed out of your officer account on this device.</p>
    </div>
    <div class="lgo-foot">
      <button type="button" class="lgo-btn quiet" id="logout-cancel">Cancel</button>
      <button type="button" class="lgo-btn danger" id="logout-confirm"> <a href="{{ url('/officerLogin') }}">Log out</a></button>
    </div>
  </div>
</div>



<!-- ============================================================
     DOCUMENT REVIEW MODAL
     ============================================================ -->
<div class="modal fade" id="reviewModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <h5 class="modal-title mb-0"><i class="bi bi-file-earmark-check me-2" style="color:var(--sd-green-700);"></i><span id="reviewScholarName">Scholar Name</span></h5>
          <div class="small text-muted-custom" id="reviewScholarId">0000-00000</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="row g-2 mb-3">
          <div class="col-6">
            <div class="info-item" style="padding-top:0;">
              <div class="info-label">Scholarship</div>
              <div class="info-value" id="reviewScholarship">DNSC Academic Scholarship</div>
            </div>
          </div>
          <div class="col-6">
            <div class="info-item" style="padding-top:0;">
              <div class="info-label">Academic Year</div>
              <div class="info-value">2026–2027</div>
            </div>
          </div>
        </div>
        <div id="reviewDocListContainer"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-scholarship" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- ============================================================
     EDIT PENDING SCHOLAR MODAL (same design as Add New Scholar)
     ============================================================ -->
<div class="modal fade" id="editPendingModal" tabindex="-1" aria-hidden="true" aria-labelledby="editPendingModalTitle" data-bs-backdrop="static">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <h5 class="modal-title mb-0" id="editPendingModalTitle"><i class="bi bi-pencil-square me-2" style="color:var(--sd-green-700);"></i>Edit Pending Scholar</h5>
          <div class="epm-readonly-note mt-1">Update this scholar's details while awaiting admin approval. The Scholar ID cannot be changed.</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="as-wizard-card">
          <div class="as-wizard-progress" id="epmProgressLabel">Step 1 of 4</div>
          <div class="as-req-legend"><span class="req-star" aria-hidden="true">*</span> Required field</div>
          <div class="as-stepper" id="epmStepper">
            <div class="as-step" data-step="1"><div class="as-step-circle"><span class="as-step-num">1</span></div><div class="as-step-label">Basic Identity</div></div>
            <div class="as-step" data-step="2"><div class="as-step-circle"><span class="as-step-num">2</span></div><div class="as-step-label">Academic Details</div></div>
            <div class="as-step" data-step="3"><div class="as-step-circle"><span class="as-step-num">3</span></div><div class="as-step-label">Scholarship Details</div></div>
            <div class="as-step" data-step="4"><div class="as-step-circle"><span class="as-step-num">4</span></div><div class="as-step-label">Review &amp; Verify</div></div>
          </div>
          <form id="editPendingForm" onsubmit="return false;" novalidate>

          <!-- STEP 1: Basic Identity -->
          <div class="wizard-pane active" id="epmPane1" data-pane="1">
            <div class="wizard-pane-title">Basic Identity</div>
            <div class="wizard-pane-sub">Enter the scholar's personal, contact, and address details.</div>
            <div class="as-information-grid">
              <section class="as-information-card">
                <div class="as-information-card-head"><h3>Personal Information</h3><p>Who the scholar is</p></div>
                <div class="as-information-rows">
                  <div class="as-information-row"><label for="epmFirstName">First Name</label><input type="text" class="form-control" id="epmFirstName" placeholder="e.g. Angelo Karl" autocomplete="given-name" required></div>
                  <div class="as-information-row"><label for="epmLastName">Last Name</label><input type="text" class="form-control" id="epmLastName" placeholder="e.g. Santos" autocomplete="family-name" required></div>
                  <div class="as-information-row"><label for="epmMiddleName">Middle Name</label><input type="text" class="form-control" id="epmMiddleName" placeholder="e.g. Reyes" autocomplete="additional-name"><input type="hidden" id="epmName"></div>
                  <div class="as-information-row"><label for="epmSex">Sex</label><select class="form-select" id="epmSex" required><option value="">Select…</option><option value="Female">Female</option><option value="Male">Male</option></select></div>
                  <div class="as-information-row"><label for="epmDob">Birth Date</label><input type="text" class="form-control" id="epmDob" inputmode="numeric" placeholder="yyyy-mm-dd" maxlength="10" pattern="[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])" autocomplete="bday" required></div>
                  <div class="as-information-row"><label for="epmNationality">Nationality</label><input type="text" class="form-control" id="epmNationality" value="Filipino" required></div>
                </div>
              </section>
              <section class="as-information-card">
                <div class="as-information-card-head"><h3>Contact Information</h3><p>How the scholarship office reaches the scholar</p></div>
                <div class="as-information-subhead">Contact</div>
                <div class="as-information-rows">
                  <div class="as-information-row"><label for="epmEmail">Email</label><input type="email" class="form-control" id="epmEmail" placeholder="e.g. angelo.santos@gmail.com" required></div>
                  <div class="as-information-row"><label for="epmAltEmail">Alternative Email</label><input type="email" class="form-control" id="epmAltEmail" placeholder="Not provided"></div>
                  <div class="as-information-row"><label for="epmContact">Phone Number</label><input type="tel" class="form-control" id="epmContact" placeholder="e.g. 0917 123 4567" required></div>
                </div>
                <div class="as-information-subhead">Address</div>
                <div class="as-information-rows">
                  <div class="as-information-row"><label for="epmSpecificAddress">Home Address</label><input type="text" class="form-control" id="epmSpecificAddress" placeholder="House / street / barangay" required></div>
                  <div class="as-information-row"><label for="epmCity">City</label><input type="text" class="form-control" id="epmCity" placeholder="e.g. Malolos City" required></div>
                  <div class="as-information-row"><label for="epmProvince">Province</label><input type="text" class="form-control" id="epmProvince" placeholder="e.g. Bulacan" required></div>
                  <div class="as-information-row"><label for="epmZip">ZIP Code</label><input type="text" class="form-control" id="epmZip" placeholder="e.g. 3000" required></div>
                </div>
              </section>
            </div>
          </div>

          <!-- STEP 2: Academic Details -->
          <div class="wizard-pane" id="epmPane2" data-pane="2">
            <div class="wizard-pane-title">Academic Details</div>
            <div class="wizard-pane-sub">Set the scholar's school, program, student ID, and current academic standing.</div>
            <div class="as-information-grid">
              <section class="as-information-card">
                <div class="as-information-card-head"><h3>School Information</h3><p>The scholar's current academic information</p></div>
                <div class="as-information-rows">
                  <div class="as-information-row"><label for="epmInstitute">Campus</label><select class="form-select" id="epmInstitute" required><option value="">Select campus…</option><option value="Main (Panabo Campus)">Main (Panabo Campus)</option><option value="Carmen Campus">Carmen Campus</option><option value="Samal Campus">Samal Campus</option><option value="Talaingod Campus">Talaingod Campus</option><option value="Asuncion Campus">Asuncion Campus</option></select></div>
                  <div class="as-information-row"><label for="epmProgram">Program</label><select class="form-select" id="epmProgram" required><option value="">Select degree program…</option></select></div>
                  <div class="as-information-row"><label for="epmYearLevel">Year Level</label><select class="form-select" id="epmYearLevel" required><option value="">Select year…</option><option value="1">1st Year</option><option value="2">2nd Year</option><option value="3">3rd Year</option><option value="4">4th Year</option><option value="5">5th Year</option></select></div>
                  <div class="as-information-row"><label for="epmStudentId">Student ID</label><input type="text" class="form-control" id="epmStudentId" placeholder="2026-0000" required></div>
                </div>
              </section>
              <section class="as-information-card">
                <div class="as-information-card-head"><h3>Academic Period</h3><p>Current term and standing</p></div>
                <div class="as-information-rows">
                  <div class="as-information-row"><label for="epmAcademicYear">Academic Year</label><select class="form-select" id="epmAcademicYear" required><option value="">Select AY…</option><option>2026–2027</option><option>2025–2026</option><option>2027–2028</option></select></div>
                  <div class="as-information-row"><label for="epmSemester">Semester</label><select class="form-select" id="epmSemester" required><option value="">Select semester…</option><option>1st Semester</option><option>2nd Semester</option><option>Summer</option></select></div>
                  <div class="as-information-row"><label for="epmGwa">Previous GWA</label><input type="number" step="0.01" min="1" max="5" class="form-control" id="epmGwa" placeholder="e.g. 1.75" required></div>
                </div>
              </section>
            </div>
          </div>

          <!-- STEP 3: Grant & Disbursement Setup -->
          <div class="wizard-pane" id="epmPane3" data-pane="3">
            <div class="wizard-pane-title">Scholarship Details</div>
            <div class="wizard-pane-sub">Choose the grant, supported classification, and where the stipend will be sent.</div>
            <div class="row g-3">
              <div class="col-md-6"><label class="form-label mb-0" for="epmScholarId">Scholar Number</label><input type="text" class="form-control" id="epmScholarId" value="" readonly disabled aria-readonly="true"></div>
              <div class="col-md-6"><label class="form-label mb-0" for="epmScholarship">Scholarship</label><select class="form-select" id="epmScholarship" required><option value="">Select scholarship type…</option><optgroup label="DNSC Internal (no stipend)"><option value="DNSC Academic Scholarship">DNSC Academic Scholarship</option><option value="DNSC GIA Category A">DNSC Grant-in-Aid (GIA) – Category A</option><option value="DNSC GIA Category B">DNSC Grant-in-Aid (GIA) – Category B</option><option value="DNSC SA Category C">DNSC Student Assistant (SA) – Category C</option></optgroup><optgroup label="External scholarships (with stipend)"><option value="CHED TDP">CHED TDP</option><option value="DOST-SEI">DOST-SEI Scholarship</option><option value="CHED TES">CHED TES</option><option value="Bagong Pilipinas Scholarship Program">Bagong Pilipinas (BPMSP)</option><option value="CHED Merit Scholarship Program">CHED Merit (CMSP)</option><option value="GrabScholar">GrabScholar</option><option value="cebuana">Cebuana Lhuillier (CLFI)</option></optgroup></select></div>
              <div class="col-md-6"><label class="form-label mb-0" for="epmClassification">Classification</label><select class="form-select" id="epmClassification" required><option value="">Select classification…</option><option value="half">Half</option><option value="full">Full</option><option value="na">N/A</option></select></div>
              <div class="col-md-6"><label class="form-label mb-0" for="epmChannel">Payment Channel</label><select class="form-select" id="epmChannel" required></select><div class="form-text" id="epmChannelHelp"></div></div>
              <div class="col-md-6"><label class="form-label mb-0" for="epmAccountNumber">Account Number</label><input type="text" class="form-control" id="epmAccountNumber" placeholder="Type card or account number" required><div class="form-text" id="epmAccountHelp"></div></div>
              <div class="col-12"><label class="form-label mb-0" for="epmStipend">Calculated Stipend</label><input type="text" class="form-control" id="epmStipend" value="Select a grant program" readonly aria-describedby="epmStipendHelp"><div class="form-text" id="epmStipendHelp">Calculated from the selected grant and classification.</div></div>
              <div class="col-12"><div class="as-scholarship-config" id="epmScholarshipConfig" aria-live="polite"><div class="as-config-empty">Select a grant program to view non-monetary benefits and requirements.</div></div></div>
            </div>
          </div>

          <!-- STEP 4: Profile Review & Final Verification -->
          <div class="wizard-pane" id="epmPane4" data-pane="4">
            <div class="wizard-pane-title">Review &amp; Verify</div>
            <div class="wizard-pane-sub">Confirm everything below is correct before saving these changes to the pending submission.</div>
            <div id="epmReviewContent"></div>
            <div class="remark-note mt-2">
              <i class="bi bi-info-circle-fill mt-1"></i>
              <div>Required documents are loaded from the selected scholarship configuration. Upload and verify them from the Document Verification page once the scholar is approved.</div>
            </div>
            <div class="as-verify-box">
              <input type="checkbox" id="epmVerifyCheck">
              <label for="epmVerifyCheck">I have verified that all information provided above is accurate and complete.</label>
            </div>
          </div>

          </form>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-scholarship" id="epmPrevBtn" onclick="navigateEditPending(-1)" style="visibility:hidden;"><i class="bi bi-arrow-left"></i> Previous Step</button>
        <button type="button" class="btn btn-scholarship-green" id="epmNextBtn" onclick="navigateEditPending(1)">Next Step <i class="bi bi-arrow-right"></i></button>
        <button type="button" class="btn btn-scholarship-green" id="epmSaveBtn" onclick="saveEditedPendingScholar()" style="display:none;" disabled><i class="bi bi-check2-circle"></i> Save Changes</button>
      </div>
    </div>
  </div>
</div>

<!-- ============================================================
     SCHOLAR PROFILE MODAL
     ============================================================ -->
<div class="modal fade" id="profileModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="profileModalTitle"><i class="bi bi-person-badge me-2" style="color:var(--sd-green-700);"></i>Scholar Profile</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="row info-grid" id="profileInfoGrid"></div>
        <div class="section-title" style="margin:0.9rem 0 0.6rem;">
          <div class="st-left"><i class="bi bi-mortarboard"></i><span>Enter / Correct GWA</span></div>
        </div>
        <div class="d-flex flex-wrap align-items-end gap-2">
          <div style="max-width:180px;">
            <label class="form-label mb-1 small" for="profileGwaInput">GWA (1.00 – 5.00)</label>
            <input type="number" step="0.01" min="1" max="5" class="form-control" id="profileGwaInput" placeholder="e.g. 1.75">
          </div>
          <button type="button" class="btn btn-sm btn-scholarship-green" id="profileGwaSaveBtn"><i class="bi bi-check2 me-1"></i>Save GWA</button>
        </div>
        <div class="small text-muted-custom mt-2" id="profileGwaHint"></div>
        <div class="small mt-1" id="profileGwaError" style="color:var(--sd-red, #b3261e);" role="alert"></div>
        <hr style="border-color: var(--sd-border);">
        <div class="section-title" style="margin-bottom:0.6rem;">
          <div class="st-left"><i class="bi bi-file-earmark-text"></i><span>Document Status</span></div>
        </div>
        <div id="profileDocStatus" class="mb-3"></div>
        <div class="section-title" style="margin-bottom:0.6rem;">
          <div class="st-left"><i class="bi bi-clock-history"></i><span>Disbursement History</span></div>
        </div>
        <div id="profileStipendHistory"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-scholarship" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- ============================================================
     RELEASE CONFIRMATION MODAL
     ============================================================ -->
<div class="modal fade" id="releaseModal" tabindex="-1" aria-hidden="true" aria-labelledby="releaseModalLabel" aria-describedby="releaseModalSummary">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="releaseModalLabel"><i class="bi bi-cash-stack me-2" style="color:var(--sd-green-700);"></i>Disburse Stipend</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="releaseModalSummary">
        <div class="row info-grid">
          <div class="col-6">
            <div class="info-item">
              <div class="info-label">Scholar</div>
              <div class="info-value" id="relScholarName">–</div>
            </div>
          </div>
          <div class="col-6">
            <div class="info-item">
              <div class="info-label">Scholar ID</div>
              <div class="info-value" id="relScholarId">–</div>
            </div>
          </div>
          <div class="col-6">
            <div class="info-item">
              <div class="info-label">Amount</div>
              <div class="info-value amount-value" id="relAmount">–</div>
            </div>
          </div>
        </div>

        <!-- Disbursement breakdown: destination account, payment period -->
        <div class="small fw-semibold mt-3 mb-2" style="color:var(--sd-ink);">Disbursement Breakdown</div>
        <div class="row info-grid">
          <div class="col-6">
            <div class="info-item">
              <div class="info-label">Account Number</div>
              <div class="info-value" id="relAccountNumber">–</div>
            </div>
          </div>
          <div class="col-6">
            <div class="info-item">
              <div class="info-label">Payment Period</div>
              <div class="info-value" id="relPeriod" style="font-size:0.95rem;">–</div>
            </div>
          </div>
        </div>

        <div class="remark-note mt-2">
          <i class="bi bi-info-circle-fill mt-1"></i>
          <div>This will record the stipend as disbursed for this semester. This action reflects on the scholar's disbursement history.</div>
        </div>

        <!-- Accidental-execution safeguard: primary button stays disabled until checked -->
        <div class="form-check mt-3" style="padding-left:1.75rem;">
          <input class="form-check-input" type="checkbox" id="relAckCheck" onchange="document.getElementById('confirmReleaseBtn').disabled = !this.checked;">
          <label class="form-check-label small" for="relAckCheck" id="relAckLabel">
            I verify that this recipient record has been reviewed.
          </label>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-scholarship" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-academic-red" id="confirmReleaseBtn" disabled>Confirm Disbursement</button>
      </div>
    </div>
  </div>
</div>

<!-- ============================================================
     DNSC SCHOLAR — MARKED AS COMPLETE MODAL
     ============================================================ -->
<div class="modal fade" id="completeModal" tabindex="-1" aria-hidden="true" aria-labelledby="completeModalLabel">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="completeModalLabel"><i class="bi bi-patch-check-fill me-2" style="color:var(--sd-green-700);"></i>Scholar Marked as Complete</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="row info-grid">
          <div class="col-12 col-sm-5">
            <div class="info-item">
              <div class="info-label">Scholar Name</div>
              <div class="info-value" id="cmpScholarName">–</div>
            </div>
          </div>
          <div class="col-6 col-sm-3">
            <div class="info-item">
              <div class="info-label">Scholar ID</div>
              <div class="info-value" id="cmpScholarId">–</div>
            </div>
          </div>
          <div class="col-6 col-sm-4">
            <div class="info-item">
              <div class="info-label">Campus</div>
              <div class="info-value" id="cmpCampus" style="font-size:0.95rem;">–</div>
            </div>
          </div>
        </div>
        <div class="alert alert-success d-flex align-items-start gap-2 mt-3 mb-0" role="alert">
          <i class="bi bi-check-circle-fill mt-1"></i>
          <div><strong>This scholar has been marked as complete.</strong> The appropriate benefits may now be awarded in person at the school's office.</div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-scholarship" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- ============================================================
     BATCH STIPEND DISBURSEMENT — two-step confirmation modal
     ============================================================ -->
<div class="modal fade" id="batchReleaseModal" tabindex="-1" aria-hidden="true" aria-labelledby="batchReleaseModalLabel" aria-describedby="batchReleaseModalSummary">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="batchReleaseModalLabel"><i class="bi bi-cash-stack me-2" style="color:var(--sd-green-700);"></i>Disburse Selected Stipends</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="batchReleaseModalSummary">

        <!-- Step 1: Review — explicit recipient count + aggregate amount -->
        <div id="batchReleaseStep1">

          <!-- Disbursement breakdown: recipients, total, payment period -->
          <div class="small fw-semibold mb-2" style="color:var(--sd-ink);">Disbursement Breakdown</div>
          <div class="row info-grid">
            <div class="col-6">
              <div class="info-item">
                <div class="info-label">Recipients</div>
                <div class="info-value" id="batchRelCount">–</div>
              </div>
            </div>
            <div class="col-6">
              <div class="info-item">
                <div class="info-label">Total Payout</div>
                <div class="info-value amount-value" id="batchRelTotal">–</div>
              </div>
            </div>
            <div class="col-6">
              <div class="info-item">
                <div class="info-label">Payment Period</div>
                <div class="info-value" id="batchRelPeriod" style="font-size:0.95rem;">–</div>
              </div>
            </div>
          </div>
          <div class="small text-muted-custom mt-2 mb-1">Scholars in this batch:</div>
          <div id="batchRelList" style="max-height:180px; overflow-y:auto; border:1px solid var(--sd-border); border-radius:var(--radius-sm); padding:0.5rem 0.75rem;"></div>
          <div class="remark-note mt-2">
            <i class="bi bi-info-circle-fill mt-1"></i>
            <div>Review the recipients and total above before continuing. You'll be asked to confirm once more on the next step.</div>
          </div>
        </div>

        <!-- Step 2: Final confirmation — restates the totals, cannot be undone -->
        <div id="batchReleaseStep2" class="d-none">
          <div class="remark-note" style="color:var(--sd-green-700); background:var(--sd-surface); border:1px solid var(--sd-border);">
            <i class="bi bi-exclamation-triangle-fill mt-1"></i>
            <div>This action cannot be undone. Stipends will be recorded as disbursed immediately for all recipients below.</div>
          </div>
          <div class="row info-grid mt-2">
            <div class="col-6">
              <div class="info-item">
                <div class="info-label">Recipients</div>
                <div class="info-value" id="batchRelCountConfirm">–</div>
              </div>
            </div>
            <div class="col-6">
              <div class="info-item">
                <div class="info-label">Total Payout</div>
                <div class="info-value amount-value" id="batchRelTotalConfirm">–</div>
              </div>
            </div>
          </div>

          <!-- Accidental-execution safeguard: primary button stays disabled until checked -->
          <div class="form-check mt-3" style="padding-left:1.75rem;">
            <input class="form-check-input" type="checkbox" id="batchRelAckCheck" onchange="document.getElementById('batchRelConfirmBtn').disabled = !this.checked;">
            <label class="form-check-label small" for="batchRelAckCheck" id="batchRelAckLabel">
              I verify that all recipient records have been reviewed.
            </label>
          </div>
        </div>

      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-scholarship" data-bs-dismiss="modal" id="batchRelCancelBtn">Cancel</button>
        <button type="button" class="btn btn-outline-scholarship d-none" id="batchRelBackBtn" onclick="showBatchReleaseStep(1)">Back</button>
        <button type="button" class="btn btn-academic-red" id="batchRelContinueBtn" onclick="showBatchReleaseStep(2)">Continue</button>
        <button type="button" class="btn btn-academic-red d-none" id="batchRelConfirmBtn" disabled>Confirm &amp; Disburse All</button>
      </div>
    </div>
  </div>
</div>

<!-- ============================================================
     MODAL: CHART GROUP DRILLDOWN (bar / doughnut segment click)
     ============================================================ -->
<div class="modal fade" id="groupModal" tabindex="-1" aria-hidden="true" aria-labelledby="groupModalTitle">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="groupModalTitle"><i class="bi bi-people-fill me-2" style="color:var(--sd-green-700);"></i>Group</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="text-muted-custom mb-3" id="groupModalSubtext"></p>
        <div class="table-app-wrap table-responsive-wrap">
          <table class="table-app">
            <thead>
              <tr>
                <th>Scholar</th>
                <th>Student ID</th>
                <th>Program</th>
                <th>Scholarship</th>
                <th>Year Level</th>
              </tr>
            </thead>
            <tbody id="groupModalTableBody"></tbody>
          </table>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-scholarship" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-scholarship-green" id="groupModalViewAllBtn">View in Scholars Table</button>
      </div>
    </div>
  </div>
</div>


