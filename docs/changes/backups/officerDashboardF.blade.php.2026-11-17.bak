          <div class="tf-pagebtns">
            <button type="button" class="btn btn-outline-scholarship btn-sm" id="dhPrevPage" onclick="changeHistoryPage(-1)">
              <i class="bi bi-chevron-left"></i> Previous
            </button>
            <span id="dhPageNumbers" class="d-flex gap-1 align-items-center"></span>
            <button type="button" class="btn btn-outline-scholarship btn-sm" id="dhNextPage" onclick="changeHistoryPage(1)">
              Next <i class="bi bi-chevron-right"></i>
