  <link rel="stylesheet" href="{{ asset('css/bakr-dashboard.css') }}">
</head>
<body class="dash">

<div id="chartFloatTooltip" role="tooltip" aria-hidden="true"></div>

<!-- ============================================================
     MOBILE TOP BAR
     ============================================================ -->
<div class="mobile-topbar d-lg-none">
