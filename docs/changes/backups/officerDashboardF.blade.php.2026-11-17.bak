        </div>
        <div class="filter-bar filter-bar-search filter-bar-inline">
          <div class="row g-2 align-items-end">
            <div class="col-md-6 col-lg-4">
              <label class="form-label mb-0">Search scholar / Scholar ID / Student ID / Program</label>
              <input type="text" class="form-control" id="scSearch" placeholder="Search scholars...">
            </div>
            <div class="col-6 col-lg-2">
              <label class="form-label mb-0">Scholarship</label>
              <select class="form-select" id="scScholarship"><option value="">All programs</option><optgroup label="DNSC Internal (no stipend)"><option value="__internal">All DNSC Internal</option><option value="DNSC Academic Scholarship">DNSC Academic Scholarship</option><option value="DNSC GIA Category A">DNSC Grant-in-Aid (GIA) – Category A</option><option value="DNSC GIA Category B">DNSC Grant-in-Aid (GIA) – Category B</option><option value="DNSC SA Category C">DNSC Student Assistant (SA) – Category C</option></optgroup><optgroup label="External scholarships (with stipend)"><option value="__external">All external</option><option value="CHED TDP">CHED TDP</option><option value="DOST-SEI">DOST-SEI Scholarship</option><option value="CHED TES">CHED TES</option><option value="Bagong Pilipinas Scholarship Program">Bagong Pilipinas (BPMSP)</option><option value="CHED Merit Scholarship Program">CHED Merit (CMSP)</option><option value="GrabScholar">GrabScholar</option><option value="cebuana">Cebuana Lhuillier (CLFI)</option></optgroup></select>
            </div>
            <div class="col-6 col-lg-2">
              <label class="form-label mb-0">School</label>
              <select class="form-select" id="scSchool"><option value="">All schools</option></select>
            </div>
            <div class="col-6 col-lg-2">
              <label class="form-label mb-0">Academic Term</label>
              <select class="form-select" id="scTerm">
                <option value="">All terms</option>
                <option value="2026–2027|1st Semester">2026–2027 · 1st Sem</option>
                <option value="2025–2026|2nd Semester">2025–2026 · 2nd Sem</option>
                <option value="2025–2026|1st Semester">2025–2026 · 1st Sem</option>
              </select>
            </div>
            <div class="col-6 col-lg-2">
              <label class="form-label mb-0">Verification Status</label>
              <select class="form-select" id="scStatus">
