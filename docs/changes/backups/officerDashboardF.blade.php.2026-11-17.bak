      <i class="bi bi-list fs-4" style="color: var(--sd-ink);"></i>
    </button>
    <div class="d-flex align-items-center gap-2">
      <div class="brand-badge" style="width:32px;height:32px;font-size:0.95rem;background: linear-gradient(135deg, var(--sd-sage), var(--sd-green-700));"><i class="bi bi-person-badge-fill"></i></div>
      <span class="fw-semibold" style="font-family:'Poppins',sans-serif; font-size:0.95rem;">Officer Portal</span>
    </div>
  </div>
  <button type="button" class="mobile-topbar-notif" aria-label="Open notifications" title="Notifications" onclick="showPage('activity-log')">
    <i class="bi bi-bell"></i>
  </button>
</div>

<!-- ============================================================
     OFFCANVAS SIDEBAR (mobile / tablet)
     ============================================================ -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="mobileSidebar">
