         PAGE: PROFILE
         ============================================================ -->
    <section class="page-section" id="page-profile">
      <div class="page-header">
        <div class="eyebrow">Officer / Profile</div>
        <h1>Profile</h1>
        <p class="text-muted-custom mb-0">Your officer account information.</p>
      </div>

      <div class="card-panel sd-account-card">
        <div class="sd-account-row">
          <div class="sd-account-avatar">JD</div>
          <div>
            <div class="sd-account-name">Juan Dela Cruz</div>
            <div class="sd-account-role">Scholarship Officer</div>
          </div>
        </div>
        <dl class="sd-account-fields">
          <div>
            <dt>Full Name</dt>
            <dd>Juan Dela Cruz</dd>
          </div>
          <div>
            <dt>Email Address</dt>
            <dd>juan.delacruz@dnsc.edu.ph</dd>
          </div>
        </dl>
