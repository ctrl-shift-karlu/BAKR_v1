        </div>
        <div class="table-app-wrap table-responsive-wrap">
          <table class="table-app">
            <thead>
              <tr id="scTableHeadRow">
                <th tabindex="0" role="button" class="th-sortable" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}" data-sort-key="scholarId">Scholar ID <i class="bi bi-arrow-down-up sort-icon"></i></th>
                <th tabindex="0" role="button" class="th-sortable" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}" data-sort-key="name">Scholar <i class="bi bi-arrow-down-up sort-icon"></i></th>
                <th tabindex="0" role="button" class="th-sortable" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}" data-sort-key="student_id">Student ID <i class="bi bi-arrow-down-up sort-icon"></i></th>
                <th tabindex="0" role="button" class="th-sortable" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}" data-sort-key="course">Program <i class="bi bi-arrow-down-up sort-icon"></i></th>
                <th tabindex="0" role="button" class="th-sortable" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}" data-sort-key="scholarship">Scholarship <i class="bi bi-arrow-down-up sort-icon"></i></th>
                <th tabindex="0" role="button" class="th-sortable" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}" data-sort-key="verification">Verification <i class="bi bi-arrow-down-up sort-icon"></i></th>
