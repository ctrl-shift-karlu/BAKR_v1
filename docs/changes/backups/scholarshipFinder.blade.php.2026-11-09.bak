<script>
(() => {
    const navbar = document.querySelector('.navbar');
    if (!navbar) return;
    const updateNavbar = () => navbar.classList.toggle('is-scrolled', window.scrollY > 24);
    updateNavbar();
    window.addEventListener('scroll', updateNavbar, { passive: true });
})();
</script>
