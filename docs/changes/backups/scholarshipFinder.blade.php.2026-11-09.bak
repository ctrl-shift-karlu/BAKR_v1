}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 104px; -webkit-tap-highlight-color: transparent; height: 100%; }

/* Sticky-footer layout, shared by every page: header/footer keep their
   natural size, and the main content area (main, or .sf-page on the
   Scholarship Finder) takes whatever space is left, so the footer sits
   pinned to the bottom of the viewport on short pages. Note: body gets
   ONLY min-height here, never a definite height — giving a flex
   container (body) a definite height that's smaller than its content
   lets the flex algorithm shrink children whose overflow isn't
   "visible" (e.g. .page-hero, .nx-hero) down to fit, and since those
   sections clip with overflow:hidden, that shrinking was cropping
   their headings. min-height doesn't create that pressure. */
body {
  margin-top: 100px;
  background: var(--vanilla);
  color: var(--ink);
  font-family: var(--font-body);
  -webkit-font-smoothing: antialiased;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}
.nx-header, body > nav.navbar { flex: 0 0 auto; }
.nx-footer-wrap { flex: 0 0 auto; }
body > main { flex: 1 0 auto; }
h1, h2, h3, h4, h5, .display {
  font-family: var(--font-display);
  letter-spacing: -0.01em;
  color: var(--green-900);
}
.serif { font-family: var(--font-serif); font-optical-sizing: auto; }
a { text-decoration: none; }
::selection { background: var(--gold-tint); color: var(--green-900); }

a:focus-visible, button:focus-visible, .form-control:focus-visible {
  outline: 3px solid var(--gold);
  outline-offset: 2px;
}

.container { max-width: var(--page-max); }

.nx-section { padding: 88px 0; }
.nx-h2 {
  font-family: var(--font-serif);
  font-optical-sizing: auto;
  font-size: clamp(1.85rem, 3.2vw, 2.5rem);
  font-weight: 500;
  letter-spacing: -0.005em;
  line-height: 1.14;
  color: var(--green-900);
  margin: 0 0 14px;
}
.nx-lead { color: var(--ink-soft); font-size: 15.5px; line-height: 1.72; max-width: 60ch; margin: 0; }

/* ---------- Brand mark (small logo square) — used in the footer ---------- */
.nx-mark {
  width: 28px; height: 28px; flex-shrink: 0;
  background: url("images/logo/bakr-logo.png") no-repeat center / contain;
  filter: drop-shadow(0 2px 6px rgba(0, 0, 0, .18));
}


/* ---------- Buttons ---------- */
.nx-btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 12px 22px; border-radius: 12px; border: 1px solid transparent;
  font-family: var(--font-display); font-size: 14px; font-weight: 700;
  text-decoration: none; cursor: pointer;
  transition: background .18s ease, color .18s ease, border-color .18s ease, box-shadow .18s ease, filter .18s ease;
}
.nx-btn-gold {
  color: var(--green-900);
  background: linear-gradient(160deg, var(--gold-light) 0%, var(--gold-fill, #c9a443) 100%);
  border-color: rgba(20, 58, 43, .08);
  box-shadow: 0 14px 26px -16px rgba(20, 58, 43, .5);
}
.nx-btn-gold:hover { box-shadow: 0 18px 30px -16px rgba(20, 58, 43, .6); filter: brightness(1.04); }
.nx-btn-ghost { color: var(--vanilla); border-color: rgba(253, 251, 248, .34); background: rgba(253, 251, 248, .05); }
.nx-btn-ghost:hover { color: var(--vanilla); background: rgba(253, 251, 248, .13); border-color: rgba(253, 251, 248, .55); }
.nx-btn-green { color: var(--vanilla); background: var(--green-700); }
.nx-btn-green:hover { color: var(--vanilla); background: var(--green-900); }
.nx-btn-outline { color: var(--green-900); background: transparent; border-color: var(--border); padding: 10px 16px; font-size: 13.5px; }
.nx-btn-outline:hover { background: var(--green-900); border-color: var(--green-900); color: var(--vanilla); }
/* ============================= NAVBAR ============================= */
.navbar {
  position: fixed;
  top: 24px;
  left: 24px;
  right: 24px;

  z-index: 1030;
  width: auto;
  max-width: none;
  padding: 14px clamp(1rem, 4vw, 3rem);
  border-radius: 0 20px 0 20px;
  background:
    radial-gradient(600px 220px at 100% 0%, rgba(184, 145, 47, 0.14), transparent 40%),
    linear-gradient(100deg, rgba(31, 70, 50, 0.94) 0%, rgba(20, 58, 43, 0.95) 70%);
  backdrop-filter: blur(16px) saturate(140%);
  -webkit-backdrop-filter: blur(16px) saturate(140%);
  box-shadow: 1px 2px 10px var(--gold-light);
  /* border: 1.5px solid white; */
}
.navbar .container { display: flex; align-items: center; padding: 0; }
.navbar-brand {
  display: flex;
  flex-direction: column;
  line-height: 1.1;
  font-family: 'Poppins', sans-serif;
  font-weight: 700;
  font-size: 17px;
  letter-spacing: 0.09em;
  color: #fdfbf8 !important;
  position: relative;
  padding-left: 36px;
}
.navbar-brand::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 28px;
  height: 28px;
  background: url("images/logo/bakr-logo.png") no-repeat center / contain;
  filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.25));
}
.navbar-brand .brand-subtitle {
  display: block;
  font-family: 'Poppins', sans-serif;
  font-weight: 500;
  font-size: 11px;
  letter-spacing: 0.02em;
  color: rgba(253, 251, 248, 0.6);
  margin-top: 2px;
}
.navbar-toggler {
  border-color: rgba(253, 251, 248, 0.3);
  padding: 6px 10px;
}
.navbar-toggler-icon {
  background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba(253,251,248,0.85)' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
}
.navbar-nav { gap: 4px; }
/* nav-link base/hover/active styles live in the "BAKR NAVBAR FINAL OVERRIDE" block below */
.navbar-nav .nav-item.find-button .nav-link {
  background: linear-gradient(160deg, #e6cf9c, #b8912f);
  color: #143a2b !important;
  font-weight: 700;
  box-shadow: none;
  /* border-radius: 0px 16px 0 16px; */
}
.navbar-nav .nav-item.find-button .nav-link:hover {
  background: linear-gradient(160deg, #efe0bc, #c9a44a);
  transform: none;
}
.navbar-nav .dropdown-toggle::after { margin-left: 6px; vertical-align: 2px; }
.dropdown-menu {
  border: 1px solid #eeece8;
  border-radius: 14px;
  padding: 8px;
  margin-top: 10px !important;
  box-shadow: 0 20px 40px -22px rgba(43, 41, 37, 0.45);
}
.dropdown-item {
  border-radius: 9px;
  padding: 9px 12px;
  font-weight: 500;
  font-size: 14px;
  color: #2b2925;
  transition: background 0.15s ease, color 0.15s ease;
}
.dropdown-item:hover, .dropdown-item:focus {
  background: #e7efe9;
  color: #143a2b;
}
@media (max-width: 991.98px) {
  .navbar { padding: 12px clamp(0.85rem, 4vw, 2rem); }
  .navbar .navbar-collapse { padding: 14px 0 6px; }
  .navbar-nav .nav-item.find-button { margin: 6px 0; }
  .navbar-nav .nav-item.find-button .nav-link { text-align: center; }
}
@media (max-width: 575.98px) {
  .navbar-brand .brand-subtitle { display: none; }
}
/* ==========================================================================
   HERO  (photo layer + deep pine wash, so any school photo stays readable)
   ========================================================================== */
.nx-hero-wrap { padding: 0; }
.nx-hero {
  position: relative; overflow: hidden;
  max-width: none; 
  /* margin: 10px 0 0;  */
  min-height: clamp(540px, 74vh, 700px);
  display: flex; align-items: center;
  padding: 64px clamp(24px, 5vw, 68px);
  border-radius: 0;
  color: var(--vanilla);
  background:
    radial-gradient(680px 340px at 92% -10%, rgba(184, 145, 47, .18), transparent 60%),
    linear-gradient(100deg, rgba(20, 58, 43, .96) 0%, rgba(20, 58, 43, .88) 46%, rgba(31, 70, 50, .55) 100%),
    var(--hero-image) var(--hero-focus) / cover no-repeat,
    linear-gradient(120deg, var(--green-900) 0%, var(--green-700) 58%, var(--green-600) 100%);
  box-shadow: 0 8px 20px rgba(43, 41, 37, .18);
}
.nx-hero::before, .nx-hero::after { content: ""; position: absolute; border-radius: 50%; pointer-events: none; }
.nx-hero::before { top: -110px; right: 150px; width: 340px; height: 340px; border: 1px solid rgba(253, 251, 248, .09); }
.nx-hero::after { bottom: -170px; right: -60px; width: 380px; height: 380px; border: 1px solid rgba(253, 251, 248, .06); }

.nx-hero-grid {
  position: relative; z-index: 1; width: 100%;
  max-width: var(--page-max); margin: 96px auto 8px auto;
  display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
  gap: 56px; align-items: center;
}
.nx-hero h1 {
  color: var(--vanilla);
  font-family: var(--font-serif); font-optical-sizing: auto;
  font-weight: 550; letter-spacing: -.015em;
  font-size: clamp(2.4rem, 4.9vw, 3.85rem); line-height: 1.08;
  margin: 0 0 20px; max-width: 14ch;
}
.nx-hero p { font-size: 16.5px; line-height: 1.68; color: rgba(253, 251, 248, .82); max-width: 54ch; margin: 0 0 30px; }
.nx-hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }


@media (max-width: 991.98px) {
  .nx-hero { min-height: 0; padding-top: 52px; padding-bottom: 52px; }
  .nx-hero-grid { grid-template-columns: 1fr; }
  .nx-profile { display: none; }
  .nx-hero::before { right: -60px; }
}
@media (max-width: 575.98px) {
  .nx-hero .nx-btn { width: 100%; justify-content: center; }
}

/* ==========================================================================
   HOW IT WORKS
   ========================================================================== */
.nx-steps { padding-top: 64px; padding-bottom: 8px; }
.nx-step {
  position: relative; height: 100%;
  background: var(--surface); border: 1px solid var(--border);
  border-radius: 14px; padding: 26px 24px 24px;
  transition: box-shadow .22s ease, transform .22s ease;
}
.nx-step:hover { transform: translateY(-3px); box-shadow: 0 22px 42px -26px rgba(20, 58, 43, .28); }
.nx-icon-tile {
  width: 46px; height: 46px; display: grid; place-items: center;
  border-radius: 0 16px 0 16px; background: var(--green-900); color: var(--gold-light); font-size: 1.2rem;
  margin-bottom: 18px;
}
.nx-step-n { position: absolute; top: 18px; right: 22px; font-family: var(--font-display); font-weight: 800; font-size: 34px; line-height: 1; color: var(--vanilla-deep); }
.nx-step h3 { font-size: 16px; font-weight: 700; color: var(--green-900); margin: 0 0 8px; }
.nx-step p { font-size: 14px; line-height: 1.6; color: var(--ink-soft); margin: 0; }

/* ==========================================================================
   SCHOLARSHIP PREVIEW
   ========================================================================== */
.nx-sch-card {
  height: 100%; display: flex; flex-direction: column;
  background: var(--surface); border: 1px solid var(--border);
  border-radius: 14px; padding: 26px 24px 24px;
  transition: box-shadow .22s ease, transform .22s ease;
}
.nx-sch-card:hover { transform: translateY(-3px); box-shadow: 0 22px 42px -26px rgba(20, 58, 43, .28); }
.nx-sch-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 18px; }
.nx-logo {
  width: 56px; height: 56px; flex-shrink: 0; border-radius: 50%;
  background: var(--vanilla-deep); border: 1px solid var(--border);
  display: grid; place-items: center; overflow: hidden;
}
.nx-logo img { width: 100%; height: 100%; object-fit: cover; }
.nx-pill {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 11.5px; font-weight: 600; color: #8a6d1f;
  background: var(--gold-tint); border: 1px solid #e6d7ae;
  padding: 4px 11px 4px 9px; border-radius: 20px; white-space: nowrap;
}
.nx-pill i { color: var(--gold); }
.nx-sch-card h3 { font-size: 17px; font-weight: 700; color: var(--green-900); line-height: 1.3; margin: 0 0 8px; }
.nx-sch-card p { font-size: 14px; line-height: 1.6; color: var(--ink-soft); margin: 0 0 20px; }
.nx-sch-card .nx-btn { margin-top: auto; align-self: flex-start; }

/* ==========================================================================
   ABOUT  (deep pine panel, leaf corners, one quiet ring: the sidebar look)
   ========================================================================== */
.nx-about { padding: 24px 0 72px; }
.nx-about-panel {
  position: relative; overflow: hidden;
  padding: clamp(28px, 4vw, 52px);
  border-radius: 0 24px 0 24px; color: var(--vanilla);
  background:
    radial-gradient(560px 320px at 100% 0%, rgba(184, 145, 47, .12), transparent 60%),
    linear-gradient(190deg, var(--green-700) 0%, var(--green-900) 62%);
}
.nx-about-panel::before {
  content: ""; position: absolute; top: -70px; right: -80px; width: 260px; height: 260px;
  border-radius: 50%; border: 1px solid rgba(253, 251, 248, .08); pointer-events: none;
}
.nx-about-grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(28px, 5vw, 64px); align-items: center; }
.nx-about-img { position: relative; }
.nx-about-img::before {
  content: ""; position: absolute; inset: 14px -14px -14px 14px;
  border: 1px solid rgba(184, 145, 47, .5); border-radius: 0 20px 0 20px;
}
.nx-about-img img {
  position: relative; display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover;
  border-radius: 0 20px 0 20px; background: var(--green-900);
}
.nx-about .nx-h2 { color: var(--vanilla); }
.nx-about-text { color: rgba(253, 251, 248, .8); font-size: 15px; line-height: 1.7; margin: 0 0 12px; max-width: 58ch; }
.nx-points { display: grid; gap: 10px; margin-top: 24px; }
.nx-point {
  display: flex; gap: 14px; align-items: flex-start; padding: 14px 16px;
  border-radius: 14px; background: rgba(253, 251, 248, .06); border: 1px solid rgba(253, 251, 248, .1);
}
.nx-point i { color: var(--gold-light); font-size: 1.15rem; line-height: 1.3; }
.nx-point strong { display: block; font-family: var(--font-display); font-size: 14.5px; color: var(--vanilla); margin-bottom: 2px; }
.nx-point span { font-size: 13.5px; line-height: 1.55; color: rgba(253, 251, 248, .7); }

@media (max-width: 991.98px) {
  .nx-about-grid { grid-template-columns: 1fr; }
  .nx-about-panel { border-radius: 0 18px 0 18px; }
  .nx-about-img { margin: 0 14px 14px 0; }
}

/* ==========================================================================
   CREATORS
   ========================================================================== */
.nx-creator {
  height: 100%; text-align: center;
  background: var(--surface); border: 1px solid var(--border);
  border-radius: 14px; padding: 30px 24px 24px;
  transition: box-shadow .22s ease;
}
.nx-creator:hover { box-shadow: 0 22px 42px -26px rgba(20, 58, 43, .24); }
.nx-creator img {
  width: 104px; height: 104px; object-fit: cover; border-radius: 50%;
  border: 3px solid var(--surface); box-shadow: 0 0 0 2px var(--gold);
  background: var(--vanilla-deep); margin-bottom: 18px;
}
.nx-creator h3 { font-size: 17px; font-weight: 700; color: var(--green-900); margin: 0 0 8px; }
.nx-role {
  display: inline-block; font-size: 12px; font-weight: 600; color: var(--green-700);
  background: var(--sage-tint); padding: 4px 12px; border-radius: 20px; margin-bottom: 14px;
}
.nx-creator p { font-size: 14px; line-height: 1.6; color: var(--ink-soft); margin: 0 0 18px; }
.nx-socials { display: flex; justify-content: center; gap: 8px; }
.nx-social {
  width: 38px; height: 38px; display: grid; place-items: center;
  border-radius: 0 12px 0 12px; background: var(--vanilla-deep); color: var(--green-900);
  text-decoration: none; transition: background .18s ease, color .18s ease;
}
.nx-social:hover { background: var(--green-900); color: var(--gold-light); }

/* ==========================================================================
   CONTACT
   ========================================================================== */
.nx-contact { background: var(--vanilla-deep); border-top: 1px solid var(--border); }
.nx-contact-list { display: grid; gap: 14px; margin: 28px 0 24px; }
.nx-contact-item { display: flex; align-items: center; gap: 14px; font-size: 14.5px; color: var(--ink); }
.nx-contact-item .nx-icon-tile { width: 42px; height: 42px; margin: 0; font-size: 1.05rem; background: var(--sage-tint); color: var(--green-700); border-radius: 0 10px 0 10px; }
.nx-form-card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: 16px 16px 16px 4px; padding: clamp(24px, 3.5vw, 36px);
  box-shadow: 0 30px 60px -36px rgba(43, 41, 37, .4);
}
.nx-form-card h3 { font-size: 20px; font-weight: 700; color: var(--green-900); margin: 0 0 20px; }
.nx-form-card label { display: block; font-size: 13px; font-weight: 600; color: var(--green-900); margin-bottom: 6px; }
.nx-form-card .form-control {
  background: var(--vanilla); border: 1px solid var(--border); border-radius: 12px;
  padding: 11px 14px; font-size: 14.5px; color: var(--ink);
}
.nx-form-card .form-control::placeholder { color: #635e57; }
.nx-form-card .form-control:focus { border-color: var(--green-600); box-shadow: 0 0 0 3px rgba(41, 88, 60, .18); background: var(--surface); }

/* ==========================================================================
   FOOTER  — kept identical to the footer on index.html
   (full-bleed, gold border, 3-column main row, contact mini-block)
   ========================================================================== */
/* --page-max is re-declared here ONLY for the footer so its side padding lines up
   with Bootstrap's .container exactly like on index.html, without touching the
   page-wide --page-max (1240px) that the rest of this page relies on. */
.nx-footer-wrap { --page-max: 100%; padding: 22px 0 0; }
@media (min-width: 576px)  { .nx-footer-wrap { --page-max: 540px; } }
@media (min-width: 768px)  { .nx-footer-wrap { --page-max: 720px; } }
@media (min-width: 992px)  { .nx-footer-wrap { --page-max: 960px; } }
@media (min-width: 1200px) { .nx-footer-wrap { --page-max: 1140px; } }
@media (min-width: 1400px) { .nx-footer-wrap { --page-max: 1320px; } }
.nx-footer {
  position: relative; overflow: hidden;
  /* full-bleed: touches the left, right and bottom edges of the screen.
     Side padding keeps the content aligned with the page container. */
  max-width: none; margin: 0;
  padding: clamp(24px, 4vw, 44px) max(clamp(20px, 4vw, 44px), calc((100% - var(--page-max)) / 2 + 12px));
  border-radius: 0; color: var(--vanilla);
  background:
    radial-gradient(560px 320px at 100% 0%, rgba(184, 145, 47, .1), transparent 60%),
    linear-gradient(190deg, var(--green-700) 0%, var(--green-900) 62%);
  border: 1px solid rgba(184,145,47,.78);
  box-shadow: 0 18px 42px rgba(20,58,43,.15), 0 0 0 4px rgba(184,145,47,.07);
}
.nx-footer::before {
  content: ""; position: absolute; top: -80px; right: -90px; width: 240px; height: 240px;
  border-radius: 50%; border: 1px solid rgba(253, 251, 248, .07); pointer-events: none;
}
.nx-footer > * { position: relative; z-index: 1; }
.nx-footer-band {
  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px;
  padding: 22px 26px; border-radius: 12px;
  background: rgba(253, 251, 248, .06); border: 1px solid rgba(253, 251, 248, .11);
  border-bottom: 1px solid rgba(184,145,47,.45);
}
.nx-footer-band h4 { color: var(--vanilla); font-size: 19px; font-weight: 600; margin: 0 0 4px; }
.nx-footer-band p { margin: 0; font-size: 14px; color: rgba(253, 251, 248, .68); max-width: 56ch; }
.nx-footer-contact-cta { white-space: nowrap; padding: 10px 17px; font-size: 13px; line-height: 1.5; box-shadow: none; }
.nx-footer-main {
  display: grid; gap: 32px; align-items: start; padding: 36px 0 26px;
  grid-template-columns: minmax(0, 1.25fr) minmax(130px, .6fr) minmax(205px, .8fr);
}
.nx-footer-brand { display: flex; align-items: center; gap: 11px; font-family: var(--font-display); font-size: 20px; font-weight: 700; letter-spacing: .09em; margin-bottom: 12px; }
.nx-footer-copy { font-size: 14px; line-height: 1.65; color: rgba(253, 251, 248, .65); max-width: 56ch; }
.nx-footer-links { display: flex; flex-wrap: wrap; gap: 6px 22px; justify-content: flex-end; }
.nx-footer-links a { color: rgba(253, 251, 248, .75); text-decoration: none; font-size: 14px; font-weight: 500; }
.nx-footer-links a:hover { color: var(--gold-light); }
.nx-footer-contact-mini {
  display: flex; flex-direction: column; gap: 9px; min-width: 205px;
  padding: 2px 0 0 18px; border-left: 1px solid rgba(184,145,47,.45);
}
.nx-footer-contact-mini h5 { margin: 0 0 2px; color: var(--gold-light); font: 600 14px/1.3 'Poppins', sans-serif; }
.nx-footer-contact-mini a,
.nx-footer-contact-mini span {
  display: flex; align-items: flex-start; gap: 8px;
  color: rgba(253,251,248,.78); font-size: 12px; line-height: 1.55; text-decoration: none;
}
.nx-footer-contact-mini i { color: var(--gold-light); margin-top: 2px; }
.nx-footer-contact-mini a:hover { color: var(--gold-light); }
.nx-footer-bottom {
  display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 20px;
  padding-top: 18px; border-top: 1px solid rgba(253, 251, 248, .11);
  font-size: 12.5px; color: rgba(253, 251, 248, .74);
}
@media (max-width: 767.98px) {
  .nx-footer { border-radius: 0; }
  .nx-footer-main { gap: 22px; grid-template-columns: 1fr; }
  .nx-footer-links { justify-content: flex-start; }
  .nx-footer-contact-mini { min-width: 0; padding: 15px 0 0; border-left: 0; border-top: 1px solid rgba(184,145,47,.4); }
  .nx-footer-contact-cta { margin-top: 8px; }
}
@media (max-width: 575.98px) { .nx-section { padding: 64px 0; } }

/* ==========================================================================
   MODALS  (dashboard hero header + surface sections)
   ========================================================================== */
.nx-modal .modal-content { border: 0; border-radius: 16px 16px 16px 4px; overflow: hidden; background: var(--vanilla); }
.nx-modal .modal-header {
  align-items: flex-start; gap: 16px; border: 0; padding: 26px 28px;
  color: var(--vanilla);
  background:
    radial-gradient(420px 220px at 100% -20%, rgba(184, 145, 47, .22), transparent 60%),
    linear-gradient(120deg, var(--green-900) 0%, var(--green-700) 58%, var(--green-600) 100%);
}
.modal-brand-line { display: flex; align-items: flex-start; gap: 16px; }
.modal-logo { width: 56px; height: 56px; flex-shrink: 0; border-radius: 50%; object-fit: cover; background: var(--surface); border: 2px solid rgba(253, 251, 248, .5); }
.modal-category {
  display: inline-block; font-size: 11.5px; font-weight: 700; color: var(--gold-light);
  background: rgba(184, 145, 47, .22); border: 1px solid var(--gold);
  padding: 3px 11px; border-radius: 20px; margin-bottom: 8px;
}
.nx-modal .modal-header h3 { color: var(--vanilla); font-size: 21px; font-weight: 600; margin: 0 0 6px; line-height: 1.25; }
.nx-modal .modal-header p { margin: 0; font-size: 14px; line-height: 1.55; color: rgba(253, 251, 248, .72); }
.nx-modal .modal-body { padding: 24px 28px 8px; }
.modal-section { height: 100%; background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 18px 20px; }
.modal-section.qualify { background: var(--sage-tint); border-color: #dfe9e2; }
.modal-section.requirements { background: var(--gold-tint); border-color: #e6d7ae; }
.modal-section-title { display: flex; align-items: center; gap: 8px; font-family: var(--font-display); font-size: 14.5px; font-weight: 700; color: var(--green-900); margin-bottom: 10px; }
.modal-section-title i { color: var(--gold); }
.modal-section p { margin: 0; font-size: 14px; line-height: 1.6; color: var(--ink-soft); }
.modal-section ul { margin: 0; padding-left: 18px; font-size: 14px; line-height: 1.55; color: var(--ink); }
.modal-section li + li { margin-top: 5px; }
.nx-modal .modal-footer { border: 0; padding: 12px 28px 26px; }
.btn-modal-close {
  border: 0; cursor: pointer; padding: 10px 22px; border-radius: 12px;
  background: var(--green-700); color: var(--vanilla); font-family: var(--font-display); font-weight: 700; font-size: 14px;
  transition: background .18s ease;
}
.btn-modal-close:hover { background: var(--green-900); }

.nx-success .modal-content { border: 0; border-radius: 16px 16px 16px 4px; background: var(--vanilla); text-align: center; padding: 40px 32px 32px; }
.nx-success .nx-avatar { width: 64px; height: 64px; margin: 0 auto 18px; font-size: 1.8rem; }
.nx-success h4 { font-size: 22px; font-weight: 600; color: var(--green-900); margin: 0 0 8px; }
.nx-success p { color: var(--ink-soft); font-size: 14.5px; margin: 0 0 24px; }
/* ============================== HERO =============================== */
.page-hero {
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
  margin: 20px 20px 0;
  padding: 64px 0 76px;
  min-height: clamp(540px, 74vh, 700px);
  display: flex;
  align-items: center;
  border-radius: 0 24px 0 24px;
  background:
    radial-gradient(620px 340px at 100% 0%, rgba(184, 145, 47, 0.2), transparent 60%),
    linear-gradient(190deg, var(--green-700) 0%, var(--green-900) 68%);
  color: var(--vanilla);
}
.page-hero::before,
.page-hero::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.page-hero::before {
  top: -90px; right: -90px; width: 300px; height: 300px;
  border: 1px solid rgba(251, 247, 238, 0.1);
}
.page-hero::after {
  top: 40px; right: -150px; width: 300px; height: 300px;
  border: 1px solid rgba(251, 247, 238, 0.07);
}
.page-hero .container { position: relative; z-index: 1; max-width: 760px; }
.eyebrow-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 7px 16px;
  border-radius: 999px;
  background: rgba(251, 247, 238, 0.1);
  border: 1px solid rgba(251, 247, 238, 0.18);
  font-size: 13px;
  font-weight: 600;
  color: var(--gold-light);
  margin-bottom: 20px;
}
.page-hero h1 {
  font-family: 'Source Serif 4', serif;
  font-optical-sizing: auto;
  font-weight: 600;
  font-size: clamp(34px, 4.4vw, 50px);
  line-height: 1.12;
  color: var(--vanilla);
  margin-bottom: 18px;
}
.page-hero h1 span {
  position: relative;
  background: linear-gradient(120deg, var(--gold-light), var(--gold) 70%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.page-hero p {
  font-size: 16.5px;
  line-height: 1.65;
  color: rgba(251, 247, 238, 0.82);
  max-width: 620px;
  margin-bottom: 22px;
}
.hero-note {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  font-size: 13.5px;
  color: rgba(251, 247, 238, 0.7);
  padding-top: 8px;
  border-top: 1px solid rgba(251, 247, 238, 0.14);
}
.hero-note i { color: var(--gold-light); }

/* ============================ LAYOUT =============================== */
.directory-wrap { padding: 44px 0 90px; }
.library-layout { align-items: flex-start; }
.library-sidebar { position: sticky; top: 20px; }

/* ============================ SIDEBAR =============================== */
.shelf-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 22px 18px;
  box-shadow: 0 18px 40px -26px rgba(31, 77, 58, 0.25);
}
.shelf-heading { display: flex; gap: 12px; align-items: center; margin-bottom: 18px; }
.shelf-icon {
  width: 42px; height: 42px; flex-shrink: 0;
  border-radius: 0 12px 0 12px;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(150deg, var(--gold-light), var(--gold));
  color: var(--green-900);
  font-size: 18px;
  box-shadow: 0 4px 12px rgba(184, 145, 47, 0.35);
}
.shelf-heading h5 { font-size: 15.5px; font-weight: 700; margin: 0; color: var(--green-900); }
.shelf-heading p { font-size: 12.5px; color: var(--ink-soft); margin: 2px 0 0; }

.sector-tabs { gap: 8px; }
.sector-tabs .nav-link {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  text-align: left;
  padding: 12px 14px;
  border-radius: 14px;
  border: 1px solid transparent;
  background: transparent;
  color: var(--ink);
  transition: background 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
}
.sector-tabs .nav-link i {
  width: 34px; height: 34px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  border-radius: 10px;
  background: var(--sage-tint);
  color: var(--green-700);
  font-size: 15px;
}
.sector-tabs .nav-link strong { display: block; font-size: 13.5px; font-weight: 700; color: var(--green-900); }
.sector-tabs .nav-link small { display: block; font-size: 11.5px; color: var(--ink-soft); font-weight: 500; }
.sector-tabs .nav-link:hover {
  background: linear-gradient(120deg, var(--sage-tint), var(--gold-tint));
  border-color: var(--border);
  transform: translateX(2px);
}
.sector-tabs .nav-link.active {
  background: linear-gradient(160deg, var(--green-700), var(--green-900));
  border-color: var(--green-900);
  box-shadow: 0 10px 24px -12px rgba(31, 77, 58, 0.55);
}
.sector-tabs .nav-link.active i { background: rgba(251, 247, 238, 0.14); color: var(--gold-light); }
.sector-tabs .nav-link.active strong,
.sector-tabs .nav-link.active small { color: var(--vanilla); }
.sector-tabs .nav-link.active small { color: rgba(251, 247, 238, 0.65); }

.sticker-note {
  margin-top: 18px;
  padding: 14px 14px 15px;
  border-radius: 14px;
  background: var(--gold-tint);
  border: 1px dashed var(--gold);
}
.sticker-note strong { display: block; font-size: 12.5px; color: var(--green-900); margin-bottom: 4px; }
.sticker-note small { font-size: 12px; color: var(--ink-soft); line-height: 1.5; }

/* ========================= DIRECTORY HEAD ============================ */
.directory-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 16px;
  margin-bottom: 26px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--border);
  flex-wrap: wrap;
}
.directory-head .label {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.06em;
  color: var(--gold);
  margin-bottom: 6px;
}
.directory-head h2 { font-size: 26px; font-weight: 700; margin: 0 0 6px; }
.directory-head p { font-size: 14.5px; color: var(--ink-soft); margin: 0; max-width: 480px; }
.count-bubble {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  border-radius: 999px;
  background: var(--surface);
  border: 1px solid var(--gold);
  color: var(--green-900);
  font-weight: 700;
  font-size: 13px;
  white-space: nowrap;
}
.count-bubble i { color: var(--gold); }

/* ============================== CARDS ================================ */
.scholar-card {
  position: relative;
  height: 100%;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 20px 20px 20px 4px;
  padding: 20px 20px 22px;
  display: flex;
  gap: 16px;
  overflow: hidden;
  transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
}
.scholar-card::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  padding: 1px;
  background: linear-gradient(135deg, rgba(184, 145, 47, 0), rgba(184, 145, 47, 0));
  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  transition: background 0.3s ease;
  pointer-events: none;
}
.scholar-card:hover {
  transform: translateY(-4px);
  border-color: transparent;
  box-shadow: 0 22px 44px -22px rgba(31, 77, 58, 0.4);
}
.scholar-card:hover::before {
  background: linear-gradient(135deg, var(--gold), var(--green-600));
}
.card-ribbon {
  position: absolute;
  top: 14px;
  left: -30px;
  transform: rotate(-45deg);
  width: 120px;
  text-align: center;
  padding: 3px 0;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.06em;
  color: var(--vanilla);
  background: linear-gradient(120deg, var(--green-600), var(--green-900));
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.18);
}
.scholar-card:has(.sector-tag.private) .card-ribbon {
  background: linear-gradient(120deg, var(--gold), var(--amber-warn));
}
.scholar-card:has(.sector-tag.government) .card-ribbon {
  background: linear-gradient(120deg, var(--teal-600), var(--teal-800));
}
.card-paper {
  flex-shrink: 0;
  width: 72px;
  height: 72px;
  border-radius: 50%;
  padding: 3px;
  background: linear-gradient(150deg, var(--gold-light), var(--gold));
  display: flex; align-items: center; justify-content: center;
}
.logo-orbit {
  width: 100%; height: 100%;
  border-radius: 50%;
  background: var(--surface);
  border: 2px solid var(--surface);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}
.logo-orbit img { width: 78%; height: 78%; object-fit: contain; }
.card-body-custom { flex: 1; min-width: 0; padding-top: 2px; }
.sector-tag {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.04em;
  margin-bottom: 8px;
}
.sector-tag.internal { background: var(--sage-tint); color: var(--green-700); }
.sector-tag.government { background: var(--teal-tint); color: var(--teal-800); }
.sector-tag.private { background: var(--gold-tint); color: var(--amber-warn); }
.scholar-card h4 { font-size: 16.5px; font-weight: 700; line-height: 1.3; margin: 0 0 6px; }
.scholar-card > .card-body-custom > p {
  font-size: 13.5px;
  color: var(--ink-soft);
  line-height: 1.55;
  margin: 0 0 14px;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.btn-details {
  display: inline-flex;
  align-items: center;
  padding: 9px 18px;
  border-radius: 999px;
  border: none;
  font-size: 13px;
  font-weight: 700;
  color: var(--green-900);
  background: linear-gradient(120deg, var(--gold-light), var(--gold));
  background-size: 160% 160%;
  background-position: 0% 50%;
  box-shadow: 0 6px 16px -6px rgba(184, 145, 47, 0.55);
  transition: background-position 0.35s ease, box-shadow 0.25s ease, transform 0.2s ease;
}
.btn-details:hover {
  background-position: 100% 50%;
  box-shadow: 0 8px 20px -6px rgba(184, 145, 47, 0.7);
  transform: translateY(-1px);
  color: var(--green-900);
}

/* ============================== MODALS ================================ */
.modal-content.scholarship-modal {
  border: none;
  border-radius: 16px;
  overflow: hidden;
  background: var(--surface);
  box-shadow: 0 40px 80px -30px rgba(20, 40, 29, 0.5);
}
.scholarship-modal .modal-header {
  position: relative;
  flex-direction: column;
  align-items: flex-start;
  gap: 12px;
  padding: 26px 28px 24px;
  border: none;
  color: var(--vanilla);
  background:
    radial-gradient(420px 220px at 100% 0%, rgba(251, 247, 238, 0.14), transparent 60%),
    linear-gradient(190deg, var(--green-700) 0%, var(--green-900) 80%);
}
.scholarship-modal.sector-government .modal-header {
  background:
    radial-gradient(420px 220px at 100% 0%, rgba(251, 247, 238, 0.14), transparent 60%),
    linear-gradient(190deg, var(--teal-600) 0%, var(--teal-800) 80%);
}
.scholarship-modal.sector-private .modal-header {
  background:
    radial-gradient(420px 220px at 100% 0%, rgba(255, 255, 255, 0.16), transparent 60%),
    linear-gradient(190deg, var(--amber-warn) 0%, #7a4018 80%);
}
.modal-sticker {
  align-self: flex-end;
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.06em;
  color: rgba(251, 247, 238, 0.55);
  text-transform: uppercase;
}
.modal-brand-line { display: flex; align-items: center; gap: 16px; width: 100%; padding-right: 34px; }
.modal-logo {
  width: 56px; height: 56px;
  border-radius: 50%;
  background: var(--vanilla);
  padding: 4px;
  object-fit: contain;
  border: 2px solid rgba(251, 247, 238, 0.4);
  flex-shrink: 0;
}
.modal-category {
  display: inline-block;
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.05em;
  padding: 3px 10px;
  border-radius: 999px;
  background: rgba(251, 247, 238, 0.14);
  color: var(--gold-light);
  margin-bottom: 6px;
}
.modal-brand-line h3 { color: var(--vanilla); font-size: 20px; font-weight: 700; margin: 0 0 4px; }
.modal-brand-line p { color: rgba(251, 247, 238, 0.78); font-size: 13.5px; margin: 0; line-height: 1.5; }
.scholarship-modal .btn-close {
  position: absolute; top: 20px; right: 22px;
  opacity: 0.8; transition: opacity 0.2s ease, transform 0.2s ease;
}
.scholarship-modal .btn-close:hover { opacity: 1; transform: rotate(90deg); }

.scholarship-modal .modal-body { padding: 24px 28px 8px; background: var(--vanilla); }
.modal-section {
  height: 100%;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 16px 18px 18px;
}
.modal-section-title {
  display: flex;
  align-items: center;
  gap: 9px;
  font-family: 'Poppins', sans-serif;
  font-weight: 700;
  font-size: 14px;
  color: var(--green-900);
  margin-bottom: 10px;
}
.modal-section-title i {
  width: 28px; height: 28px;
  display: flex; align-items: center; justify-content: center;
  border-radius: 8px;
  background: var(--sage-tint);
  color: var(--green-700);
  font-size: 13px;
}
.modal-section.overview p { font-size: 13.5px; color: var(--ink-soft); line-height: 1.65; margin: 0; }
.feature-pills { display: flex; flex-wrap: wrap; gap: 7px; }
.feature-pill {
  font-size: 12px;
  font-weight: 600;
  padding: 6px 12px;
  border-radius: 999px;
  background: var(--gold-tint);
  color: var(--amber-warn);
  border: 1px solid rgba(184, 145, 47, 0.25);
  transition: background 0.2s ease, transform 0.2s ease;
}
.feature-pill:hover { background: var(--gold-light); transform: translateY(-1px); }
.benefit-tile {
  height: 100%;
  padding: 12px 14px;
  border-radius: 12px;
  background: linear-gradient(160deg, var(--sage-tint), var(--surface));
  border: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  gap: 2px;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.benefit-tile:hover { transform: translateY(-2px); box-shadow: 0 10px 20px -12px rgba(31, 77, 58, 0.35); }
.benefit-tile strong { font-size: 14px; color: var(--green-900); }
.benefit-tile span { font-size: 12px; color: var(--ink-soft); line-height: 1.4; }
.modal-section.requirements ul { margin: 0; padding: 0; list-style: none; }
.modal-section.requirements li {
  position: relative;
  padding: 7px 0 7px 26px;
  font-size: 13px;
  color: var(--ink);
  border-bottom: 1px dashed var(--border);
  line-height: 1.5;
}
.modal-section.requirements li:last-child { border-bottom: none; }
.modal-section.requirements li::before {
  content: "\f26b";
  font-family: "bootstrap-icons";
  position: absolute;
  left: 0; top: 7px;
  color: var(--green-600);
  font-size: 13px;
}
.application-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-top: 18px;
  padding: 16px 20px;
  border-radius: 16px;
  background: linear-gradient(120deg, var(--green-700), var(--green-900));
  color: var(--vanilla);
  flex-wrap: wrap;
}
.application-strip small { display: block; font-size: 11px; letter-spacing: 0.04em; color: rgba(251, 247, 238, 0.6); margin-bottom: 4px; }
.application-strip strong { font-size: 13px; font-weight: 500; line-height: 1.55; color: rgba(251, 247, 238, 0.92); }
.application-strip .btn-light {
  background: linear-gradient(120deg, var(--gold-light), var(--gold));
  border: none;
  color: var(--green-900);
  border-radius: 999px;
  padding: 8px 16px;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  flex-shrink: 0;
}
.application-strip .btn-light:hover { transform: translateY(-1px); box-shadow: 0 8px 18px -6px rgba(0, 0, 0, 0.35); }
.status-note {
  margin-top: 14px;
  font-size: 12.5px;
  color: var(--ink-soft);
  padding-bottom: 6px;
}
.status-note i { color: var(--gold); }
.scholarship-modal .modal-footer {
  border-top: 1px solid var(--border);
  background: var(--vanilla);
  padding: 16px 28px;
}
.scholarship-modal .modal-footer .btn-outline-secondary {
  border-radius: 999px;
  border-color: var(--border);
  color: var(--ink-soft);
  font-weight: 600;
  padding: 8px 20px;
  transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
}
.scholarship-modal .modal-footer .btn-outline-secondary:hover {
  background: var(--green-900);
  border-color: var(--green-900);
  color: var(--vanilla);
}

/* ============================== FOOTER ================================ */
.site-footer {
  margin: 60px 20px 20px;
  border-radius: 24px 24px 0 0;
  overflow: hidden;
  flex-shrink: 0;
  position: relative;
  background:
    radial-gradient(560px 260px at 0% 0%, rgba(184, 145, 47, 0.14), transparent 60%),
    linear-gradient(190deg, var(--green-700) 0%, var(--green-900) 70%);
  color: var(--vanilla);
}
.footer-contact-band {
  padding: 30px 0;
  border-bottom: 1px solid rgba(251, 247, 238, 0.12);
}
.footer-contact-band h4 { color: var(--vanilla); font-size: 20px; margin: 0 0 4px; }
.footer-contact-band p { color: rgba(251, 247, 238, 0.7); font-size: 13.5px; margin: 0; }
.footer-contact-button {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 12px 22px;
  border-radius: 999px;
  background: linear-gradient(120deg, var(--gold-light), var(--gold));
  background-size: 160% 160%;
  background-position: 0% 50%;
  color: var(--green-900) !important;
  font-weight: 700;
  font-size: 14px;
  white-space: nowrap;
  box-shadow: 0 10px 22px -8px rgba(184, 145, 47, 0.55);
  transition: background-position 0.35s ease, transform 0.2s ease, box-shadow 0.25s ease;
}
.footer-contact-button:hover {
  background-position: 100% 50%;
  transform: translateY(-1px);
  box-shadow: 0 12px 26px -6px rgba(184, 145, 47, 0.7);
}
.footer-main { padding: 44px 0 26px; }
.footer-brand {
  font-family: 'Poppins', sans-serif;
  font-weight: 800;
  font-size: 24px;
  letter-spacing: 0.05em;
  color: var(--vanilla);
  margin-bottom: 10px;
}
.footer-copy { font-size: 13.5px; color: rgba(251, 247, 238, 0.68); line-height: 1.65; max-width: 420px; }
.footer-links { display: flex; flex-wrap: wrap; gap: 10px 22px; justify-content: flex-start; }
.footer-links a {
  color: rgba(251, 247, 238, 0.82);
  font-size: 14px;
  font-weight: 600;
  position: relative;
  padding-bottom: 2px;
  transition: color 0.2s ease;
}
.footer-links a::after {
  content: "";
  position: absolute;
  left: 0; bottom: -2px;
  width: 0; height: 1.5px;
  background: linear-gradient(90deg, var(--gold-light), var(--gold));
  transition: width 0.25s ease;
}
.footer-links a:hover { color: var(--vanilla); }
.footer-links a:hover::after { width: 100%; }
.footer-bottom {
  margin-top: 34px;
  padding-top: 18px;
  border-top: 1px solid rgba(251, 247, 238, 0.12);
  font-size: 12.5px;
  color: rgba(251, 247, 238, 0.55);
}

/* ============================ RESPONSIVE =============================== */
@media (max-width: 991.98px) {
  .page-hero { margin: 12px 12px 0; border-radius: 0 16px 0 16px; padding: 48px 0 56px; min-height: 0; }
  .library-sidebar { position: static; margin-bottom: 24px; }
  .sector-tabs { flex-direction: row !important; flex-wrap: wrap; }
  .sector-tabs .nav-link { width: auto; flex: 1 1 220px; }
  .site-footer { margin: 40px 12px 12px; border-radius: 32px 32px 0 0; }
}
@media (max-width: 575.98px) {
  .modal-brand-line { flex-wrap: wrap; }
  .application-strip { flex-direction: column; align-items: flex-start; }
}

/* Respect reduced motion preferences */
@media (prefers-reduced-motion: reduce) {
  .scholar-card, .btn-details, .footer-contact-button, .sector-tabs .nav-link, .benefit-tile {
    transition: none !important;
  }
}

/* ==========================================================================
   STUDENT FINDER (ScholarshipFinder.php)
   Moved out of that page's inline <style> block so the Scholarship Finder
   shares this one stylesheet — and its navbar — with every other page.
   Only uses the variables already defined above.
   ========================================================================== */
.sf-page { background: var(--vanilla); padding: 56px 16px 80px; flex: 1 0 auto; display: flex; flex-direction: column; justify-content: center; }

/* Shell = the picture sidebar (.sf-media) plus the content card (.sf-card),
   side by side, stretched to the same height. The image placeholder below is
   intentionally separate from the overlay: replace only the URL when ready.
   IMAGE PLACEHOLDER: img/student-finder-bg.jpg */
.sf-shell { max-width: 1096px; width: 100%; margin: 0 auto; display: flex; min-height: clamp(540px, 74vh, 700px); background: var(--surface); border: 1px solid rgba(184,145,47,.42); border-radius: 22px; overflow: hidden; box-shadow: 0 22px 52px rgba(31,77,58,.12), 0 0 0 4px rgba(184,145,47,.045); }
.sf-media {
  flex: 0 0 350px; position: relative; isolation: isolate; overflow: hidden;
  display: flex; align-items: flex-end; padding: 34px; color: var(--vanilla);
  background: linear-gradient(135deg, #143a2b 0%, #1f4d3a 52%, #b8912f 115%);
}
/* Visible DNSC campus photo with a balanced green-to-gold overlay. */
.sf-media::after {
  content: ""; position: absolute; inset: 0; z-index: -2;
  background-image: url("images/img/opt/dnsc-seal.jpg");
  background-position: center; background-size: cover; background-repeat: no-repeat;
  opacity: .68; z-index: 0;
}
.sf-media::before {
  content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none;
  background:
    radial-gradient(ellipse at 88% 90%, rgba(184,145,47,.56) 0%, transparent 48%),
    linear-gradient(145deg, rgba(20,58,43,.48) 0%, rgba(31,77,58,.44) 52%, rgba(184,145,47,.24) 100%);
}
.sf-media-icon { position: absolute; top: 36px; left: 50%; transform: translateX(-50%); z-index: 2; font-size: 68px; color: rgba(251,247,238,.28); text-shadow: 0 5px 24px rgba(20,58,43,.16); }
.sf-media-cap { position: relative; z-index: 2; font-family: var(--font-serif); font-size: 1.1rem; line-height: 1.35; text-shadow: 0 2px 14px rgba(20,58,43,.22); }
.sf-media-cap small { display: block; font-family: var(--font-display); font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #f6dfa0; margin-bottom: 8px; text-shadow: 0 1px 8px rgba(20,58,43,.25); }

.sf-card { flex: 1 1 auto; min-width: 0; background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 36px; box-shadow: 0 18px 40px rgba(31,77,58,.08); }
.sf-shell .sf-card { border: 0; border-radius: 0; box-shadow: none; }
/* Intro and question cards sit inside a tall shell, so their content is
   vertically centered instead of pinned to the top with empty space
   trailing underneath. */
.sf-shell .sf-card { display: flex; flex-direction: column; justify-content: center; }
.sf-card-q { justify-content: flex-start; }
.sf-card-q .sf-qbody { flex: 1; display: flex; flex-direction: column; justify-content: center; }
.sf-intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 30px; }
.sf-intro-grid div { display: flex; align-items: center; gap: 12px; }
.sf-intro-grid i { flex-shrink: 0; width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; font-size: 1.05rem; background: var(--sage-tint); color: var(--green-700); border-radius: 0 10px 0 10px; }
.sf-intro-grid span { font-size: 14px; font-weight: 600; color: var(--green-900); line-height: 1.3; }
@media (max-width: 575px) { .sf-intro-grid { grid-template-columns: 1fr; } }
/* Card column layout: top bar/progress pinned to the top, the question
   body vertically centered in the space between, nav pinned to the
   bottom — kept the same height whether it's a 2-option or 8-option
   question. */
.sf-card-q { display: flex; flex-direction: column; }
.sf-card-q .sf-nav { margin-top: auto; }
/* Long option lists (7-8 choices) scroll INSIDE this box instead of
   pushing Back/Next off the bottom of the screen. The cap is the
   viewport height minus everything else on the page (header, card
   padding, question text, nav) so Back/Next always stay on screen —
   on desktop and on a short phone screen alike. */
#answers { max-height: max(160px, calc(100vh - 460px)); overflow-y: auto; padding-right: 6px; scrollbar-width: thin; scrollbar-color: var(--sage) var(--vanilla-deep); }
#answers::-webkit-scrollbar { width: 7px; }
#answers::-webkit-scrollbar-track { background: var(--vanilla-deep); border-radius: 6px; }
#answers::-webkit-scrollbar-thumb { background: var(--sage); border-radius: 6px; }
.sf-page--q { padding-top: 24px; padding-bottom: 24px; }
/* AJAX step swap: only the question card fades/slides; the .sf-media panel stays put. */
.sf-card-q .sf-qbody { transition: opacity .16s ease, transform .16s ease; }
.sf-card-q.is-swapping .sf-qbody { opacity: 0; transform: translateX(var(--sf-shift, -14px)); }
.sf-card-q.is-busy .sf-nav { pointer-events: none; opacity: .75; }
.sf-card-q .sf-qbody h2:focus { outline: none; }
.sf-media-cap { transition: opacity .16s ease; }
.sf-media-cap.is-swapping { opacity: 0; }
@media (prefers-reduced-motion: reduce) { .sf-card-q .sf-qbody, .sf-media-cap { transition: none; } }
@media (max-width: 767px) {
    .sf-shell { flex-direction: column; min-height: 0; }
    .sf-media { flex: 0 0 120px; padding: 16px 20px; align-items: center; }
    .sf-media-icon { display: none; }
    .sf-media-cap { font-size: 0.95rem; }
    /* Stacking the media panel above the card on mobile adds ~120px of
       height the desktop calc doesn't know about — account for it here
       so Back/Next still stay on screen without a page scroll. */
    #answers { max-height: max(140px, calc(100vh - 580px)); }
}
/* Reserve the hint/error line's space even when empty, so the card
   doesn't shift up when there's no hint on a given question. */
.sf-hint-slot { min-height: 26px; margin-bottom: 4px; }
/* Fixed card size on question steps: the shell no longer grows with long question
   text or long option lists. The option list scrolls inside the card instead. */
.sf-shell:has(.sf-card-q) { height: clamp(540px, 74vh, 700px); min-height: 0; }
.sf-card-q, .sf-card-q .sf-qbody { min-height: 0; }
.sf-card-q .sf-qbody > h2, .sf-card-q .sf-qbody > .sf-hint, .sf-card-q .sf-nav { flex-shrink: 0; }
.sf-card-q #answers { flex: 0 1 auto; min-height: 0; max-height: none; overflow-y: auto; }
@media (max-width: 767px) { .sf-shell:has(.sf-card-q) { height: clamp(520px, 82vh, 700px); } }
.sf-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; font-size: 13px; font-weight: 600; color: var(--ink-soft); margin-bottom: 10px; }
.sf-top-count { flex-shrink: 0; background: var(--sage-tint); color: var(--green-700); padding: 4px 12px; border-radius: 999px; font-weight: 700; }
.sf-track { height: 6px; border-radius: 6px; background: var(--vanilla-deep); overflow: hidden; margin-bottom: 28px; }
.sf-fill { height: 100%; background: linear-gradient(90deg, var(--gold), var(--green-600)); border-radius: 6px; transition: width .35s ease; }
.sf-card h1, .sf-card h2 { font-family: var(--font-serif); font-weight: 600; color: var(--green-900); line-height: 1.25; }
.sf-card h1 { font-size: 2rem; } .sf-card h2 { font-size: 1.55rem; margin-bottom: 6px; }
.sf-hint, .sf-card p { color: var(--ink-soft); }
.sf-opt { position: relative; display: flex; align-items: center; gap: 12px; padding: 12px 44px 12px 16px; margin-bottom: 8px; border: 1px solid var(--border); border-radius: 12px; background: var(--vanilla); color: var(--ink); cursor: pointer; font-weight: 500; transition: border-color .15s ease, background .15s ease, transform .15s ease, box-shadow .15s ease; }
.sf-opt:hover { border-color: var(--sage); background: var(--sage-tint); transform: translateY(-1px); box-shadow: 0 4px 10px rgba(31,77,58,.08); }
.sf-opt input { accent-color: var(--green-700); width: 18px; height: 18px; flex-shrink: 0; }
.sf-opt-label { flex: 1; }
.sf-opt-check { position: absolute; right: 16px; top: 50%; transform: translateY(-50%) scale(.6); font-size: 18px; color: var(--green-700); opacity: 0; transition: opacity .15s ease, transform .15s ease; }
.sf-opt:has(input:checked) { border-color: var(--green-700); background: var(--sage-tint); }
.sf-opt:has(input:checked) .sf-opt-check { opacity: 1; transform: translateY(-50%) scale(1); }
.sf-opt:has(input:focus-visible) { outline: 3px solid var(--gold-light); }
.sf-card select { width: 100%; padding: 13px 16px; border: 1px solid var(--border); border-radius: 12px; background: var(--vanilla); color: var(--ink); }
.sf-err { background: #fbeaea; color: #5c1a22; border-radius: 10px; padding: 10px 14px; margin-bottom: 14px; font-size: 14px; }
.sf-nav { display: flex; justify-content: space-between; align-items: center; margin-top: 26px; padding-top: 22px; border-top: 1px solid var(--border); }
/* Buttons: each state (default / ghost / gold) gets its own :hover so
   hovering a gold button doesn't fall back to the default green hover
   (equal specificity + source order previously let plain .sf-btn:hover
   silently win over .sf-btn.gold — the "gold button doesn't seem to
   react on hover" bug). */
.sf-btn { display: inline-flex; align-items: center; gap: 8px; border-radius: 999px; padding: 11px 24px; font-weight: 600; font-size: 15px; text-decoration: none; cursor: pointer; border: 1px solid var(--green-900); background: var(--green-900); color: var(--vanilla); transition: background .15s ease, color .15s ease, border-color .15s ease; }
.sf-btn:hover { background: var(--green-700); color: var(--vanilla); }
.sf-btn.ghost { background: transparent; color: var(--green-900); border-color: var(--border); }
.sf-btn.ghost:hover { background: var(--sage-tint); color: var(--green-900); }
.sf-btn.gold { background: var(--gold); border-color: var(--gold); color: #fff; }
.sf-btn.gold:hover { background: #9c7a28; border-color: #9c7a28; color: #fff; }
/* Review step: styled to read like a real form being double-checked,
   not a plain list — bordered "input" rows grouped into fieldset-like
   sections, with a small premium accent (gold rail + kicker + sheen). */
.sf-review-card { max-width: 720px; margin: 0 auto; }
.sf-review-head { text-align: center; margin-bottom: 22px; }
.sf-review-kicker { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-display); font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--gold); background: var(--gold-tint); border: 1px solid #e6d7ae; padding: 6px 16px; border-radius: 999px; margin-bottom: 14px; }
.sf-review-head h2 { text-align: center; }
.sf-review-head p { text-align: center; max-width: 480px; margin: 0 auto; }
.sf-review-form { position: relative; border: 1px solid var(--border); border-radius: 18px; padding: 6px 24px 4px; background: linear-gradient(180deg, var(--vanilla) 0%, var(--surface) 46%); box-shadow: 0 1px 0 rgba(255,255,255,.6) inset, 0 16px 34px rgba(31,77,58,.07); }
.sf-review-form::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 4px; border-radius: 18px 18px 0 0; background: linear-gradient(90deg, var(--green-900), var(--gold), var(--green-900)); background-size: 220% 100%; animation: sfSheen 5s linear infinite; }
.sf-rev-sec { display: flex; align-items: center; gap: 10px; margin: 22px 0 12px; padding-top: 18px; border-top: 1px dashed var(--border); }
.sf-rev-sec:first-child { border-top: 0; margin-top: 14px; padding-top: 0; }
.sf-rev-sec-n { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 27px; height: 27px; border-radius: 50%; background: linear-gradient(155deg, var(--green-600), var(--green-900)); color: var(--gold-light); font-family: var(--font-display); font-weight: 700; font-size: 11.5px; box-shadow: 0 3px 8px rgba(20,58,43,.3); }
.sf-rev-sec-label { font-family: var(--font-display); font-weight: 700; font-size: 13px; letter-spacing: .07em; text-transform: uppercase; color: var(--green-700); }
.sf-rev-field { margin-bottom: 12px; }
.sf-rev-field > label { display: block; font-size: 12.5px; font-weight: 600; color: var(--ink-soft); margin-bottom: 6px; }
.sf-rev-value { display: flex; align-items: center; justify-content: space-between; gap: 14px; border: 1px solid var(--border); border-left: 3px solid var(--sage); border-radius: 10px; padding: 12px 14px; background: var(--surface); transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease; }
.sf-rev-value:hover { border-color: var(--green-600); border-left-color: var(--gold); box-shadow: 0 6px 14px rgba(31,77,58,.08); transform: translateY(-1px); }
.sf-rev-answer { display: flex; align-items: center; gap: 9px; min-width: 0; font-weight: 600; color: var(--green-900); font-size: 14.5px; }
.sf-rev-answer i { flex-shrink: 0; color: var(--green-600); font-size: 15px; }
.sf-rev-answer span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sf-rev-edit { flex-shrink: 0; display: inline-flex; align-items: center; gap: 5px; font-size: 12.5px; font-weight: 700; color: var(--gold); padding: 6px 13px; border-radius: 999px; background: var(--gold-tint); border: 1px solid #e6d7ae; transition: background .15s ease, color .15s ease, border-color .15s ease; }
.sf-rev-edit:hover { background: var(--gold); border-color: var(--gold); color: #fff; }
@media (max-width: 480px) { .sf-rev-value { flex-wrap: wrap; } .sf-rev-edit { margin-left: auto; } }
@keyframes sfSheen { 0% { background-position: 0% 0; } 100% { background-position: -220% 0; } }
@media (prefers-reduced-motion: reduce) { .sf-review-form::before { animation: none; } }
/* Each result IS a banner now: a rod with diamond finials hangs a
   notch-bottomed pennant, and that pennant is the container holding
   the scholarship's full content — not a small logo tile beside a
   plain white card. */
/* Grid of banners: auto-fit columns so the row wraps responsively,
   align-items: stretch (the grid default) makes every card in a row
   match the tallest one, and each card is a flex column internally
   so its call-to-action row lands at the same bottom edge no matter
   how long its description or chip list runs. */
.sf-results-grid { max-width: 1180px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 34px 24px; }
@media (max-width: 680px) { .sf-results-grid { grid-template-columns: 1fr; } }
.sf-res { position: relative; display: flex; flex-direction: column; height: 100%; }
.sf-res-rod { position: relative; flex: 0 0 auto; height: 9px; margin: 0 20px; border-radius: 4px; background: linear-gradient(90deg, #8f6d22, var(--gold-light), #8f6d22); box-shadow: 0 3px 6px rgba(31,77,58,.2); }
.sf-res-rod::before, .sf-res-rod::after { content: ""; position: absolute; top: 50%; width: 15px; height: 15px; background: var(--gold); box-shadow: 0 0 0 1px #8f6d22 inset; transform: translateY(-50%) rotate(45deg); }
.sf-res-rod::before { left: -7px; } .sf-res-rod::after { right: -7px; }
.sf-res-banner { position: relative; flex: 1 1 auto; display: flex; background: var(--vanilla); box-shadow: inset 0 0 0 2px var(--gold), 0 14px 32px rgba(31,77,58,.10); clip-path: polygon(0 0, 100% 0, 100% calc(100% - 26px), 50% 100%, 0 calc(100% - 26px)); }
.sf-res-content { position: relative; flex: 1 1 auto; display: flex; flex-direction: column; padding: 30px 28px 40px; }
.sf-res-content > div:last-child { margin-top: auto; padding-top: 10px; }
.sf-res-head { display: flex; align-items: flex-start; gap: 16px; margin-bottom: 6px; }
.sf-res-seal { flex-shrink: 0; width: 52px; height: 52px; border-radius: 50%; background: #fff; padding: 5px; box-shadow: 0 0 0 2px var(--gold), 0 6px 14px rgba(0,0,0,.28); overflow: hidden; }
.sf-res-seal img { width: 100%; height: 100%; object-fit: contain; display: block; }
.sf-res h3 { font-family: var(--font-serif); font-size: 1.25rem; color: var(--green-900); margin: 0 0 2px; }
.sf-res-content p { color: var(--ink-soft); }
.sf-cat { font-size: 13px; font-weight: 700; letter-spacing: .02em; color: #8f6d22; }
.sf-badge { display: inline-block; background: var(--sage-tint); color: var(--green-700); font-size: 13px; font-weight: 700; padding: 4px 12px; border-radius: 999px; }
.sf-chip { display: inline-block; background: var(--gold-tint); color: var(--green-900); font-size: 13px; padding: 4px 11px; border-radius: 999px; margin: 0 6px 6px 0; }
.sf-closed { display: inline-flex; align-items: center; gap: 4px; background: #fbeaea; color: #5c1a22; font-size: 14px; font-weight: 600; padding: 5px 12px; border-radius: 999px; }
/* Button row: same left-aligned start and same button size whether a
   card has one action (View Details only) or two (+ Apply), so the
   row lines up card to card instead of drifting with content length. */
.sf-res-content > div:last-child { display: flex; align-items: center; }
.sf-res-content .sf-btn { min-width: 150px; justify-content: center; }
@media (max-width: 575px) { .sf-res-content { padding: 24px 18px 44px; } .sf-res-content .sf-btn { min-width: 0; flex: 1 1 150px; } }
.sf-modal { position: fixed; inset: 0; background: rgba(31,77,58,.72); backdrop-filter: blur(4px); display: grid; place-items: center; padding: 16px; z-index: 1050; animation: sfFade .3s ease both; }
.sf-modal .sf-card { max-width: 440px; text-align: center; }
@media (max-width: 575px) { .sf-card { padding: 24px 18px; } }

/* ---------- Completion pop-up ---------- */
.sf-done-card { position: relative; padding-top: 40px; animation: sfPop .45s cubic-bezier(.2,.9,.25,1.15) both; }
@keyframes sfFade { from { opacity: 0; } to { opacity: 1; } }
@keyframes sfPop { from { opacity: 0; transform: scale(.92) translateY(14px); } to { opacity: 1; transform: scale(1) translateY(0); } }
.sf-done-badge { position: relative; width: 88px; height: 88px; margin: 0 auto 18px; display: grid; place-items: center; border-radius: 50%; background: linear-gradient(155deg, var(--green-600), var(--green-900)); box-shadow: 0 0 0 6px var(--gold-tint), 0 14px 28px rgba(31,77,58,.28); }
.sf-done-badge i { position: relative; z-index: 1; font-size: 2.1rem; color: var(--vanilla); }
.sf-confetti { position: absolute; top: 50%; left: 50%; width: 7px; height: 7px; border-radius: 2px; opacity: 0; animation: sfSpark .9s ease-out both; }
.sf-confetti.c1 { --tx: -46px; --ty: -8px;  background: var(--gold);       animation-delay: .22s; }
.sf-confetti.c2 { --tx: 42px;  --ty: -18px; background: var(--sage);       animation-delay: .3s; }
.sf-confetti.c3 { --tx: -30px; --ty: 34px;  background: var(--green-500); animation-delay: .38s; }
.sf-confetti.c4 { --tx: 34px;  --ty: 32px;  background: var(--gold-light);animation-delay: .46s; }
.sf-confetti.c5 { --tx: 6px;   --ty: -44px; background: var(--gold);       animation-delay: .54s; }
.sf-confetti.c6 { --tx: -8px;  --ty: 44px;  background: var(--sage);       animation-delay: .62s; }
@keyframes sfSpark { 0% { opacity: 0; transform: translate(-50%,-50%) rotate(0deg) scale(.3); } 35% { opacity: 1; } 100% { opacity: 0; transform: translate(calc(-50% + var(--tx)), calc(-50% + var(--ty))) rotate(200deg) scale(1); } }
.sf-done-stat { display: inline-flex; align-items: center; gap: 6px; margin: 2px 0 22px; padding: 6px 14px; border-radius: 999px; background: var(--sage-tint); color: var(--green-700); font-size: 13px; font-weight: 700; }
.sf-done-actions { display: flex; flex-direction: column; gap: 8px; }
.sf-done-actions .sf-btn { justify-content: center; width: 100%; }
.sf-done-actions .sf-btn.ghost { border-color: transparent; color: var(--ink-soft); }
.sf-done-actions .sf-btn.ghost:hover { background: var(--sage-tint); color: var(--green-900); }
@media (prefers-reduced-motion: reduce) {
    .sf-modal, .sf-done-card { animation: none; }
    .sf-confetti { display: none; }
}

/* View Details modal (Bootstrap), styled like the scholarshipPage cards */
.sf-dmodal { border: 0; border-radius: 14px; overflow: hidden; }
.sf-dmodal-head { position: relative; background: linear-gradient(165deg, var(--green-700), var(--green-900)); padding: 26px 28px; border: 0; box-shadow: inset 0 -3px 0 var(--gold); }
.sf-dmodal-sticker { position: absolute; top: 14px; right: 52px; font-family: var(--font-display); font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--gold-light); }
.sf-dmodal-brand { display: flex; align-items: flex-start; gap: 16px; }
.sf-dmodal-brand img { width: 52px; height: 52px; border-radius: 50%; background: #fff; padding: 5px; object-fit: contain; box-shadow: 0 0 0 2px var(--gold); flex-shrink: 0; }
.sf-dmodal-cat { display: block; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--gold-light); margin-bottom: 4px; }
.sf-dmodal-head h3 { font-family: var(--font-serif); color: var(--vanilla); font-size: 1.4rem; margin: 0 0 4px; }
.sf-dmodal-head p { color: rgba(251,247,238,.82); margin: 0; font-size: 14px; }
.sf-dmodal .btn-close { position: absolute; top: 16px; right: 16px; }
.sf-dmodal-body { padding: 26px 28px; }
.sf-dmodal-section { margin-bottom: 20px; }
.sf-dmodal-section:last-child { margin-bottom: 0; }
.sf-dmodal-section-title { display: flex; align-items: center; gap: 8px; font-family: var(--font-display); font-weight: 700; font-size: 13px; letter-spacing: .04em; text-transform: uppercase; color: var(--green-700); margin-bottom: 10px; }
.sf-dmodal-section p { color: var(--ink-soft); margin: 0; }
.sf-dmodal-pills { display: flex; flex-wrap: wrap; gap: 8px; }
.sf-dmodal-pill { display: inline-flex; align-items: center; gap: 6px; background: var(--sage-tint); color: var(--green-900); font-size: 13px; font-weight: 500; padding: 6px 13px; border-radius: 999px; }
.sf-dmodal-foot { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 10px; padding: 18px 28px; border-top: 1px solid var(--border); }

.sf-doc-note { font-size: 13px; color: var(--ink-soft); margin: 0 0 10px; }
.sf-dmodal-docs { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px 12px; }
.sf-dmodal-docs li { display: flex; align-items: flex-start; gap: 9px; padding: 10px 12px; background: #f8f3e8; border: 1px solid rgba(184,145,47,.22); border-radius: 10px; color: var(--green-900); font-size: 13px; line-height: 1.45; }
.sf-dmodal-docs li i { color: #9a7623; margin-top: 2px; flex-shrink: 0; }
.sf-dmodal-foot .sf-btn.gold { background: linear-gradient(135deg, #f6dfa0, #b8912f); border-color: #b8912f; color: #143a2b; }
.sf-dmodal-foot .sf-btn.gold:hover { background: linear-gradient(135deg, #fbeeca, #c9a44a); color: #143a2b; }
@media (max-width: 575px) { .sf-dmodal-docs { grid-template-columns: 1fr; } }

@media (max-width: 575px) { .sf-dmodal-head, .sf-dmodal-body { padding: 20px; } .sf-dmodal-sticker { display: none; } }


/* ========================================================================== 
   STUDENT FINDER RESULTS — featured match layout
   Uses only the shared BAKR variables above so the page stays on-brand.
   ========================================================================== */
/* Results page hero.
   The green band is now the hero's OWN background (see .sf-results-hero::before), so it
   always grows with its content. Before, it was a fixed 260px angled shape pinned to the
   top of the page while the page vertically centered its content, so on a short page (0
   matches) the text slid down off the banner and overlapped. */
body:has(.sf-results-hero) { margin-top: 0; }          /* green runs up behind the floating navbar: no white strip above it */
.sf-page:has(.sf-results-hero) {
  position: relative;
  overflow: hidden;
  padding: 0 16px 72px;
  justify-content: flex-start;                          /* .sf-page centers vertically; results must start at the top */
  background: var(--surface);
}
.sf-page:has(.sf-results-hero)::before { content: none; }   /* old fixed-height, clipped banner removed */
.sf-page:has(.sf-results-hero) > *:not(.modal) { position: relative; z-index: 1; }
.sf-results-hero {
  --sf-nav-offset: 100px;                               /* room for the fixed navbar (it was the old body margin-top) */
  max-width: 1180px; margin: 0 auto 36px;
  padding: calc(var(--sf-nav-offset) + 42px) 26px 44px; /* auto height: grows with the title/paragraphs, never overflows */
  color: var(--vanilla);
}
.sf-results-hero::before {                              /* full-width, plain rectangle behind the hero */
  content: "";
  position: absolute; z-index: -1;
  top: 0; bottom: 0; left: 50%; width: 100vw; transform: translateX(-50%);
  background:
    radial-gradient(560px 260px at 100% 0%, rgba(246,223,160,.22), transparent 70%),              /* --gold-light glow, top right */
    linear-gradient(112deg, rgba(20,58,43,.90) 0%, rgba(31,77,58,.82) 58%, rgba(184,145,47,.62) 150%), /* green/gold overlay keeps text readable */
    url("images/img/graduates.jpg") center / cover no-repeat,                                              /* hero background photo: public/img/graduates.jpg */
    var(--green-900);                                                                              /* fallback if the image is missing */
  clip-path: none;
  border-radius: 0;
}
.sf-results-hero-text { flex: 1 1 auto; min-width: 0; }
.sf-results-kicker { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; font-size: 11px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: var(--gold-light); }
.sf-results-kicker span { width: 40px; height: 2px; background: var(--sage); }
.sf-results-hero-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 28px; }
.sf-results-title { margin: 0 0 10px; color: var(--vanilla); font-family: var(--font-display); font-size: clamp(2.35rem, 5vw, 4.25rem); line-height: .98; letter-spacing: -.055em; font-weight: 800; }
.sf-results-title em { color: var(--gold-light); font-style: normal; }
.sf-results-intro { max-width: 720px; margin: 0; color: rgba(251,247,238,.78); font-size: 15px; line-height: 1.65; }
.sf-results-hero .sf-hint { color: rgba(251,247,238,.7); max-width: 680px; }
.sf-results-count { flex: 0 0 190px; display: grid; grid-template-columns: 36px 1fr; gap: 2px 10px; align-items: center; padding: 16px 18px; border: 1px solid rgba(251,247,238,.22); border-radius: 14px; background: rgba(251,247,238,.1); backdrop-filter: blur(10px); }
.sf-results-count i { grid-row: span 2; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; color: var(--green-900); background: var(--gold-light); }
.sf-results-count strong { color: var(--vanilla); font-family: var(--font-display); font-size: 18px; }
.sf-results-count span { color: rgba(251,247,238,.7); font-size: 11px; line-height: 1.35; }
.sf-results-list { max-width: 1180px; margin: 0 auto; display: grid; gap: 14px; }
.sf-result-row { min-height: 150px; display: grid; grid-template-columns: minmax(0, 1fr) 250px; align-items: stretch; overflow: hidden; border: 1px solid rgba(31,77,58,.11); border-radius: 14px; background: var(--surface); box-shadow: 0 14px 30px rgba(31,77,58,.08); }
.sf-result-row--featured { grid-template-columns: 126px minmax(0, 1fr) 250px; border-color: rgba(184,145,47,.55); box-shadow: 0 18px 38px rgba(31,77,58,.13); }
.sf-best-match { display: flex; flex-direction: column; justify-content: space-between; align-items: center; width: 126px; padding: 20px 12px 12px; color: var(--green-900); background: linear-gradient(160deg, var(--gold-light), var(--gold)); text-align: center; }
.sf-best-match > i { font-size: 22px; color: #7b5b14; }
.sf-best-match strong { font-family: var(--font-display); font-size: 15px; line-height: 1.05; letter-spacing: .02em; }
.sf-best-match span { font-size: 34px; color: rgba(255,255,255,.55); }
.sf-result-main { display: flex; align-items: flex-start; gap: 18px; min-width: 0; padding: 22px 18px 18px 26px; }
.sf-best-match + .sf-result-main { padding-left: 22px; }
.sf-result-copy { min-width: 0; }
.sf-result-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 5px; }
.sf-result-copy h3 { margin: 0 0 5px; color: var(--green-900); font-family: var(--font-display); font-size: clamp(1.08rem, 1.7vw, 1.42rem); line-height: 1.18; }
.sf-result-copy p { margin: 0 0 10px; color: var(--ink-soft); font-size: 14px; line-height: 1.45; }
.sf-result-chips { display: flex; flex-wrap: wrap; gap: 5px; }
.sf-result-chips .sf-chip { margin: 0; background: var(--sage-tint); color: var(--green-900); font-size: 12px; padding: 5px 10px; }
.sf-result-action { display: flex; flex-direction: column; justify-content: center; gap: 6px; padding: 18px 22px; }
.sf-top-label { color: var(--gold); font-size: 11px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
.sf-result-action strong { color: var(--green-900); font-size: 17px; line-height: 1.15; }
.sf-result-action p { margin: 0 0 5px; color: var(--ink-soft); font-size: 13px; line-height: 1.35; }
.sf-result-action .sf-btn { align-self: stretch; justify-content: center; min-width: 0; }
.sf-official-link { color: var(--green-700); font-size: 12px; text-align: center; }
.sf-official-link:hover { color: var(--gold); }
@media (max-width: 900px) {
  .sf-result-row { grid-template-columns: minmax(0, 1fr); }
  .sf-result-row--featured { grid-template-columns: 126px minmax(0, 1fr); }
  .sf-result-action { grid-column: 1 / -1; flex-direction: row; align-items: center; border-top: 1px solid var(--border); padding: 14px 18px; }
  .sf-result-action .sf-btn { margin-left: auto; flex: 0 0 auto; }
  .sf-result-action p, .sf-result-action strong { display: none; }
}
@media (max-width: 620px) {
  .sf-page:has(.sf-results-hero) { padding-left: 10px; padding-right: 10px; }
  .sf-results-hero { padding: calc(var(--sf-nav-offset) + 32px) 10px 34px; }
  .sf-results-hero-row { flex-direction: column; }
  .sf-results-count { width: 100%; }
  .sf-results-title { font-size: 2.45rem; }
  .sf-result-row { display: block; }
  .sf-best-match { width: 100%; flex-direction: row; justify-content: flex-start; gap: 12px; padding: 10px 18px; }
  .sf-best-match span { margin-left: auto; }
  .sf-result-main, .sf-best-match + .sf-result-main { padding: 18px; }
  .sf-result-action { flex-wrap: wrap; }
  .sf-result-action .sf-btn { width: 100%; margin-left: 0; }
}

/* ==========================================================================
   MOTION — entrance, hover and idle animations for the Finder.
   Everything is inside prefers-reduced-motion: no-preference, so people who ask
   their device for less motion get the static page. Entrances use "backwards"
   fill (not "both") so they don't lock transform and block the hover effects.
   ========================================================================== */
.sf-results-count strong b { font: inherit; }
@media (prefers-reduced-motion: no-preference) {
  @keyframes sfRise  { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @keyframes sfShine { 0%, 55% { transform: translateX(-140%) skewX(-18deg); } 100% { transform: translateX(300%) skewX(-18deg); } }
  @keyframes sfTextShine { to { background-position: -200% 0; } }
  @keyframes sfStar  { 0%, 100% { transform: scale(1) rotate(0); } 50% { transform: scale(1.2) rotate(14deg); } }
  @keyframes sfFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }

  /* Results hero: staggered entrance + shimmering gold word */
  .sf-results-kicker  { animation: sfRise .6s ease backwards; }
  .sf-results-title   { animation: sfRise .7s ease .08s backwards; }
  .sf-results-intro   { animation: sfRise .7s ease .18s backwards; }
  .sf-results-hero .sf-hint { animation: sfRise .7s ease .26s backwards; }
  .sf-results-count   { animation: sfRise .7s ease .34s backwards; }
  .sf-results-count i { animation: sfFloat 3.2s ease-in-out 1.2s infinite; }
  .sf-results-title em {
    background: linear-gradient(90deg, var(--gold-light) 0%, #fff6d6 35%, var(--gold-light) 70%);
    background-size: 200% 100%; -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
    animation: sfTextShine 4.5s linear 1s infinite;
  }

  /* Result cards: rise in one after another, lift on hover */
  .sf-result-row { animation: sfRise .65s cubic-bezier(.2,.7,.3,1) calc(.4s + min(var(--i, 0), 6) * .09s) backwards;
                   transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease; }
  .sf-result-row:hover { transform: translateY(-4px); box-shadow: 0 22px 44px rgba(31,77,58,.17); border-color: rgba(184,145,47,.6); }
  .sf-res-seal { transition: transform .3s ease; }
  .sf-result-row:hover .sf-res-seal { transform: scale(1.08) rotate(-4deg); }
  .sf-result-chips .sf-chip { transition: transform .2s ease, background-color .2s ease; }
  .sf-result-chips .sf-chip:hover { transform: translateY(-2px); background: var(--gold-tint); }

  /* Featured card: sheen sweeping over the BEST MATCH tab, pulsing star */
  .sf-best-match { position: relative; overflow: hidden; }
  .sf-best-match::after { content: ""; position: absolute; inset: 0 auto 0 0; width: 45%; pointer-events: none;
                          background: linear-gradient(90deg, transparent, rgba(255,255,255,.5), transparent);
                          animation: sfShine 4.8s ease-in-out 1.4s infinite; }
  .sf-best-match > i { animation: sfStar 2.6s ease-in-out infinite; }

  /* Buttons: press feedback and arrow nudge */
  .sf-btn { transition: transform .15s ease, background-color .2s ease, color .2s ease, border-color .2s ease; }
  .sf-btn:hover { transform: translateY(-1px); }
  .sf-btn:active { transform: scale(.97); }
  .sf-btn .bi-arrow-right, .sf-btn .bi-arrow-left, .sf-btn .bi-box-arrow-up-right, .sf-official-link .bi { display: inline-block; transition: transform .2s ease; }
  .sf-btn:hover .bi-arrow-right { transform: translateX(4px); }
  .sf-btn:hover .bi-arrow-left { transform: translateX(-4px); }
  .sf-btn:hover .bi-box-arrow-up-right, .sf-official-link:hover .bi { transform: translate(2px, -2px); }
  .sf-results-foot { animation: sfRise .6s ease .9s backwards; }

  /* Details modal: sections and pills fade up when it opens */
  .modal.show .sf-dmodal-section { animation: sfRise .5s ease backwards; }
  .modal.show .sf-dmodal-section:nth-child(2) { animation-delay: .08s; }
  .modal.show .sf-dmodal-section:nth-child(3) { animation-delay: .16s; }
  .modal.show .sf-dmodal-section:nth-child(4) { animation-delay: .24s; }
  .modal.show .sf-dmodal-pill { animation: sfRise .45s ease backwards; }
  .modal.show .sf-dmodal-pill:nth-child(2) { animation-delay: .08s; }
  .modal.show .sf-dmodal-pill:nth-child(3) { animation-delay: .14s; }
  .modal.show .sf-dmodal-pill:nth-child(4) { animation-delay: .2s; }
  .modal.show .sf-dmodal-pill:nth-child(n+5) { animation-delay: .26s; }

  /* Intro / question / review cards */
  .sf-shell, .sf-review-card { animation: sfRise .55s ease backwards; }
  .sf-intro-grid div { animation: sfRise .5s ease backwards; }
  .sf-intro-grid div:nth-child(1) { animation-delay: .15s; }
  .sf-intro-grid div:nth-child(2) { animation-delay: .22s; }
  .sf-intro-grid div:nth-child(3) { animation-delay: .29s; }
  .sf-intro-grid div:nth-child(4) { animation-delay: .36s; }
  .sf-intro-grid div:nth-child(n+5) { animation-delay: .43s; }
}


/* ==========================================================================
   LANDING-PAGE SECTIONS  (moved from index.html inline <style>,
   re-skinned to the Admin Portal palette: warm-white/ivory surfaces,
   #1f4d3a scholarship green, #143a2b deep emerald, #b8912f gold,
   #eeece8 borders, Poppins type, 8-16px radii, soft admin shadows)
   ========================================================================== */
.nx-photo-section { background: var(--vanilla-deep); }
.nx-photo-grid { display: grid; grid-template-columns: 1.08fr .92fr; gap: 1.5rem; align-items: stretch; }
.nx-photo-card { position: relative; overflow: hidden; aspect-ratio: 4 / 3; min-height: 0; border-radius: 0 20px 0 20px; background: var(--sage-tint); border: 1px solid var(--border); box-shadow: 0 2px 10px rgba(43, 41, 37, .06); }
.nx-photo-card img { width: 100%; height: 100%; min-height: 0; object-fit: cover; display: block; }
.nx-photo-card.tall { aspect-ratio: 4 / 5; }
.nx-photo-card.tall img { min-height: 0; }
.nx-photo-caption { position: absolute; inset: auto 0 0; padding: 2.2rem 1.5rem 1.35rem; color: var(--vanilla); background: linear-gradient(transparent, rgba(20, 58, 43, .92)); }
.nx-photo-caption strong { display:block; font-family: var(--font-display); font-size: 1.05rem; }
.nx-photo-caption span { display:block; margin-top:.25rem; color:var(--gold-light); font-size:.9rem; }
.nx-photo-stack { display: grid; grid-template-rows: 1fr 1fr; gap: 1.5rem; align-self: stretch; }
.nx-photo-stack .nx-photo-card { aspect-ratio: auto; min-height: 0; }
.nx-story-copy { max-width: 680px; }
.nx-benefit { height:100%; padding:1.5rem; border:1px solid var(--border); border-radius:14px; background:var(--surface); box-shadow:0 2px 10px rgba(43, 41, 37,.06); }
.nx-benefit i { color:var(--gold); font-size:1.8rem; }
.nx-benefit h3 { margin:.8rem 0 .45rem; font-size:1.1rem; }
.nx-benefit p { margin:0; color:var(--ink-soft); }
.nx-local-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }
.nx-local-item { display:flex; gap:.8rem; align-items:flex-start; padding:1rem; border-left:3px solid var(--gold); background:var(--surface); border:1px solid var(--border); border-left-width:3px; border-radius:0 10px 0 10px; }
.nx-local-item i { color:var(--green-700); font-size:1.2rem; }
.nx-footer-photo { width:100%; height:180px; object-fit:cover; border-radius:0 14px 0 14px; filter:saturate(.88); border:1px solid rgba(253, 251, 248,.18); }
.nx-footer-local { display:flex; gap:1.25rem; align-items:center; }
.nx-faq { background: var(--vanilla); }
.nx-faq-list { display:grid; gap:12px; max-width:900px; margin:0 auto; }
.nx-faq-item { border:1px solid var(--border); border-radius:12px; background:var(--surface); overflow:hidden; }
.nx-faq-item summary { cursor:pointer; list-style:none; padding:18px 22px; color:var(--green-900); font-family:var(--font-display); font-weight:700; display:flex; align-items:center; justify-content:space-between; gap:16px; }
.nx-faq-item summary::-webkit-details-marker { display:none; }
.nx-faq-item summary::after { content:'+'; color:var(--gold); font-size:1.4rem; line-height:1; }
.nx-faq-item[open] summary::after { content:'−'; }
.nx-faq-answer { padding:0 22px 18px; color:var(--ink-soft); font-size:14px; line-height:1.65; }
.nx-footer-location { display:inline-flex; align-items:center; gap:8px; margin-top:14px; color:var(--gold-light); font-size:0.875rem; text-decoration:none; }
.nx-footer-location:hover { color:var(--vanilla); }
.nx-feedback { background: var(--vanilla-deep); border-top: 1px solid var(--border); }
.nx-feedback-carousel { max-width: 920px; margin: 0 auto; }
.nx-feedback-card { min-height: 250px; margin: 0 48px; padding: 34px clamp(24px, 5vw, 58px); border-radius: 16px; background: var(--surface); border: 1px solid var(--border); box-shadow: 0 2px 10px rgba(43, 41, 37,.06); text-align: center; }
.nx-feedback-stars { display:flex; justify-content:center; gap:4px; color:var(--gold); font-size:1.05rem; margin-bottom:18px; }
.nx-feedback-comment { margin:0 auto 20px; max-width: 60ch; color:var(--ink); font-family:var(--font-body); font-size:clamp(1.05rem, 1.8vw, 1.25rem); line-height:1.5; font-weight:500; }
.nx-feedback-comment::before, .nx-feedback-comment::after { color:var(--gold); font-size:1.6em; line-height:0; vertical-align:-.15em; }
.nx-feedback-comment::before { content:'\201C'; margin-right:4px; }
.nx-feedback-comment::after { content:'\201D'; margin-left:4px; }
.nx-feedback-person { color:var(--green-700); font-family:var(--font-display); font-size:13px; font-weight:700; }
.nx-feedback-role { display:block; margin-top:4px; color:var(--ink-soft); font-family:var(--font-body); font-size:12px; font-weight:400; }
.nx-feedback .carousel-control-prev, .nx-feedback .carousel-control-next { width:42px; opacity:1; }
.nx-feedback .carousel-control-prev-icon, .nx-feedback .carousel-control-next-icon { width:36px; height:36px; padding:8px; border-radius:10px; background-color:var(--green-700); background-size:55%; }
.nx-feedback .carousel-indicators { position:static; margin:22px 0 0; }
.nx-feedback .carousel-indicators [data-bs-target] { width:8px; height:8px; border:0; border-radius:50%; background-color:var(--sage); opacity:.6; }
.nx-feedback .carousel-indicators .active { background-color:var(--gold); opacity:1; }
.nx-feedback-form { max-width: 920px; margin: 36px auto 0; padding: 28px; border: 1px solid var(--border); border-radius: 16px 16px 16px 4px; background: var(--surface); box-shadow: 0 2px 10px rgba(43, 41, 37,.06); }
.nx-feedback-form h3 { margin:0 0 6px; color:var(--green-900); font-size:20px; }
.nx-feedback-form-intro { margin:0 0 20px; color:var(--ink-soft); font-size:14px; }
.nx-feedback-form label { display:block; margin-bottom:6px; color:var(--green-900); font-size:13px; font-weight:700; }
.nx-feedback-form .form-control, .nx-feedback-form .form-select { background:var(--vanilla); border:1px solid var(--border); border-radius:10px; padding:11px 14px; color:var(--ink); }
.nx-feedback-form .form-control:focus, .nx-feedback-form .form-select:focus { border-color:var(--green-600); box-shadow:0 0 0 3px rgba(31, 77, 58,.12); background:var(--surface); }
.nx-feedback-status { display:block; min-height:20px; margin-top:12px; color:var(--green-700); font-size:13px; }
@media (max-width: 575.98px) { .nx-feedback-card { margin:0 28px; padding:28px 20px; } }

/* ---------- visual polish, admin edition ---------- */
.nx-story-label { display:inline-flex; align-items:center; gap:7px; padding:6px 12px; border:1px solid rgba(184,145,47,.35); border-radius:999px; background:var(--gold-tint); color:#8a6d1f; font-family:var(--font-display); font-size:.68rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; }
.nx-story-label::before { content:''; width:6px; height:6px; border-radius:50%; background:var(--gold); }
.nx-benefit { position:relative; overflow:hidden; padding:24px 22px 22px; border-top:3px solid var(--gold); transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
.nx-benefit:hover { transform:translateY(-3px); border-color:var(--gold); box-shadow:0 6px 18px rgba(43, 41, 37,.10); }
.nx-benefit i { width:46px; height:46px; display:grid; place-items:center; margin-bottom:16px; border-radius:10px; background:var(--sage-tint); color:var(--green-700); font-size:1.25rem; }
.nx-benefit h3 { font-size:1.05rem; }
.nx-local-item { position:relative; transition:transform .16s ease, box-shadow .16s ease, border-color .16s ease; }
.nx-local-item:hover { transform:translateX(4px); border-color:var(--gold); box-shadow:0 6px 18px rgba(43, 41, 37,.10); }
.nx-local-item strong { color:var(--green-900); font-family:var(--font-display); }
.nx-scholarship-logo { background:var(--surface); box-shadow:0 2px 10px rgba(43, 41, 37,.06); }
.nx-scholarship-logo:hover { transform:translateY(-3px); border-color:var(--gold); box-shadow:0 6px 18px rgba(43, 41, 37,.10); }
.nx-scholarship-logo img { border-radius:50%; background:var(--vanilla-deep); padding:6px; border:1px solid var(--border); }
.nx-feedback-card { position:relative; overflow:hidden; }
.nx-feedback-card::before { content:'\201C'; position:absolute; top:10px; left:24px; color:rgba(184,145,47,.18); font-family:var(--font-body); font-size:6rem; font-weight:700; line-height:1; pointer-events:none; }
.nx-feedback-form { position:relative; overflow:hidden; background:var(--surface); }
.nx-feedback-form::before { content:''; position:absolute; left:0; top:0; bottom:0; width:4px; background:linear-gradient(var(--gold), var(--green-700)); }
.nx-feedback-form h3, .nx-feedback-form-intro, .nx-feedback-form form { position:relative; }
#process .nx-local-item i { flex:0 0 auto; width:34px; height:34px; display:grid; place-items:center; border-radius:10px; background:var(--sage-tint); color:var(--green-700); font-size:1rem; }
@media (max-width: 767.98px) { .nx-local-item:hover { transform:none; } .nx-benefit:hover { transform:none; } }
.nx-scholarship-strip { background: var(--surface); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
.nx-strip-heading { max-width: 760px; margin: 0 auto 34px; text-align: center; }
.nx-strip-heading h2 { color: var(--ink); }
.nx-strip-heading p { margin: 0 auto; }
.nx-scholarship-logos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; align-items: stretch; }
.nx-scholarship-logo { min-height: 150px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; padding: 20px; border: 1px solid transparent; border-radius: 0 12px 0 12px; text-align: center; transition: border-color .16s ease, background .16s ease; }
.nx-scholarship-logo:hover { border-color: var(--border); background: var(--vanilla); }
.nx-scholarship-logo img { width: 92px; height: 62px; object-fit: contain; }
.nx-scholarship-logo strong { color: var(--green-900); font-family: var(--font-display); font-size: 14px; line-height: 1.35; }
@media (max-width: 767px) { .nx-scholarship-logos { grid-template-columns: 1fr; gap: 10px; } .nx-scholarship-logo { min-height: 110px; flex-direction: row; justify-content: flex-start; text-align: left; } }
@media (max-width: 767px) { .nx-photo-grid, .nx-local-list { grid-template-columns:1fr; } .nx-photo-card.tall { aspect-ratio: 4 / 3; } .nx-footer-local { align-items:flex-start; flex-direction:column; } }

/* ==========================================================================
   ADMIN-PORTAL ALIGNMENT OVERRIDES (chrome: navbar, hero, buttons, cards)
   ========================================================================== */
:root { --radius: 12px; --radius-sm: 8px; }

/* Type: Poppins everywhere, like the admin dashboard */
.nx-hero h1, .nx-h2, .sf-card h1, .sf-card h2, .page-hero h1, .nx-modal .modal-header h3 {
  font-family: 'Poppins', sans-serif; font-weight: 700; letter-spacing: -0.015em;
}
.page-hero h1 span { background: none; -webkit-background-clip: initial; background-clip: initial; color: var(--gold-light); }

/* Buttons: admin radius + shadow language */
.nx-btn, .btn-modal-close { border-radius: 10px; box-shadow: none; }

/* Navbar: exact admin-sidebar chrome (deep emerald gradient + gold brand mark + gold CTA) */
.navbar {
  background: radial-gradient(600px 220px at 100% 0%, rgba(184,145,47,.16), transparent 60%),
              linear-gradient(190deg, #1f4d3a 0%, #143a2b 70%);
  /* box-shadow: 0 4px 18px rgba(184, 145, 47, 0.4); */
}
.navbar-brand { font-family: 'Poppins', sans-serif; letter-spacing: .06em; }
.navbar-nav .nav-item.find-button .nav-link {
  background: linear-gradient(160deg, #f6dfa0, #b8912f); color: #143a2b !important; border-radius: 999px;
}
.navbar-nav .nav-item.find-button .nav-link:hover { background: linear-gradient(160deg, #fbeeca, #c9a44a); }

/* Hero: admin deep-emerald panel over the school photo */
.nx-hero {
  background: radial-gradient(680px 340px at 92% -10%, rgba(184,145,47,.20), transparent 60%),
    linear-gradient(100deg, rgba(20,58,43,.97) 0%, rgba(20,58,43,.90) 46%, rgba(31,77,58,.62) 100%),
    var(--hero-image) var(--hero-focus) center / cover no-repeat,
    linear-gradient(190deg, #1f4d3a 0%, #143a2b 70%);
  box-shadow: none;
}

/* Cards: admin white-card feel (light-gray border + 0 2px 10px shadow, 6px hover lift) */
.nx-step, .nx-sch-card, .nx-creator, .nx-benefit, .nx-form-card, .card-panel, .shelf-card, .program-card {
  border: 1px solid #eeece8; box-shadow: 0 2px 10px rgba(43,41,37,.06);
}
.nx-step:hover, .nx-sch-card:hover, .nx-creator:hover {
  transform: translateY(-3px); box-shadow: 0 6px 18px rgba(43,41,37,.10);
}

/* Icon tiles: admin soft-green-tint tiles (dark tiles only stay on dark panels) */
.nx-icon-tile { background: var(--sage-tint); color: var(--green-700); border-radius: 10px; }
.nx-step-n { color: rgba(31,77,58,.10); }

/* Pills: admin program-chip treatment */
.nx-pill { background: var(--sage-tint); border-color: transparent; color: var(--green-700); }

/* Panels: admin corner language */
.nx-about-panel { border-radius: 0 24px 0 24px; }
.nx-footer-band { border-radius: 12px; }

/* Modals + forms: admin radii */
.nx-modal .modal-content, .nx-success .modal-content { border-radius: 16px; }
.modal-section { border-radius: 12px; }
.nx-form-card .form-control, .nx-form-card { border-radius: 14px; }
.nx-feedback-form .form-control, .nx-feedback-form .form-select { border-radius: 10px; }

/* Success modal avatar: admin-style soft-green-tint circle */
.nx-success .nx-avatar { background: var(--sage-tint); color: var(--green-700); }

/* Steps section breathing room, admin spacing */
.nx-section { padding: 72px 0; }
@media (max-width: 575.98px) { .nx-section { padding: 56px 0; } }

/* Respect reduced motion preferences (kept from admin dashboard) */
@media (prefers-reduced-motion: reduce) {
  .nx-step, .nx-sch-card, .nx-creator, .nx-benefit, .nx-local-item, .nx-btn { transition: none !important; }
}
/* ==========================================================================
   PREMIUM UPGRADE — motion + refined shapes
   Builds on the classes already defined above; nothing here needs new
   markup. Cards/badges pick up the site's existing "cut corner" language
   (see .nx-mark, .nx-about-panel) so the premium look stays consistent
   with what's already there, plus a gold shine sweep and lift on hover.
   ========================================================================== */
@keyframes nxFadeUp {
  from { opacity: 0; transform: translateY(26px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes nxGlowPulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(184, 145, 47, .35); }
  50%      { box-shadow: 0 0 0 8px rgba(184, 145, 47, 0); }
}
@keyframes nxShimmer {
  0%   { background-position: 0% 50%; }
  100% { background-position: 160% 50%; }
}
/* One-shot sweeps: play a single time, then sit still until reload. */
@keyframes nxSweepOnce {
  0%   { transform: translateX(-140%); }
  100% { transform: translateX(140%); }
}
@keyframes nxSweepOnceLeft {
  0%   { left: -60%; }
  100% { left: 130%; }
}

/* ---------- Hero: headline, copy, buttons ease in on load ---------- */
.nx-hero-grid h1,
.nx-hero-grid > div > p,
.nx-hero-actions {
  opacity: 0;
  animation: nxFadeUp .8s cubic-bezier(.2,.7,.3,1) forwards;
}
.nx-hero-grid h1 { animation-delay: .1s; }
.nx-hero-grid > div > p { animation-delay: .26s; }
.nx-hero-actions { animation-delay: .42s; }

/* ---------- Buttons: one gold-foil shine on load, softer premium cut.
   The sweep plays once (animation, not :hover) and stays gone — hovering
   afterwards only does the plain lift/shadow below, no repeat shine. ---------- */
.nx-btn {
  position: relative; overflow: hidden;
  border-radius: 14px 4px 14px 4px;
}
.nx-btn::after {
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(115deg, transparent 30%, rgba(255,255,255,.55) 48%, transparent 66%);
  transform: translateX(-140%);
  animation: nxSweepOnce 1s ease-out .5s 1 forwards;
  pointer-events: none;
}
.nx-btn-gold {
  background-image: linear-gradient(160deg, var(--gold-light) 0%, var(--gold-fill, #c9a443) 45%, var(--gold-light) 100%);
  transition: transform .18s ease, box-shadow .18s ease;
}
.nx-btn-gold:hover { transform: translateY(-2px); box-shadow: 0 16px 30px -16px rgba(20, 58, 43, .55); }

/* ---------- Cards: cut-corner premium shape + one gold shine when the
   card first appears. Hover afterwards is just a lift — no repeat shine. ---------- */
.nx-step, .nx-sch-card, .nx-creator, .nx-benefit, .nx-feedback-card {
  position: relative; overflow: hidden;
  border-radius: 4px 22px 4px 22px;
  transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
}
.nx-step::before, .nx-sch-card::before, .nx-creator::before, .nx-benefit::before, .nx-feedback-card::before {
  content: ""; position: absolute; top: 0; left: -60%; width: 45%; height: 100%;
  background: linear-gradient(115deg, transparent, rgba(184,145,47,.22), transparent);
  transform: skewX(-18deg);
  animation: nxSweepOnceLeft 1.1s ease-out .2s 1 forwards;
  pointer-events: none;
}
.nx-step:hover, .nx-sch-card:hover, .nx-creator:hover, .nx-benefit:hover {
  transform: translateY(-5px); border-color: var(--gold);
  box-shadow: 0 26px 46px -26px rgba(20, 58, 43, .32);
}

/* ---------- Icon tiles: gold-foil gradient instead of a flat fill ---------- */
.nx-icon-tile, .nx-benefit i {
  background-image: linear-gradient(135deg, var(--green-700), var(--green-900));
  color: var(--gold-light);
  border-radius: 4px 16px 4px 16px;
  transition: transform .25s ease, box-shadow .25s ease;
}
.nx-step:hover .nx-icon-tile, .nx-benefit:hover i {
  transform: scale(1.08) rotate(-4deg);
  box-shadow: 0 10px 20px -10px rgba(20, 58, 43, .5);
}

/* ---------- Creator photo ring hover ---------- */
.nx-creator img { transition: box-shadow .25s ease, transform .25s ease; }
.nx-creator:hover img { transform: scale(1.04); box-shadow: 0 0 0 3px var(--gold-light), 0 12px 24px -14px rgba(20,58,43,.5); }

/* ---------- Badges / pills: one soft gold pulse on load to draw the eye ---------- */
.nx-story-label::before { animation: nxGlowPulse 1.2s ease-out 2; }
.nx-pill, .nx-role {
  transition: transform .18s ease, box-shadow .18s ease;
}
.nx-sch-card:hover .nx-pill, .nx-creator:hover .nx-role {
  transform: translateY(-1px); box-shadow: 0 6px 14px -8px rgba(184,145,47,.5);
}

/* ---------- Scholarship logos: soft lift + ring ---------- */
.nx-scholarship-logo { transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease; }
.nx-scholarship-logo:hover { transform: translateY(-4px); box-shadow: 0 20px 36px -22px rgba(20,58,43,.28); }
.nx-scholarship-logo img { transition: transform .22s ease; }
.nx-scholarship-logo:hover img { transform: scale(1.06); }

/* ---------- FAQ answers ease open instead of snapping ---------- */
.nx-faq-answer { animation: nxFadeUp .3s ease; }

@media (prefers-reduced-motion: reduce) {
  .nx-hero-grid h1, .nx-hero-grid > div > p, .nx-hero-actions,
  .nx-mark, .nx-story-label::before, .nx-faq-answer,
  .nx-btn::after, .nx-step::before, .nx-sch-card::before, .nx-creator::before,
  .nx-benefit::before, .nx-feedback-card::before {
    animation: none !important; transition: none !important;
    opacity: 1 !important; transform: none !important; left: -60% !important;
  }
  .nx-btn::after,
  .nx-step::before, .nx-sch-card::before, .nx-creator::before,
  .nx-benefit::before, .nx-feedback-card::before { display: none !important; }
}

/* ==========================================================================
   FEEDBACK — restructured into a spotlight panel + floating form card
   ========================================================================== */
.nx-feedback-showcase {
  display: grid; grid-template-columns: 1.15fr .95fr;
  align-items: stretch; gap: 0; margin-top: 8px;
}
.nx-feedback-spotlight {
  position: relative; overflow: hidden;
  padding: clamp(28px, 4vw, 48px) clamp(24px, 4vw, 44px);
  border-radius: 4px 0 0 4px;
  color: var(--vanilla);
  background:
    radial-gradient(520px 300px at 100% 0%, rgba(184,145,47,.22), transparent 62%),
    linear-gradient(190deg, var(--green-700) 0%, var(--green-900) 68%);
  display: flex; flex-direction: column; justify-content: center;
}
.nx-feedback-quote-mark {
  position: absolute; top: -18px; left: 18px; font-family: var(--font-serif);
  font-size: 9rem; line-height: 1; color: rgba(253,251,248,.08); pointer-events: none;
}
.nx-feedback-rating-badge {
  position: relative; z-index: 1;
  display: inline-flex; flex-direction: column; align-items: flex-start; gap: 4px;
  margin-bottom: 22px; padding: 14px 20px; width: fit-content;
  border-radius: 4px 14px 4px 14px;
  background: rgba(253,251,248,.08); border: 1px solid rgba(253,251,248,.16);
  backdrop-filter: blur(2px);
}
.nx-feedback-rating-badge strong { font-family: var(--font-serif); font-size: 2.1rem; line-height: 1; color: var(--gold-light); }
.nx-feedback-rating-badge .nx-feedback-stars { margin: 4px 0 0; justify-content: flex-start; color: var(--gold-light); font-size: .85rem; }
.nx-feedback-rating-badge span { font-size: 12px; color: rgba(253,251,248,.72); letter-spacing: .03em; }
.nx-feedback-spotlight .nx-feedback-carousel { position: relative; z-index: 1; max-width: none; margin: 0; }
.nx-feedback-spotlight .carousel-indicators [data-bs-target] { background-color: rgba(253,251,248,.4); }
.nx-feedback-spotlight .carousel-indicators .active { background-color: var(--gold-light); }
.nx-feedback-spotlight .carousel-control-prev-icon, .nx-feedback-spotlight .carousel-control-next-icon { background-color: rgba(253,251,248,.14); }

.nx-feedback-showcase .nx-feedback-form {
  margin: clamp(-28px, -3vw, -18px) 0 0 0;
  border-radius: 0 4px 4px 4px;
  box-shadow: 0 30px 60px -30px rgba(20, 58, 43, .4);
}

@media (max-width: 991.98px) {
  .nx-feedback-showcase { grid-template-columns: 1fr; }
  .nx-feedback-spotlight { border-radius: 4px 22px 0 0; }
  .nx-feedback-showcase .nx-feedback-form { margin: 0; border-radius: 0 0 4px 22px; }
}

/* ==========================================================================
   CONTACT — restructured into a deep-emerald panel with a floating form
   ========================================================================== */
.nx-contact { padding-top: 24px; }
.nx-contact-showcase {
  display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
  align-items: center; gap: clamp(0px, 2vw, 8px);
}
.nx-contact-panel {
  position: relative; overflow: hidden;
  padding: clamp(32px, 4.5vw, 56px) clamp(26px, 4vw, 46px);
  border-radius: 0 24px 0 24px; color: var(--vanilla);
  background:
    radial-gradient(560px 320px at 100% 0%, rgba(184,145,47,.16), transparent 60%),
    linear-gradient(190deg, var(--green-700) 0%, var(--green-900) 62%);
}
.nx-contact-panel::before {
  content: ""; position: absolute; top: -70px; right: -80px; width: 240px; height: 240px;
  border-radius: 50%; border: 1px solid rgba(253, 251, 248, .1); pointer-events: none;
}
.nx-contact-panel .nx-h2 { color: var(--vanilla); }
.nx-contact-panel .nx-lead { color: rgba(253, 251, 248, .78); }
.nx-contact-panel .nx-contact-item { color: rgba(253, 251, 248, .9); }
.nx-contact-panel .nx-icon-tile { background-image: linear-gradient(135deg, var(--gold), #8f6d22); color: var(--green-900); }
.nx-contact-panel .nx-social { background: rgba(253,251,248,.1); color: var(--vanilla); }
.nx-contact-panel .nx-social:hover { background: var(--gold); color: var(--green-900); }
.nx-story-label.light { background: rgba(253,251,248,.1); border-color: rgba(253,251,248,.3); color: var(--vanilla); }
.nx-story-label.light::before { background: var(--gold-light); }

.nx-contact-float {
  position: relative; z-index: 1;
  margin-left: clamp(-40px, -3vw, -20px);
  box-shadow: 0 34px 64px -30px rgba(20, 58, 43, .42);
  border-radius: 4px 24px 4px 24px;
}

@media (max-width: 991.98px) {
  .nx-contact-showcase { grid-template-columns: 1fr; gap: 24px; }
  .nx-contact-panel { border-radius: 0 18px 0 18px; }
  .nx-contact-float { margin: -28px 14px 0; }
}

/* ==========================================================================
   OPENING PRELOADER — brand pulse shown while the page first opens
   ========================================================================== */
@keyframes nxPreloaderPulse {
  0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(184,145,47,.45); }
  50%      { transform: scale(1.1); box-shadow: 0 0 0 10px rgba(184,145,47,0); }
}
.nx-preloader {
  position: fixed; inset: 0; z-index: 12000;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px;
  background:
    radial-gradient(600px 300px at 50% 0%, rgba(184,145,47,.14), transparent 62%),
    linear-gradient(190deg, var(--green-700) 0%, var(--green-900) 70%);
  transition: opacity .5s ease, visibility .5s ease;
}
.nx-preloader-mark {
  width: 64px; height: 64px;
  background: url("images/logo/bakr-logo.png") no-repeat center / contain;
  animation: nxPreloaderPulse 1.1s ease-in-out infinite;
}
.nx-preloader span {
  font-family: var(--font-display); color: var(--vanilla);
  letter-spacing: .3em; font-size: 13px; font-weight: 700; text-transform: uppercase; opacity: .85;
}
.nx-preloader.nx-preloader-hide { opacity: 0; visibility: hidden; pointer-events: none; }

@media (prefers-reduced-motion: reduce) {
  .nx-preloader { transition: none; }
  .nx-preloader-mark { animation: none; }
}

/* ==========================================================================
   WELCOME POPUP
   ========================================================================== */
.nx-welcome .modal-content { text-align: center; padding: clamp(30px, 4vw, 40px) clamp(24px, 4vw, 34px) 30px; position: relative; }
.nx-welcome-close { position: absolute; top: 16px; right: 16px; }
.nx-success .nx-avatar, .nx-welcome .nx-avatar { display: flex; align-items: center; justify-content: center; border-radius: 50%; }
.nx-welcome .nx-avatar {
  background-image: linear-gradient(135deg, var(--gold-light), var(--gold));
  color: var(--green-900);
  box-shadow: 0 12px 26px -14px rgba(184,145,47,.6);
}
.nx-welcome h4 { font-family: var(--font-serif); font-size: 1.5rem; color: var(--green-900); margin: 4px 0 10px; }
.nx-welcome p { color: var(--ink-soft); font-size: 14.5px; line-height: 1.65; max-width: 40ch; margin: 0 auto 22px; }
.nx-welcome-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }

/* ==========================================================================
   REFINED SUCCESS / WELCOME MODALS — brand header band + floating avatar
   (overrides the earlier .nx-success / .nx-welcome rules above)
   ========================================================================== */
.nx-success .modal-dialog,
.nx-welcome .modal-dialog {
  max-width: 420px;
  transform: translateY(28px) scale(.95);
  transition: transform .4s cubic-bezier(.22,1,.36,1), opacity .35s ease;
}
.nx-success.show .modal-dialog,
.nx-welcome.show .modal-dialog { transform: translateY(0) scale(1); }

.nx-success .modal-content,
.nx-welcome .modal-content {
  border: 0;
  border-radius: 4px 28px 4px 28px;
  overflow: hidden;
  background: var(--vanilla);
  text-align: center;
  padding: 0;
  box-shadow: 0 44px 90px -32px rgba(20, 58, 43, .5);
}

.nx-modal-band {
  height: 92px;
  position: relative;
  background:
    radial-gradient(220px 140px at 50% -10%, rgba(230, 207, 156, .35), transparent 65%),
    linear-gradient(165deg, var(--green-700) 0%, var(--green-900) 100%);
}
.nx-modal-band::after {
  content: "";
  position: absolute; inset: 0;
  background-image: radial-gradient(rgba(253, 251, 248, .16) 1px, transparent 1px);
  background-size: 14px 14px;
  opacity: .55;
  pointer-events: none;
}

.nx-modal-body-pad { padding: 0 clamp(24px, 4vw, 34px) clamp(28px, 4vw, 34px); }

.nx-success .nx-avatar,
.nx-welcome .nx-avatar {
  width: 78px; height: 78px;
  margin: -46px auto 18px;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  border: 5px solid var(--vanilla);
  box-shadow: 0 16px 30px -14px rgba(20, 58, 43, .45);
  font-size: 1.9rem;
  position: relative; z-index: 1;
}
.nx-success .nx-avatar { background: var(--sage-tint); color: var(--green-700); }
.nx-welcome .nx-avatar {
  background: linear-gradient(150deg, var(--green-700), var(--green-900));
  padding: 17px;
}
.nx-welcome .nx-avatar img {
  width: 100%; height: 100%; object-fit: contain;
  filter: drop-shadow(0 3px 6px rgba(0, 0, 0, .35));
}

.nx-success h4, .nx-welcome h4 {
  font-family: var(--font-serif);
  font-size: 1.5rem; font-weight: 600; color: var(--green-900);
  margin: 4px 0 10px;
}
.nx-success p, .nx-welcome p {
  color: var(--ink-soft); font-size: 14.5px; line-height: 1.65;
  max-width: 40ch; margin: 0 auto 24px;
}

.nx-welcome-close, .nx-success-close {
  position: absolute; top: 14px; right: 14px; z-index: 2;
  filter: invert(1) brightness(2.4);
  opacity: .85; transition: opacity .18s ease;
}
.nx-welcome-close:hover, .nx-success-close:hover { opacity: 1; }

.nx-welcome-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }

@media (prefers-reduced-motion: reduce) {
  .nx-success .modal-dialog, .nx-welcome .modal-dialog { transition: none; }
}

    
/* Compact navbar state (same as index) — toggled by the scroll script below. */
.navbar {
  transition: top 200ms ease-in-out, padding 200ms ease-in-out, box-shadow 200ms ease-in-out, border-radius 200ms ease-in-out;
}
.navbar.is-scrolled {
  top: 12px;
  padding-top: 8px;
  padding-bottom: 8px;
  box-shadow: 0 12px 28px rgba(20, 58, 43, .28);
}
@media (max-width: 991.98px) {
  .navbar { top: 0; left: 0; right: 0; width: 100%; border-radius: 0; padding: 8px 14px; }
  .navbar.is-scrolled { top: 0; padding-top: 5px; padding-bottom: 5px; box-shadow: 0 8px 22px rgba(20, 58, 43, .3); }
  html { scroll-padding-top: 72px; }
}

/* Mobile navigation is full-width and flush to the viewport edge (same as index). */
@media (max-width: 768px) {
