   no other markup needs to change.

   Link this ONE file on every page (instead of home.css AND
   scholarships-BAKR.css AND BAKR-navbar.css):
     <link rel="stylesheet" href="BAKR.css">
   ========================================================================== */

:root {
  /* ------------------------------------------------------------------
     HERO IMAGE (home page)  <<< change this one line to swap in your photo >>>
     ------------------------------------------------------------------ */
  

  /* Shared palette — taken from scholarships-BAKR.css (the navbar's
     palette), used everywhere now for one consistent look */
